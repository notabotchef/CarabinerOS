        "code": "// ✅ ENHANCED use-workspace.ts with cache\nconst cache = new Map<string, { data: unknown; timestamp: number }>();\nconst CACHE_TTL = 30000; // 30 seconds\n\nexport function useWorkspace<T = Record<string, unknown>>(\n  endpoint: string,\n  locationId?: string,\n): UseWorkspaceReturn<T> {\n  const [data, setData] = useState<T[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n  const [refreshKey, setRefreshKey] = useState(0);\n\n  useEffect(() => {\n    const url = locationId\n      ? `${endpoint}?location_id=${locationId}`\n      : endpoint;\n\n    // Check cache first\n    const cached = cache.get(url);\n    if (cached && Date.now() - cached.timestamp < CACHE_TTL) {\n      setData(cached.data as T[]);\n      setLoading(false);\n      return;\n    }\n\n    setLoading(true);\n    fetch(url, { credentials: \"include\" })\n      .then(async (res) => {\n        if (!res.ok) throw new Error(`${res.status}`);\n        const json = await res.json();\n        const items = Array.isArray(json) ? json : json.items ?? json.data ?? [];\n        \n        // Update cache\n        cache.set(url, { data: items, timestamp: Date.now() });\n        \n        setData(items);\n        setError(null);\n      })\n      .catch((err) => {\n        setError(err.message);\n        setData([]);\n      })\n      .finally(() => setLoading(false));\n  }, [endpoint, locationId, refreshKey]);\n\n  return { data, loading, error, refresh: () => setRefreshKey((k) => k + 1) };\n}"
