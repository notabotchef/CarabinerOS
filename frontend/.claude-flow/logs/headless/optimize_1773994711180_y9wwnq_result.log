ipt\nconst sendMessage = useCallback(async (text: string): Promise<string> => {\n  if (isProcessingRef.current) {\n    // ✅ Queue WITHOUT showing - doSend will add the message\n    setQueuedMessages(prev => [...prev, text]);\n    return contextIdRef.current || \"\";\n  }\n  return doSend(text);\n}, [doSend]);\n```\n\n---\n\n",
