        "code": "// ✅ Memoize extraction and only process new logs\nconst lastProcessedLog = useRef<number>(0);\n\nconst { thoughts, headline, step } = useMemo(() => {\n  if (!snapshot?.logs?.length) {\n    return { thoughts: [], headline: null, step: null };\n  }\n\n  // Only process logs after lastProcessedLog\n  const newLogs = snapshot.logs.slice(lastProcessedLog.current);\n  \n  for (let i = newLogs.length - 1; i >= 0; i--) {\n    const log = newLogs[i];\n    if (log.type !== \"agent\" || !log.kvps) continue;\n\n    const kvps = getAgentKvps(log.kvps);\n    if (kvps.thoughts?.length || kvps.headline || kvps.step) {\n      lastProcessedLog.current = snapshot.logs.length;\n      return {\n        thoughts: kvps.thoughts ?? [],\n        headline: kvps.headline ?? null,\n        step: kvps.step ?? null,\n      };\n    }\n  }\n\n  return { thoughts: [], headline: null, step: null };\n}, [snapshot]);"
