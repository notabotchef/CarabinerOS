        "code": "// ✅ Bounded cache with automatic cleanup\nconst MAX_PROCESSED = 1000;\nconst processedIds = useRef(new Set<string>());\n\nuseEffect(() => {\n  for (const log of snapshot.logs) {\n    if (processedIds.current.has(log.id)) continue;\n    \n    // Limit set size\n    if (processedIds.current.size >= MAX_PROCESSED) {\n      const firstItem = processedIds.current.values().next().value;\n      processedIds.current.delete(firstItem);\n    }\n    \n    processedIds.current.add(log.id);\n    // ... rest of logic\n  }\n}, [snapshot]);"
