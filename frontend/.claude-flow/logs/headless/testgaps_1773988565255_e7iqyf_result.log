        "language": "typescript",
        "code": "// __tests__/hooks/use-workspace.test.ts\n\nimport { renderHook, waitFor } from '@testing-library/react';\nimport { useWorkspace } from '@/hooks/use-workspace';\n\nglobal.fetch = jest.fn();\n\ndescribe('useWorkspace', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n  });\n\n  it('should fetch data successfully', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => [{ id: 1, name: 'Item 1' }]\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/items'));\n\n    await waitFor(() => expect(result.current.loading).toBe(false));\n\n    expect(result.current.data).toEqual([{ id: 1, name: 'Item 1' }]);\n    expect(result.current.error).toBeNull();\n  });\n\n  it('should append locationId to URL when provided', async () => {\n    const mockFetch = global.fetch as jest.Mock;\n    mockFetch.mockResolvedValue({\n      ok: true,\n      json: async () => []\n    });\n\n    renderHook(() => useWorkspace('/api/items', 'loc-123'));\n\n    await waitFor(() => {\n      expect(mockFetch).toHaveBeenCalledWith(\n        '/api/items?location_id=loc-123',\n        expect.any(Object)\n      );\n    });\n  });\n\n  it('should handle response.items wrapper format', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => ({ items: [{ id: 1 }], total: 1 })\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/wrapped'));\n\n    await waitFor(() => expect(result.current.loading).toBe(false));\n\n    expect(result.current.data).toEqual([{ id: 1 }]);\n  });\n\n  it('should handle response.data wrapper format', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => ({ data: [{ id: 2 }] })\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/wrapped2'));\n\n    await waitFor(() => expect(result.current.loading).toBe(false));\n\n    expect(result.current.data).toEqual([{ id: 2 }]);\n  });\n\n  it('should handle non-ok responses', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      ok: false,\n      status: 404\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/missing'));\n\n    await waitFor(() => expect(result.current.loading).toBe(false));\n\n    expect(result.current.error).toBe('404');\n    expect(result.current.data).toEqual([]);\n  });\n\n  it('should handle network errors', async () => {\n    (global.fetch as jest.Mock).mockRejectedValue(new Error('Connection failed'));\n\n    const { result } = renderHook(() => useWorkspace('/api/fail'));\n\n    await waitFor(() => expect(result.current.loading).toBe(false));\n\n    expect(result.current.error).toBe('Connection failed');\n    expect(result.current.data).toEqual([]);\n  });\n\n  it('should refresh when refresh() is called', async () => {\n    const mockFetch = global.fetch as jest.Mock;\n    mockFetch.mockResolvedValue({\n      ok: true,\n      json: async () => [{ id: 1 }]\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/items'));\n\n    await waitFor(() => expect(result.current.loading).toBe(false));\n\n    expect(mockFetch).toHaveBeenCalledTimes(1);\n\n    result.current.refresh();\n\n    await waitFor(() => expect(mockFetch).toHaveBeenCalledTimes(2));\n  });\n\n  it('should refetch when endpoint changes', async () => {\n    const mockFetch = global.fetch as jest.Mock;\n    mockFetch.mockResolvedValue({\n      ok: true,\n      json: async () => []\n    });\n\n    const { rerender } = renderHook(\n      ({ ep }) => useWorkspace(ep),\n      { initialProps: { ep: '/api/a' } }\n    );\n\n    await waitFor(() => expect(mockFetch).toHaveBeenCalledWith('/api/a', expect.any(Object)));\n\n    rerender({ ep: '/api/b' });\n\n    await waitFor(() => expect(mockFetch).toHaveBeenCalledWith('/api/b', expect.any(Object)));\n  });\n});"
