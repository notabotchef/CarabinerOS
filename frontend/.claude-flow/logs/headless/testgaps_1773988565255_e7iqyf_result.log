        "language": "typescript",
        "code": "// __tests__/lib/csrf.test.ts\n\nimport { getCsrfToken, clearCsrfToken, getRuntimeId } from '@/lib/csrf';\n\nglobal.fetch = jest.fn();\n\ndescribe('csrf', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n    clearCsrfToken();\n    document.cookie = '';\n  });\n\n  it('should fetch and cache CSRF token', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'csrf-123', runtime_id: 'rt-1' })\n    });\n\n    const token = await getCsrfToken();\n\n    expect(token).toBe('csrf-123');\n    expect(global.fetch).toHaveBeenCalledTimes(1);\n\n    // Second call should use cache\n    const token2 = await getCsrfToken();\n    expect(token2).toBe('csrf-123');\n    expect(global.fetch).toHaveBeenCalledTimes(1); // Still 1\n  });\n\n  it('should handle concurrent requests', async () => {\n    (global.fetch as jest.Mock).mockImplementation(\n      () => new Promise(resolve => \n        setTimeout(() => resolve({\n          json: async () => ({ ok: true, token: 'csrf-456', runtime_id: 'rt-2' })\n        }), 100)\n      )\n    );\n\n    const [token1, token2, token3] = await Promise.all([\n      getCsrfToken(),\n      getCsrfToken(),\n      getCsrfToken()\n    ]);\n\n    expect(token1).toBe('csrf-456');\n    expect(token2).toBe('csrf-456');\n    expect(token3).toBe('csrf-456');\n    expect(global.fetch).toHaveBeenCalledTimes(1); // Only one fetch\n  });\n\n  it('should set cookie with runtime_id in name', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'csrf-789', runtime_id: 'rt-xyz' })\n    });\n\n    await getCsrfToken();\n\n    expect(document.cookie).toContain('csrf_token_rt-xyz=csrf-789');\n    expect(document.cookie).toContain('SameSite=Strict');\n  });\n\n  it('should throw on error response', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: false, error: 'Invalid request' })\n    });\n\n    await expect(getCsrfToken()).rejects.toThrow('Invalid request');\n  });\n\n  it('should handle network errors', async () => {\n    (global.fetch as jest.Mock).mockRejectedValue(new Error('Network failure'));\n\n    await expect(getCsrfToken()).rejects.toThrow('Network failure');\n  });\n\n  it('should return runtimeId after successful fetch', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'csrf-999', runtime_id: 'rt-abc' })\n    });\n\n    await getCsrfToken();\n\n    expect(getRuntimeId()).toBe('rt-abc');\n  });\n\n  it('should clear cache and allow re-fetch', async () => {\n    (global.fetch as jest.Mock)\n      .mockResolvedValueOnce({\n        json: async () => ({ ok: true, token: 'old-token', runtime_id: 'rt-1' })\n      })\n      .mockResolvedValueOnce({\n        json: async () => ({ ok: true, token: 'new-token', runtime_id: 'rt-2' })\n      });\n\n    const token1 = await getCsrfToken();\n    expect(token1).toBe('old-token');\n\n    clearCsrfToken();\n\n    const token2 = await getCsrfToken();\n    expect(token2).toBe('new-token');\n    expect(global.fetch).toHaveBeenCalledTimes(2);\n  });\n});"
