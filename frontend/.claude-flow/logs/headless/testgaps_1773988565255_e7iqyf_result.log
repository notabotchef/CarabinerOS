        "title": "Missing Test Scenarios",
        "content": "\n```typescript\n// __tests__/hooks/use-action-cards.test.ts\n\nimport { renderHook, act } from '@testing-library/react';\nimport { useActionCards } from '@/hooks/use-action-cards';\nimport type { A0Snapshot } from '@/lib/types';\n\ndescribe('useActionCards', () => {\n  describe('card extraction', () => {\n    it('should extract action cards from tool logs', () => {\n      const snapshot: A0Snapshot = {\n        logs: [{\n          id: 'log-1',\n          no: 1,\n          type: 'tool',\n          kvps: {\n            module: 'inventory',\n            action: 'check_stock',\n            item_id: 'item-123',\n            item: { name: 'Tomatoes' }\n          },\n          content: 'Checking stock for tomatoes in walk-in',\n          heading: '',\n          timestamp: Date.now() / 1000,\n          agentno: 0\n        }],\n        /* ... other snapshot fields */\n      };\n      \n      const { result } = renderHook(() => useActionCards(snapshot));\n      \n      expect(result.current.cards).toHaveLength(1);\n      expect(result.current.cards[0].module).toBe('inventory');\n      expect(result.current.cards[0].action).toBe('check_stock');\n    });\n\n    it('should handle null snapshot', () => {\n      const { result } = renderHook(() => useActionCards(null));\n      expect(result.current.cards).toEqual([]);\n      expect(result.current.unreadCount).toBe(0);\n    });\n\n    it('should skip logs without module/action kvps', () => {\n      const snapshot: A0Snapshot = {\n        logs: [\n          { id: '1', no: 1, type: 'tool', kvps: {}, content: '', heading: '', timestamp: 0, agentno: 0 },\n          { id: '2', no: 2, type: 'tool', kvps: { module: 'foo' }, content: '', heading: '', timestamp: 0, agentno: 0 }\n        ],\n        /* ... */\n      };\n      \n      const { result } = renderHook(() => useActionCards(snapshot));\n      expect(result.current.cards).toEqual([]);\n    });\n\n    it('should not process duplicate log IDs', () => {\n      const log = {\n        id: 'dup-1',\n        no: 1,\n        type: 'tool' as const,\n        kvps: { module: 'prep', action: 'create_list' },\n        content: 'Creating prep list',\n        heading: '',\n        timestamp: 0,\n        agentno: 0\n      };\n\n      const { result, rerender } = renderHook(\n        ({ snap }) => useActionCards(snap),\n        { initialProps: { snap: { logs: [log] } as A0Snapshot } }\n      );\n\n      expect(result.current.cards).toHaveLength(1);\n\n      // Re-render with same log\n      rerender({ snap: { logs: [log, log] } as A0Snapshot });\n      expect(result.current.cards).toHaveLength(1); // Should still be 1\n    });\n\n    it('should truncate summary to 120 chars', () => {\n      const longContent = 'A'.repeat(200);\n      const snapshot: A0Snapshot = {\n        logs: [{\n          id: '1', no: 1, type: 'tool',\n          kvps: { module: 'test', action: 'test' },\n          content: longContent,\n          heading: '', timestamp: 0, agentno: 0\n        }],\n        /* ... */\n      };\n\n      const { result } = renderHook(() => useActionCards(snapshot));\n      expect(result.current.cards[0].summary).toHaveLength(120);\n    });\n  });\n\n  describe('markRead', () => {\n    it('should mark specific card as read', () => {\n      const snapshot: A0Snapshot = {\n        logs: [\n          { id: 'c1', no: 1, type: 'tool', kvps: { module: 'a', action: 'b' }, content: '', heading: '', timestamp: 0, agentno: 0 },\n          { id: 'c2', no: 2, type: 'tool', kvps: { module: 'a', action: 'b' }, content: '', heading: '', timestamp: 0, agentno: 0 }\n        ],\n        /* ... */\n      };\n\n      const { result } = renderHook(() => useActionCards(snapshot));\n      \n      act(() => result.current.markRead('c1'));\n      \n      expect(result.current.cards[0].read).toBe(true);\n      expect(result.current.cards[1].read).toBe(false);\n      expect(result.current.unreadCount).toBe(1);\n    });\n\n    it('should handle marking non-existent card', () => {\n      const { result } = renderHook(() => useActionCards(null));\n      \n      act(() => result.current.markRead('non-existent'));\n      \n      expect(result.current.cards).toEqual([]);\n    });\n  });\n\n  describe('markAllRead', () => {\n    it('should mark all cards as read', () => {\n      const snapshot: A0Snapshot = {\n        logs: [\n          { id: 'c1', no: 1, type: 'tool', kvps: { module: 'a', action: 'b' }, content: '', heading: '', timestamp: 0, agentno: 0 },\n          { id: 'c2', no: 2, type: 'tool', kvps: { module: 'a', action: 'b' }, content: '', heading: '', timestamp: 0, agentno: 0 }\n        ],\n        /* ... */\n      };\n\n      const { result } = renderHook(() => useActionCards(snapshot));\n      \n      act(() => result.current.markAllRead());\n      \n      expect(result.current.unreadCount).toBe(0);\n      expect(result.current.cards.every(c => c.read)).toBe(true);\n    });\n  });\n});\n```\n\n---\n\n",
