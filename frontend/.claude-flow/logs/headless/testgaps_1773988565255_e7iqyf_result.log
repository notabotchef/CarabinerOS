        "title": "3. use-expo-stream.ts",
        "content": "\n",
        "level": 2
      },
      {
        "title": "Missing Edge Cases",
        "content": "\n```typescript\n// __tests__/hooks/use-expo-stream.test.ts\n\nimport { renderHook, act } from '@testing-library/react';\nimport { useExpoStream } from '@/hooks/use-expo-stream';\nimport type { A0Snapshot, ChefStatus } from '@/lib/types';\n\ndescribe('useExpoStream', () => {\n  describe('text priority resolution', () => {\n    it('should prioritize headline over step', () => {\n      const snapshot: A0Snapshot = {\n        logs: [{\n          id: '1', no: 1, type: 'agent',\n          kvps: { headline: 'Checking inventory', step: 'Opening walk-in' },\n          content: '', heading: '', timestamp: 0, agentno: 0\n        }],\n        log_progress_active: true,\n        /* ... */\n      };\n\n      const { result } = renderHook(() => useExpoStream(snapshot, null));\n\n      expect(result.current.text).toBe('Checking inventory');\n    });\n\n    it('should use step when headline is missing', () => {\n      const snapshot: A0Snapshot = {\n        logs: [{\n          id: '1', no: 1, type: 'agent',\n          kvps: { step: 'Counting stock' },\n          content: '', heading: '', timestamp: 0, agentno: 0\n        }],\n        log_progress_active: true,\n        /* ... */\n      };\n\n      const { result } = renderHook(() => useExpoStream(snapshot, null));\n\n      expect(result.current.text).toBe('Counting stock');\n    });\n\n    it('should fall back to chefStatus when no headline/step', () => {\n      const snapshot: A0Snapshot = {\n        logs: [],\n        log_progress_active: true,\n        /* ... */\n      };\n      const chefStatus: ChefStatus = {\n        status: 'working',\n        text: 'Processing order',\n        active: true\n      };\n\n      const { result } = renderHook(() => useExpoStream(snapshot, chefStatus));\n\n      expect(result.current.text).toBe('Processing order');\n    });\n\n    it('should use sticky text when current log has no text', () => {\n      const { result, rerender } = renderHook(\n        ({ snap, chef }) => useExpoStream(snap, chef),\n        {\n          initialProps: {\n            snap: {\n              logs: [{ id: '1', no: 1, type: 'agent', kvps: { headline: 'Sticky text' }, content: '', heading: '', timestamp: 0, agentno: 0 }],\n              log_progress_active: true\n            } as A0Snapshot,\n            chef: null\n          }\n        }\n      );\n\n      expect(result.current.text).toBe('Sticky text');\n\n      // New log without headline\n      rerender({\n        snap: {\n          logs: [{ id: '2', no: 2, type: 'agent', kvps: {}, content: '', heading: '', timestamp: 0, agentno: 0 }],\n          log_progress_active: true\n        } as A0Snapshot,\n        chef: null\n      });\n\n      expect(result.current.text).toBe('Sticky text'); // Should persist\n    });\n\n    it('should fall back to random joke as last resort', () => {\n      const snapshot: A0Snapshot = {\n        logs: [],\n        log_progress_active: true,\n        /* ... */\n      };\n\n      const { result } = renderHook(() => useExpoStream(snapshot, null));\n\n      expect(result.current.text).toBeTruthy();\n      expect(typeof result.current.text).toBe('string');\n    });\n  });\n\n  describe('thoughts extraction', () => {\n    it('should extract thoughts array from agent logs', () => {\n      const snapshot: A0Snapshot = {\n        logs: [{\n          id: '1', no: 1, type: 'agent',\n          kvps: { thoughts: ['First thought', 'Second thought'] },\n          content: '', heading: '', timestamp: 0, agentno: 0\n        }],\n        log_progress_active: true,\n        /* ... */\n      };\n\n      const { result } = renderHook(() => useExpoStream(snapshot, null));\n\n      expect(result.current.thoughts).toEqual(['First thought', 'Second thought']);\n    });\n\n    it('should scan logs from most recent backwards', () => {\n      const snapshot: A0Snapshot = {\n        logs: [\n          { id: '1', no: 1, type: 'agent', kvps: { thoughts: ['Old'] }, content: '', heading: '', timestamp: 0, agentno: 0 },\n          { id: '2', no: 2, type: 'agent', kvps: { thoughts: ['Recent'] }, content: '', heading: '', timestamp: 0, agentno: 0 }\n        ],\n        log_progress_active: true,\n        /* ... */\n      };\n\n      const { result } = renderHook(() => useExpoStream(snapshot, null));\n\n      expect(result.current.thoughts).toEqual(['Recent']);\n    });\n\n    it('should handle non-array thoughts gracefully', () => {\n      const snapshot: A0Snapshot = {\n        logs: [{\n          id: '1', no: 1, type: 'agent',\n          kvps: { thoughts: 'not an array' },\n          content: '', heading: '', timestamp: 0, agentno: 0\n        }],\n        log_progress_active: true,\n        /* ... */\n      };\n\n      const { result } = renderHook(() => useExpoStream(snapshot, null));\n\n      expect(result.current.thoughts).toEqual([]);\n    });\n  });\n\n  describe('completion behavior', () => {\n    it('should transition to inactive after 3s when chefStatus completes', async () => {\n      jest.useFakeTimers();\n\n      const { result, rerender } = renderHook(\n        ({ chef }) => useExpoStream(null, chef),\n        {\n          initialProps: {\n            chef: { status: 'completed' as const, text: 'Done', active: false }\n          }\n        }\n      );\n\n      expect(result.current.text).toBe('Done');\n      expect(result.current.active).toBe(false);\n\n      act(() => jest.advanceTimersByTime(3000));\n\n      expect(result.current.text).toBeNull();\n\n      jest.useRealTimers();\n    });\n\n    it('should clear sticky text on completion', () => {\n      const { result, rerender } = renderHook(\n        ({ snap, chef }) => useExpoStream(snap, chef),\n        {\n          initialProps: {\n            snap: {\n              logs: [{ id: '1', no: 1, type: 'agent', kvps: { headline: 'Working' }, content: '', heading: '', timestamp: 0, agentno: 0 }],\n              log_progress_active: true\n            } as A0Snapshot,\n            chef: null\n          }\n        }\n      );\n\n      expect(result.current.text).toBe('Working');\n\n      // Complete\n      rerender({\n        snap: { logs: [], log_progress_active: false } as A0Snapshot,\n        chef: { status: 'completed' as const, text: 'Done', active: false }\n      });\n\n      expect(result.current.text).toBe('Done');\n    });\n  });\n});\n```\n\n---\n\n",
