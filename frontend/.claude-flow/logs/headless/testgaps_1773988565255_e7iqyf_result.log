        "language": "typescript",
        "code": "// __tests__/hooks/use-chat.test.ts\n\nimport { renderHook, act, waitFor } from '@testing-library/react';\nimport { useChat } from '@/hooks/use-chat';\nimport * as csrfModule from '@/lib/csrf';\n\n// Mock fetch\nglobal.fetch = jest.fn();\n\ndescribe('useChat', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n    jest.spyOn(csrfModule, 'getCsrfToken').mockResolvedValue('test-token');\n  });\n\n  describe('message queueing', () => {\n    it('should queue messages sent while processing', async () => {\n      (global.fetch as jest.Mock).mockResolvedValue({\n        ok: true,\n        json: async () => ({ context: 'ctx-1' })\n      });\n\n      const { result } = renderHook(() => useChat(null));\n\n      // Send first message (starts processing)\n      act(() => { result.current.sendMessage('msg1'); });\n      \n      // Send second before first completes (should queue)\n      act(() => { result.current.sendMessage('msg2'); });\n\n      await waitFor(() => expect(result.current.queuedMessages).toContain('msg2'));\n    });\n\n    it('should process queued messages after loading finishes', async () => {\n      (global.fetch as jest.Mock).mockResolvedValue({\n        ok: true,\n        json: async () => ({ context: 'ctx-1' })\n      });\n\n      const snapshot = { logs: [], log_progress_active: false, /* ... */ };\n      const { result, rerender } = renderHook(\n        ({ snap }) => useChat(snap),\n        { initialProps: { snap: null } }\n      );\n\n      act(() => { result.current.sendMessage('msg1'); });\n      act(() => { result.current.sendMessage('msg2'); }); // Queued\n\n      // Simulate loading complete\n      rerender({ snap: snapshot as any });\n\n      await waitFor(() => expect(result.current.queuedMessages).toHaveLength(0), { timeout: 2000 });\n    });\n  });\n\n  describe('error handling', () => {\n    it('should show error message on network failure', async () => {\n      (global.fetch as jest.Mock).mockRejectedValue(new Error('Network error'));\n\n      const { result } = renderHook(() => useChat(null));\n\n      await act(async () => {\n        await result.current.sendMessage('test');\n      });\n\n      expect(result.current.messages).toContainEqual(\n        expect.objectContaining({\n          role: 'assistant',\n          content: expect.stringContaining(\"Can't reach the kitchen\")\n        })\n      );\n      expect(result.current.loading).toBe(false);\n    });\n\n    it('should handle non-200 responses', async () => {\n      (global.fetch as jest.Mock).mockResolvedValue({\n        ok: false,\n        status: 500\n      });\n\n      const { result } = renderHook(() => useChat(null));\n\n      await act(async () => {\n        await result.current.sendMessage('test');\n      });\n\n      expect(result.current.messages.some(m => \n        m.role === 'assistant' && m.content.includes(\"Can't reach\")\n      )).toBe(true);\n    });\n  });\n\n  describe('resetChat', () => {\n    it('should clear all state and ignore stale logs', async () => {\n      const staleSnapshot = {\n        logs: [\n          { id: '1', no: 1, type: 'user', content: 'old message', heading: '', kvps: {}, timestamp: 0, agentno: 0 }\n        ],\n        context: 'old-ctx',\n        log_progress_active: false,\n        /* ... */\n      };\n\n      const { result } = renderHook(() => useChat(staleSnapshot as any));\n\n      act(() => result.current.resetChat());\n\n      expect(result.current.messages).toEqual([]);\n      expect(result.current.contextId).toBeNull();\n      expect(result.current.queuedMessages).toEqual([]);\n    });\n\n    it('should accept logs after first message post-reset', async () => {\n      (global.fetch as jest.Mock).mockResolvedValue({\n        ok: true,\n        json: async () => ({ context: 'new-ctx' })\n      });\n\n      const { result } = renderHook(() => useChat(null));\n\n      act(() => result.current.resetChat());\n      \n      await act(async () => {\n        await result.current.sendMessage('first new message');\n      });\n\n      // Now snapshot logs should be processed\n      expect(result.current.loading).toBe(false);\n    });\n  });\n\n  describe('deduplication', () => {\n    it('should not duplicate logs with same ID', () => {\n      const log = {\n        id: 'msg-1',\n        no: 1,\n        type: 'user' as const,\n        content: 'Hello',\n        heading: '',\n        kvps: {},\n        timestamp: 0,\n        agentno: 0\n      };\n\n      const { result, rerender } = renderHook(\n        ({ snap }) => useChat(snap),\n        { initialProps: { snap: { logs: [log] } as any } }\n      );\n\n      const initialCount = result.current.messages.length;\n\n      rerender({ snap: { logs: [log, log] } as any });\n\n      expect(result.current.messages).toHaveLength(initialCount);\n    });\n\n    it('should use log.no as fallback dedup key when id is null', () => {\n      const logs = [\n        { id: null, no: 1, type: 'user' as const, content: 'A', heading: '', kvps: {}, timestamp: 0, agentno: 0 },\n        { id: null, no: 1, type: 'user' as const, content: 'B', heading: '', kvps: {}, timestamp: 0, agentno: 0 }\n      ];\n\n      const { result } = renderHook(() => useChat({ logs } as any));\n\n      expect(result.current.messages).toHaveLength(1);\n    });\n  });\n\n  describe('context management', () => {\n    it('should update contextId from snapshot', () => {\n      const snapshot = {\n        logs: [],\n        context: 'ctx-123',\n        log_progress_active: false,\n        /* ... */\n      };\n\n      const { result } = renderHook(() => useChat(snapshot as any));\n\n      expect(result.current.contextId).toBe('ctx-123');\n    });\n\n    it('should send contextId in message requests', async () => {\n      const mockFetch = global.fetch as jest.Mock;\n      mockFetch.mockResolvedValue({\n        ok: true,\n        json: async () => ({ context: 'ctx-1' })\n      });\n\n      const snapshot = { logs: [], context: 'existing-ctx', log_progress_active: false };\n      const { result } = renderHook(() => useChat(snapshot as any));\n\n      await act(async () => {\n        await result.current.sendMessage('test');\n      });\n\n      expect(mockFetch).toHaveBeenCalledWith(\n        '/message_async',\n        expect.objectContaining({\n          body: expect.stringContaining('\"context\":\"existing-ctx\"')\n        })\n      );\n    });\n  });\n});"
