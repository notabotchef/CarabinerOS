        "title": "6. use-workspace.ts",
        "content": "\n",
        "level": 2
      },
      {
        "title": "Error Handling & Data Format Tests",
        "content": "\n```typescript\n// __tests__/hooks/use-workspace.test.ts\n\nimport { renderHook, waitFor } from '@testing-library/react';\nimport { useWorkspace } from '@/hooks/use-workspace';\n\nglobal.fetch = jest.fn();\n\ndescribe('useWorkspace', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n  });\n\n  it('should fetch data successfully', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => [{ id: 1, name: 'Item 1' }]\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/items'));\n\n    await waitFor(() => expect(result.current.loading).toBe(false));\n\n    expect(result.current.data).toEqual([{ id: 1, name: 'Item 1' }]);\n    expect(result.current.error).toBeNull();\n  });\n\n  it('should append locationId to URL when provided', async () => {\n    const mockFetch = global.fetch as jest.Mock;\n    mockFetch.mockResolvedValue({\n      ok: true,\n      json: async () => []\n    });\n\n    renderHook(() => useWorkspace('/api/items', 'loc-123'));\n\n    await waitFor(() => {\n      expect(mockFetch).toHaveBeenCalledWith(\n        '/api/items?location_id=loc-123',\n        expect.any(Object)\n      );\n    });\n  });\n\n  it('should handle response.items wrapper format', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => ({ items: [{ id: 1 }], total: 1 })\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/wrapped'));\n\n    await waitFor(() => expect(result.current.loading).toBe(false));\n\n    expect(result.current.data).toEqual([{ id: 1 }]);\n  });\n\n  it('should handle response.data wrapper format', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => ({ data: [{ id: 2 }] })\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/wrapped2'));\n\n    await waitFor(() => expect(result.current.loading).toBe(false));\n\n    expect(result.current.data).toEqual([{ id: 2 }]);\n  });\n\n  it('should handle non-ok responses', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      ok: false,\n      status: 404\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/missing'));\n\n    await waitFor(() => expect(result.current.loading).toBe(false));\n\n    expect(result.current.error).toBe('404');\n    expect(result.current.data).toEqual([]);\n  });\n\n  it('should handle network errors', async () => {\n    (global.fetch as jest.Mock).mockRejectedValue(new Error('Connection failed'));\n\n    const { result } = renderHook(() => useWorkspace('/api/fail'));\n\n    await waitFor(() => expect(result.current.loading).toBe(false));\n\n    expect(result.current.error).toBe('Connection failed');\n    expect(result.current.data).toEqual([]);\n  });\n\n  it('should refresh when refresh() is called', async () => {\n    const mockFetch = global.fetch as jest.Mock;\n    mockFetch.mockResolvedValue({\n      ok: true,\n      json: async () => [{ id: 1 }]\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/items'));\n\n    await waitFor(() => expect(result.current.loading).toBe(false));\n\n    expect(mockFetch).toHaveBeenCalledTimes(1);\n\n    result.current.refresh();\n\n    await waitFor(() => expect(mockFetch).toHaveBeenCalledTimes(2));\n  });\n\n  it('should refetch when endpoint changes', async () => {\n    const mockFetch = global.fetch as jest.Mock;\n    mockFetch.mockResolvedValue({\n      ok: true,\n      json: async () => []\n    });\n\n    const { rerender } = renderHook(\n      ({ ep }) => useWorkspace(ep),\n      { initialProps: { ep: '/api/a' } }\n    );\n\n    await waitFor(() => expect(mockFetch).toHaveBeenCalledWith('/api/a', expect.any(Object)));\n\n    rerender({ ep: '/api/b' });\n\n    await waitFor(() => expect(mockFetch).toHaveBeenCalledWith('/api/b', expect.any(Object)));\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "7. utils.ts",
        "content": "\n```typescript\n// __tests__/lib/utils.test.ts\n\nimport { cn } from '@/lib/utils';\n\ndescribe('utils', () => {\n  describe('cn', () => {\n    it('should merge class names', () => {\n      expect(cn('foo', 'bar')).toBe('foo bar');\n    });\n\n    it('should handle conditional classes', () => {\n      expect(cn('base', false && 'hidden', 'visible')).toBe('base visible');\n    });\n\n    it('should merge Tailwind classes correctly', () => {\n      // twMerge should dedupe conflicting utilities\n      expect(cn('px-2 py-1', 'px-4')).toBe('py-1 px-4');\n    });\n\n    it('should handle undefined and null', () => {\n      expect(cn('foo', undefined, null, 'bar')).toBe('foo bar');\n    });\n\n    it('should handle empty input', () => {\n      expect(cn()).toBe('');\n    });\n\n    it('should handle arrays', () => {\n      expect(cn(['foo', 'bar'], 'baz')).toBe('foo bar baz');\n    });\n  });\n});\n```\n\n---\n\n",
        "level": 2
      },
      {
        "title": "8. expo-messages.ts",
        "content": "\n```typescript\n// __tests__/lib/expo-messages.test.ts\n\nimport { getExpoMessage, getCompletionMessage } from '@/lib/expo-messages';\nimport type { A0LogEntry } from '@/lib/types';\n\ndescribe('expo-messages', () => {\n  describe('getExpoMessage', () => {\n    it('should return message for known tool', () => {\n      const log: A0LogEntry = {\n        id: '1',\n        no: 1,\n        type: 'tool',\n        heading: 'Using food_cost_tool...',\n        content: '',\n        kvps: {},\n        timestamp: 0,\n        agentno: 0\n      };\n\n      const msg = getExpoMessage(log);\n      expect(msg).toBeTruthy();\n      expect(typeof msg).toBe('string');\n    });\n\n    it('should return default message for unknown tool', () => {\n      const log: A0LogEntry = {\n        id: '1',\n        no: 1,\n        type: 'tool',\n        heading: 'Using unknown_tool...',\n        content: '',\n        kvps: {},\n        timestamp: 0,\n        agentno: 0\n      };\n\n      const msg = getExpoMessage(log);\n      expect(msg).toBeTruthy();\n    });\n\n    it('should handle agent/subagent logs', () => {\n      const log: A0LogEntry = {\n        id: '1',\n        no: 1,\n        type: 'agent',\n        heading: 'Sous Chef',\n        content: '',\n        kvps: {},\n        timestamp: 0,\n        agentno: 1\n      };\n\n      const msg = getExpoMessage(log);\n      expect(msg).toContain('Delegating to Sous Chef');\n    });\n\n    it('should return progress content when present', () => {\n      const log: A0LogEntry = {\n        id: '1',\n        no: 1,\n        type: 'progress',\n        heading: '',\n        content: 'Processing step 3/5',\n        kvps: {},\n        timestamp: 0,\n        agentno: 0\n      };\n\n      expect(getExpoMessage(log)).toBe('Processing step 3/5');\n    });\n\n    it('should return null for unsupported log types', () => {\n      const log: A0LogEntry = {\n        id: '1',\n        no: 1,\n        type: 'user',\n        heading: '',\n        content: 'Hello',\n        kvps: {},\n        timestamp: 0,\n        agentno: 0\n      };\n\n      expect(getExpoMessage(log)).toBeNull();\n    });\n\n    it('should handle missing heading', () => {\n      const log: A0LogEntry = {\n        id: '1',\n        no: 1,\n        type: 'tool',\n        heading: '',\n        content: '',\n        kvps: {},\n        timestamp: 0,\n        agentno: 0\n      };\n\n      const msg = getExpoMessage(log);\n      expect(msg).toBeTruthy(); // Should fall back to default\n    });\n  });\n\n  describe('getCompletionMessage', () => {\n    it('should return a completion message', () => {\n      const msg = getCompletionMessage();\n      expect(msg).toBeTruthy();\n      expect(typeof msg).toBe('string');\n    });\n\n    it('should return different messages on multiple calls', () => {\n      const messages = new Set();\n      for (let i = 0; i < 20; i++) {\n        messages.add(getCompletionMessage());\n      }\n      // Should have some variety (not all the same)\n      expect(messages.size).toBeGreaterThan(1);\n    });\n  });\n});\n```\n\n---\n\n",
        "level": 2
      },
      {
        "title": "9. socket-client.ts",
        "content": "\n```typescript\n// __tests__/lib/socket-client.test.ts\n\nimport { initStateSyncSocket, getStateSyncSocket, disconnectAll } from '@/lib/socket-client';\nimport { io } from 'socket.io-client';\nimport * as csrfModule from '@/lib/csrf';\n\njest.mock('socket.io-client');\n\ndescribe('socket-client', () => {\n  const mockSocket = {\n    on: jest.fn(),\n    disconnect: jest.fn(),\n    connect: jest.fn(),\n  };\n\n  beforeEach(() => {\n    jest.clearAllMocks();\n    (io as jest.Mock).mockReturnValue(mockSocket);\n    jest.spyOn(csrfModule, 'getCsrfToken').mockResolvedValue('test-token');\n    jest.spyOn(csrfModule, 'clearCsrfToken').mockImplementation();\n  });\n\n  it('should initialize socket with correct config', () => {\n    initStateSyncSocket();\n\n    expect(io).toHaveBeenCalledWith(\n      expect.stringContaining('/state_sync'),\n      expect.objectContaining({\n        autoConnect: false,\n        transports: ['polling', 'websocket'],\n        withCredentials: true\n      })\n    );\n  });\n\n  it('should use NEXT_PUBLIC_A0_URL when set', () => {\n    process.env.NEXT_PUBLIC_A0_URL = 'http://localhost:5000';\n\n    initStateSyncSocket();\n\n    expect(io).toHaveBeenCalledWith(\n      'http://localhost:5000/state_sync',\n      expect.any(Object)\n    );\n\n    delete process.env.NEXT_PUBLIC_A0_URL;\n  });\n\n  it('should return existing socket on subsequent calls', () => {\n    const socket1 = initStateSyncSocket();\n    const socket2 = initStateSyncSocket();\n\n    expect(socket1).toBe(socket2);\n    expect(io).toHaveBeenCalledTimes(1);\n  });\n\n  it('should fetch CSRF token in auth callback', async () => {\n    initStateSyncSocket();\n\n    const ioCall = (io as jest.Mock).mock.calls[0];\n    const config = ioCall[1];\n    const authCallback = config.auth;\n\n    const cb = jest.fn();\n    await authCallback(cb);\n\n    expect(csrfModule.getCsrfToken).toHaveBeenCalled();\n    expect(cb).toHaveBeenCalledWith({ csrf_token: 'test-token' });\n  });\n\n  it('should handle CSRF fetch failure gracefully', async () => {\n    jest.spyOn(csrfModule, 'getCsrfToken').mockRejectedValue(new Error('Fetch failed'));\n    const consoleErrorSpy = jest.spyOn(console, 'error').mockImplementation();\n\n    initStateSyncSocket();\n\n    const ioCall = (io as jest.Mock).mock.calls[0];\n    const authCallback = ioCall[1].auth;\n    const cb = jest.fn();\n\n    await authCallback(cb);\n\n    expect(consoleErrorSpy).toHaveBeenCalled();\n    expect(cb).toHaveBeenCalledWith({});\n\n    consoleErrorSpy.mockRestore();\n  });\n\n  it('should clear CSRF token on connect_error', () => {\n    initStateSyncSocket();\n\n    const onCall = mockSocket.on.mock.calls.find(call => call[0] === 'connect_error');\n    expect(onCall).toBeTruthy();\n\n    const errorHandler = onCall![1];\n    errorHandler();\n\n    expect(csrfModule.clearCsrfToken).toHaveBeenCalled();\n  });\n\n  it('should return socket from getStateSyncSocket', () => {\n    const socket = initStateSyncSocket();\n    expect(getStateSyncSocket()).toBe(socket);\n  });\n\n  it('should disconnect and clear on disconnectAll', () => {\n    initStateSyncSocket();\n    \n    disconnectAll();\n\n    expect(mockSocket.disconnect).toHaveBeenCalled();\n    expect(getStateSyncSocket()).toBeNull();\n  });\n});\n```\n\n---\n\n",
        "level": 2
      },
