import type { A0LogEntry } from "@/lib/types";

const QUIRKY_MESSAGES: Record<string, string[]> = {
  food_cost_tool: [
    "Crunching the numbers on that produce order...",
    "Checking if the avocado market crashed yet...",
  ],
  inventory_tool: [
