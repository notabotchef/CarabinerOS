        "content": "**File**: `src/hooks/use-expo-stream.ts:58-77`\n\n**Problem**: Searches backwards through ALL logs on every snapshot change\n\n```typescript\n// ❌ Current: O(n) search on every snapshot update\nfunction extractFromLogs(snapshot: A0Snapshot | null): {\n  thoughts: string[];\n  headline: string | null;\n  step: string | null;\n} {\n  if (!snapshot?.logs?.length) return { thoughts: [], headline: null, step: null };\n\n  for (let i = snapshot.logs.length - 1; i >= 0; i--) { // Inefficient\n    const log = snapshot.logs[i];\n    if (log.type !== \"agent\" || !log.kvps) continue;\n    // ...\n  }\n}\n```\n\n**Solution**: Cache last agent log and only update when new ones arrive\n```typescript\nexport function useExpoStream(\n  snapshot: A0Snapshot | null,\n  chefStatus: ChefStatus | null,\n): ExpoState {\n  const [expo, setExpo] = useState<ExpoState>({\n    text: null,\n    thoughts: [],\n    active: false,\n  });\n  const jokeRef = useRef(getRandomJoke());\n  const stickyTextRef = useRef<string | null>(null);\n  const lastAgentLogNo = useRef(-1);\n  \n  // Memoize extraction to avoid recalculating on every render\n  const { thoughts, headline, step } = useMemo(() => {\n    if (!snapshot?.logs?.length) {\n      return { thoughts: [], headline: null, step: null };\n    }\n    \n    // Only search if there are new logs\n    const hasNewLogs = snapshot.logs.some(log => log.no > lastAgentLogNo.current);\n    if (!hasNewLogs && lastAgentLogNo.current >= 0) {\n      return { thoughts: [], headline: null, step: null }; // Return cached\n    }\n    \n    // Find most recent agent log\n    for (let i = snapshot.logs.length - 1; i >= 0; i--) {\n      const log = snapshot.logs[i];\n      if (log.type !== \"agent\" || !log.kvps) continue;\n\n      const kvps = getAgentKvps(log.kvps);\n      if (kvps.thoughts?.length || kvps.headline || kvps.step) {\n        lastAgentLogNo.current = log.no;\n        return {\n          thoughts: kvps.thoughts ?? [],\n          headline: kvps.headline ?? null,\n          step: kvps.step ?? null,\n        };\n      }\n    }\n    \n    return { thoughts: [], headline: null, step: null };\n  }, [snapshot]);\n\n  useEffect(() => {\n    if (!snapshot) return;\n    const isActive = snapshot.log_progress_active;\n\n    if (isActive) {\n      const realText = headline ?? step ?? null;\n      if (realText) stickyTextRef.current = realText;\n\n      const displayText =\n        realText ??\n        chefStatus?.text ??\n        stickyTextRef.current ??\n        jokeRef.current;\n\n      setExpo({ text: displayText, thoughts, active: true });\n    }\n  }, [snapshot, chefStatus, thoughts, headline, step]);\n  \n  // ... rest remains same\n}\n```\n\n",
        "level": 3
      },
      {
        "title": "Issue C: Inline Function Creation Causing Re-renders",
        "content": "**File**: Multiple workspace pages (orders, invoices, etc.)\n\n**Problem**: Inline parsing functions recreated on every render\n\n```typescript\n// ❌ Current: Functions recreated every render\nfunction formatCurrency(v: unknown): string {\n  if (v == null || v === \"\") return \"\\u2014\";\n  const s = String(v).replace(/[$,]/g, \"\").trim();\n  const n = Number(s);\n  if (isNaN(n)) return String(v);\n  return `$${n.toLocaleString(\"en-US\", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;\n}\n\n// Inside component:\n<TableCell>{formatCurrency(order.total)}</TableCell>\n```\n\n**Solution**: Move formatters to shared utility file + add memoization\n```typescript\n// src/lib/formatters.ts\nconst currencyFormatter = new Intl.NumberFormat(\"en-US\", {\n  style: \"currency\",\n  currency: \"USD\",\n  minimumFractionDigits: 2,\n  maximumFractionDigits: 2,\n});\n\nconst dateFormatter = new Intl.DateTimeFormat(\"en-US\", {\n  month: \"short\",\n  day: \"numeric\",\n  year: \"numeric\",\n});\n\nexport function formatCurrency(v: unknown): string {\n  if (v == null || v === \"\") return \"—\";\n  const s = String(v).replace(/[$,]/g, \"\").trim();\n  const n = Number(s);\n  if (isNaN(n)) return String(v);\n  return currencyFormatter.format(n);\n}\n\nexport function formatDate(v: unknown): string {\n  if (!v || typeof v !== \"string\") return \"—\";\n  const d = new Date(v);\n  if (isNaN(d.getTime())) return \"—\";\n  return dateFormatter.format(d);\n}\n\n// Memoized parser for repeated parsing\nconst parseCache = new Map<string, number>();\nexport function parseNum(v: unknown): number {\n  if (v == null) return 0;\n  const s = String(v).trim();\n  \n  if (parseCache.has(s)) return parseCache.get(s)!;\n  \n  const match = s.match(/^[+-]?\\d+(\\.\\d+)?/);\n  const result = match ? Number(match[0]) : 0;\n  \n  parseCache.set(s, result);\n  if (parseCache.size > 1000) parseCache.clear(); // Prevent unbounded growth\n  \n  return result;\n}\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "3. Caching Opportunities",
        "content": "\n",
        "level": 2
      },
      {
        "title": "Issue: No Request Deduplication in useWorkspace",
        "content": "**File**: `src/hooks/use-workspace.ts`\n\n**Problem**: Same endpoint fetched multiple times if hook used in multiple components\n\n```typescript\n// ❌ Current: No caching, every component instance fetches\nexport function useWorkspace<T = Record<string, unknown>>(\n  endpoint: string,\n  locationId?: string,\n): UseWorkspaceReturn<T> {\n  const [data, setData] = useState<T[]>([]);\n  \n  useEffect(() => {\n    fetch(url, { credentials: \"include\" }) // Duplicate requests\n      .then(/* ... */)\n  }, [endpoint, locationId, refreshKey]);\n}\n```\n\n**Solution**: Add SWR-style caching layer\n```typescript\n// src/lib/workspace-cache.ts\ntype CacheEntry<T> = {\n  data: T[];\n  timestamp: number;\n  promise?: Promise<T[]>;\n};\n\nconst cache = new Map<string, CacheEntry<any>>();\nconst CACHE_TTL = 30000; // 30 seconds\n\nexport async function fetchWorkspaceData<T>(\n  endpoint: string,\n  locationId?: string,\n): Promise<T[]> {\n  const url = locationId ? `${endpoint}?location_id=${locationId}` : endpoint;\n  const now = Date.now();\n  const cached = cache.get(url);\n  \n  // Return cached data if fresh\n  if (cached && now - cached.timestamp < CACHE_TTL) {\n    return cached.data;\n  }\n  \n  // Return in-flight request if exists (deduplication)\n  if (cached?.promise) {\n    return cached.promise;\n  }\n  \n  // Fetch new data\n  const promise = fetch(url, { credentials: \"include\" })\n    .then(async (res) => {\n      if (!res.ok) throw new Error(`${res.status}`);\n      const json = await res.json();\n      const data = Array.isArray(json) ? json : json.items ?? json.data ?? [];\n      \n      cache.set(url, { data, timestamp: Date.now() });\n      return data;\n    })\n    .catch((err) => {\n      cache.delete(url); // Remove failed entry\n      throw err;\n    });\n  \n  cache.set(url, { data: [], timestamp: 0, promise });\n  return promise;\n}\n\nexport function invalidateCache(endpoint?: string) {\n  if (endpoint) {\n    // Remove specific endpoint\n    for (const key of cache.keys()) {\n      if (key.startsWith(endpoint)) cache.delete(key);\n    }\n  } else {\n    cache.clear(); // Clear all\n  }\n}\n\n// Updated hook\nexport function useWorkspace<T = Record<string, unknown>>(\n  endpoint: string,\n  locationId?: string,\n): UseWorkspaceReturn<T> {\n  const [data, setData] = useState<T[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n  const [refreshKey, setRefreshKey] = useState(0);\n\n  useEffect(() => {\n    setLoading(true);\n    \n    fetchWorkspaceData<T>(endpoint, locationId)\n      .then((data) => {\n        setData(data);\n        setError(null);\n      })\n      .catch((err) => {\n        setError(err.message);\n        setData([]);\n      })\n      .finally(() => setLoading(false));\n  }, [endpoint, locationId, refreshKey]);\n\n  const refresh = useCallback(() => {\n    invalidateCache(endpoint);\n    setRefreshKey(k => k + 1);\n  }, [endpoint]);\n\n  return { data, loading, error, refresh };\n}\n```\n\n---\n\n",
        "level": 3
      },
