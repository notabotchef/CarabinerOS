        "code": "export function useActionCards(snapshot: A0Snapshot | null): UseActionCardsReturn {\n  const [cards, setCards] = useState<ActionCard[]>([]);\n  const lastProcessedIndex = useRef(0);\n\n  useEffect(() => {\n    if (!snapshot?.logs) return;\n    \n    // Only process new logs since last index\n    const newLogs = snapshot.logs.slice(lastProcessedIndex.current);\n    const newCards: ActionCard[] = [];\n    \n    for (const log of newLogs) {\n      if (log.type !== \"tool\") continue;\n      const kvps = log.kvps || {};\n      if (kvps.module && kvps.action) {\n        newCards.push({\n          id: log.id,\n          type: String(kvps.action),\n          module: String(kvps.module),\n          action: String(kvps.action),\n          itemId: kvps.item_id ? String(kvps.item_id) : undefined,\n          item: kvps.item as Record<string, unknown> | undefined,\n          summary: log.content.slice(0, 120),\n          timestamp: log.timestamp,\n          read: false,\n        });\n      }\n    }\n    \n    if (newCards.length > 0) {\n      setCards(prev => [...prev, ...newCards]);\n    }\n    lastProcessedIndex.current = snapshot.logs.length;\n  }, [snapshot]);\n\n  // ... rest remains same\n}"
