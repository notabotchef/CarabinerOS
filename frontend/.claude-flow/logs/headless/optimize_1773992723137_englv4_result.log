        "language": "typescript",
        "code": "export function useChat(snapshot: A0Snapshot | null): UseChatReturn {\n  const [messages, setMessages] = useState<ChatMessage[]>([]);\n  const lastProcessedLogNo = useRef(-1);\n  const contextIdRef = useRef<string | null>(null);\n  const isProcessingRef = useRef(false);\n  const freshChatRef = useRef(false);\n\n  useEffect(() => {\n    if (!snapshot?.logs?.length) return;\n    if (freshChatRef.current) {\n      setLoading(false);\n      return;\n    }\n\n    // Only process logs newer than last processed\n    const newLogs = snapshot.logs.filter(log => log.no > lastProcessedLogNo.current);\n    if (newLogs.length === 0) return;\n\n    const newMessages: ChatMessage[] = [];\n    \n    for (const log of newLogs) {\n      const logKey = log.id ?? `no-${log.no}`;\n      \n      if (log.type === \"user\") {\n        newMessages.push({\n          id: logKey,\n          role: \"user\",\n          content: log.content,\n          timestamp: log.timestamp,\n        });\n      }\n      \n      if (log.type === \"response\" && log.content.trim()) {\n        newMessages.push({\n          id: logKey,\n          role: \"assistant\",\n          content: log.content,\n          timestamp: log.timestamp,\n        });\n      }\n      \n      lastProcessedLogNo.current = Math.max(lastProcessedLogNo.current, log.no);\n    }\n\n    if (newMessages.length > 0) {\n      setMessages(prev => [...prev, ...newMessages]);\n    }\n\n    if (snapshot.context) setContextId(snapshot.context);\n    setLoading(snapshot.log_progress_active);\n  }, [snapshot]);\n  \n  // Reset tracking on chat reset\n  const resetChat = useCallback(() => {\n    setMessages([]);\n    setContextId(null);\n    contextIdRef.current = null;\n    lastProcessedLogNo.current = -1; // Reset index\n    setLoading(false);\n    setQueuedMessages([]);\n    isProcessingRef.current = false;\n    freshChatRef.current = true;\n  }, []);\n  \n  // ... rest of implementation\n}"
