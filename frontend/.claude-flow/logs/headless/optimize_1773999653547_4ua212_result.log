        "code": "// ✅ Add cache layer\nconst cache = new Map<string, { data: unknown; timestamp: number }>();\nconst CACHE_TTL = 30000; // 30 seconds\n\nexport function useWorkspace<T = Record<string, unknown>>(\n  endpoint: string,\n  locationId?: string,\n): UseWorkspaceReturn<T> {\n  const [data, setData] = useState<T[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n  const [refreshKey, setRefreshKey] = useState(0);\n\n  useEffect(() => {\n    const url = locationId\n      ? `${endpoint}?location_id=${locationId}`\n      : endpoint;\n\n    const cached = cache.get(url);\n    if (cached && Date.now() - cached.timestamp < CACHE_TTL) {\n      setData(cached.data as T[]);\n      setLoading(false);\n      return;\n    }\n\n    setLoading(true);\n    fetch(url, { credentials: \"include\" })\n      .then(async (res) => {\n        if (!res.ok) throw new Error(`${res.status}`);\n        const json = await res.json();\n        const result = Array.isArray(json) ? json : json.items ?? json.data ?? [];\n        \n        cache.set(url, { data: result, timestamp: Date.now() });\n        setData(result);\n        setError(null);\n      })\n      .catch((err) => {\n        setError(err.message);\n        setData([]);\n      })\n      .finally(() => setLoading(false));\n  }, [endpoint, locationId, refreshKey]);\n\n  return { \n    data, \n    loading, \n    error, \n    refresh: () => {\n      cache.delete(endpoint);\n      setRefreshKey((k) => k + 1);\n    } \n  };\n}"
