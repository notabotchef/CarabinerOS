        "language": "typescript",
        "code": "// __tests__/lib/expo-messages.test.ts\nimport { getExpoMessage, getCompletionMessage } from \"@/lib/expo-messages\";\nimport type { A0LogEntry } from \"@/lib/types\";\n\ndescribe(\"expo-messages\", () => {\n  describe(\"getExpoMessage\", () => {\n    it(\"should return quirky message for known tool\", () => {\n      const log: A0LogEntry = {\n        type: \"tool\",\n        heading: \"Using food_cost_tool...\",\n        content: \"Calculating food cost\",\n        no: 1,\n        id: \"log-1\",\n        kvps: {},\n        timestamp: 123,\n        agentno: 0,\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBeTruthy();\n      expect(typeof message).toBe(\"string\");\n    });\n\n    it(\"should return default message for unknown tool\", () => {\n      const log: A0LogEntry = {\n        type: \"tool\",\n        heading: \"Using unknown_tool_xyz...\",\n        content: \"\",\n        // ...\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBeTruthy();\n      expect([\"Working on it...\", \"One moment...\", \"On it, Chef...\"]).toContain(message);\n    });\n\n    it(\"should extract tool name from heading\", () => {\n      const log: A0LogEntry = {\n        type: \"tool\",\n        heading: \"Using inventory_tool...\",\n        content: \"\",\n        // ...\n      };\n\n      const message = getExpoMessage(log);\n\n      // Should match inventory_tool messages, not default\n      expect([\n        \"Checking the walk-in...\",\n        \"Counting what's left after brunch service...\",\n      ]).toContain(message);\n    });\n\n    it(\"should handle agent delegation\", () => {\n      const log: A0LogEntry = {\n        type: \"agent\",\n        heading: \"Sous Chef\",\n        content: \"\",\n        // ...\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBe(\"Delegating to Sous Chef...\");\n    });\n\n    it(\"should handle subagent delegation\", () => {\n      const log: A0LogEntry = {\n        type: \"subagent\",\n        heading: \"Prep Cook\",\n        content: \"\",\n        // ...\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBe(\"Delegating to Prep Cook...\");\n    });\n\n    it(\"should use default heading when missing\", () => {\n      const log: A0LogEntry = {\n        type: \"agent\",\n        heading: \"\",\n        content: \"\",\n        // ...\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBe(\"Delegating to a specialist...\");\n    });\n\n    it(\"should return progress content for progress logs\", () => {\n      const log: A0LogEntry = {\n        type: \"progress\",\n        heading: \"\",\n        content: \"Processing step 3 of 10...\",\n        // ...\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBe(\"Processing step 3 of 10...\");\n    });\n\n    it(\"should return null for non-matching log types\", () => {\n      const log: A0LogEntry = {\n        type: \"user\",\n        heading: \"\",\n        content: \"Hello\",\n        // ...\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBeNull();\n    });\n\n    it(\"should randomly select from available messages\", () => {\n      const log: A0LogEntry = {\n        type: \"tool\",\n        heading: \"Using food_cost_tool...\",\n        content: \"\",\n        // ...\n      };\n\n      const messages = new Set<string>();\n      \n      // Run 100 times to get both possible messages\n      for (let i = 0; i < 100; i++) {\n        const msg = getExpoMessage(log);\n        if (msg) messages.add(msg);\n      }\n\n      // Should have gotten at least 2 different messages (probabilistically)\n      expect(messages.size).toBeGreaterThanOrEqual(1);\n    });\n  });\n\n  describe(\"getCompletionMessage\", () => {\n    it(\"should return one of the completion messages\", () => {\n      const message = getCompletionMessage();\n\n      expect([\"Heard.\", \"Service.\", \"All set.\", \"Done, Chef.\"]).toContain(message);\n    });\n\n    it(\"should randomly select completion messages\", () => {\n      const messages = new Set<string>();\n      \n      for (let i = 0; i < 100; i++) {\n        messages.add(getCompletionMessage());\n      }\n\n      // Should have gotten multiple different messages\n      expect(messages.size).toBeGreaterThanOrEqual(2);\n    });\n  });\n});"
