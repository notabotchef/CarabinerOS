ate_request\", expect.objectContaining({\n        log_from: 0, // Reset on subscribe\n      }));\n    });\n\n    it(\"should filter and log response logs\", () => {\n      const consoleSpy = jest.spyOn(console, \"log\").mockImplementation();\n      \n      renderHook(() => useSocket());\n      \n      eventHandlers.state_push({\n        data: {\n          snapshot: {\n            logs: [\n              { no: 1, type: \"response\", content: \"Hello\" },\n              { no: 2, type: \"user\", content: \"Hi\" },\n            ],\n            log_progress_active: true,\n            // ...\n          },\n        },\n      });\n      \n      expect(consoleSpy).toHaveBeenCalledWith(\n        expect.stringContaining(\"1 responses\")\n      );\n    });\n  });\n\n  describe(\"chef_status handling\", () => {\n    it(\"should update chef status from event\", () => {\n      const { result } = renderHook(() => useSocket());\n      \n      const status = {\n        status: \"working\",\n        text: \"Processing\",\n        active: true,\n      };\n      \n      eventHandlers.chef_status(status);\n      \n      expect(result.current.chefStatus).toEqual(status);\n    });\n  });\n\n  describe(\"cleanup\", () => {\n    it(\"should remove all event listeners on unmount\", () => {\n      const { unmount } = renderHook(() => useSocket());\n      \n      unmount();\n      \n      expect(mockSocket.off).toHaveBeenCalledWith(\"connect\");\n      expect(mockSocket.off).toHaveBeenCalledWith(\"disconnect\");\n      expect(mockSocket.off).toHaveBeenCalledWith(\"state_push\");\n      expect(mockSocket.off).toHaveBeenCalledWith(\"chef_status\");\n    });\n\n    it(\"should disconnect socket on unmount\", () => {\n      const { unmount } = renderHook(() => useSocket());\n      \n      unmount();\n      \n      expect(mockSocket.disconnect).toHaveBeenCalled();\n    });\n  });\n});\n```\n\n---\n\n## 6. `src/hooks/use-workspace.ts`\n\n### Identified Gaps\n\n**Untested Functions:**\n- Generic data fetching\n- Response format normalization\n- Refresh mechanism\n- Error state management\n\n**Missing Edge Cases:**\n- Different response structures (array, {items}, {data})\n- Location ID query parameter\n- Network timeouts\n- Empty responses\n\n**Error Handling:**\n- 404/500 status codes\n- Malformed JSON\n- Missing credentials\n\n### Test Skeletons\n\n```typescript\n// __tests__/hooks/use-workspace.test.ts\nimport { renderHook, waitFor } from \"@testing-library/react\";\nimport { useWorkspace } from \"@/hooks/use-workspace\";\n\ndescribe(\"useWorkspace\", () => {\n  beforeEach(() => {\n    global.fetch = jest.fn();\n  });\n\n  describe(\"data fetching\", () => {\n    it(\"should fetch and normalize array response\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => [{ id: 1 }, { id: 2 }],\n      });\n\n      const { result } = renderHook(() => useWorkspace(\"/api/items\"));\n\n      await waitFor(() => {\n        expect(result.current.loading).toBe(false);\n      });\n\n      expect(result.current.data).toEqual([{ id: 1 }, { id: 2 }]);\n      expect(result.current.error).toBeNull();\n    });\n\n    it(\"should normalize object response with items field\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => ({ items: [{ id: 1 }] }),\n      });\n\n      const { result } = renderHook(() => useWorkspace(\"/api/items\"));\n\n      await waitFor(() => {\n        expect(result.current.data).toEqual([{ id: 1 }]);\n      });\n    });\n\n    it(\"should normalize object response with data field\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => ({ data: [{ id: 1 }] }),\n      });\n\n      const { result } = renderHook(() => useWorkspace(\"/api/items\"));\n\n      await waitFor(() => {\n        expect(result.current.data).toEqual([{ id: 1 }]);\n      });\n    });\n\n    it(\"should default to empty array for unrecognized format\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => ({ something: \"else\" }),\n      });\n\n      const { result } = renderHook(() => useWorkspace(\"/api/items\"));\n\n      await waitFor(() => {\n        expect(result.current.data).toEqual([]);\n      });\n    });\n  });\n\n  describe(\"location filtering\", () => {\n    it(\"should append location_id query parameter\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => [],\n      });\n\n      renderHook(() => useWorkspace(\"/api/items\", \"loc-123\"));\n\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledWith(\n          \"/api/items?location_id=loc-123\",\n          expect.any(Object)\n        );\n      });\n    });\n\n    it(\"should not append query parameter when locationId is undefined\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => [],\n      });\n\n      renderHook(() => useWorkspace(\"/api/items\"));\n\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledWith(\n          \"/api/items\",\n          expect.any(Object)\n        );\n      });\n    });\n  });\n\n  describe(\"refresh mechanism\", () => {\n    it(\"should re-fetch data when refresh is called\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValue({\n        ok: true,\n        json: async () => [],\n      });\n\n      const { result } = renderHook(() => useWorkspace(\"/api/items\"));\n\n      await waitFor(() => expect(result.current.loading).toBe(false));\n      \n      const firstCallCount = (global.fetch as jest.Mock).mock.calls.length;\n      \n      result.current.refresh();\n\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledTimes(firstCallCount + 1);\n      });\n    });\n  });\n\n  describe(\"error handling\", () => {\n    it(\"should set error state on network failure\", async () => {\n      (global.fetch as jest.Mock).mockRejectedValueOnce(new Error(\"Network error\"));\n\n      const { result } = renderHook(() => useWorkspace(\"/api/items\"));\n\n      await waitFor(() => {\n        expect(result.current.error).toBe(\"Network error\");\n        expect(result.current.data).toEqual([]);\n        expect(result.current.loading).toBe(false);\n      });\n    });\n\n    it(\"should set error state on non-OK response\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: false,\n        status: 500,\n      });\n\n      const { result } = renderHook(() => useWorkspace(\"/api/items\"));\n\n      await waitFor(() => {\n        expect(result.current.error).toBe(\"500\");\n      });\n    });\n\n    it(\"should clear error on successful retry\", async () => {\n      (global.fetch as jest.Mock)\n        .mockRejectedValueOnce(new Error(\"Fail\"))\n        .mockResolvedValueOnce({ ok: true, json: async () => [] });\n\n      const { result } = renderHook(() => useWorkspace(\"/api/items\"));\n\n      await waitFor(() => expect(result.current.error).toBeTruthy());\n\n      result.current.refresh();\n\n      await waitFor(() => {\n        expect(result.current.error).toBeNull();\n      });\n    });\n  });\n\n  describe(\"loading state\", () => {\n    it(\"should set loading true during fetch\", () => {\n      (global.fetch as jest.Mock).mockImplementation(\n        () => new Promise(() => {}) // Never resolves\n      );\n\n      const { result } = renderHook(() => useWorkspace(\"/api/items\"));\n\n      expect(result.current.loading).toBe(true);\n    });\n\n    it(\"should set loading false after completion\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => [],\n      });\n\n      const { result } = renderHook(() => useWorkspace(\"/api/items\"));\n\n      await waitFor(() => {\n        expect(result.current.loading).toBe(false);\n      });\n    });\n  });\n\n  describe(\"credentials\", () => {\n    it(\"should include credentials in fetch\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => [],\n      });\n\n      renderHook(() => useWorkspace(\"/api/items\"));\n\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledWith(\n          expect.any(String),\n          expect.objectContaining({ credentials: \"include\" })\n        );\n      });\n    });\n  });\n});\n```\n\n---\n\n## 7. `src/lib/csrf.ts`\n\n### Identified Gaps\n\n**Untested Functions:**\n- Promise caching for concurrent calls\n- Cookie setting with runtime_id\n- Token clearing\n\n**Missing Edge Cases:**\n- Concurrent getCsrfToken calls\n- Invalid response format\n- Cookie domain/path/SameSite\n\n**Error Handling:**\n- Fetch failures\n- Missing token in response\n- JSON parse errors\n\n### Test Skeletons\n\n```typescript\n// __tests__/lib/csrf.test.ts\nimport { getCsrfToken, getRuntimeId, clearCsrfToken } from \"@/lib/csrf\";\n\ndescribe(\"csrf\", () => {\n  let cookieSetter: jest.SpyInstance;\n\n  beforeEach(() => {\n    global.fetch = jest.fn();\n    cookieSetter = jest.spyOn(document, \"cookie\", \"set\");\n    clearCsrfToken(); // Reset module state\n  });\n\n  describe(\"getCsrfToken\", () => {\n    it(\"should fetch and cache CSRF token\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({ ok: true, token: \"csrf-123\", runtime_id: \"run-456\" }),\n      });\n\n      const token = await getCsrfToken();\n\n      expect(token).toBe(\"csrf-123\");\n      expect(global.fetch).toHaveBeenCalledWith(\"/csrf_token\", {\n        credentials: \"include\",\n      });\n    });\n\n    it(\"should return cached token on subsequent calls\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({ ok: true, token: \"csrf-123\", runtime_id: \"run-456\" }),\n      });\n\n      await getCsrfToken();\n      await getCsrfToken();\n      await getCsrfToken();\n\n      expect(global.fetch).toHaveBeenCalledTimes(1);\n    });\n\n    it(\"should handle concurrent calls with single fetch\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({ ok: true, token: \"csrf-123\", runtime_id: \"run-456\" }),\n      });\n\n      const [t1, t2, t3] = await Promise.all([\n        getCsrfToken(),\n        getCsrfToken(),\n        getCsrfToken(),\n      ]);\n\n      expect(t1).toBe(\"csrf-123\");\n      expect(t2).toBe(\"csrf-123\");\n      expect(t3).toBe(\"csrf-123\");\n      expect(global.fetch).toHaveBeenCalledTimes(1);\n    });\n\n    it(\"should set cookie with runtime_id in name\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({ ok: true, token: \"csrf-123\", runtime_id: \"run-456\" }),\n      });\n\n      await getCsrfToken();\n\n      expect(cookieSetter).toHaveBeenCalledWith(\n        expect.stringContaining(\"csrf_token_run-456=csrf-123\")\n      );\n    });\n\n    it(\"should set cookie with SameSite=Strict and Path=/\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({ ok: true, token: \"csrf-123\", runtime_id: \"run-456\" }),\n      });\n\n      await getCsrfToken();\n\n      expect(cookieSetter).toHaveBeenCalledWith(\n        expect.stringMatching(/SameSite=Strict.*Path=\\//)\n      );\n    });\n\n    it(\"should throw on error response\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({ ok: false, error: \"Token generation failed\" }),\n      });\n\n      await expect(getCsrfToken()).rejects.toThrow(\"Token generation failed\");\n    });\n\n    it(\"should throw default error when no error message provided\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({ ok: false }),\n      });\n\n      await expect(getCsrfToken()).rejects.toThrow(\"Failed to get CSRF token\");\n    });\n\n    it(\"should clear promise cache after fetch completes\", async () => {\n      (global.fetch as jest.Mock)\n        .mockResolvedValueOnce({\n          json: async () => ({ ok: true, token: \"csrf-1\", runtime_id: \"run-1\" }),\n        })\n        .mockResolvedValueOnce({\n          json: async () => ({ ok: true, token: \"csrf-2\", runtime_id: \"run-2\" }),\n        });\n\n      await getCsrfToken();\n      clearCsrfToken();\n      await getCsrfToken();\n\n      expect(global.fetch).toHaveBeenCalledTimes(2);\n    });\n  });\n\n  describe(\"getRuntimeId\", () => {\n    it(\"should return null initially\", () => {\n      expect(getRuntimeId()).toBeNull();\n    });\n\n    it(\"should return runtime_id after getCsrfToken\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({ ok: true, token: \"csrf-123\", runtime_id: \"run-456\" }),\n      });\n\n      await getCsrfToken();\n\n      expect(getRuntimeId()).toBe(\"run-456\");\n    });\n  });\n\n  describe(\"clearCsrfToken\", () => {\n    it(\"should reset token and runtime_id\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({ ok: true, token: \"csrf-123\", runtime_id: \"run-456\" }),\n      });\n\n      await getCsrfToken();\n      expect(getRuntimeId()).toBe(\"run-456\");\n\n      clearCsrfToken();\n      expect(getRuntimeId()).toBeNull();\n    });\n\n    it(\"should force new fetch after clear\", async () => {\n      (global.fetch as jest.Mock)\n        .mockResolvedValueOnce({\n          json: async () => ({ ok: true, token: \"csrf-1\", runtime_id: \"run-1\" }),\n        })\n        .mockResolvedValueOnce({\n          json: async () => ({ ok: true, token: \"csrf-2\", runtime_id: \"run-2\" }),\n        });\n\n      const token1 = await getCsrfToken();\n      clearCsrfToken();\n      const token2 = await getCsrfToken();\n\n      expect(token1).toBe(\"csrf-1\");\n      expect(token2).toBe(\"csrf-2\");\n    });\n  });\n});\n```\n\n---\n\n## 8. `src/lib/expo-messages.ts`\n\n### Identified Gaps\n\n**Untested Functions:**\n- Tool name extraction from heading\n- Random message selection\n- Message category matching\n\n**Missing Edge Cases:**\n- Missing or empty heading\n- Unknown tool names\n- All message categories\n- Random selection distribution\n\n### Test Skeletons\n\n```typescript\n// __tests__/lib/expo-messages.test.ts\nimport { getExpoMessage, getCompletionMessage } from \"@/lib/expo-messages\";\nimport type { A0LogEntry } from \"@/lib/types\";\n\ndescribe(\"expo-messages\", () => {\n  describe(\"getExpoMessage\", () => {\n    it(\"should return quirky message for known tool\", () => {\n      const log: A0LogEntry = {\n        type: \"tool\",\n        heading: \"Using food_cost_tool...\",\n        content: \"Calculating food cost\",\n        no: 1,\n        id: \"log-1\",\n        kvps: {},\n        timestamp: 123,\n        agentno: 0,\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBeTruthy();\n      expect(typeof message).toBe(\"string\");\n    });\n\n    it(\"should return default message for unknown tool\", () => {\n      const log: A0LogEntry = {\n        type: \"tool\",\n        heading: \"Using unknown_tool_xyz...\",\n        content: \"\",\n        // ...\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBeTruthy();\n      expect([\"Working on it...\", \"One moment...\", \"On it, Chef...\"]).toContain(message);\n    });\n\n    it(\"should extract tool name from heading\", () => {\n      const log: A0LogEntry = {\n        type: \"tool\",\n        heading: \"Using inventory_tool...\",\n        content: \"\",\n        // ...\n      };\n\n      const message = getExpoMessage(log);\n\n      // Should match inventory_tool messages, not default\n      expect([\n        \"Checking the walk-in...\",\n        \"Counting what's left after brunch service...\",\n      ]).toContain(message);\n    });\n\n    it(\"should handle agent delegation\", () => {\n      const log: A0LogEntry = {\n        type: \"agent\",\n        heading: \"Sous Chef\",\n        content: \"\",\n        // ...\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBe(\"Delegating to Sous Chef...\");\n    });\n\n    it(\"should handle subagent delegation\", () => {\n      const log: A0LogEntry = {\n        type: \"subagent\",\n        heading: \"Prep Cook\",\n        content: \"\",\n        // ...\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBe(\"Delegating to Prep Cook...\");\n    });\n\n    it(\"should use default heading when missing\", () => {\n      const log: A0LogEntry = {\n        type: \"agent\",\n        heading: \"\",\n        content: \"\",\n        // ...\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBe(\"Delegating to a specialist...\");\n    });\n\n    it(\"should return progress content for progress logs\", () => {\n      const log: A0LogEntry = {\n        type: \"progress\",\n        heading: \"\",\n        content: \"Processing step 3 of 10...\",\n        // ...\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBe(\"Processing step 3 of 10...\");\n    });\n\n    it(\"should return null for non-matching log types\", () => {\n      const log: A0LogEntry = {\n        type: \"user\",\n        heading: \"\",\n        content: \"Hello\",\n        // ...\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBeNull();\n    });\n\n    it(\"should randomly select from available messages\", () => {\n      const log: A0LogEntry = {\n        type: \"tool\",\n        heading: \"Using food_cost_tool...\",\n        content: \"\",\n        // ...\n      };\n\n      const messages = new Set<string>();\n      \n      // Run 100 times to get both possible messages\n      for (let i = 0; i < 100; i++) {\n        const msg = getExpoMessage(log);\n        if (msg) messages.add(msg);\n      }\n\n      // Should have gotten at least 2 different messages (probabilistically)\n      expect(messages.size).toBeGreaterThanOrEqual(1);\n    });\n  });\n\n  describe(\"getCompletionMessage\", () => {\n    it(\"should return one of the completion messages\", () => {\n      const message = getCompletionMessage();\n\n      expect([\"Heard.\", \"Service.\", \"All set.\", \"Done, Chef.\"]).toContain(message);\n    });\n\n    it(\"should randomly select completion messages\", () => {\n      const messages = new Set<string>();\n      \n      for (let i = 0; i < 100; i++) {\n        messages.add(getCompletionMessage());\n      }\n\n      // Should have gotten multiple different messages\n      expect(messages.size).toBeGreaterThanOrEqual(2);\n    });\n  });\n});\n```\n\n---\n\n## 9. `src/lib/socket-client.ts`\n\n### Identified Gaps\n\n**Untested Functions:**\n- Singleton socket management\n- Auth callback flow\n- CSRF integration\n- Transport configuration\n\n**Missing Edge Cases:**\n- Multiple initialization calls\n- Auth callback errors\n- connect_error handling\n- Environment variable configuration\n\n### Test Skeletons\n\n```typescript\n// __tests__/lib/socket-client.test.ts\nimport { io } from \"socket.io-client\";\nimport { initStateSyncSocket, getStateSyncSocket, disconnectAll } from \"@/lib/socket-client\";\nimport * as csrfModule from \"@/lib/csrf\";\n\njest.mock(\"socket.io-client\");\njest.mock(\"@/lib/csrf\");\n\ndescribe(\"socket-client\", () => {\n  let mockSocket: any;\n  let authCallback: (cb: (data: Record<string, string>) => void) => void;\n  let connectErrorHandler: () => void;\n\n  beforeEach(() => {\n    mockSocket = {\n      on: jest.fn((event: string, handler: () => void) => {\n        if (event === \"connect_error\") {\n          connectErrorHandler = handler;\n        }\n      }),\n      disconnect: jest.fn(),\n    };\n\n    (io as jest.Mock).mockImplementation((url: string, options: any) => {\n      authCallback = options.auth;\n      return mockSocket;\n    });\n\n    jest.spyOn(csrfModule, \"getCsrfToken\").mockResolvedValue(\"csrf-token-123\");\n    jest.spyOn(csrfModule, \"clearCsrfToken\").mockImplementation();\n  });\n\n  afterEach(() => {\n    disconnectAll();\n    jest.clearAllMocks();\n  });\n\n  describe(\"initStateSyncSocket\", () => {\n    it(\"should create socket with correct URL\", () => {\n      initStateSyncSocket();\n\n      expect(io).toHaveBeenCalledWith(\n        expect.stringContaining(\"/state_sync\"),\n        expect.any(Object)\n      );\n    });\n\n    it(\"should configure socket with polling first, then websocket\", () => {\n      initStateSyncSocket();\n\n      expect(io).toHaveBeenCalledWith(\n        expect.any(String),\n        expect.objectContaining({\n          transports: [\"polling\", \"websocket\"],\n        })\n      );\n    });\n\n    it(\"should set autoConnect to false\", () => {\n      initStateSyncSocket();\n\n      expect(io).toHaveBeenCalledWith(\n        expect.any(String),\n        expect.objectContaining({\n          autoConnect: false,\n        })\n      );\n    });\n\n    it(\"should enable withCredentials\", () => {\n      initStateSyncSocket();\n\n      expect(io).toHaveBeenCalledWith(\n        expect.any(String),\n        expect.objectContaining({\n          withCredentials: true,\n        })\n      );\n    });\n\n    it(\"should return same instance on multiple calls (singleton)\", () => {\n      const socket1 = initStateSyncSocket();\n      const socket2 = initStateSyncSocket();\n\n      expect(socket1).toBe(socket2);\n      expect(io).toHaveBeenCalledTimes(1);\n    });\n\n    it(\"should use NEXT_PUBLIC_A0_URL when set\", () => {\n      process.env.NEXT_PUBLIC_A0_URL = \"http://localhost:5000\";\n      \n      initStateSyncSocket();\n\n      expect(io).toHaveBeenCalledWith(\n        \"http://localhost:5000/state_sync\",\n        expect.any(Object)\n      );\n    });\n\n    it(\"should use empty string URL when env var not set\", () => {\n      delete process.env.NEXT_PUBLIC_A0_URL;\n      \n      initStateSyncSocket();\n\n      expect(io).toHaveBeenCalledWith(\n        \"/state_sync\",\n        expect.any(Object)\n      );\n    });\n  });\n\n  describe(\"auth callback\", () => {\n    it(\"should fetch CSRF token and pass to callback\", async () => {\n      initStateSyncSocket();\n\n      const mockCb = jest.fn();\n      await authCallback(mockCb);\n\n      expect(csrfModule.getCsrfToken).toHaveBeenCalled();\n      expect(mockCb).toHaveBeenCalledWith({ csrf_token: \"csrf-token-123\" });\n    });\n\n    it(\"should pass empty object when CSRF fetch fails\", async () => {\n      jest.spyOn(csrfModule, \"getCsrfToken\").mockRejectedValueOnce(new Error(\"Failed\"));\n      \n      initStateSyncSocket();\n\n      const mockCb = jest.fn();\n      await authCallback(mockCb);\n\n      expect(mockCb).toHaveBeenCalledWith({});\n    });\n\n    it(\"should log error when CSRF fetch fails\", async () => {\n      const consoleSpy = jest.spyOn(console, \"error\").mockImplementation();\n      jest.spyOn(csrfModule, \"getCsrfToken\").mockRejectedValueOnce(new Error(\"Network\"));\n      \n      initStateSyncSocket();\n\n      const mockCb = jest.fn();\n      await authCallback(mockCb);\n\n      expect(consoleSpy).toHaveBeenCalledWith(\n        expect.stringContaining(\"CSRF token fetch failed\"),\n        expect.any(Error)\n      );\n    });\n  });\n\n  describe(\"connect_error handling\", () => {\n    it(\"should clear CSRF token on connect_error\", () => {\n      initStateSyncSocket();\n\n      connectErrorHandler();\n\n      expect(csrfModule.clearCsrfToken).toHaveBeenCalled();\n    });\n\n    it(\"should register connect_error handler\", () => {\n      initStateSyncSocket();\n\n      expect(mockSocket