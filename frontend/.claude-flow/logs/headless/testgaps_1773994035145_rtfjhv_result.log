        "language": "typescript",
        "code": "// __tests__/hooks/use-socket.test.ts\nimport { renderHook, waitFor } from \"@testing-library/react\";\nimport { useSocket } from \"@/hooks/use-socket\";\nimport * as socketClient from \"@/lib/socket-client\";\nimport * as csrfModule from \"@/lib/csrf\";\nimport type { Socket } from \"socket.io-client\";\n\njest.mock(\"@/lib/socket-client\");\njest.mock(\"@/lib/csrf\");\n\ndescribe(\"useSocket\", () => {\n  let mockSocket: Partial<Socket>;\n  let eventHandlers: Record<string, (...args: unknown[]) => void>;\n\n  beforeEach(() => {\n    eventHandlers = {};\n    mockSocket = {\n      on: jest.fn((event: string, handler: (...args: unknown[]) => void) => {\n        eventHandlers[event] = handler;\n      }),\n      off: jest.fn(),\n      emit: jest.fn(),\n      connect: jest.fn(),\n      disconnect: jest.fn(),\n      connected: false,\n    };\n\n    jest.spyOn(socketClient, \"initStateSyncSocket\").mockReturnValue(mockSocket as Socket);\n    jest.spyOn(socketClient, \"getStateSyncSocket\").mockReturnValue(mockSocket as Socket);\n    jest.spyOn(csrfModule, \"getCsrfToken\").mockResolvedValue(\"mock-token\");\n  });\n\n  describe(\"initialization\", () => {\n    it(\"should initialize socket on mount\", () => {\n      renderHook(() => useSocket());\n      expect(socketClient.initStateSyncSocket).toHaveBeenCalled();\n    });\n\n    it(\"should fetch CSRF token before connecting\", async () => {\n      renderHook(() => useSocket());\n      \n      await waitFor(() => {\n        expect(csrfModule.getCsrfToken).toHaveBeenCalled();\n        expect(mockSocket.connect).toHaveBeenCalled();\n      });\n    });\n\n    it(\"should connect even if CSRF fetch fails\", async () => {\n      jest.spyOn(csrfModule, \"getCsrfToken\").mockRejectedValueOnce(new Error());\n      \n      renderHook(() => useSocket());\n      \n      await waitFor(() => {\n        expect(mockSocket.connect).toHaveBeenCalled();\n      });\n    });\n\n    it(\"should register all event handlers\", () => {\n      renderHook(() => useSocket());\n      \n      expect(mockSocket.on).toHaveBeenCalledWith(\"connect\", expect.any(Function));\n      expect(mockSocket.on).toHaveBeenCalledWith(\"disconnect\", expect.any(Function));\n      expect(mockSocket.on).toHaveBeenCalledWith(\"state_push\", expect.any(Function));\n      expect(mockSocket.on).toHaveBeenCalledWith(\"chef_status\", expect.any(Function));\n    });\n  });\n\n  describe(\"connection state\", () => {\n    it(\"should set connected true on connect event\", () => {\n      const { result } = renderHook(() => useSocket());\n      \n      eventHandlers.connect();\n      \n      expect(result.current.connected).toBe(true);\n    });\n\n    it(\"should set connected false on disconnect event\", () => {\n      const { result } = renderHook(() => useSocket());\n      \n      eventHandlers.disconnect();\n      \n      expect(result.current.connected).toBe(false);\n    });\n\n    it(\"should emit state_request on connect\", () => {\n      renderHook(() => useSocket());\n      \n      eventHandlers.connect();\n      \n      expect(mockSocket.emit).toHaveBeenCalledWith(\"state_request\", expect.objectContaining({\n        context: null,\n        log_from: 0,\n        notifications_from: 0,\n      }));\n    });\n  });\n\n  describe(\"state subscription\", () => {\n    it(\"should emit state_request when socket connected\", () => {\n      mockSocket.connected = true;\n      const { result } = renderHook(() => useSocket());\n      \n      result.current.subscribe(\"ctx-123\");\n      \n      expect(mockSocket.emit).toHaveBeenCalledWith(\"state_request\", expect.objectContaining({\n        context: \"ctx-123\",\n      }));\n    });\n\n    it(\"should queue context when socket not connected\", () => {\n      mockSocket.connected = false;\n      const { result } = renderHook(() => useSocket());\n      \n      result.current.subscribe(\"ctx-123\");\n      \n      // Should not emit yet\n      expect(mockSocket.emit).not.toHaveBeenCalledWith(\"state_request\", expect.anything());\n      \n      // Should emit on connect with queued context\n      eventHandlers.connect();\n      \n      expect(mockSocket.emit).toHaveBeenCalledWith(\"state_request\", expect.objectContaining({\n        context: \"ctx-123\",\n      }));\n    });\n\n    it(\"should reset log_from to 0 on subscribe\", () => {\n      mockSocket.connected = true;\n      const { result } = renderHook(() => useSocket());\n      \n      result.current.subscribe(\"new-ctx\");\n      \n      expect(mockSocket.emit).toHaveBeenCalledWith(\"state_request\", expect.objectContaining({\n        log_from: 0,\n      }));\n    });\n  });\n\n  describe(\"state_push handling\", () => {\n    it(\"should update snapshot from state_push event\", () => {\n      const { result } = renderHook(() => useSocket());\n      \n      const envelope = {\n        data: {\n          snapshot: {\n            logs: [{ type: \"user\", content: \"Hi\", no: 1 }],\n            context: \"ctx-1\",\n            // ... other fields\n          },\n        },\n      };\n      \n      eventHandlers.state_push(envelope);\n      \n      expect(result.current.snapshot).toEqual(envelope.data.snapshot);\n    });\n\n    it(\"should warn when envelope has no snapshot\", () => {\n      const consoleSpy = jest.spyOn(console, \"warn\").mockImplementation();\n      \n      renderHook(() => useSocket());\n      \n      eventHandlers.state_push({ data: {} });\n      \n      expect(consoleSpy).toHaveBeenCalledWith(\n        expect.stringContaining(\"no snapshot\"),\n        expect.anything()\n      );\n    });\n\n    it(\"should increment log_from based on last log.no\", () => {\n      const { result } = renderHook(() => useSocket());\n      \n      eventHandlers.state_push({\n        data: {\n          snapshot: {\n            logs: [\n              { no: 1, type: \"user\", content: \"A\" },\n              { no: 5, type: \"response\", content: \"B\" },\n            ],\n            // ...\n          },\n        },\n      });\n      \n      // Next state_request should use log_from: 6\n      mockSocket.connected = true;\n      result.current.subscribe(\"ctx\");\n      \n      expect(mockSocket.emit).toHaveBeenCalledWith(\"state_request\", expect.objectContaining({\n        log_from: 0, // Reset on subscribe\n      }));\n    });\n\n    it(\"should filter and log response logs\", () => {\n      const consoleSpy = jest.spyOn(console, \"log\").mockImplementation();\n      \n      renderHook(() => useSocket());\n      \n      eventHandlers.state_push({\n        data: {\n          snapshot: {\n            logs: [\n              { no: 1, type: \"response\", content: \"Hello\" },\n              { no: 2, type: \"user\", content: \"Hi\" },\n            ],\n            log_progress_active: true,\n            // ...\n          },\n        },\n      });\n      \n      expect(consoleSpy).toHaveBeenCalledWith(\n        expect.stringContaining(\"1 responses\")\n      );\n    });\n  });\n\n  describe(\"chef_status handling\", () => {\n    it(\"should update chef status from event\", () => {\n      const { result } = renderHook(() => useSocket());\n      \n      const status = {\n        status: \"working\",\n        text: \"Processing\",\n        active: true,\n      };\n      \n      eventHandlers.chef_status(status);\n      \n      expect(result.current.chefStatus).toEqual(status);\n    });\n  });\n\n  describe(\"cleanup\", () => {\n    it(\"should remove all event listeners on unmount\", () => {\n      const { unmount } = renderHook(() => useSocket());\n      \n      unmount();\n      \n      expect(mockSocket.off).toHaveBeenCalledWith(\"connect\");\n      expect(mockSocket.off).toHaveBeenCalledWith(\"disconnect\");\n      expect(mockSocket.off).toHaveBeenCalledWith(\"state_push\");\n      expect(mockSocket.off).toHaveBeenCalledWith(\"chef_status\");\n    });\n\n    it(\"should disconnect socket on unmount\", () => {\n      const { unmount } = renderHook(() => useSocket());\n      \n      unmount();\n      \n      expect(mockSocket.disconnect).toHaveBeenCalled();\n    });\n  });\n});"
