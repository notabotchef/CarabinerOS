 undefined, \"extra\")).toBe(\"base extra\");\n    });\n\n    it(\"should handle null values\", () => {\n      expect(cn(\"base\", null, \"extra\")).toBe(\"base extra\");\n    });\n\n    it(\"should handle empty strings\", () => {\n      expect(cn(\"\", \"class1\", \"\")).toBe(\"class1\");\n    });\n\n    it(\"should deduplicate classes\", () => {\n      expect(cn(\"class1 class2\", \"class1\")).toBe(\"class1 class2\");\n    });\n\n    it(\"should handle no arguments\", () => {\n      expect(cn()).toBe(\"\");\n    });\n\n    it(\"should handle complex nested structures\", () => {\n      expect(\n        cn(\n          \"base\",\n          [\"conditional\", { active: true }],\n          undefined,\n          \"extra\"\n        )\n      ).toBe(\"base conditional active extra\");\n    });\n  });\n});\n```\n\n---\n\n## 11. `src/lib/workspace-config.ts`\n\n### Identified Gaps\n\n**Static Configuration Tests:**\n- Icon mapping correctness\n- Href uniqueness\n- ID uniqueness\n- Required fields validation\n\n### Test Skeletons\n\n```typescript\n// __tests__/lib/workspace-config.test.ts\nimport { MODULES, type ModuleConfig } from \"@/lib/workspace-config\";\n\ndescribe(\"workspace-config\", () => {\n  describe(\"MODULES configuration\", () => {\n    it(\"should have unique IDs\", () => {\n      const ids = MODULES.map(m => m.id);\n      const uniqueIds = new Set(ids);\n      \n      expect(ids.length).toBe(uniqueIds.size);\n    });\n\n    it(\"should have unique hrefs\", () => {\n      const hrefs = MODULES.map(m => m.href);\n      const uniqueHrefs = new Set(hrefs);\n      \n      expect(hrefs.length).toBe(uniqueHrefs.size);\n    });\n\n    it(\"should have all required fields\", () => {\n      MODULES.forEach(module => {\n        expect(module.id).toBeTruthy();\n        expect(module.label).toBeTruthy();\n        expect(module.href).toBeTruthy();\n        expect(module.icon).toBeTruthy();\n        expect(module.description).toBeTruthy();\n      });\n    });\n\n    it(\"should have valid href paths\", () => {\n      MODULES.forEach(module => {\n        expect(module.href).toMatch(/^\\/[a-z-]*$/);\n      });\n    });\n\n    it(\"should have valid icon components\", () => {\n      MODULES.forEach(module => {\n        expect(typeof module.icon).toBe(\"function\");\n      });\n    });\n\n    it(\"should have home module at index 0\", () => {\n      expect(MODULES[0].id).toBe(\"home\");\n      expect(MODULES[0].href).toBe(\"/\");\n    });\n\n    it(\"should have correct module count\", () => {\n      expect(MODULES).toHaveLength(10);\n    });\n\n    it(\"should have descriptive labels\", () => {\n      MODULES.forEach(module => {\n        expect(module.label.length).toBeGreaterThan(0);\n        expect(module.label.length).toBeLessThan(20);\n      });\n    });\n\n    it(\"should have concise descriptions\", () => {\n      MODULES.forEach(module => {\n        expect(module.description.length).toBeGreaterThan(5);\n        expect(module.description.length).toBeLessThan(50);\n      });\n    });\n  });\n});\n```\n\n---\n\n## Integration Test Gaps\n\n### Critical Integration Scenarios\n\n```typescript\n// __tests__/integration/chat-flow.test.tsx\ndescribe(\"Chat Flow Integration\", () => {\n  it(\"should handle complete chat lifecycle: connect → send → receive → disconnect\", () => {\n    // Test full flow from socket connection to message display\n  });\n\n  it(\"should sync action cards with chat messages\", () => {\n    // Test that tool logs create both messages and cards\n  });\n\n  it(\"should handle message queueing during active response\", () => {\n    // Test queue behavior with real snapshot updates\n  });\n});\n\n// __tests__/integration/socket-csrf-flow.test.ts\ndescribe(\"Socket + CSRF Integration\", () => {\n  it(\"should fetch CSRF before socket connection\", () => {\n    // Test initialization order\n  });\n\n  it(\"should refresh CSRF on connection error\", () => {\n    // Test error recovery flow\n  });\n\n  it(\"should include