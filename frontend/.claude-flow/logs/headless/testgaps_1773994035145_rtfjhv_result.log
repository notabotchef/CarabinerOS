        "language": "typescript",
        "code": "// __tests__/hooks/use-workspace.test.ts\nimport { renderHook, waitFor } from \"@testing-library/react\";\nimport { useWorkspace } from \"@/hooks/use-workspace\";\n\ndescribe(\"useWorkspace\", () => {\n  beforeEach(() => {\n    global.fetch = jest.fn();\n  });\n\n  describe(\"data fetching\", () => {\n    it(\"should fetch and normalize array response\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => [{ id: 1 }, { id: 2 }],\n      });\n\n      const { result } = renderHook(() => useWorkspace(\"/api/items\"));\n\n      await waitFor(() => {\n        expect(result.current.loading).toBe(false);\n      });\n\n      expect(result.current.data).toEqual([{ id: 1 }, { id: 2 }]);\n      expect(result.current.error).toBeNull();\n    });\n\n    it(\"should normalize object response with items field\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => ({ items: [{ id: 1 }] }),\n      });\n\n      const { result } = renderHook(() => useWorkspace(\"/api/items\"));\n\n      await waitFor(() => {\n        expect(result.current.data).toEqual([{ id: 1 }]);\n      });\n    });\n\n    it(\"should normalize object response with data field\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => ({ data: [{ id: 1 }] }),\n      });\n\n      const { result } = renderHook(() => useWorkspace(\"/api/items\"));\n\n      await waitFor(() => {\n        expect(result.current.data).toEqual([{ id: 1 }]);\n      });\n    });\n\n    it(\"should default to empty array for unrecognized format\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => ({ something: \"else\" }),\n      });\n\n      const { result } = renderHook(() => useWorkspace(\"/api/items\"));\n\n      await waitFor(() => {\n        expect(result.current.data).toEqual([]);\n      });\n    });\n  });\n\n  describe(\"location filtering\", () => {\n    it(\"should append location_id query parameter\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => [],\n      });\n\n      renderHook(() => useWorkspace(\"/api/items\", \"loc-123\"));\n\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledWith(\n          \"/api/items?location_id=loc-123\",\n          expect.any(Object)\n        );\n      });\n    });\n\n    it(\"should not append query parameter when locationId is undefined\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => [],\n      });\n\n      renderHook(() => useWorkspace(\"/api/items\"));\n\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledWith(\n          \"/api/items\",\n          expect.any(Object)\n        );\n      });\n    });\n  });\n\n  describe(\"refresh mechanism\", () => {\n    it(\"should re-fetch data when refresh is called\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValue({\n        ok: true,\n        json: async () => [],\n      });\n\n      const { result } = renderHook(() => useWorkspace(\"/api/items\"));\n\n      await waitFor(() => expect(result.current.loading).toBe(false));\n      \n      const firstCallCount = (global.fetch as jest.Mock).mock.calls.length;\n      \n      result.current.refresh();\n\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledTimes(firstCallCount + 1);\n      });\n    });\n  });\n\n  describe(\"error handling\", () => {\n    it(\"should set error state on network failure\", async () => {\n      (global.fetch as jest.Mock).mockRejectedValueOnce(new Error(\"Network error\"));\n\n      const { result } = renderHook(() => useWorkspace(\"/api/items\"));\n\n      await waitFor(() => {\n        expect(result.current.error).toBe(\"Network error\");\n        expect(result.current.data).toEqual([]);\n        expect(result.current.loading).toBe(false);\n      });\n    });\n\n    it(\"should set error state on non-OK response\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: false,\n        status: 500,\n      });\n\n      const { result } = renderHook(() => useWorkspace(\"/api/items\"));\n\n      await waitFor(() => {\n        expect(result.current.error).toBe(\"500\");\n      });\n    });\n\n    it(\"should clear error on successful retry\", async () => {\n      (global.fetch as jest.Mock)\n        .mockRejectedValueOnce(new Error(\"Fail\"))\n        .mockResolvedValueOnce({ ok: true, json: async () => [] });\n\n      const { result } = renderHook(() => useWorkspace(\"/api/items\"));\n\n      await waitFor(() => expect(result.current.error).toBeTruthy());\n\n      result.current.refresh();\n\n      await waitFor(() => {\n        expect(result.current.error).toBeNull();\n      });\n    });\n  });\n\n  describe(\"loading state\", () => {\n    it(\"should set loading true during fetch\", () => {\n      (global.fetch as jest.Mock).mockImplementation(\n        () => new Promise(() => {}) // Never resolves\n      );\n\n      const { result } = renderHook(() => useWorkspace(\"/api/items\"));\n\n      expect(result.current.loading).toBe(true);\n    });\n\n    it(\"should set loading false after completion\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => [],\n      });\n\n      const { result } = renderHook(() => useWorkspace(\"/api/items\"));\n\n      await waitFor(() => {\n        expect(result.current.loading).toBe(false);\n      });\n    });\n  });\n\n  describe(\"credentials\", () => {\n    it(\"should include credentials in fetch\", async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => [],\n      });\n\n      renderHook(() => useWorkspace(\"/api/items\"));\n\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledWith(\n          expect.any(String),\n          expect.objectContaining({ credentials: \"include\" })\n        );\n      });\n    });\n  });\n});"
