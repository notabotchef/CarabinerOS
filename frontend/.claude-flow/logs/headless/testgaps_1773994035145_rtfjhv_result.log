        "code": "// __tests__/lib/utils.test.ts\nimport { cn } from \"@/lib/utils\";\n\ndescribe(\"utils\", () => {\n  describe(\"cn\", () => {\n    it(\"should merge class names\", () => {\n      expect(cn(\"class1\", \"class2\")).toBe(\"class1 class2\");\n    });\n\n    it(\"should handle conditional classes\", () => {\n      expect(cn(\"base\", true && \"active\", false && \"inactive\")).toBe(\"base active\");\n    });\n\n    it(\"should merge Tailwind classes correctly\", () => {\n      expect(cn(\"px-2 py-1\", \"px-4\")).toBe(\"py-1 px-4\");\n    });\n\n    it(\"should handle arrays\", () => {\n      expect(cn([\"class1\", \"class2\"])).toBe(\"class1 class2\");\n    });\n\n    it(\"should handle objects\", () => {\n      expect(cn({ active: true, disabled: false })).toBe(\"active\");\n    });\n\n    it(\"should handle undefined values\", () => {\n      expect(cn(\"base\", undefined, \"extra\")).toBe(\"base extra\");\n    });\n\n    it(\"should handle null values\", () => {\n      expect(cn(\"base\", null, \"extra\")).toBe(\"base extra\");\n    });\n\n    it(\"should handle empty strings\", () => {\n      expect(cn(\"\", \"class1\", \"\")).toBe(\"class1\");\n    });\n\n    it(\"should deduplicate classes\", () => {\n      expect(cn(\"class1 class2\", \"class1\")).toBe(\"class1 class2\");\n    });\n\n    it(\"should handle no arguments\", () => {\n      expect(cn()).toBe(\"\");\n    });\n\n    it(\"should handle complex nested structures\", () => {\n      expect(\n        cn(\n          \"base\",\n          [\"conditional\", { active: true }],\n          undefined,\n          \"extra\"\n        )\n      ).toBe(\"base conditional active extra\");\n    });\n  });\n});"
