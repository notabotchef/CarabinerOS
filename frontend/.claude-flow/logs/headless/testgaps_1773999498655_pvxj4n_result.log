  "output": "# Test Coverage Analysis\n\n## 1. use-action-cards.ts\n\n### Untested Functions\n- `useActionCards` - core hook logic\n\n### Missing Test Scenarios\n\n#### Edge Cases\n1. **Null snapshot handling**\n2. **Empty snapshot.logs array**\n3. **Duplicate log IDs** (processedIds deduplication)\n4. **Logs without kvps field**\n5. **Logs with partial kvps** (missing module or action)\n6. **Type coercion** (kvps values that aren't strings)\n7. **markRead with non-existent ID**\n8. **Large snapshot** (performance with 1000+ logs)\n\n#### Error Handling\n9. **Malformed log entries** (missing required fields)\n10. **Concurrent state updates** (multiple snapshots in rapid succession)\n\n### Test Skeletons\n\n```typescript\n// __tests__/hooks/use-action-cards.test.ts\nimport { renderHook, act } from '@testing-library/react';\nimport { useActionCards } from '@/hooks/use-action-cards';\nimport type { A0Snapshot } from '@/lib/types';\n\ndescribe('useActionCards', () => {\n  it('should return empty cards for null snapshot', () => {\n    const { result } = renderHook(() => useActionCards(null));\n    expect(result.current.cards).toEqual([]);\n    expect(result.current.unreadCount).toBe(0);\n  });\n\n  it('should filter and process tool logs with module and action', () => {\n    const snapshot: A0Snapshot = {\n      logs: [\n        {\n          id: '1',\n          no: 1,\n          type: 'tool',\n          kvps: { module: 'inventory', action: 'update', item_id: '123' },\n          content: 'Updated inventory item',\n          timestamp: Date.now(),\n          heading: '',\n          agentno: 0,\n        },\n      ],\n      // ... other required fields\n    };\n    \n    const { result } = renderHook(() => useActionCards(snapshot));\n    expect(result.current.cards).toHaveLength(1);\n    expect(result.current.cards[0].module).toBe('inventory');\n  });\n\n  it('should not process duplicate log IDs', () => {\n    const log = {\n      id: '1',\n      no: 1,\n      type: 'tool' as const,\n      kvps: { module: 'test', action: 'test' },\n      content: 'Test',\n      timestamp: Date.now(),\n      heading: '',\n      agentno: 0,\n    };\n    \n    const { result, rerender } = renderHook(\n      ({ snapshot }) => useActionCards(snapshot),\n      { initialProps: { snapshot: { logs: [log] } as A0Snapshot } }\n    );\n    \n    expect(result.current.cards).toHaveLength(1);\n    \n    // Re-render with same log\n    rerender({ snapshot: { logs: [log, log] } as A0Snapshot });\n    expect(result.current.cards).toHaveLength(1); // Should still be 1\n  });\n\n  it('should skip logs without module or action in kvps', () => {\n    const snapshot: A0Snapshot = {\n      logs: [\n        { id: '1', type: 'tool', kvps: { module: 'test' } }, // missing action\n        { id: '2', type: 'tool', kvps: { action: 'test' } }, // missing module\n        { id: '3', type: 'tool', kvps: {} }, // missing both\n      ],\n    } as A0Snapshot;\n    \n    const { result } = renderHook(() => useActionCards(snapshot));\n    expect(result.current.cards).toHaveLength(0);\n  });\n\n  it('should handle non-string kvps values through type coercion', () => {\n    const snapshot: A0Snapshot = {\n      logs: [{\n        id: '1',\n        type: 'tool',\n        kvps: { module: 123, action: true, item_id: null },\n        // ... other fields\n      }],\n    } as unknown as A0Snapshot;\n    \n    const { result } = renderHook(() => useActionCards(snapshot));\n    expect(result.current.cards[0].module).toBe('123');\n    expect(result.current.cards[0].action).toBe('true');\n  });\n\n  it('should mark specific card as read', () => {\n    const snapshot = createSnapshotWithCards(2);\n    const { result } = renderHook(() => useActionCards(snapshot));\n    \n    act(() => {\n      result.current.markRead(result.current.cards[0].id);\n    });\n    \n    expect(result.current.cards[0].read).toBe(true);\n    expect(result.current.cards[1].read).toBe(false);\n    expect(result.current.unreadCount).toBe(1);\n  });\n\n  it('should handle markRead with non-existent ID gracefully', () => {\n    const snapshot = createSnapshotWithCards(1);\n    const { result } = renderHook(() => useActionCards(snapshot));\n    \n    act(() => {\n      result.current.markRead('non-existent-id');\n    });\n    \n    expect(result.current.cards[0].read).toBe(false);\n  });\n\n  it('should mark all cards as read', () => {\n    const snapshot = createSnapshotWithCards(3);\n    const { result } = renderHook(() => useActionCards(snapshot));\n    \n    act(() => {\n      result.current.markAllRead();\n    });\n    \n    expect(result.current.cards.every(c => c.read)).toBe(true);\n    expect(result.current.unreadCount).toBe(0);\n  });\n\n  it('should handle item objects in kvps', () => {\n    const item = { name: 'Tomatoes', quantity: 50, unit: 'kg' };\n    const snapshot: A0Snapshot = {\n      logs: [{\n        id: '1',\n        type: 'tool',\n        kvps: { module: 'inventory', action: 'add', item },\n        // ... other fields\n      }],\n    } as A0Snapshot;\n    \n    const { result } = renderHook(() => useActionCards(snapshot));\n    expect(result.current.cards[0].item).toEqual(item);\n  });\n\n  it('should truncate long content to 120 chars', () => {\n    const longContent = 'a'.repeat(200);\n    const snapshot: A0Snapshot = {\n      logs: [{\n        id: '1',\n        type: 'tool',\n        kvps: { module: 'test', action: 'test' },\n        content: longContent,\n        // ... other fields\n      }],\n    } as A0Snapshot;\n    \n    const { result } = renderHook(() => useActionCards(snapshot));\n    expect(result.current.cards[0].summary).toHaveLength(120);\n  });\n});\n```\n\n---\n\n## 2. use-socket.ts\n\n### Untested Functions\n- `useSocket` - main hook\n- `subscribe` callback\n\n### Missing Test Scenarios\n\n#### Connection Management\n1. **CSRF token fetch failure before connect**\n2. **Socket reconnection after disconnect**\n3. **Multiple connect/disconnect cycles**\n4. **Pending context subscription before connection**\n\n#### State Management\n5. **state_push with missing snapshot**\n6. **state_push with malformed envelope**\n7. **logFrom tracking across multiple pushes**\n8. **Concurrent subscribe calls**\n\n#### Error Handling\n9. **Network timeout during connection**\n10. **Invalid JSON in state_push**\n\n### Test Skeletons\n\n```typescript\n// __tests__/hooks/use-socket.test.ts\nimport { renderHook, waitFor, act } from '@testing-library/react';\nimport { useSocket } from '@/hooks/use-socket';\nimport { initStateSyncSocket } from '@/lib/socket-client';\nimport { getCsrfToken } from '@/lib/csrf';\n\njest.mock('@/lib/socket-client');\njest.mock('@/lib/csrf');\n\ndescribe('useSocket', () => {\n  let mockSocket: any;\n\n  beforeEach(() => {\n    mockSocket = {\n      on: jest.fn(),\n      off: jest.fn(),\n      emit: jest.fn(),\n      connect: jest.fn(),\n      disconnect: jest.fn(),\n      connected: false,\n    };\n    \n    (initStateSyncSocket as jest.Mock).mockReturnValue(mockSocket);\n    (getCsrfToken as jest.Mock).mockResolvedValue('test-token');\n  });\n\n  it('should initialize socket and request CSRF token', async () => {\n    renderHook(() => useSocket());\n    \n    await waitFor(() => {\n      expect(getCsrfToken).toHaveBeenCalled();\n      expect(mockSocket.connect).toHaveBeenCalled();\n    });\n  });\n\n  it('should connect socket even if CSRF fetch fails', async () => {\n    (getCsrfToken as jest.Mock).mockRejectedValue(new Error('CSRF failed'));\n    \n    renderHook(() => useSocket());\n    \n    await waitFor(() => {\n      expect(mockSocket.connect).toHaveBeenCalled();\n    });\n  });\n\n  it('should emit state_request on connect', async () => {\n    const { result } = renderHook(() => useSocket());\n    \n    // Simulate connect event\n    const connectHandler = mockSocket.on.mock.calls.find(\n      ([event]) => event === 'connect'\n    )?.[1];\n    \n    act(() => {\n      connectHandler?.();\n    });\n    \n    await waitFor(() => {\n      expect(mockSocket.emit).toHaveBeenCalledWith(\n        'state_request',\n        expect.objectContaining({\n          context: null,\n          log_from: 0,\n          notifications_from: 0,\n        })\n      );\n    });\n  });\n\n  it('should handle subscribe with pending connection', () => {\n    mockSocket.connected = false;\n    const { result } = renderHook(() => useSocket());\n    \n    act(() => {\n      result.current.subscribe('test-context-id');\n    });\n    \n    // Should not emit yet\n    expect(mockSocket.emit).not.toHaveBeenCalledWith('state_request');\n    \n    // Simulate connection\n    mockSocket.connected = true;\n    const connectHandler = mockSocket.on.mock.calls.find(\n      ([event]) => event === 'connect'\n    )?.[1];\n    \n    act(() => {\n      connectHandler?.();\n    });\n    \n    // Should emit with queued context\n    expect(mockSocket.emit).toHaveBeenCalledWith(\n      'state_request',\n      expect.objectContaining({ context: 'test-context-id' })\n    );\n  });\n\n  it('should update snapshot on state_push', () => {\n    const { result } = renderHook(() => useSocket());\n    \n    const statePushHandler = mockSocket.on.mock.calls.find(\n      ([event]) => event === 'state_push'\n    )?.[1];\n    \n    const mockPush = {\n      data: {\n        snapshot: {\n          logs: [{ no: 1, type: 'response', content: 'test' }],\n          log_progress_active: false,\n        },\n      },\n    };\n    \n    act(() => {\n      statePushHandler?.(mockPush);\n    });\n    \n    expect(result.current.snapshot).toEqual(mockPush.data.snapshot);\n  });\n\n  it('should handle state_push with missing snapshot gracefully', () => {\n    const { result } = renderHook(() => useSocket());\n    \n    const statePushHandler = mockSocket.on.mock.calls.find(\n      ([event]) => event === 'state_push'\n    )?.[1];\n    \n    const consoleSpy = jest.spyOn(console, 'warn').mockImplementation();\n    \n    act(() => {\n      statePushHandler?.({ data: {} }); // No snapshot\n    });\n    \n    expect(consoleSpy).toHaveBeenCalledWith(\n      expect.stringContaining('no snapshot'),\n      expect.any(Array)\n    );\n    expect(result.current.snapshot).toBeNull();\n    \n    consoleSpy.mockRestore();\n  });\n\n  it('should update chef status on chef_status event', () => {\n    const { result } = renderHook(() => useSocket());\n    \n    const chefStatusHandler = mockSocket.on.mock.calls.find(\n      ([event]) => event === 'chef_status'\n    )?.[1];\n    \n    const mockStatus = {\n      status: 'working',\n      text: 'Processing order',\n      active: true,\n    };\n    \n    act(() => {\n      chefStatusHandler?.(mockStatus);\n    });\n    \n    expect(result.current.chefStatus).toEqual(mockStatus);\n  });\n\n  it('should cleanup socket on unmount', () => {\n    const { unmount } = renderHook(() => useSocket());\n    \n    unmount();\n    \n    expect(mockSocket.off).toHaveBeenCalledWith('connect');\n    expect(mockSocket.off).toHaveBeenCalledWith('disconnect');\n    expect(mockSocket.off).toHaveBeenCalledWith('state_push');\n    expect(mockSocket.off).toHaveBeenCalledWith('chef_status');\n    expect(mockSocket.disconnect).toHaveBeenCalled();\n  });\n\n  it('should reset logFrom on subscribe', () => {\n    mockSocket.connected = true;\n    const { result } = renderHook(() => useSocket());\n    \n    // First subscription\n    act(() => {\n      result.current.subscribe('context-1');\n    });\n    \n    expect(mockSocket.emit).toHaveBeenCalledWith(\n      'state_request',\n      expect.objectContaining({ log_from: 0 })\n    );\n    \n    // Second subscription should reset\n    act(() => {\n      result.current.subscribe('context-2');\n    });\n    \n    expect(mockSocket.emit).toHaveBeenCalledWith(\n      'state_request',\n      expect.objectContaining({ log_from: 0, context: 'context-2' })\n    );\n  });\n});\n```\n\n---\n\n## 3. csrf.ts\n\n### Untested Functions\n- `getCsrfToken`\n- `getRuntimeId`\n- `clearCsrfToken`\n\n### Missing Test Scenarios\n\n#### Concurrent Access\n1. **Multiple simultaneous getCsrfToken calls** (promise caching)\n2. **clearCsrfToken during active fetch**\n\n#### Error Handling\n3. **Server returns ok: false**\n4. **Network failure**\n5. **Malformed JSON response**\n6. **Missing token in response**\n\n#### Cookie Management\n7. **Cookie setting with special characters**\n8. **document.cookie write failure**\n\n#### State Management\n9. **getRuntimeId before token fetched**\n10. **Token caching across multiple calls**\n\n### Test Skeletons\n\n```typescript\n// __tests__/lib/csrf.test.ts\nimport { getCsrfToken, getRuntimeId, clearCsrfToken } from '@/lib/csrf';\n\nglobal.fetch = jest.fn();\n\ndescribe('csrf', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n    clearCsrfToken();\n    // Reset document.cookie\n    document.cookie = '';\n  });\n\n  describe('getCsrfToken', () => {\n    it('should fetch and cache CSRF token', async () => {\n      (fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          token: 'test-token-123',\n          runtime_id: 'runtime-456',\n        }),\n      });\n\n      const token = await getCsrfToken();\n      \n      expect(token).toBe('test-token-123');\n      expect(fetch).toHaveBeenCalledWith('/csrf_token', {\n        credentials: 'include',\n      });\n    });\n\n    it('should return cached token on subsequent calls', async () => {\n      (fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          token: 'cached-token',\n          runtime_id: 'runtime-123',\n        }),\n      });\n\n      const token1 = await getCsrfToken();\n      const token2 = await getCsrfToken();\n      \n      expect(token1).toBe(token2);\n      expect(fetch).toHaveBeenCalledTimes(1);\n    });\n\n    it('should handle concurrent calls with promise caching', async () => {\n      (fetch as jest.Mock).mockImplementationOnce(() =>\n        new Promise(resolve =>\n          setTimeout(() =>\n            resolve({\n              json: async () => ({\n                ok: true,\n                token: 'concurrent-token',\n                runtime_id: 'runtime-789',\n              }),\n            }),\n            100\n          )\n        )\n      );\n\n      const [token1, token2, token3] = await Promise.all([\n        getCsrfToken(),\n        getCsrfToken(),\n        getCsrfToken(),\n      ]);\n\n      expect(token1).toBe(token2);\n      expect(token2).toBe(token3);\n      expect(fetch).toHaveBeenCalledTimes(1); // Only one fetch\n    });\n\n    it('should throw error when server returns ok: false', async () => {\n      (fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: false,\n          error: 'CSRF generation failed',\n        }),\n      });\n\n      await expect(getCsrfToken()).rejects.toThrow('CSRF generation failed');\n    });\n\n    it('should throw error on network failure', async () => {\n      (fetch as jest.Mock).mockRejectedValueOnce(\n        new Error('Network error')\n      );\n\n      await expect(getCsrfToken()).rejects.toThrow('Network error');\n    });\n\n    it('should throw generic error when error message missing', async () => {\n      (fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({ ok: false }),\n      });\n\n      await expect(getCsrfToken()).rejects.toThrow(\n        'Failed to get CSRF token'\n      );\n    });\n\n    it('should set cookie with runtime_id', async () => {\n      (fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          token: 'token-abc',\n          runtime_id: 'runtime-xyz',\n        }),\n      });\n\n      await getCsrfToken();\n      \n      expect(document.cookie).toContain('csrf_token_runtime-xyz=token-abc');\n      expect(document.cookie).toContain('SameSite=Strict');\n      expect(document.cookie).toContain('Path=/');\n    });\n\n    it('should handle special characters in runtime_id', async () => {\n      (fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          token: 'token-special',\n          runtime_id: 'runtime-with-dashes_and_underscores',\n        }),\n      });\n\n      await getCsrfToken();\n      \n      expect(document.cookie).toContain(\n        'csrf_token_runtime-with-dashes_and_underscores=token-special'\n      );\n    });\n  });\n\n  describe('getRuntimeId', () => {\n    it('should return null before token is fetched', () => {\n      expect(getRuntimeId()).toBeNull();\n    });\n\n    it('should return runtime_id after token is fetched', async () => {\n      (fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          token: 'token',\n          runtime_id: 'my-runtime',\n        }),\n      });\n\n      await getCsrfToken();\n      expect(getRuntimeId()).toBe('my-runtime');\n    });\n  });\n\n  describe('clearCsrfToken', () => {\n    it('should clear cached token and runtime_id', async () => {\n      (fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          token: 'token-to-clear',\n          runtime_id: 'runtime-to-clear',\n        }),\n      });\n\n      await getCsrfToken();\n      expect(getRuntimeId()).toBe('runtime-to-clear');\n      \n      clearCsrfToken();\n      \n      expect(getRuntimeId()).toBeNull();\n    });\n\n    it('should cause next getCsrfToken to fetch again', async () => {\n      (fetch as jest.Mock)\n        .mockResolvedValueOnce({\n          json: async () => ({ ok: true, token: 'token1', runtime_id: 'r1' }),\n        })\n        .mockResolvedValueOnce({\n          json: async () => ({ ok: true, token: 'token2', runtime_id: 'r2' }),\n        });\n\n      await getCsrfToken();\n      clearCsrfToken();\n      await getCsrfToken();\n      \n      expect(fetch).toHaveBeenCalledTimes(2);\n    });\n  });\n});\n```\n\n---\n\n## 4. use-workspace.ts\n\n### Untested Functions\n- `useWorkspace` hook\n\n### Missing Test Scenarios\n\n#### Network Errors\n1. **Fetch timeout**\n2. **401/403 authentication errors**\n3. **500 server errors**\n4. **Network disconnection**\n\n#### Response Handling\n5. **Malformed JSON**\n6. **Response with .items vs .data vs direct array**\n7. **Empty array response**\n8. **Null response**\n\n#### State Management\n9. **Multiple rapid refresh() calls**\n10. **Unmount during active fetch**\n11. **locationId changes mid-fetch**\n\n### Test Skeletons\n\n```typescript\n// __tests__/hooks/use-workspace.test.ts\nimport { renderHook, waitFor, act } from '@testing-library/react';\nimport { useWorkspace } from '@/hooks/use-workspace';\n\nglobal.fetch = jest.fn();\n\ndescribe('useWorkspace', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n  });\n\n  it('should fetch data successfully', async () => {\n    const mockData = [{ id: 1, name: 'Item 1' }, { id: 2, name: 'Item 2' }];\n    (fetch as jest.Mock).mockResolvedValueOnce({\n      ok: true,\n      json: async () => mockData,\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/items'));\n\n    expect(result.current.loading).toBe(true);\n\n    await waitFor(() => {\n      expect(result.current.loading).toBe(false);\n    });\n\n    expect(result.current.data).toEqual(mockData);\n    expect(result.current.error).toBeNull();\n  });\n\n  it('should append locationId to URL when provided', async () => {\n    (fetch as jest.Mock).mockResolvedValueOnce({\n      ok: true,\n      json: async () => [],\n    });\n\n    renderHook(() => useWorkspace('/api/items', 'loc-123'));\n\n    await waitFor(() => {\n      expect(fetch).toHaveBeenCalledWith(\n        '/api/items?location_id=loc-123',\n        { credentials: 'include' }\n      );\n    });\n  });\n\n  it('should handle response with .items property', async () => {\n    const mockData = [{ id: 1 }];\n    (fetch as jest.Mock).mockResolvedValueOnce({\n      ok: true,\n      json: async () => ({ items: mockData }),\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/data'));\n\n    await waitFor(() => {\n      expect(result.current.data).toEqual(mockData);\n    });\n  });\n\n  it('should handle response with .data property', async () => {\n    const mockData = [{ id: 1 }];\n    (fetch as jest.Mock).mockResolvedValueOnce({\n      ok: true,\n      json: async () => ({ data: mockData }),\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/data'));\n\n    await waitFor(() => {\n      expect(result.current.data).toEqual(mockData);\n    });\n  });\n\n  it('should handle non-200 status as error', async () => {\n    (fetch as jest.Mock).mockResolvedValueOnce({\n      ok: false,\n      status: 404,\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/missing'));\n\n    await waitFor(() => {\n      expect(result.current.error).toBe('404');\n      expect(result.current.data).toEqual([]);\n    });\n  });\n\n  it('should handle network errors', async () => {\n    (fetch as jest.Mock).mockRejectedValueOnce(\n      new Error('Network timeout')\n    );\n\n    const { result } = renderHook(() => useWorkspace('/api/items'));\n\n    await waitFor(() => {\n      expect(result.current.error).toBe('Network timeout');\n      expect(result.current.data).toEqual([]);\n      expect(result.current.loading).toBe(false);\n    });\n  });\n\n  it('should handle malformed JSON', async () => {\n    (fetch as jest.Mock).mockResolvedValueOnce({\n      ok: true,\n      json: async () => {\n        throw new Error('Invalid JSON');\n      },\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/items'));\n\n    await waitFor(() => {\n      expect(result.current.error).toBe('Invalid JSON');\n    });\n  });\n\n  it('should refetch on refresh()', async () => {\n    (fetch as jest.Mock)\n      .mockResolvedValueOnce({ ok: true, json: async () => [{ id: 1 }] })\n      .mockResolvedValueOnce({ ok: true, json: async () => [{ id: 2 }] });\n\n    const { result } = renderHook(() => useWorkspace('/api/items'));\n\n    await waitFor(() => {\n      expect(result.current.data).toEqual([{ id: 1 }]);\n    });\n\n    act(() => {\n      result.current.refresh();\n    });\n\n    await waitFor(() => {\n      expect(result.current.data).toEqual([{ id: 2 }]);\n    });\n\n    expect(fetch).toHaveBeenCalledTimes(2);\n  });\n\n  it('should handle multiple rapid refresh calls', async () => {\n    (fetch as jest.Mock).mockImplementation(() =>\n      Promise.resolve({ ok: true, json: async () => [] })\n    );\n\n    const { result } = renderHook(() => useWorkspace('/api/items'));\n\n    await waitFor(() => expect(result.current.loading).toBe(false));\n\n    act(() => {\n      result.current.refresh();\n      result.current.refresh();\n      result.current.refresh();\n    });\n\n    await waitFor(() => {\n      expect(result.current.loading).toBe(false);\n    });\n\n    // Should have initial + 3 refreshes = 4 total\n    expect(fetch).toHaveBeenCalledTimes(4);\n  });\n\n  it('should refetch when locationId changes', async () => {\n    (fetch as jest.Mock).mockImplementation(() =>\n      Promise.resolve({ ok: true, json: async () => [] })\n    );\n\n    const { rerender } = renderHook(\n      ({ locationId }) => useWorkspace('/api/items', locationId),\n      { initialProps: { locationId: 'loc-1' } }\n    );\n\n    await waitFor(() => {\n      expect(fetch).toHaveBeenCalledWith(\n        '/api/items?location_id=loc-1',\n        expect.any(Object)\n      );\n    });\n\n    rerender({ locationId: 'loc-2' });\n\n    await waitFor(() => {\n      expect(fetch).toHaveBeenCalledWith(\n        '/api/items?location_id=loc-2',\n        expect.any(Object)\n      );\n    });\n  });\n\n  it('should handle non-array response gracefully', async () => {\n    (fetch as jest.Mock).mockResolvedValueOnce({\n      ok: true,\n      json: async () => ({ total: 10 }), // No items/data/array\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/stats'));\n\n    await waitFor(() => {\n      expect(result.current.data).toEqual([]);\n    });\n  });\n});\n```\n\n---\n\n## 5. expo-messages.ts\n\n### Untested Functions\n- `getExpoMessage`\n- `getCompletionMessage`\n\n### Missing Test Scenarios\n\n1. **Unknown tool names**\n2. **Tool heading without \"Using \" prefix**\n3. **Empty/null heading**\n4. **Subagent logs**\n5. **Progress logs with empty content**\n6. **Message randomness distribution**\n7. **Special characters in tool names**\n8. **Very long tool names**\n\n### Test Skeletons\n\n```typescript\n// __tests__/lib/expo-messages.test.ts\nimport { getExpoMessage, getCompletionMessage } from '@/lib/expo-messages';\nimport type { A0LogEntry } from '@/lib/types';\n\ndescribe('expo-messages', () => {\n  describe('getExpoMessage', () => {\n    it('should return quirky message for known tool', () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: '1',\n        type: 'tool',\n        heading: 'Using food_cost_tool...',\n        content: '',\n        kvps: {},\n        timestamp: 0,\n        agentno: 0,\n      };\n\n      const message = getExpoMessage(log);\n      \n      expect(message).toBeTruthy();\n      expect([\n        'Crunching the numbers on that produce order...',\n        'Checking if the avocado market crashed yet...',\n      ]).toContain(message);\n    });\n\n    it('should return default message for unknown tool', () => {\n      const log: A0LogEntry = {\n        type: 'tool',\n        heading: 'Using unknown_tool...',\n        // ... other fields\n      } as A0LogEntry;\n\n      const message = getExpoMessage(log);\n      \n      expect([\n        'Working on it...',\n        'One moment...',\n        'On it, Chef...',\n      ]).toContain(message);\n    });\n\n    it('should handle tool heading without \"Using\" prefix', () => {\n      const log: A0LogEntry = {\n        type: 'tool',\n        heading: 'inventory_tool...',\n      } as A0LogEntry;\n\n      const message = getExpoMessage(log);\n      expect(message).toBeTruthy();\n    });\n\n    it('should return delegation message for agent logs', () => {\n      const log: A0LogEntry = {\n        type: 'agent',\n        heading: 'Sous Chef',\n      } as A0LogEntry;\n\n      const message = getExpoMessage(log);\n      expect(message).toBe('Delegating to Sous Chef...');\n    });\n\n    it('should return delegation message for subagent logs', () => {\n      const log: A0LogEntry = {\n        type: 'subagent',\n        heading: 'Recipe Analyzer',\n      } as A0LogEntry;\n\n      const message = getExpoMessage(log);\n      expect(message).toBe('Delegating to Recipe Analyzer...');\n    });\n\n    it('should return progress content when available', () => {\n      const log: A0LogEntry = {\n        type: 'progress',\n        content: 'Analyzing inventory levels...',\n      } as A0LogEntry;\n\n      const message = getExpoMessage(log);\n      expect(message).toBe('Analyzing inventory levels...');\n    });\n\n    it('should return null for progress log with empty content', () => {\n      const log: A0LogEntry = {\n        type: 'progress',\n        content: '',\n      } as A0LogEntry;\n\n      const message = getExpoMessage(log);\n      expect(message).toBeNull();\n    });\n\n    it('should return null for unhandled log types', () => {\n      const log: A0LogEntry = {\n        type: 'response',\n        heading: 'Response',\n      } as A0LogEntry;\n\n      const message = getExpoMessage(log);\n      expect(message).toBeNull();\n    });\n\n    it('should handle empty heading gracefully', () => {\n      const log: A0LogEntry = {\n        type: 'tool',\n        heading: '',\n      } as A0LogEntry;\n\n      const message = getExpoMessage(log);\n      expect([\n        'Working on it...',\n        'One moment...',\n        'On it, Chef...',\n      ]).toContain(message);\n    });\n\n    it('should handle agent log with null heading', () => {\n      const log: A0LogEntry = {\n        type: 'agent',\n        heading: '',\n      } as A0LogEntry;\n\n      const message = getExpoMessage(log);\n      expect(message).toBe('Delegating to ...');\n    });\n  });\n\n  describe('getCompletionMessage', () => {\n    it('should return one of the predefined completion messages', () => {\n      const message = getCompletionMessage();\n      \n      expect([\n        'Heard.',\n        'Service.',\n        'All set.',\n        'Done, Chef.',\n      ]).toContain(message);\n    });\n\n    it('should return different messages on multiple calls (randomness)', () => {\n      const messages = new Set();\n      for (let i = 0; i < 50; i++) {\n        messages.add(getCompletionMessage());\n      }\n      \n      // With 50 calls, we should get at least 2 different messages\n      // (probability of getting only 1 is extremely low)\n      expect(messages.size).toBeGreaterThan(1);\n    });\n  });\n});\n```\n\n---\n\n## 6. Integration Test Gaps\n\n### Cross-Hook Integration\n1. **useSocket + useChat** - message sending during disconnection\n2. **useSocket + useActionCards** - card extraction from real socket data\n3. **useSocket + useExpoStream** - expo state updates from socket\n4. **useChat + useActionCards** - ensuring no duplicate processing\n\n### End-to-End Scenarios\n5. **Full chat flow** - send message → socket emit → receive response → update UI\n6. **Reconnection recovery** - socket disconnect → reconnect → state restoration\n7. **CSRF token rotation** - token expiry → refresh → retry\n8. **Multi-tab synchronization** - same context in multiple tabs\n\n### Integration Test Skeleton\n\n```typescript\n// __tests__/integration/chat-flow.test.ts\nimport { renderHook, act, waitFor } from '@testing-library/react';\nimport { useSocket } from '@/hooks/use-socket';\nimport { useChat } from '@/hooks/use-chat';\nimport { useActionCards } from '@/hooks/use-action-cards';\n\ndescribe('Chat Flow Integration', () => {\n  it('should handle complete message send and response cycle', async () => {\n    // Mock fetch and socket\n    const mockSocket = setupMockSocket();\n    const mockFetch = setupMockFetch();\n\n    const { result: socketResult } = renderHook(() => useSocket());\n    const { result: chatResult } = renderHook(() =>\n      useChat(socketResult.current.snapshot)\n    );\n\n    // Wait for connection\n    await waitFor(() => {\n      expect(socketResult.current.connected).toBe(true);\n    });\n\n    // Send message\n    await act(async () => {\n      await chatResult.current.sendMessage('Check inventory');\n    });\n\n    // Simulate socket response\n    act(() => {\n      simulateSocketStatePush(mockSocket, {\n        logs: [\n          { type: 'user', content: 'Check inventory', no: 1 },\n          { type: 'agent', heading: 'Analyzing request', no: 2 },\n          { type: 'tool', heading: 'Using inventory_tool', no: 3 },\n          { type: 'response', content: 'Current stock levels...', no: 4 },\n        ],\n      });\n    });\n\n    // Verify chat updated\n    await waitFor(() => {\n      expect(chatResult.current.messages).toHaveLength(2);\n      expect(chatResult.current.messages[1].role).toBe('assistant');\n    });\n  });\n\n  it('should handle socket reconnection gracefully', async () => {\n    const mockSocket = setupMockSocket();\n    const { result } = renderHook(() => useSocket());\n\n    // Initial connection\n    act(() => simulateConnect(mockSocket));\n    await waitFor(() => expect(result.current.connected).toBe(true));\n\n    // Disconnect\n    act(() => simulateDisconnect(mockSocket));\n    expect(result.current.connected).toBe(false);\n\n    // Reconnect\n    act(() => simulateConnect(mockSocket));\n    await waitFor(() => {\n      expect(result.current.connected).toBe(true);\n      // Should emit state_request on reconnect\n      expect(mockSocket.emit).toHaveBeenCalledWith(\n        'state_request',\n        expect.any(Object)\n      );\n    });\n  });\n});\n```\n\n---\n\n## Summary\n\n### Critical Test Priorities\n\n1. **High Priority**\n   - CSRF token management (concurrent calls, error handling)\n   - Socket connection lifecycle (reconnect, error recovery)\n   - Chat message deduplication\n   - useWorkspace error handling\n\n2. **Medium Priority**\n   - Action card filtering logic\n   - Expo message generation\n   - Mobile detection edge cases\n   - State synchronization across hooks\n\n3. **Low Priority**\n   - Message randomness distribution\n   - Cookie edge cases with special characters\n   - Performance with large datasets\n\n### Recommended Testing Tools\n- **Jest** - Unit tests\n- **@testing-library/react** - Hook testing\n- **MSW (Mock Service Worker)** - API mocking\n- **socket.io-mock** - Socket testing\n",
