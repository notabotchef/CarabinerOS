      {
        "title": "Cross-Hook Integration",
        "content": "1. **useSocket + useChat** - message sending during disconnection\n2. **useSocket + useActionCards** - card extraction from real socket data\n3. **useSocket + useExpoStream** - expo state updates from socket\n4. **useChat + useActionCards** - ensuring no duplicate processing\n\n",
        "level": 3
      },
      {
        "title": "End-to-End Scenarios",
        "content": "5. **Full chat flow** - send message → socket emit → receive response → update UI\n6. **Reconnection recovery** - socket disconnect → reconnect → state restoration\n7. **CSRF token rotation** - token expiry → refresh → retry\n8. **Multi-tab synchronization** - same context in multiple tabs\n\n",
        "level": 3
      },
      {
        "title": "Integration Test Skeleton",
        "content": "\n```typescript\n// __tests__/integration/chat-flow.test.ts\nimport { renderHook, act, waitFor } from '@testing-library/react';\nimport { useSocket } from '@/hooks/use-socket';\nimport { useChat } from '@/hooks/use-chat';\nimport { useActionCards } from '@/hooks/use-action-cards';\n\ndescribe('Chat Flow Integration', () => {\n  it('should handle complete message send and response cycle', async () => {\n    // Mock fetch and socket\n    const mockSocket = setupMockSocket();\n    const mockFetch = setupMockFetch();\n\n    const { result: socketResult } = renderHook(() => useSocket());\n    const { result: chatResult } = renderHook(() =>\n      useChat(socketResult.current.snapshot)\n    );\n\n    // Wait for connection\n    await waitFor(() => {\n      expect(socketResult.current.connected).toBe(true);\n    });\n\n    // Send message\n    await act(async () => {\n      await chatResult.current.sendMessage('Check inventory');\n    });\n\n    // Simulate socket response\n    act(() => {\n      simulateSocketStatePush(mockSocket, {\n        logs: [\n          { type: 'user', content: 'Check inventory', no: 1 },\n          { type: 'agent', heading: 'Analyzing request', no: 2 },\n          { type: 'tool', heading: 'Using inventory_tool', no: 3 },\n          { type: 'response', content: 'Current stock levels...', no: 4 },\n        ],\n      });\n    });\n\n    // Verify chat updated\n    await waitFor(() => {\n      expect(chatResult.current.messages).toHaveLength(2);\n      expect(chatResult.current.messages[1].role).toBe('assistant');\n    });\n  });\n\n  it('should handle socket reconnection gracefully', async () => {\n    const mockSocket = setupMockSocket();\n    const { result } = renderHook(() => useSocket());\n\n    // Initial connection\n    act(() => simulateConnect(mockSocket));\n    await waitFor(() => expect(result.current.connected).toBe(true));\n\n    // Disconnect\n    act(() => simulateDisconnect(mockSocket));\n    expect(result.current.connected).toBe(false);\n\n    // Reconnect\n    act(() => simulateConnect(mockSocket));\n    await waitFor(() => {\n      expect(result.current.connected).toBe(true);\n      // Should emit state_request on reconnect\n      expect(mockSocket.emit).toHaveBeenCalledWith(\n        'state_request',\n        expect.any(Object)\n      );\n    });\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "Summary",
