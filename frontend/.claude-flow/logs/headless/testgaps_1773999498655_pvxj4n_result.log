      {
        "title": "Response Handling",
        "content": "5. **Malformed JSON**\n6. **Response with .items vs .data vs direct array**\n7. **Empty array response**\n8. **Null response**\n\n",
        "level": 4
      },
      {
        "title": "State Management",
        "content": "9. **Multiple rapid refresh() calls**\n10. **Unmount during active fetch**\n11. **locationId changes mid-fetch**\n\n",
        "level": 4
      },
      {
        "title": "Test Skeletons",
        "content": "\n```typescript\n// __tests__/hooks/use-workspace.test.ts\nimport { renderHook, waitFor, act } from '@testing-library/react';\nimport { useWorkspace } from '@/hooks/use-workspace';\n\nglobal.fetch = jest.fn();\n\ndescribe('useWorkspace', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n  });\n\n  it('should fetch data successfully', async () => {\n    const mockData = [{ id: 1, name: 'Item 1' }, { id: 2, name: 'Item 2' }];\n    (fetch as jest.Mock).mockResolvedValueOnce({\n      ok: true,\n      json: async () => mockData,\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/items'));\n\n    expect(result.current.loading).toBe(true);\n\n    await waitFor(() => {\n      expect(result.current.loading).toBe(false);\n    });\n\n    expect(result.current.data).toEqual(mockData);\n    expect(result.current.error).toBeNull();\n  });\n\n  it('should append locationId to URL when provided', async () => {\n    (fetch as jest.Mock).mockResolvedValueOnce({\n      ok: true,\n      json: async () => [],\n    });\n\n    renderHook(() => useWorkspace('/api/items', 'loc-123'));\n\n    await waitFor(() => {\n      expect(fetch).toHaveBeenCalledWith(\n        '/api/items?location_id=loc-123',\n        { credentials: 'include' }\n      );\n    });\n  });\n\n  it('should handle response with .items property', async () => {\n    const mockData = [{ id: 1 }];\n    (fetch as jest.Mock).mockResolvedValueOnce({\n      ok: true,\n      json: async () => ({ items: mockData }),\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/data'));\n\n    await waitFor(() => {\n      expect(result.current.data).toEqual(mockData);\n    });\n  });\n\n  it('should handle response with .data property', async () => {\n    const mockData = [{ id: 1 }];\n    (fetch as jest.Mock).mockResolvedValueOnce({\n      ok: true,\n      json: async () => ({ data: mockData }),\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/data'));\n\n    await waitFor(() => {\n      expect(result.current.data).toEqual(mockData);\n    });\n  });\n\n  it('should handle non-200 status as error', async () => {\n    (fetch as jest.Mock).mockResolvedValueOnce({\n      ok: false,\n      status: 404,\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/missing'));\n\n    await waitFor(() => {\n      expect(result.current.error).toBe('404');\n      expect(result.current.data).toEqual([]);\n    });\n  });\n\n  it('should handle network errors', async () => {\n    (fetch as jest.Mock).mockRejectedValueOnce(\n      new Error('Network timeout')\n    );\n\n    const { result } = renderHook(() => useWorkspace('/api/items'));\n\n    await waitFor(() => {\n      expect(result.current.error).toBe('Network timeout');\n      expect(result.current.data).toEqual([]);\n      expect(result.current.loading).toBe(false);\n    });\n  });\n\n  it('should handle malformed JSON', async () => {\n    (fetch as jest.Mock).mockResolvedValueOnce({\n      ok: true,\n      json: async () => {\n        throw new Error('Invalid JSON');\n      },\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/items'));\n\n    await waitFor(() => {\n      expect(result.current.error).toBe('Invalid JSON');\n    });\n  });\n\n  it('should refetch on refresh()', async () => {\n    (fetch as jest.Mock)\n      .mockResolvedValueOnce({ ok: true, json: async () => [{ id: 1 }] })\n      .mockResolvedValueOnce({ ok: true, json: async () => [{ id: 2 }] });\n\n    const { result } = renderHook(() => useWorkspace('/api/items'));\n\n    await waitFor(() => {\n      expect(result.current.data).toEqual([{ id: 1 }]);\n    });\n\n    act(() => {\n      result.current.refresh();\n    });\n\n    await waitFor(() => {\n      expect(result.current.data).toEqual([{ id: 2 }]);\n    });\n\n    expect(fetch).toHaveBeenCalledTimes(2);\n  });\n\n  it('should handle multiple rapid refresh calls', async () => {\n    (fetch as jest.Mock).mockImplementation(() =>\n      Promise.resolve({ ok: true, json: async () => [] })\n    );\n\n    const { result } = renderHook(() => useWorkspace('/api/items'));\n\n    await waitFor(() => expect(result.current.loading).toBe(false));\n\n    act(() => {\n      result.current.refresh();\n      result.current.refresh();\n      result.current.refresh();\n    });\n\n    await waitFor(() => {\n      expect(result.current.loading).toBe(false);\n    });\n\n    // Should have initial + 3 refreshes = 4 total\n    expect(fetch).toHaveBeenCalledTimes(4);\n  });\n\n  it('should refetch when locationId changes', async () => {\n    (fetch as jest.Mock).mockImplementation(() =>\n      Promise.resolve({ ok: true, json: async () => [] })\n    );\n\n    const { rerender } = renderHook(\n      ({ locationId }) => useWorkspace('/api/items', locationId),\n      { initialProps: { locationId: 'loc-1' } }\n    );\n\n    await waitFor(() => {\n      expect(fetch).toHaveBeenCalledWith(\n        '/api/items?location_id=loc-1',\n        expect.any(Object)\n      );\n    });\n\n    rerender({ locationId: 'loc-2' });\n\n    await waitFor(() => {\n      expect(fetch).toHaveBeenCalledWith(\n        '/api/items?location_id=loc-2',\n        expect.any(Object)\n      );\n    });\n  });\n\n  it('should handle non-array response gracefully', async () => {\n    (fetch as jest.Mock).mockResolvedValueOnce({\n      ok: true,\n      json: async () => ({ total: 10 }), // No items/data/array\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/stats'));\n\n    await waitFor(() => {\n      expect(result.current.data).toEqual([]);\n    });\n  });\n});\n```\n\n---\n\n",
