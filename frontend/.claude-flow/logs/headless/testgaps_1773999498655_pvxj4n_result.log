      {
        "title": "State Management",
        "content": "9. **getRuntimeId before token fetched**\n10. **Token caching across multiple calls**\n\n",
        "level": 4
      },
      {
        "title": "Test Skeletons",
        "content": "\n```typescript\n// __tests__/lib/csrf.test.ts\nimport { getCsrfToken, getRuntimeId, clearCsrfToken } from '@/lib/csrf';\n\nglobal.fetch = jest.fn();\n\ndescribe('csrf', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n    clearCsrfToken();\n    // Reset document.cookie\n    document.cookie = '';\n  });\n\n  describe('getCsrfToken', () => {\n    it('should fetch and cache CSRF token', async () => {\n      (fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          token: 'test-token-123',\n          runtime_id: 'runtime-456',\n        }),\n      });\n\n      const token = await getCsrfToken();\n      \n      expect(token).toBe('test-token-123');\n      expect(fetch).toHaveBeenCalledWith('/csrf_token', {\n        credentials: 'include',\n      });\n    });\n\n    it('should return cached token on subsequent calls', async () => {\n      (fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          token: 'cached-token',\n          runtime_id: 'runtime-123',\n        }),\n      });\n\n      const token1 = await getCsrfToken();\n      const token2 = await getCsrfToken();\n      \n      expect(token1).toBe(token2);\n      expect(fetch).toHaveBeenCalledTimes(1);\n    });\n\n    it('should handle concurrent calls with promise caching', async () => {\n      (fetch as jest.Mock).mockImplementationOnce(() =>\n        new Promise(resolve =>\n          setTimeout(() =>\n            resolve({\n              json: async () => ({\n                ok: true,\n                token: 'concurrent-token',\n                runtime_id: 'runtime-789',\n              }),\n            }),\n            100\n          )\n        )\n      );\n\n      const [token1, token2, token3] = await Promise.all([\n        getCsrfToken(),\n        getCsrfToken(),\n        getCsrfToken(),\n      ]);\n\n      expect(token1).toBe(token2);\n      expect(token2).toBe(token3);\n      expect(fetch).toHaveBeenCalledTimes(1); // Only one fetch\n    });\n\n    it('should throw error when server returns ok: false', async () => {\n      (fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: false,\n          error: 'CSRF generation failed',\n        }),\n      });\n\n      await expect(getCsrfToken()).rejects.toThrow('CSRF generation failed');\n    });\n\n    it('should throw error on network failure', async () => {\n      (fetch as jest.Mock).mockRejectedValueOnce(\n        new Error('Network error')\n      );\n\n      await expect(getCsrfToken()).rejects.toThrow('Network error');\n    });\n\n    it('should throw generic error when error message missing', async () => {\n      (fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({ ok: false }),\n      });\n\n      await expect(getCsrfToken()).rejects.toThrow(\n        'Failed to get CSRF token'\n      );\n    });\n\n    it('should set cookie with runtime_id', async () => {\n      (fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          token: 'token-abc',\n          runtime_id: 'runtime-xyz',\n        }),\n      });\n\n      await getCsrfToken();\n      \n      expect(document.cookie).toContain('csrf_token_runtime-xyz=token-abc');\n      expect(document.cookie).toContain('SameSite=Strict');\n      expect(document.cookie).toContain('Path=/');\n    });\n\n    it('should handle special characters in runtime_id', async () => {\n      (fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          token: 'token-special',\n          runtime_id: 'runtime-with-dashes_and_underscores',\n        }),\n      });\n\n      await getCsrfToken();\n      \n      expect(document.cookie).toContain(\n        'csrf_token_runtime-with-dashes_and_underscores=token-special'\n      );\n    });\n  });\n\n  describe('getRuntimeId', () => {\n    it('should return null before token is fetched', () => {\n      expect(getRuntimeId()).toBeNull();\n    });\n\n    it('should return runtime_id after token is fetched', async () => {\n      (fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          token: 'token',\n          runtime_id: 'my-runtime',\n        }),\n      });\n\n      await getCsrfToken();\n      expect(getRuntimeId()).toBe('my-runtime');\n    });\n  });\n\n  describe('clearCsrfToken', () => {\n    it('should clear cached token and runtime_id', async () => {\n      (fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          token: 'token-to-clear',\n          runtime_id: 'runtime-to-clear',\n        }),\n      });\n\n      await getCsrfToken();\n      expect(getRuntimeId()).toBe('runtime-to-clear');\n      \n      clearCsrfToken();\n      \n      expect(getRuntimeId()).toBeNull();\n    });\n\n    it('should cause next getCsrfToken to fetch again', async () => {\n      (fetch as jest.Mock)\n        .mockResolvedValueOnce({\n          json: async () => ({ ok: true, token: 'token1', runtime_id: 'r1' }),\n        })\n        .mockResolvedValueOnce({\n          json: async () => ({ ok: true, token: 'token2', runtime_id: 'r2' }),\n        });\n\n      await getCsrfToken();\n      clearCsrfToken();\n      await getCsrfToken();\n      \n      expect(fetch).toHaveBeenCalledTimes(2);\n    });\n  });\n});\n```\n\n---\n\n",
