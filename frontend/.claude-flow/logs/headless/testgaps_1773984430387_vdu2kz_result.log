        "language": "typescript",
        "code": "// test: use-mobile.test.ts\n\ndescribe(\"useIsMobile\", () => {\n  it(\"should return undefined initially (SSR-safe)\", () => {\n    const { result } = renderHook(() => useIsMobile());\n    // First render should be undefined to prevent hydration mismatch\n    expect(result.current).toBe(false); // Note: !!undefined = false\n  });\n\n  it(\"should detect mobile viewport\", () => {\n    global.innerWidth = 500;\n    const { result } = renderHook(() => useIsMobile());\n    expect(result.current).toBe(true);\n  });\n\n  it(\"should detect desktop viewport\", () => {\n    global.innerWidth = 1024;\n    const { result } = renderHook(() => useIsMobile());\n    expect(result.current).toBe(false);\n  });\n\n  it(\"should update on window resize\", () => {\n    global.innerWidth = 1024;\n    const { result } = renderHook(() => useIsMobile());\n    expect(result.current).toBe(false);\n    \n    act(() => {\n      global.innerWidth = 500;\n      window.dispatchEvent(new Event(\"resize\"));\n    });\n    \n    expect(result.current).toBe(true);\n  });\n\n  it(\"should cleanup event listener on unmount\", () => {\n    const removeEventListenerSpy = jest.spyOn(\n      window.matchMedia(`(max-width: 767px)`),\n      \"removeEventListener\"\n    );\n    \n    const { unmount } = renderHook(() => useIsMobile());\n    unmount();\n    \n    expect(removeEventListenerSpy).toHaveBeenCalled();\n  });\n\n  it(\"should handle missing matchMedia gracefully\", () => {\n    const originalMatchMedia = window.matchMedia;\n    // @ts-ignore\n    delete window.matchMedia;\n    \n    // Should not crash\n    const { result } = renderHook(() => useIsMobile());\n    \n    window.matchMedia = originalMatchMedia;\n  });\n});"
      },
      {
        "language": "typescript",
        "code": "// test: use-socket.test.ts\n\ndescribe(\"useSocket\", () => {\n  it(\"should initialize as disconnected\", () => {\n    const { result } = renderHook(() => useSocket());\n    expect(result.current.connected).toBe(false);\n    expect(result.current.snapshot).toBeNull();\n  });\n\n  it(\"should connect and request initial state\", async () => {\n    const mockSocket = mockSocketIO();\n    \n    const { result } = renderHook(() => useSocket());\n    \n    act(() => mockSocket.emit(\"connect\"));\n    \n    expect(result.current.connected).toBe(true);\n    expect(mockSocket.emit).toHaveBeenCalledWith(\n      \"state_request\",\n      expect.objectContaining({ context: null, log_from: 0 })\n    );\n  });\n\n  it(\"should handle state_push and update snapshot\", () => {\n    const mockSocket = mockSocketIO();\n    const { result } = renderHook(() => useSocket());\n    \n    const statePush: A0StatePush = {\n      handlerId: \"test\",\n      eventId: \"1\",\n      correlationId: \"abc\",\n      ts: \"2024-01-01T00:00:00Z\",\n      data: {\n        runtime_epoch: \"123\",\n        seq: 1,\n        snapshot: mockSnapshot\n      }\n    };\n    \n    act(() => mockSocket.emit(\"state_push\", statePush));\n    \n    expect(result.current.snapshot).toEqual(mockSnapshot);\n  });\n\n  it(\"should handle malformed state_push gracefully\", () => {\n    const mockSocket = mockSocketIO();\n    const { result } = renderHook(() => useSocket());\n    \n    // Missing snapshot\n    act(() => mockSocket.emit(\"state_push\", { data: {} }));\n    \n    // Should log warning but not crash\n    expect(result.current.snapshot).toBeNull();\n  });\n\n  it(\"should handle CSRF token fetch failure on connect\", async () => {\n    jest.mock(\"@/lib/csrf\", () => ({\n      getCsrfToken: jest.fn(() => Promise.reject(new Error(\"CSRF failed\")))\n    }));\n    \n    // Should still attempt connection\n    const { result } = renderHook(() => useSocket());\n    // Should eventually connect despite CSRF failure\n  });\n\n  it(\"should handle subscribe when socket disconnected\", () => {\n    const { result } = renderHook(() => useSocket());\n    \n    // Should not throw when called before connection\n    act(() => result.current.subscribe(\"test-context\"));\n  });\n\n  it(\"should reset logFromRef when subscribing\", () => {\n    const mockSocket = mockSocketIO();\n    const { result } = renderHook(() => useSocket());\n    \n    act(() => mockSocket.emit(\"connect\"));\n    act(() => result.current.subscribe(\"new-context\"));\n    \n    expect(mockSocket.emit).toHaveBeenCalledWith(\n      \"state_request\",\n      expect.objectContaining({ log_from: 0 })\n    );\n  });\n\n  it(\"should update logFromRef after processing logs\", () => {\n    // Test that logFromRef increments to last log no + 1\n  });\n\n  it(\"should handle chef_status events\", () => {\n    const mockSocket = mockSocketIO();\n    const { result } = renderHook(() => useSocket());\n    \n    const chefStatus = { active: true, text: \"Working\", status: \"working\" };\n    act(() => mockSocket.emit(\"chef_status\", chefStatus));\n    \n    expect(result.current.chefStatus).toEqual(chefStatus);\n  });\n\n  it(\"should cleanup socket on unmount\", () => {\n    const mockSocket = mockSocketIO();\n    const { unmount } = renderHook(() => useSocket());\n    \n    unmount();\n    \n    expect(mockSocket.off).toHaveBeenCalledWith(\"connect\");\n    expect(mockSocket.off).toHaveBeenCalledWith(\"disconnect\");\n    expect(mockSocket.disconnect).toHaveBeenCalled();\n  });\n});"
      },
