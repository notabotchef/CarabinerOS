ken();\n    \n    expect(document.cookie).toContain(\"csrf_token_runtime-123=test-token\");\n    expect(document.cookie).toContain(\"SameSite=Strict\");\n    expect(document.cookie).toContain(\"Path=/\");\n  });\n\n  it(\"should return runtimeId after successful fetch\", async () => {\n    global.fetch = jest.fn(() =>\n      Promise.resolve({\n        ok: true,\n        json: () => Promise.resolve({ \n          ok: true, \n          token: \"test-token\", \n          runtime_id: \"runtime-123\" \n        })\n      })\n    );\n    \n    await getCsrfToken();\n    \n    expect(getRuntimeId()).toBe(\"runtime-123\");\n  });\n\n  it(\"should clear token and runtimeId\", async () => {\n    global.fetch = jest.fn(() =>\n      Promise.resolve({\n        ok: true,\n        json: () => Promise.resolve({ \n          ok: true, \n          token: \"test-token\", \n          runtime_id: \"runtime-123\" \n        })\n      })\n    );\n    \n    await getCsrfToken();\n    expect(getRuntimeId()).toBe(\"runtime-123\");\n    \n    clearCsrfToken();\n    \n    expect(getRuntimeId()).toBeNull();\n  });\n\n  it(\"should refetch after clearCsrfToken\", async () => {\n    global.fetch = jest.fn(() =>\n      Promise.resolve({\n        ok: true,\n        json: () => Promise.resolve({ \n          ok: true, \n          token: \"test-token\", \n          runtime_id: \"runtime-123\" \n        })\n      })\n    );\n    \n    await getCsrfToken();\n    clearCsrfToken();\n    await getCsrfToken();\n    \n    expect(global.fetch).toHaveBeenCalledTimes(2);\n  });\n});\n```\n\n---\n\n## 8. `src/lib/expo-messages.ts`\n\n### Identified Gaps\n\n| Gap Type | Description |\n|----------|-------------|\n| **Unit Test** | All tool names covered |\n| **Unit Test** | Unknown tool names fallback |\n| **Edge Case** | Missing heading field |\n| **Edge Case** | All log types tested |\n| **Unit Test** | Randomness produces variety |\n\n### Test Skeletons\n\n```typescript\n// test: expo-messages.test.ts\n\ndescribe(\