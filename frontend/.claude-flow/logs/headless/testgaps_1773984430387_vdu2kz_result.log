        "code": "// test: expo-messages.test.ts\n\ndescribe(\"expo-messages\", () => {\n  describe(\"getExpoMessage\", () => {\n    it(\"should return message for known tool\", () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: \"1\",\n        type: \"tool\",\n        heading: \"Using food_cost_tool...\",\n        content: \"test\",\n        kvps: {},\n        timestamp: 1000,\n        agentno: 0\n      };\n      \n      const message = getExpoMessage(log);\n      expect(message).toBeTruthy();\n      expect(typeof message).toBe(\"string\");\n    });\n\n    it(\"should return default message for unknown tool\", () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: \"1\",\n        type: \"tool\",\n        heading: \"Using unknown_tool...\",\n        content: \"test\",\n        kvps: {},\n        timestamp: 1000,\n        agentno: 0\n      };\n      \n      const message = getExpoMessage(log);\n      expect(message).toBeTruthy();\n      expect([\"Working on it...\", \"One moment...\", \"On it, Chef...\"]).toContain(message);\n    });\n\n    it(\"should handle log with no heading\", () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: \"1\",\n        type: \"tool\",\n        heading: \"\",\n        content: \"test\",\n        kvps: {},\n        timestamp: 1000,\n        agentno: 0\n      };\n      \n      const message = getExpoMessage(log);\n      expect(message).toBeTruthy();\n    });\n\n    it(\"should return message for agent delegation\", () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: \"1\",\n        type: \"agent\",\n        heading: \"Sous Chef\",\n        content: \"test\",\n        kvps: {},\n        timestamp: 1000,\n        agentno: 0\n      };\n      \n      const message = getExpoMessage(log);\n      expect(message).toContain(\"Delegating to\");\n    });\n\n    it(\"should return message for subagent\", () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: \"1\",\n        type: \"subagent\",\n        heading: \"Assistant\",\n        content: \"test\",\n        kvps: {},\n        timestamp: 1000,\n        agentno: 0\n      };\n      \n      const message = getExpoMessage(log);\n      expect(message).toContain(\"Delegating to\");\n    });\n\n    it(\"should return progress content\", () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: \"1\",\n        type: \"progress\",\n        heading: \"\",\n        content: \"Calculating food costs...\",\n        kvps: {},\n        timestamp: 1000,\n        agentno: 0\n      };\n      \n      const message = getExpoMessage(log);\n      expect(message).toBe(\"Calculating food costs...\");\n    });\n\n    it(\"should return null for non-relevant log types\", () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: \"1\",\n        type: \"user\",\n        heading: \"\",\n        content: \"test\",\n        kvps: {},\n        timestamp: 1000,\n        agentno: 0\n      };\n      \n      expect(getExpoMessage(log)).toBeNull();\n    });\n\n    // Coverage for all tool names\n    const tools = [\n      \"food_cost_tool\", \"inventory_tool\", \"prep_tool\", \"order_tool\",\n      \"recipe_tool\", \"reporting_tool\", \"invoice_tool\", \"marketing_tool\",\n      \"menu_tool\"\n    ];\n\n    tools.forEach(tool => {\n      it(`should have message for ${tool}`, () => {\n        const log: A0LogEntry = {\n          no: 1,\n          id: \"1\",\n          type: \"tool\",\n          heading: `Using ${tool}...`,\n          content: \"test\",\n          kvps: {},\n          timestamp: 1000,\n          agentno: 0\n        };\n        \n        const message = getExpoMessage(log);\n        expect(message).toBeTruthy();\n      });\n    });\n  });\n\n  describe(\"getCompletionMessage\", () => {\n    it(\"should return a completion message\", () => {\n      const message = getCompletionMessage();\n      expect([\"Heard.\", \"Service.\", \"All set.\", \"Done, Chef.\"]).toContain(message);\n    });\n\n    it(\"should return different messages over multiple calls\", () => {\n      const messages = new Set();\n      for (let i = 0; i < 20; i++) {\n        messages.add(getCompletionMessage());\n      }\n      // With randomness, we should get at least 2 different messages\n      expect(messages.size).toBeGreaterThan(1);\n    });\n  });\n});"
