        "language": "typescript",
        "code": "// test: use-action-cards.test.ts\n\ndescribe(\"useActionCards\", () => {\n  it(\"should return empty cards when snapshot is null\", () => {\n    const { result } = renderHook(() => useActionCards(null));\n    expect(result.current.cards).toEqual([]);\n    expect(result.current.unreadCount).toBe(0);\n  });\n\n  it(\"should ignore logs without module/action kvps\", () => {\n    const snapshot = {\n      logs: [\n        { id: \"1\", type: \"tool\", kvps: {}, content: \"test\", timestamp: 1000 },\n        { id: \"2\", type: \"tool\", kvps: { module: \"test\" }, content: \"test\", timestamp: 1001 }\n      ]\n    } as A0Snapshot;\n    const { result } = renderHook(() => useActionCards(snapshot));\n    expect(result.current.cards).toEqual([]);\n  });\n\n  it(\"should not process duplicate log IDs\", () => {\n    // First render with log ID \"1\"\n    // Second render with same log ID \"1\"\n    // Verify card only added once\n  });\n\n  it(\"should mark specific card as read\", () => {\n    // Setup with unread cards\n    // Call markRead with specific ID\n    // Verify only that card is marked read\n  });\n\n  it(\"should mark all cards as read\", () => {\n    // Setup with multiple unread cards\n    // Call markAllRead\n    // Verify all cards marked read\n  });\n\n  it(\"should handle markRead with non-existent ID gracefully\", () => {\n    const { result } = renderHook(() => useActionCards(mockSnapshot));\n    act(() => result.current.markRead(\"non-existent\"));\n    // Should not throw, cards unchanged\n  });\n\n  it(\"should calculate unreadCount correctly\", () => {\n    // Setup with mix of read/unread cards\n    // Verify count matches unread cards\n  });\n});"
