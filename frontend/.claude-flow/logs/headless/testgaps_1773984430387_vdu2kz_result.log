      content: \"test\",\n        kvps: {},\n        timestamp: 1000,\n        agentno: 0\n      };\n      \n      const message = getExpoMessage(log);\n      expect(message).toContain(\"Delegating to\");\n    });\n\n    it(\"should return progress content\", () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: \"1\",\n        type: \"progress\",\n        heading: \"\",\n        content: \"Calculating food costs...\",\n        kvps: {},\n        timestamp: 1000,\n        agentno: 0\n      };\n      \n      const message = getExpoMessage(log);\n      expect(message).toBe(\"Calculating food costs...\");\n    });\n\n    it(\"should return null for non-relevant log types\", () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: \"1\",\n        type: \"user\",\n        heading: \"\",\n        content: \"test\",\n        kvps: {},\n        timestamp: 1000,\n        agentno: 0\n      };\n      \n      expect(getExpoMessage(log)).toBeNull();\n    });\n\n    // Coverage for all tool names\n    const tools = [\n      \"food_cost_tool\", \"inventory_tool\", \"prep_tool\", \"order_tool\",\n      \"recipe_tool\", \"reporting_tool\", \"invoice_tool\", \"marketing_tool\",\n      \"menu_tool\"\n    ];\n\n    tools.forEach(tool => {\n      it(`should have message for ${tool}`, () => {\n        const log: A0LogEntry = {\n          no: 1,\n          id: \"1\",\n          type: \"tool\",\n          heading: `Using ${tool}...`,\n          content: \"test\",\n          kvps: {},\n          timestamp: 1000,\n          agentno: 0\n        };\n        \n        const message = getExpoMessage(log);\n        expect(message).toBeTruthy();\n      });\n    });\n  });\n\n  describe(\"getCompletionMessage\", () => {\n    it(\"should return a completion message\", () => {\n      const message = getCompletionMessage();\n      expect([\"Heard.\", \"Service.\", \"All set.\", \"Done, Chef.\"]).toContain(message);\n    });\n\n    it(\"should return different messages over