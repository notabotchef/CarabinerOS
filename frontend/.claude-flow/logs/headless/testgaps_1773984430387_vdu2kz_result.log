  await waitFor(() => expect(mockGetCsrfToken).toHaveBeenCalled());\n  });\n\n  it(\"should handle auth callback CSRF failure\", async () => {\n    const mockGetCsrfToken = jest.fn(() => Promise.reject(new Error(\"CSRF failed\")));\n    jest.mock(\"@/lib/csrf\", () => ({\n      getCsrfToken: mockGetCsrfToken\n    }));\n    \n    const socket = initStateSyncSocket();\n    \n    const authCb = jest.fn();\n    socket.io.opts.auth(authCb);\n    \n    await waitFor(() => expect(authCb).toHaveBeenCalledWith({}));\n  });\n\n  it(\"should clear CSRF token on connect_error\", () => {\n    const mockClearCsrfToken = jest.fn();\n    jest.mock(\"@/lib/csrf\", () => ({\n      clearCsrfToken: mockClearCsrfToken\n    }));\n    \n    const socket = initStateSyncSocket();\n    \n    socket.emit(\"connect_error\");\n    \n    expect(mockClearCsrfToken).toHaveBeenCalled();\n  });\n\n  it(\"should return null initially from getStateSyncSocket\", () => {\n    expect(getStateSyncSocket()).toBeNull();\n  });\n\n  it(\"should return socket after init\", () => {\n    initStateSyncSocket();\n    expect(getStateSyncSocket()).not.toBeNull();\n  });\n\n  it(\"should disconnect socket on disconnectAll\", () => {\n    const socket = initStateSyncSocket();\n    const disconnectSpy = jest.spyOn(socket, \"disconnect\");\n    \n    disconnectAll();\n    \n    expect(disconnectSpy).toHaveBeenCalled();\n    expect(getStateSyncSocket()).toBeNull();\n  });\n\n  it(\"should handle disconnectAll when socket is null\", () => {\n    // Should not throw\n    expect(() => disconnectAll()).not.toThrow();\n  });\n\n  it(\"should use NEXT_PUBLIC_A0_URL if set\", () => {\n    process.env.NEXT_PUBLIC_A0_URL = \"http://localhost:5000\";\n    \n    const socket = initStateSyncSocket();\n    \n    expect(socket.io.uri).toContain(\"localhost:5000\");\n  });\n});\n```\n\n---\n\n## 10. `src/lib/utils.ts`\n\n### Identified Gaps\n\n| Gap Type | Description |\n|----------|-------------|\n| **Unit Test** | No arguments |\n| **Unit Test** | Null/undefined values |\n| **Unit Test** | Mixed class values |\n| **Integration** | clsx + twMerge behavior |\n\n### Test Skeletons\n\n```typescript\n// test: utils.test.ts\n\ndescribe(\"cn utility\", () => {\n  it(\"should merge class names\", () => {\n    expect(cn(\"foo\", \"bar\")).toBe(\"foo bar\");\n  });\n\n  it(\"should handle conditional classes\", () => {\n    expect(cn(\"foo\", false && \"bar\", \"baz\")).toBe(\"foo baz\");\n  });\n\n  it(\"should handle no arguments\", () => {\n    expect(cn()).toBe(\"\");\n  });\n\n  it(\"should handle undefined values\", () => {\n    expect(cn(\"foo\", undefined, \"bar\")).toBe(\"foo bar\");\n  });\n\n  it(\"should handle null values\", () => {\n    expect(cn(\"foo\", null, \"bar\")).toBe(\"foo bar\");\n  });\n\n  it(\"should merge tailwind conflicting classes\", () => {\n    // twMerge should handle this\n    expect(cn(\"px-2\", \"px-4\")).toBe(\"px-4\");\n  });\n\n  it(\"should handle array of classes\", () => {\n    expect(cn([\"foo\", \"bar\"])).toBe(\"foo bar\");\n  });\n\n  it(\"should handle object notation\", () => {\n    expect(cn({ foo: true, bar: false })).toBe(\"foo\");\n  });\n\n  it(\"should handle mixed inputs\", () => {\n    expect(cn(\n      \"base\",\n      [\"array-1\", \"array-2\"],\n      { conditional: true, skipped: false },\n      undefined,\n      \"final\"\n    )).toBeTruthy();\n  });\n});\n```\n\n---\n\n## Critical Integration Tests\n\n### Cross-Module Tests\n\n```typescript\n// test: integration.test.ts\n\ndescribe(\"Socket + Chat Integration\", () => {\n  it(\"should sync chat messages from socket events\", () => {\n    // Test full flow: socket state_push → useChat → messages array\n  });\n\n  it(\"should handle context switching\", () => {\n    // Test: send message → get context → subscribe → new messages\n  });\n});\n\ndescribe(\"Expo Stream + Socket Integration\", () => {\n  it(\"should show correct expo bar state from chef_status\", () => {\n    // Test: chef_status e