        "language": "typescript",
        "code": "// test: csrf.test.ts\n\ndescribe(\"csrf\", () => {\n  beforeEach(() => {\n    clearCsrfToken();\n    jest.clearAllMocks();\n  });\n\n  it(\"should fetch and cache CSRF token\", async () => {\n    global.fetch = jest.fn(() =>\n      Promise.resolve({\n        ok: true,\n        json: () => Promise.resolve({ \n          ok: true, \n          token: \"test-token\", \n          runtime_id: \"runtime-123\" \n        })\n      })\n    );\n    \n    const token = await getCsrfToken();\n    \n    expect(token).toBe(\"test-token\");\n    expect(global.fetch).toHaveBeenCalledTimes(1);\n    \n    // Second call should use cache\n    const token2 = await getCsrfToken();\n    expect(token2).toBe(\"test-token\");\n    expect(global.fetch).toHaveBeenCalledTimes(1);\n  });\n\n  it(\"should handle concurrent getCsrfToken calls\", async () => {\n    global.fetch = jest.fn(() =>\n      Promise.resolve({\n        ok: true,\n        json: () => Promise.resolve({ \n          ok: true, \n          token: \"test-token\", \n          runtime_id: \"runtime-123\" \n        })\n      })\n    );\n    \n    // Call multiple times concurrently\n    const [token1, token2, token3] = await Promise.all([\n      getCsrfToken(),\n      getCsrfToken(),\n      getCsrfToken()\n    ]);\n    \n    expect(token1).toBe(\"test-token\");\n    expect(token2).toBe(\"test-token\");\n    expect(token3).toBe(\"test-token\");\n    // Should only fetch once due to promise caching\n    expect(global.fetch).toHaveBeenCalledTimes(1);\n  });\n\n  it(\"should handle server error (ok: false)\", async () => {\n    global.fetch = jest.fn(() =>\n      Promise.resolve({\n        ok: true,\n        json: () => Promise.resolve({ \n          ok: false, \n          error: \"Invalid session\" \n        })\n      })\n    );\n    \n    await expect(getCsrfToken()).rejects.toThrow(\"Invalid session\");\n  });\n\n  it(\"should handle network failure\", async () => {\n    global.fetch = jest.fn(() => Promise.reject(new Error(\"Network error\")));\n    \n    await expect(getCsrfToken()).rejects.toThrow(\"Network error\");\n  });\n\n  it(\"should set cookie with correct format\", async () => {\n    global.fetch = jest.fn(() =>\n      Promise.resolve({\n        ok: true,\n        json: () => Promise.resolve({ \n          ok: true, \n          token: \"test-token\", \n          runtime_id: \"runtime-123\" \n        })\n      })\n    );\n    \n    document.cookie = \"\";\n    await getCsrfToken();\n    \n    expect(document.cookie).toContain(\"csrf_token_runtime-123=test-token\");\n    expect(document.cookie).toContain(\"SameSite=Strict\");\n    expect(document.cookie).toContain(\"Path=/\");\n  });\n\n  it(\"should return runtimeId after successful fetch\", async () => {\n    global.fetch = jest.fn(() =>\n      Promise.resolve({\n        ok: true,\n        json: () => Promise.resolve({ \n          ok: true, \n          token: \"test-token\", \n          runtime_id: \"runtime-123\" \n        })\n      })\n    );\n    \n    await getCsrfToken();\n    \n    expect(getRuntimeId()).toBe(\"runtime-123\");\n  });\n\n  it(\"should clear token and runtimeId\", async () => {\n    global.fetch = jest.fn(() =>\n      Promise.resolve({\n        ok: true,\n        json: () => Promise.resolve({ \n          ok: true, \n          token: \"test-token\", \n          runtime_id: \"runtime-123\" \n        })\n      })\n    );\n    \n    await getCsrfToken();\n    expect(getRuntimeId()).toBe(\"runtime-123\");\n    \n    clearCsrfToken();\n    \n    expect(getRuntimeId()).toBeNull();\n  });\n\n  it(\"should refetch after clearCsrfToken\", async () => {\n    global.fetch = jest.fn(() =>\n      Promise.resolve({\n        ok: true,\n        json: () => Promise.resolve({ \n          ok: true, \n          token: \"test-token\", \n          runtime_id: \"runtime-123\" \n        })\n      })\n    );\n    \n    await getCsrfToken();\n    clearCsrfToken();\n    await getCsrfToken();\n    \n    expect(global.fetch).toHaveBeenCalledTimes(2);\n  });\n});"
