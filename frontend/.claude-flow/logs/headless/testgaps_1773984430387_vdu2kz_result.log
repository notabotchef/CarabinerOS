        "language": "typescript",
        "code": "// test: use-expo-stream.test.ts\n\ndescribe(\"useExpoStream\", () => {\n  it(\"should return inactive state when both inputs are null\", () => {\n    const { result } = renderHook(() => useExpoStream(null, null));\n    expect(result.current).toEqual({ text: null, active: false });\n  });\n\n  it(\"should show active state when chefStatus is active\", () => {\n    const chefStatus = { active: true, text: \"Working...\", status: \"working\" };\n    const { result } = renderHook(() => useExpoStream(null, chefStatus));\n    expect(result.current.active).toBe(true);\n    expect(result.current.text).toBe(\"Working...\");\n  });\n\n  it(\"should clear text after 3s when status becomes inactive\", async () => {\n    jest.useFakeTimers();\n    const { result, rerender } = renderHook(\n      ({ status }) => useExpoStream(null, status),\n      { initialProps: { status: { active: true, text: \"Working...\", status: \"working\" } } }\n    );\n    \n    rerender({ status: { active: false, text: \"Done\", status: \"completed\" } });\n    \n    jest.advanceTimersByTime(3000);\n    expect(result.current.text).toBeNull();\n  });\n\n  it(\"should cleanup timers on unmount\", () => {\n    jest.useFakeTimers();\n    const { unmount } = renderHook(() => \n      useExpoStream(null, { active: false, text: \"Done\", status: \"completed\" })\n    );\n    \n    unmount();\n    jest.advanceTimersByTime(3000);\n    // Should not cause memory leak or state update\n  });\n\n  it(\"should fallback to snapshot progress when no chefStatus\", () => {\n    const snapshot = {\n      log_progress_active: true,\n      log_progress: \"icon://chat A0: Responding\"\n    } as A0Snapshot;\n    \n    const { result } = renderHook(() => useExpoStream(snapshot, null));\n    expect(result.current.active).toBe(true);\n    expect(result.current.text).not.toContain(\"icon://\");\n  });\n});\n\ndescribe(\"cleanProgressText\", () => {\n  it(\"should remove icon:// prefix\", () => {\n    expect(cleanProgressText(\"icon://chat A0: Responding\")).toBe(\"Responding\");\n  });\n\n  it(\"should remove agent name prefix\", () => {\n    expect(cleanProgressText(\"A0: Working on it\")).toBe(\"Working on it\");\n    expect(cleanProgressText(\"A1: Processing\")).toBe(\"Processing\");\n  });\n\n  it(\"should return fallback for empty string\", () => {\n    expect(cleanProgressText(\"\")).toBe(\"Working...\");\n  });\n\n  it(\"should handle text with no prefixes\", () => {\n    expect(cleanProgressText(\"Just working\")).toBe(\"Just working\");\n  });\n});"
      },
