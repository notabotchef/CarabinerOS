        "title": "Test Skeletons",
        "content": "\n```typescript\n// test: socket-client.test.ts\n\ndescribe(\"socket-client\", () => {\n  beforeEach(() => {\n    disconnectAll();\n    jest.clearAllMocks();\n  });\n\n  it(\"should create socket singleton\", () => {\n    const socket1 = initStateSyncSocket();\n    const socket2 = initStateSyncSocket();\n    \n    expect(socket1).toBe(socket2);\n  });\n\n  it(\"should initialize with polling transport first\", () => {\n    const socket = initStateSyncSocket();\n    \n    expect(socket.io.opts.transports).toEqual([\"polling\", \"websocket\"]);\n  });\n\n  it(\"should set withCredentials to true\", () => {\n    const socket = initStateSyncSocket();\n    \n    expect(socket.io.opts.withCredentials).toBe(true);\n  });\n\n  it(\"should start with autoConnect false\", () => {\n    const socket = initStateSyncSocket();\n    \n    expect(socket.io.opts.autoConnect).toBe(false);\n  });\n\n  it(\"should call auth callback on connect\", async () => {\n    const mockGetCsrfToken = jest.fn(() => Promise.resolve(\"test-token\"));\n    jest.mock(\"@/lib/csrf\", () => ({\n      getCsrfToken: mockGetCsrfToken\n    }));\n    \n    const socket = initStateSyncSocket();\n    \n    // Simulate connect\n    const authCb = jest.fn();\n    socket.io.opts.auth(authCb);\n    \n    await waitFor(() => expect(mockGetCsrfToken).toHaveBeenCalled());\n  });\n\n  it(\"should handle auth callback CSRF failure\", async () => {\n    const mockGetCsrfToken = jest.fn(() => Promise.reject(new Error(\"CSRF failed\")));\n    jest.mock(\"@/lib/csrf\", () => ({\n      getCsrfToken: mockGetCsrfToken\n    }));\n    \n    const socket = initStateSyncSocket();\n    \n    const authCb = jest.fn();\n    socket.io.opts.auth(authCb);\n    \n    await waitFor(() => expect(authCb).toHaveBeenCalledWith({}));\n  });\n\n  it(\"should clear CSRF token on connect_error\", () => {\n    const mockClearCsrfToken = jest.fn();\n    jest.mock(\"@/lib/csrf\", () => ({\n      clearCsrfToken: mockClearCsrfToken\n    }));\n    \n    const socket = initStateSyncSocket();\n    \n    socket.emit(\"connect_error\");\n    \n    expect(mockClearCsrfToken).toHaveBeenCalled();\n  });\n\n  it(\"should return null initially from getStateSyncSocket\", () => {\n    expect(getStateSyncSocket()).toBeNull();\n  });\n\n  it(\"should return socket after init\", () => {\n    initStateSyncSocket();\n    expect(getStateSyncSocket()).not.toBeNull();\n  });\n\n  it(\"should disconnect socket on disconnectAll\", () => {\n    const socket = initStateSyncSocket();\n    const disconnectSpy = jest.spyOn(socket, \"disconnect\");\n    \n    disconnectAll();\n    \n    expect(disconnectSpy).toHaveBeenCalled();\n    expect(getStateSyncSocket()).toBeNull();\n  });\n\n  it(\"should handle disconnectAll when socket is null\", () => {\n    // Should not throw\n    expect(() => disconnectAll()).not.toThrow();\n  });\n\n  it(\"should use NEXT_PUBLIC_A0_URL if set\", () => {\n    process.env.NEXT_PUBLIC_A0_URL = \"http://localhost:5000\";\n    \n    const socket = initStateSyncSocket();\n    \n    expect(socket.io.uri).toContain(\"localhost:5000\");\n  });\n});\n```\n\n---\n\n",
