      {
        "language": "typescript",
        "code": "// test: use-chat.test.ts\n\ndescribe(\"useChat\", () => {\n  it(\"should add user message immediately when sending\", async () => {\n    const { result } = renderHook(() => useChat(null));\n    await act(async () => {\n      await result.current.sendMessage(\"test\");\n    });\n    expect(result.current.messages).toContainEqual(\n      expect.objectContaining({ role: \"user\", content: \"test\" })\n    );\n  });\n\n  it(\"should queue messages when already processing\", async () => {\n    const { result } = renderHook(() => useChat(null));\n    // Send first message (starts processing)\n    act(() => { result.current.sendMessage(\"msg1\"); });\n    // Send second message (should queue)\n    act(() => { result.current.sendMessage(\"msg2\"); });\n    \n    expect(result.current.queuedMessages).toContain(\"msg2\");\n  });\n\n  it(\"should handle network timeout gracefully\", async () => {\n    // Mock fetch to timeout\n    global.fetch = jest.fn(() => new Promise((_, reject) => \n      setTimeout(() => reject(new Error(\"timeout\")), 100)\n    ));\n    \n    const { result } = renderHook(() => useChat(null));\n    await act(async () => {\n      await result.current.sendMessage(\"test\");\n    });\n    \n    expect(result.current.messages).toContainEqual(\n      expect.objectContaining({ \n        role: \"assistant\", \n        content: expect.stringContaining(\"Can't reach the kitchen\")\n      })\n    );\n  });\n\n  it(\"should handle 500 server error\", async () => {\n    global.fetch = jest.fn(() => \n      Promise.resolve({ ok: false, status: 500 })\n    );\n    \n    const { result } = renderHook(() => useChat(null));\n    await act(async () => {\n      await result.current.sendMessage(\"test\");\n    });\n    \n    expect(result.current.loading).toBe(false);\n  });\n\n  it(\"should handle malformed JSON response\", async () => {\n    global.fetch = jest.fn(() => \n      Promise.resolve({ \n        ok: true, \n        json: () => Promise.reject(new Error(\"Invalid JSON\"))\n      })\n    );\n    \n    // Should not crash, should show error message\n  });\n\n  it(\"should reset chat and ignore stale logs\", () => {\n    const { result } = renderHook(() => useChat(mockSnapshot));\n    act(() => result.current.resetChat());\n    \n    expect(result.current.messages).toEqual([]);\n    expect(result.current.contextId).toBeNull();\n    // freshChatRef should prevent old snapshot logs from being ingested\n  });\n\n  it(\"should process queued messages after loading completes\", async () => {\n    // Send message while processing\n    // Verify queued message is sent after first completes\n  });\n\n  it(\"should handle log entries with null IDs using fallback key\", () => {\n    const snapshot = {\n      logs: [\n        { id: null, no: 1, type: \"user\", content: \"test\", timestamp: 1000 }\n      ]\n    } as A0Snapshot;\n    \n    const { result } = renderHook(() => useChat(snapshot));\n    // Should create message with fallback key \"no-1\"\n    expect(result.current.messages.length).toBe(1);\n  });\n});"
      },
