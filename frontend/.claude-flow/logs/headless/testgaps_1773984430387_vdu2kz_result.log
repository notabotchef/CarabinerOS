        "content": "\n```typescript\n// test: use-workspace.test.ts\n\ndescribe(\"useWorkspace\", () => {\n  it(\"should fetch and parse array response\", async () => {\n    global.fetch = jest.fn(() =>\n      Promise.resolve({\n        ok: true,\n        json: () => Promise.resolve([{ id: 1 }, { id: 2 }])\n      })\n    );\n    \n    const { result } = renderHook(() => useWorkspace(\"/api/test\"));\n    \n    await waitFor(() => expect(result.current.loading).toBe(false));\n    expect(result.current.data).toEqual([{ id: 1 }, { id: 2 }]);\n    expect(result.current.error).toBeNull();\n  });\n\n  it(\"should handle 404 error\", async () => {\n    global.fetch = jest.fn(() =>\n      Promise.resolve({ ok: false, status: 404 })\n    );\n    \n    const { result } = renderHook(() => useWorkspace(\"/api/test\"));\n    \n    await waitFor(() => expect(result.current.loading).toBe(false));\n    expect(result.current.error).toBe(\"404\");\n    expect(result.current.data).toEqual([]);\n  });\n\n  it(\"should handle network timeout\", async () => {\n    global.fetch = jest.fn(() => \n      new Promise((_, reject) => \n        setTimeout(() => reject(new Error(\"timeout\")), 100)\n      )\n    );\n    \n    const { result } = renderHook(() => useWorkspace(\"/api/test\"));\n    \n    await waitFor(() => expect(result.current.loading).toBe(false));\n    expect(result.current.error).toBe(\"timeout\");\n  });\n\n  it(\"should parse response with items property\", async () => {\n    global.fetch = jest.fn(() =>\n      Promise.resolve({\n        ok: true,\n        json: () => Promise.resolve({ items: [{ id: 1 }] })\n      })\n    );\n    \n    const { result } = renderHook(() => useWorkspace(\"/api/test\"));\n    \n    await waitFor(() => expect(result.current.data).toEqual([{ id: 1 }]));\n  });\n\n  it(\"should parse response with data property\", async () => {\n    global.fetch = jest.fn(() =>\n      Promise.resolve({\n        ok: true,\n        json: () => Promise.resolve({ data: [{ id: 1 }] })\n      })\n    );\n    \n    const { result } = renderHook(() => useWorkspace(\"/api/test\"));\n    \n    await waitFor(() => expect(result.current.data).toEqual([{ id: 1 }]));\n  });\n\n  it(\"should include locationId in query string\", async () => {\n    global.fetch = jest.fn(() =>\n      Promise.resolve({ ok: true, json: () => Promise.resolve([]) })\n    );\n    \n    renderHook(() => useWorkspace(\"/api/test\", \"loc-123\"));\n    \n    expect(global.fetch).toHaveBeenCalledWith(\n      \"/api/test?location_id=loc-123\",\n      expect.any(Object)\n    );\n  });\n\n  it(\"should refetch on refresh\", async () => {\n    global.fetch = jest.fn(() =>\n      Promise.resolve({ ok: true, json: () => Promise.resolve([]) })\n    );\n    \n    const { result } = renderHook(() => useWorkspace(\"/api/test\"));\n    \n    await waitFor(() => expect(result.current.loading).toBe(false));\n    expect(global.fetch).toHaveBeenCalledTimes(1);\n    \n    act(() => result.current.refresh());\n    \n    await waitFor(() => expect(global.fetch).toHaveBeenCalledTimes(2));\n  });\n\n  it(\"should handle rapid refresh calls\", async () => {\n    // Test race condition when refresh called multiple times quickly\n  });\n\n  it(\"should handle locationId change during active fetch\", async () => {\n    // Test what happens when locationId prop changes before fetch completes\n  });\n});\n```\n\n---\n\n",
