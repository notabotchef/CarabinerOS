        "title": "Test Skeletons",
        "content": "\n```typescript\n// __tests__/lib/socket-client.test.ts\n\nimport { initStateSyncSocket, getStateSyncSocket, disconnectAll } from '@/lib/socket-client';\nimport { getCsrfToken, clearCsrfToken } from '@/lib/csrf';\nimport { io } from 'socket.io-client';\n\njest.mock('socket.io-client');\njest.mock('@/lib/csrf');\n\ndescribe('socket-client', () => {\n  let mockSocket: any;\n\n  beforeEach(() => {\n    mockSocket = {\n      on: jest.fn(),\n      disconnect: jest.fn(),\n    };\n    (io as jest.Mock).mockReturnValue(mockSocket);\n    (getCsrfToken as jest.Mock).mockResolvedValue('token');\n  });\n\n  afterEach(() => {\n    disconnectAll();\n  });\n\n  test('should initialize socket with correct config', () => {\n    initStateSyncSocket();\n    \n    expect(io).toHaveBeenCalledWith(\n      expect.stringContaining('/state_sync'),\n      expect.objectContaining({\n        autoConnect: false,\n        transports: ['polling', 'websocket'],\n        withCredentials: true,\n      })\n    );\n  });\n\n  test('should return same socket instance on multiple calls', () => {\n    const s1 = initStateSyncSocket();\n    const s2 = initStateSyncSocket();\n    expect(s1).toBe(s2);\n  });\n\n  test('should call getCsrfToken in auth callback', async () => {\n    initStateSyncSocket();\n    const authFn = (io as jest.Mock).mock.calls[0][1].auth;\n    \n    const mockCb = jest.fn();\n    await authFn(mockCb);\n    \n    expect(getCsrfToken).toHaveBeenCalled();\n    expect(mockCb).toHaveBeenCalledWith({ csrf_token: 'token' });\n  });\n\n  test('should handle CSRF fetch failure in auth', async () => {\n    (getCsrfToken as jest.Mock).mockRejectedValue(new Error('Fetch failed'));\n    \n    initStateSyncSocket();\n    const authFn = (io as jest.Mock).mock.calls[0][1].auth;\n    \n    const mockCb = jest.fn();\n    await authFn(mockCb);\n    \n    expect(mockCb).toHaveBeenCalledWith({});\n  });\n\n  test('should clear CSRF token on connect_error', () => {\n    initStateSyncSocket();\n    \n    const errorHandler = mockSocket.on.mock.calls.find(\n      (call: any) => call[0] === 'connect_error'\n    )[1];\n    \n    errorHandler();\n    expect(clearCsrfToken).toHaveBeenCalled();\n  });\n\n  test('should disconnect socket on disconnectAll', () => {\n    initStateSyncSocket();\n    disconnectAll();\n    expect(mockSocket.disconnect).toHaveBeenCalled();\n    expect(getStateSyncSocket()).toBeNull();\n  });\n\n  test('should use NEXT_PUBLIC_A0_URL from env', () => {\n    process.env.NEXT_PUBLIC_A0_URL = 'http://custom:5000';\n    initStateSyncSocket();\n    \n    expect(io).toHaveBeenCalledWith(\n      'http://custom:5000/state_sync',\n      expect.anything()\n    );\n  });\n});\n```\n\n---\n\n",
