        "title": "Test Skeletons",
        "content": "\n```typescript\n// __tests__/lib/csrf.test.ts\n\nimport { getCsrfToken, getRuntimeId, clearCsrfToken } from '@/lib/csrf';\n\nglobal.fetch = jest.fn();\n\ndescribe('csrf', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n    // Clear module state\n    clearCsrfToken();\n    document.cookie = '';\n  });\n\n  test('should fetch CSRF token on first call', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'token-1', runtime_id: 'rt-1' }),\n    });\n    \n    const token = await getCsrfToken();\n    expect(token).toBe('token-1');\n    expect(global.fetch).toHaveBeenCalledTimes(1);\n  });\n\n  test('should cache token and not refetch', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'token-1', runtime_id: 'rt-1' }),\n    });\n    \n    await getCsrfToken();\n    const token2 = await getCsrfToken();\n    \n    expect(token2).toBe('token-1');\n    expect(global.fetch).toHaveBeenCalledTimes(1);\n  });\n\n  test('should deduplicate concurrent calls', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'token-1', runtime_id: 'rt-1' }),\n    });\n    \n    const [t1, t2, t3] = await Promise.all([\n      getCsrfToken(),\n      getCsrfToken(),\n      getCsrfToken(),\n    ]);\n    \n    expect(t1).toBe('token-1');\n    expect(t2).toBe('token-1');\n    expect(t3).toBe('token-1');\n    expect(global.fetch).toHaveBeenCalledTimes(1);\n  });\n\n  test('should set cookie with runtime_id', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'token-1', runtime_id: 'rt-1' }),\n    });\n    \n    await getCsrfToken();\n    expect(document.cookie).toContain('csrf_token_rt-1=token-1');\n  });\n\n  test('should throw error when response not ok', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: false, error: 'Failed' }),\n    });\n    \n    await expect(getCsrfToken()).rejects.toThrow('Failed');\n  });\n\n  test('should clear cached token on clearCsrfToken', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'token-1', runtime_id: 'rt-1' }),\n    });\n    \n    await getCsrfToken();\n    clearCsrfToken();\n    \n    expect(getRuntimeId()).toBeNull();\n  });\n\n  test('should return null for getRuntimeId when not initialized', () => {\n    expect(getRuntimeId()).toBeNull();\n  });\n\n  test('should return runtime_id after fetch', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'token-1', runtime_id: 'rt-1' }),\n    });\n    \n    await getCsrfToken();\n    expect(getRuntimeId()).toBe('rt-1');\n  });\n});\n```\n\n---\n\n",
