        "code": "// __tests__/lib/expo-messages.test.ts\nimport { getExpoMessage, getCompletionMessage } from '@/lib/expo-messages';\nimport type { A0LogEntry } from '@/lib/types';\n\ndescribe('expo-messages', () => {\n  describe('getExpoMessage', () => {\n    it('should return tool-specific message for known tools', () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: 'log-1',\n        type: 'tool',\n        heading: 'Using food_cost_tool...',\n        content: '',\n        kvps: {},\n        timestamp: 1000,\n        agentno: 0,\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBeTruthy();\n      expect(message).toMatch(/food|cost|produce|avocado/i);\n    });\n\n    it('should return default message for unknown tools', () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: 'log-1',\n        type: 'tool',\n        heading: 'Using unknown_tool...',\n        content: '',\n        kvps: {},\n        timestamp: 1000,\n        agentno: 0,\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBeTruthy();\n      expect(['Working on it...', 'One moment...', 'On it, Chef...']).toContain(message);\n    });\n\n    it('should return agent delegation message for agent logs', () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: 'log-1',\n        type: 'agent',\n        heading: 'Food Cost Analyst',\n        content: '',\n        kvps: {},\n        timestamp: 1000,\n        agentno: 1,\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBe('Delegating to Food Cost Analyst...');\n    });\n\n    it('should return delegation message for subagent logs', () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: 'log-1',\n        type: 'subagent',\n        heading: 'Inventory Checker',\n        content: '',\n        kvps: {},\n        timestamp: 1000,\n        agentno: 2,\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBe('Delegating to Inventory Checker...');\n    });\n\n    it('should return content for progress logs', () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: 'log-1',\n        type: 'progress',\n        heading: '',\n        content: 'Processing invoice 3 of 10...',\n        kvps: {},\n        timestamp: 1000,\n        agentno: 0,\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBe('Processing invoice 3 of 10...');\n    });\n\n    it('should return null for non-relevant log types', () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: 'log-1',\n        type: 'user',\n        heading: '',\n        content: 'User message',\n        kvps: {},\n        timestamp: 1000,\n        agentno: 0,\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBeNull();\n    });\n\n    it('should handle missing heading gracefully', () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: 'log-1',\n        type: 'agent',\n        heading: '',\n        content: '',\n        kvps: {},\n        timestamp: 1000,\n        agentno: 1,\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBe('Delegating to a specialist...');\n    });\n\n    it('should handle null log gracefully', () => {\n      const message = getExpoMessage(null as any);\n      expect(message).toBeNull();\n    });\n  });\n\n  describe('getCompletionMessage', () => {\n    it('should return one of the completion messages', () => {\n      const message = getCompletionMessage();\n\n      expect(['Heard.', 'Service.', 'All set.', 'Done, Chef.']).toContain(message);\n    });\n\n    it('should randomize completion messages', () => {\n      const messages = new Set<string>();\n      \n      for (let i = 0; i < 50; i++) {\n        messages.add(getCompletionMessage());\n      }\n\n      // With 50 calls, we should see at least 2 different messages\n      expect(messages.size).toBeGreaterThan(1);\n    });\n  });\n});"
