        "title": "Missing Edge Cases",
        "content": "- Socket connection failures\n- Malformed state_push data\n- Missing snapshot in envelope\n- CSRF token failures\n- Rapid subscribe calls\n- Connect/disconnect cycles\n\n",
        "level": 3
      },
      {
        "title": "Test Skeletons",
        "content": "\n```typescript\n// __tests__/hooks/use-socket.test.ts\nimport { renderHook, act } from '@testing-library/react';\nimport { useSocket } from '@/hooks/use-socket';\nimport * as socketClient from '@/lib/socket-client';\nimport * as csrfModule from '@/lib/csrf';\nimport { EventEmitter } from 'events';\n\njest.mock('@/lib/socket-client');\njest.mock('@/lib/csrf');\n\nclass MockSocket extends EventEmitter {\n  connected = false;\n  connect = jest.fn(() => { this.connected = true; });\n  disconnect = jest.fn(() => { this.connected = false; });\n  emit = jest.fn();\n  off = jest.fn();\n}\n\ndescribe('useSocket', () => {\n  let mockSocket: MockSocket;\n\n  beforeEach(() => {\n    mockSocket = new MockSocket();\n    (socketClient.initStateSyncSocket as jest.Mock).mockReturnValue(mockSocket);\n    (socketClient.getStateSyncSocket as jest.Mock).mockReturnValue(mockSocket);\n    (csrfModule.getCsrfToken as jest.Mock).mockResolvedValue('test-token');\n  });\n\n  afterEach(() => {\n    jest.clearAllMocks();\n  });\n\n  it('should initialize socket on mount', () => {\n    renderHook(() => useSocket());\n    expect(socketClient.initStateSyncSocket).toHaveBeenCalled();\n  });\n\n  it('should set connected to true on connect event', () => {\n    const { result } = renderHook(() => useSocket());\n    \n    act(() => {\n      mockSocket.emit('connect');\n    });\n    \n    expect(result.current.connected).toBe(true);\n  });\n\n  it('should emit state_request on connect', () => {\n    renderHook(() => useSocket());\n    \n    act(() => {\n      mockSocket.emit('connect');\n    });\n    \n    expect(mockSocket.emit).toHaveBeenCalledWith(\n      'state_request',\n      expect.objectContaining({\n        context: null,\n        log_from: 0,\n        notifications_from: 0,\n      })\n    );\n  });\n\n  it('should update snapshot on state_push event', () => {\n    const { result } = renderHook(() => useSocket());\n    \n    const mockSnapshot = {\n      context: 'ctx-1',\n      logs: [{ no: 1, id: 'log-1', type: 'response', content: 'Test', timestamp: 1000 }],\n      log_progress_active: false,\n    };\n    \n    act(() => {\n      mockSocket.emit('state_push', {\n        data: { snapshot: mockSnapshot },\n      });\n    });\n    \n    expect(result.current.snapshot).toMatchObject(mockSnapshot);\n  });\n\n  it('should handle state_push with missing snapshot', () => {\n    const { result } = renderHook(() => useSocket());\n    const consoleSpy = jest.spyOn(console, 'warn').mockImplementation();\n    \n    act(() => {\n      mockSocket.emit('state_push', { data: {} });\n    });\n    \n    expect(consoleSpy).toHaveBeenCalledWith(\n      expect.stringContaining('no snapshot'),\n      expect.anything()\n    );\n    expect(result.current.snapshot).toBeNull();\n    \n    consoleSpy.mockRestore();\n  });\n\n  it('should update chefStatus on chef_status event', () => {\n    const { result } = renderHook(() => useSocket());\n    \n    const mockStatus = {\n      status: 'working' as const,\n      text: 'Processing order',\n      active: true,\n    };\n    \n    act(() => {\n      mockSocket.emit('chef_status', mockStatus);\n    });\n    \n    expect(result.current.chefStatus).toEqual(mockStatus);\n  });\n\n  it('should subscribe to context', () => {\n    const { result } = renderHook(() => useSocket());\n    mockSocket.connected = true;\n    \n    act(() => {\n      result.current.subscribe('ctx-123');\n    });\n    \n    expect(mockSocket.emit).toHaveBeenCalledWith(\n      'state_request',\n      expect.objectContaining({\n        context: 'ctx-123',\n        log_from: 0,\n      })\n    );\n  });\n\n  it('should not subscribe when socket is disconnected', () => {\n    const { result } = renderHook(() => useSocket());\n    mockSocket.connected = false;\n    \n    act(() => {\n      result.current.subscribe('ctx-123');\n    });\n    \n    // Should not emit if not connected\n    const emitCalls = (mockSocket.emit as jest.Mock).mock.calls.filter(\n      ([event]) => event === 'state_request'\n    );\n    expect(emitCalls.length).toBe(0);\n  });\n\n  it('should disconnect socket on unmount', () => {\n    const { unmount } = renderHook(() => useSocket());\n    \n    unmount();\n    \n    expect(mockSocket.disconnect).toHaveBeenCalled();\n    expect(mockSocket.off).toHaveBeenCalledWith('connect');\n    expect(mockSocket.off).toHaveBeenCalledWith('disconnect');\n    expect(mockSocket.off).toHaveBeenCalledWith('state_push');\n    expect(mockSocket.off).toHaveBeenCalledWith('chef_status');\n  });\n\n  it('should handle CSRF token failure gracefully', async () => {\n    (csrfModule.getCsrfToken as jest.Mock).mockRejectedValue(new Error('CSRF failed'));\n    \n    renderHook(() => useSocket());\n    \n    // Should still attempt to connect even if CSRF fails\n    await act(async () => {\n      await new Promise(resolve => setTimeout(resolve, 0));\n    });\n    \n    expect(mockSocket.connect).toHaveBeenCalled();\n  });\n\n  it('should track logFromRef and increment on state_push', () => {\n    const { result } = renderHook(() => useSocket());\n    \n    const snapshot1 = {\n      logs: [{ no: 5, id: 'log-5', type: 'response', content: 'Test', timestamp: 1000 }],\n      log_progress_active: false,\n    };\n    \n    act(() => {\n      mockSocket.emit('state_push', { data: { snapshot: snapshot1 } });\n    });\n    \n    // Next subscribe should use log_from = 6 (last log.no + 1)\n    mockSocket.connected = true;\n    act(() => {\n      result.current.subscribe('ctx-new');\n    });\n    \n    // Note: logFromRef is internal, but we can verify by checking the emit call\n    // In a real implementation, this would be reset to 0 on subscribe\n    expect(mockSocket.emit).toHaveBeenCalledWith(\n      'state_request',\n      expect.objectContaining({\n        log_from: 0, // Reset on subscribe\n      })\n    );\n  });\n});\n```\n\n---\n\n",
