      {
        "title": "Test Skeletons",
        "content": "\n```typescript\n// __tests__/lib/csrf.test.ts\nimport { getCsrfToken, getRuntimeId, clearCsrfToken } from '@/lib/csrf';\n\nglobal.fetch = jest.fn();\n\ndescribe('csrf', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n    clearCsrfToken(); // Reset state\n    Object.defineProperty(document, 'cookie', {\n      writable: true,\n      value: '',\n    });\n  });\n\n  describe('getCsrfToken', () => {\n    it('should fetch and cache CSRF token', async () => {\n      (global.fetch as jest.Mock).mockResolvedValue({\n        json: async () => ({ ok: true, token: 'test-token', runtime_id: 'runtime-123' }),\n      });\n\n      const token = await getCsrfToken();\n\n      expect(token).toBe('test-token');\n      expect(global.fetch).toHaveBeenCalledWith('/csrf_token', { credentials: 'include' });\n    });\n\n    it('should return cached token on subsequent calls', async () => {\n      (global.fetch as jest.Mock).mockResolvedValue({\n        json: async () => ({ ok: true, token: 'cached-token', runtime_id: 'runtime-123' }),\n      });\n\n      const token1 = await getCsrfToken();\n      const token2 = await getCsrfToken();\n\n      expect(token1).toBe('cached-token');\n      expect(token2).toBe('cached-token');\n      expect(global.fetch).toHaveBeenCalledTimes(1); // Only fetched once\n    });\n\n    it('should handle concurrent calls with promise caching', async () => {\n      (global.fetch as jest.Mock).mockImplementation(() =>\n        new Promise(resolve =>\n          setTimeout(() => resolve({ json: async () => ({ ok: true, token: 'concurrent-token', runtime_id: 'runtime-123' }) }), 50)\n        )\n      );\n\n      const [token1, token2, token3] = await Promise.all([\n        getCsrfToken(),\n        getCsrfToken(),\n        getCsrfToken(),\n      ]);\n\n      expect(token1).toBe('concurrent-token');\n      expect(token2).toBe('concurrent-token');\n      expect(token3).toBe('concurrent-token');\n      expect(global.fetch).toHaveBeenCalledTimes(1); // Only one fetch\n    });\n\n    it('should throw error when response ok is false', async () => {\n      (global.fetch as jest.Mock).mockResolvedValue({\n        json: async () => ({ ok: false, error: 'Invalid request' }),\n      });\n\n      await expect(getCsrfToken()).rejects.toThrow('Invalid request');\n    });\n\n    it('should throw error when token is missing', async () => {\n      (global.fetch as jest.Mock).mockResolvedValue({\n        json: async () => ({ ok: true, runtime_id: 'runtime-123' }), // No token\n      });\n\n      await expect(getCsrfToken()).rejects.toThrow('Failed to get CSRF token');\n    });\n\n    it('should set cookie with correct format', async () => {\n      const setCookieSpy = jest.spyOn(document, 'cookie', 'set');\n      \n      (global.fetch as jest.Mock).mockResolvedValue({\n        json: async () => ({ ok: true, token: 'cookie-token', runtime_id: 'runtime-456' }),\n      });\n\n      await getCsrfToken();\n\n      expect(document.cookie).toContain('csrf_token_runtime-456=cookie-token');\n      expect(document.cookie).toContain('SameSite=Strict');\n      expect(document.cookie).toContain('Path=/');\n    });\n\n    it('should handle network errors', async () => {\n      (global.fetch as jest.Mock).mockRejectedValue(new Error('Network failure'));\n\n      await expect(getCsrfToken()).rejects.toThrow('Network failure');\n    });\n  });\n\n  describe('getRuntimeId', () => {\n    it('should return null initially', () => {\n      expect(getRuntimeId()).toBeNull();\n    });\n\n    it('should return runtime ID after getCsrfToken', async () => {\n      (global.fetch as jest.Mock).mockResolvedValue({\n        json: async () => ({ ok: true, token: 'token', runtime_id: 'runtime-789' }),\n      });\n\n      await getCsrfToken();\n\n      expect(getRuntimeId()).toBe('runtime-789');\n    });\n  });\n\n  describe('clearCsrfToken', () => {\n    it('should clear cached token and runtime ID', async () => {\n      (global.fetch as jest.Mock).mockResolvedValue({\n        json: async () => ({ ok: true, token: 'clear-token', runtime_id: 'runtime-clear' }),\n      });\n\n      await getCsrfToken();\n      expect(getRuntimeId()).toBe('runtime-clear');\n\n      clearCsrfToken();\n\n      expect(getRuntimeId()).toBeNull();\n\n      // Should fetch again after clearing\n      (global.fetch as jest.Mock).mockResolvedValue({\n        json: async () => ({ ok: true, token: 'new-token', runtime_id: 'runtime-new' }),\n      });\n\n      await getCsrfToken();\n      expect(global.fetch).toHaveBeenCalledTimes(2);\n    });\n  });\n});\n```\n\n---\n\n",
