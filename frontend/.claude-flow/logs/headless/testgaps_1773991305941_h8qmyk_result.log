        "content": "\n```typescript\n// __tests__/hooks/use-chat.test.ts\nimport { renderHook, act, waitFor } from '@testing-library/react';\nimport { useChat } from '@/hooks/use-chat';\nimport * as csrfModule from '@/lib/csrf';\n\n// Mock fetch\nglobal.fetch = jest.fn();\njest.mock('@/lib/csrf');\n\ndescribe('useChat', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n    (csrfModule.getCsrfToken as jest.Mock).mockResolvedValue('test-token');\n  });\n\n  it('should initialize with empty messages', () => {\n    const { result } = renderHook(() => useChat(null));\n    expect(result.current.messages).toEqual([]);\n    expect(result.current.contextId).toBeNull();\n    expect(result.current.loading).toBe(false);\n  });\n\n  it('should extract user and response messages from snapshot', () => {\n    const snapshot = {\n      logs: [\n        { no: 1, id: 'log-1', type: 'user', content: 'Hello', timestamp: 1000 },\n        { no: 2, id: 'log-2', type: 'response', content: 'Hi there', timestamp: 1001 },\n      ],\n      context: 'ctx-1',\n      log_progress_active: false,\n    };\n    \n    const { result } = renderHook(() => useChat(snapshot as any));\n    \n    expect(result.current.messages).toHaveLength(2);\n    expect(result.current.messages[0]).toMatchObject({ role: 'user', content: 'Hello' });\n    expect(result.current.messages[1]).toMatchObject({ role: 'assistant', content: 'Hi there' });\n  });\n\n  it('should deduplicate logs using log.id and log.no', () => {\n    const log1 = { no: 1, id: 'log-1', type: 'user', content: 'Test', timestamp: 1000 };\n    const log2 = { no: 2, id: null, type: 'user', content: 'Test 2', timestamp: 1001 };\n    \n    const { result, rerender } = renderHook(\n      ({ snapshot }) => useChat(snapshot),\n      { initialProps: { snapshot: { logs: [log1], log_progress_active: false } as any } }\n    );\n    \n    expect(result.current.messages).toHaveLength(1);\n    \n    rerender({ snapshot: { logs: [log1, log1, log2], log_progress_active: false } as any });\n    expect(result.current.messages).toHaveLength(2); // No duplicates\n  });\n\n  it('should send message and update state', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => ({ context: 'ctx-123' }),\n    });\n    \n    const { result } = renderHook(() => useChat(null));\n    \n    let returnedContext: string;\n    await act(async () => {\n      returnedContext = await result.current.sendMessage('Test message');\n    });\n    \n    expect(result.current.messages).toContainEqual(\n      expect.objectContaining({ role: 'user', content: 'Test message' })\n    );\n    expect(result.current.contextId).toBe('ctx-123');\n    expect(returnedContext!).toBe('ctx-123');\n  });\n\n  it('should queue messages when already processing', async () => {\n    (global.fetch as jest.Mock).mockImplementation(() => \n      new Promise(resolve => setTimeout(() => resolve({ ok: true, json: async () => ({}) }), 100))\n    );\n    \n    const { result } = renderHook(() => useChat(null));\n    \n    await act(async () => {\n      result.current.sendMessage('Message 1');\n      result.current.sendMessage('Message 2'); // Should queue\n    });\n    \n    expect(result.current.queuedMessages).toContain('Message 2');\n  });\n\n  it('should handle network errors gracefully', async () => {\n    (global.fetch as jest.Mock).mockRejectedValue(new Error('Network error'));\n    \n    const { result } = renderHook(() => useChat(null));\n    \n    await act(async () => {\n      await result.current.sendMessage('Test');\n    });\n    \n    expect(result.current.messages).toContainEqual(\n      expect.objectContaining({ \n        role: 'assistant', \n        content: expect.stringContaining('Can\\'t reach the kitchen') \n      })\n    );\n    expect(result.current.loading).toBe(false);\n  });\n\n  it('should handle CSRF token failures', async () => {\n    (csrfModule.getCsrfToken as jest.Mock).mockRejectedValue(new Error('CSRF error'));\n    \n    const { result } = renderHook(() => useChat(null));\n    \n    await act(async () => {\n      await result.current.sendMessage('Test');\n    });\n    \n    // Should still attempt to send (error handling in sendMessage)\n    expect(global.fetch).not.toHaveBeenCalled();\n  });\n\n  it('should reset chat and ignore stale snapshot logs', () => {\n    const snapshot = {\n      logs: [{ no: 1, id: 'log-1', type: 'user', content: 'Old message', timestamp: 1000 }],\n      log_progress_active: false,\n    };\n    \n    const { result, rerender } = renderHook(\n      ({ snap }) => useChat(snap),\n      { initialProps: { snap: snapshot as any } }\n    );\n    \n    expect(result.current.messages).toHaveLength(1);\n    \n    act(() => {\n      result.current.resetChat();\n    });\n    \n    expect(result.current.messages).toEqual([]);\n    expect(result.current.contextId).toBeNull();\n    \n    // Stale logs should be ignored after reset\n    rerender({ snap: snapshot as any });\n    expect(result.current.messages).toEqual([]);\n  });\n\n  it('should process queued messages after loading completes', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => ({ context: 'ctx' }),\n    });\n    \n    const { result, rerender } = renderHook(() => useChat({ log_progress_active: false } as any));\n    \n    // Simulate loading by setting snapshot with active progress\n    rerender(() => useChat({ log_progress_active: true } as any));\n    \n    await act(async () => {\n      result.current.sendMessage('First');\n      result.current.sendMessage('Queued');\n    });\n    \n    // Wait for queue processing\n    await waitFor(() => {\n      expect(result.current.queuedMessages).toHaveLength(0);\n    }, { timeout: 1000 });\n  });\n});\n```\n\n---\n\n",
