        "language": "typescript",
        "code": "// __tests__/hooks/use-expo-stream.test.ts\nimport { renderHook, act } from '@testing-library/react';\nimport { useExpoStream } from '@/hooks/use-expo-stream';\nimport type { A0Snapshot, ChefStatus } from '@/lib/types';\n\ndescribe('useExpoStream', () => {\n  beforeEach(() => {\n    jest.useFakeTimers();\n  });\n\n  afterEach(() => {\n    jest.useRealTimers();\n  });\n\n  it('should return inactive state when snapshot is null', () => {\n    const { result } = renderHook(() => useExpoStream(null, null));\n    expect(result.current).toEqual({\n      text: null,\n      thoughts: [],\n      active: false,\n    });\n  });\n\n  it('should extract thoughts from agent logs', () => {\n    const snapshot: A0Snapshot = {\n      logs: [{\n        no: 1,\n        id: 'log-1',\n        type: 'agent',\n        heading: '',\n        content: '',\n        kvps: { thoughts: ['Thinking about food', 'Checking inventory'] },\n        timestamp: 1000,\n        agentno: 0,\n      }],\n      log_progress_active: true,\n      // ...\n    };\n    \n    const { result } = renderHook(() => useExpoStream(snapshot as any, null));\n    expect(result.current.thoughts).toEqual(['Thinking about food', 'Checking inventory']);\n    expect(result.current.active).toBe(true);\n  });\n\n  it('should prefer headline over step', () => {\n    const snapshot: A0Snapshot = {\n      logs: [{\n        no: 1,\n        id: 'log-1',\n        type: 'agent',\n        heading: '',\n        content: '',\n        kvps: { headline: 'Main task', step: 'Sub step' },\n        timestamp: 1000,\n        agentno: 0,\n      }],\n      log_progress_active: true,\n    };\n    \n    const { result } = renderHook(() => useExpoStream(snapshot as any, null));\n    expect(result.current.text).toBe('Main task');\n  });\n\n  it('should fallback to random joke when no text available', () => {\n    const snapshot: A0Snapshot = {\n      logs: [],\n      log_progress_active: true,\n    };\n    \n    const { result } = renderHook(() => useExpoStream(snapshot as any, null));\n    expect(result.current.text).toBeTruthy();\n    expect(typeof result.current.text).toBe('string');\n  });\n\n  it('should persist sticky text across updates', () => {\n    const { result, rerender } = renderHook(\n      ({ snap, status }) => useExpoStream(snap, status),\n      {\n        initialProps: {\n          snap: {\n            logs: [{ no: 1, id: 'log-1', type: 'agent', kvps: { headline: 'Task 1' }, content: '', timestamp: 1000 }],\n            log_progress_active: true,\n          } as any,\n          status: null,\n        },\n      }\n    );\n    \n    expect(result.current.text).toBe('Task 1');\n    \n    // New snapshot without headline\n    rerender({\n      snap: { logs: [], log_progress_active: true } as any,\n      status: null,\n    });\n    \n    expect(result.current.text).toBe('Task 1'); // Sticky text persists\n  });\n\n  it('should clear sticky text after completion', () => {\n    const chefStatus: ChefStatus = {\n      status: 'completed',\n      text: 'Done',\n      active: false,\n    };\n    \n    const { result, rerender } = renderHook(\n      ({ status }) => useExpoStream(null, status),\n      { initialProps: { status: null } }\n    );\n    \n    rerender({ status: chefStatus });\n    expect(result.current.text).toBe('Done');\n    expect(result.current.active).toBe(false);\n    \n    // Should clear after 3 seconds\n    act(() => {\n      jest.advanceTimersByTime(3000);\n    });\n    \n    expect(result.current.text).toBeNull();\n  });\n\n  it('should handle logs with malformed kvps', () => {\n    const snapshot: A0Snapshot = {\n      logs: [\n        { no: 1, id: 'log-1', type: 'agent', kvps: { thoughts: 'not-an-array' }, content: '', timestamp: 1000 },\n        { no: 2, id: 'log-2', type: 'agent', kvps: { headline: 123 }, content: '', timestamp: 1001 },\n      ],\n      log_progress_active: true,\n    };\n    \n    const { result } = renderHook(() => useExpoStream(snapshot as any, null));\n    expect(result.current.thoughts).toEqual([]); // Type guard should filter invalid\n  });\n\n  it('should prioritize chefStatus text when active', () => {\n    const snapshot: A0Snapshot = {\n      logs: [{ no: 1, type: 'agent', kvps: { headline: 'Snapshot text' }, content: '', id: 'log-1', timestamp: 1000 }],\n      log_progress_active: true,\n    };\n    \n    const chefStatus: ChefStatus = {\n      status: 'working',\n      text: 'Chef status text',\n      active: true,\n    };\n    \n    const { result } = renderHook(() => useExpoStream(snapshot as any, chefStatus));\n    \n    // When there's a headline, it takes priority over chefStatus\n    // But chefStatus is fallback when headline is missing\n    // Test the fallback scenario:\n    const snapshot2: A0Snapshot = {\n      logs: [],\n      log_progress_active: true,\n    };\n    \n    const { result: result2 } = renderHook(() => useExpoStream(snapshot2 as any, chefStatus));\n    expect(result2.current.text).toBe('Chef status text');\n  });\n});"
