        "content": "\n```typescript\n// __tests__/lib/socket-client.test.ts\nimport { initStateSyncSocket, getStateSyncSocket, disconnectAll } from '@/lib/socket-client';\nimport { io } from 'socket.io-client';\nimport * as csrfModule from '@/lib/csrf';\n\njest.mock('socket.io-client');\njest.mock('@/lib/csrf');\n\ndescribe('socket-client', () => {\n  let mockSocket: any;\n\n  beforeEach(() => {\n    jest.clearAllMocks();\n    \n    mockSocket = {\n      on: jest.fn(),\n      off: jest.fn(),\n      disconnect: jest.fn(),\n      connected: false,\n    };\n\n    (io as jest.Mock).mockReturnValue(mockSocket);\n    (csrfModule.getCsrfToken as jest.Mock).mockResolvedValue('test-token');\n    (csrfModule.clearCsrfToken as jest.Mock).mockImplementation(() => {});\n  });\n\n  describe('initStateSyncSocket', () => {\n    it('should create socket with correct config', () => {\n      initStateSyncSocket();\n\n      expect(io).toHaveBeenCalledWith(\n        '/state_sync',\n        expect.objectContaining({\n          autoConnect: false,\n          transports: ['polling', 'websocket'],\n          withCredentials: true,\n        })\n      );\n    });\n\n    it('should return same socket on subsequent calls', () => {\n      const socket1 = initStateSyncSocket();\n      const socket2 = initStateSyncSocket();\n\n      expect(socket1).toBe(socket2);\n      expect(io).toHaveBeenCalledTimes(1);\n    });\n\n    it('should setup auth callback', () => {\n      initStateSyncSocket();\n\n      const config = (io as jest.Mock).mock.calls[0][1];\n      expect(config.auth).toBeInstanceOf(Function);\n    });\n\n    it('should fetch CSRF token in auth callback', async () => {\n      initStateSyncSocket();\n\n      const config = (io as jest.Mock).mock.calls[0][1];\n      const mockCb = jest.fn();\n\n      await config.auth(mockCb);\n\n      expect(csrfModule.getCsrfToken).toHaveBeenCalled();\n      expect(mockCb).toHaveBeenCalledWith({ csrf_token: 'test-token' });\n    });\n\n    it('should handle CSRF token failure in auth callback', async () => {\n      (csrfModule.getCsrfToken as jest.Mock).mockRejectedValue(new Error('CSRF error'));\n      const consoleSpy = jest.spyOn(console, 'error').mockImplementation();\n\n      initStateSyncSocket();\n\n      const config = (io as jest.Mock).mock.calls[0][1];\n      const mockCb = jest.fn();\n\n      await config.auth(mockCb);\n\n      expect(consoleSpy).toHaveBeenCalledWith(\n        expect.stringContaining('CSRF token fetch failed'),\n        expect.any(Error)\n      );\n      expect(mockCb).toHaveBeenCalledWith({});\n\n      consoleSpy.mockRestore();\n    });\n\n    it('should clear CSRF token on connect_error', () => {\n      initStateSyncSocket();\n\n      expect(mockSocket.on).toHaveBeenCalledWith('connect_error', expect.any(Function));\n\n      const errorHandler = mockSocket.on.mock.calls.find(\n        ([event]: [string]) => event === 'connect_error'\n      )[1];\n\n      errorHandler();\n\n      expect(csrfModule.clearCsrfToken).toHaveBeenCalled();\n    });\n\n    it('should use custom URL from env var', () => {\n      process.env.NEXT_PUBLIC_A0_URL = 'http://custom:5000';\n\n      initStateSyncSocket();\n\n      expect(io).toHaveBeenCalledWith(\n        'http://custom:5000/state_sync',\n        expect.any(Object)\n      );\n\n      delete process.env.NEXT_PUBLIC_A0_URL;\n    });\n  });\n\n  describe('getStateSyncSocket', () => {\n    it('should return null initially', () => {\n      expect(getStateSyncSocket()).toBeNull();\n    });\n\n    it('should return socket after init', () => {\n      initStateSyncSocket();\n\n      expect(getStateSyncSocket()).toBe(mockSocket);\n    });\n  });\n\n  describe('disconnectAll', () => {\n    it('should disconnect socket', () => {\n      initStateSyncSocket();\n\n      disconnectAll();\n\n      expect(mockSocket.disconnect).toHaveBeenCalled();\n      expect(getStateSyncSocket()).toBeNull();\n    });\n\n    it('should handle disconnect when no socket exists', () => {\n      expect(() => disconnectAll()).not.toThrow();\n    });\n  });\n});\n```\n\n---\n\n",
        "level": 3
