        "language": "typescript",
        "code": "// __tests__/hooks/use-action-cards.test.ts\nimport { renderHook, act } from '@testing-library/react';\nimport { useActionCards } from '@/hooks/use-action-cards';\nimport type { A0Snapshot } from '@/lib/types';\n\ndescribe('useActionCards', () => {\n  it('should return empty cards when snapshot is null', () => {\n    const { result } = renderHook(() => useActionCards(null));\n    expect(result.current.cards).toEqual([]);\n    expect(result.current.unreadCount).toBe(0);\n  });\n\n  it('should extract action cards from tool logs', () => {\n    const snapshot: A0Snapshot = {\n      logs: [{\n        no: 1,\n        id: 'log-1',\n        type: 'tool',\n        heading: '',\n        content: 'Created order #123',\n        kvps: { module: 'orders', action: 'create', item_id: '123' },\n        timestamp: 1000,\n        agentno: 0,\n      }],\n      // ... other required fields\n    };\n    \n    const { result } = renderHook(() => useActionCards(snapshot));\n    expect(result.current.cards).toHaveLength(1);\n    expect(result.current.cards[0]).toMatchObject({\n      type: 'create',\n      module: 'orders',\n      itemId: '123',\n    });\n  });\n\n  it('should ignore duplicate log IDs', () => {\n    const log = {\n      no: 1,\n      id: 'log-1',\n      type: 'tool' as const,\n      heading: '',\n      content: 'Test',\n      kvps: { module: 'test', action: 'test' },\n      timestamp: 1000,\n      agentno: 0,\n    };\n    \n    const { result, rerender } = renderHook(\n      ({ snapshot }) => useActionCards(snapshot),\n      { initialProps: { snapshot: { logs: [log] } as A0Snapshot } }\n    );\n    \n    expect(result.current.cards).toHaveLength(1);\n    \n    rerender({ snapshot: { logs: [log, log] } as A0Snapshot });\n    expect(result.current.cards).toHaveLength(1); // No duplicates\n  });\n\n  it('should ignore logs without module and action kvps', () => {\n    const snapshot: A0Snapshot = {\n      logs: [\n        { no: 1, id: 'log-1', type: 'tool', content: '', kvps: {}, timestamp: 1000 },\n        { no: 2, id: 'log-2', type: 'tool', content: '', kvps: { module: 'test' }, timestamp: 1001 },\n      ],\n      // ...\n    };\n    \n    const { result } = renderHook(() => useActionCards(snapshot));\n    expect(result.current.cards).toHaveLength(0);\n  });\n\n  it('should handle type coercion for kvps values', () => {\n    const snapshot: A0Snapshot = {\n      logs: [{\n        no: 1,\n        id: 'log-1',\n        type: 'tool',\n        content: '',\n        kvps: { module: 123, action: true, item_id: 456 }, // Wrong types\n        timestamp: 1000,\n      }],\n    };\n    \n    const { result } = renderHook(() => useActionCards(snapshot));\n    expect(result.current.cards[0].module).toBe('123');\n    expect(result.current.cards[0].action).toBe('true');\n  });\n\n  it('should mark individual card as read', () => {\n    const snapshot: A0Snapshot = {\n      logs: [{ no: 1, id: 'log-1', type: 'tool', kvps: { module: 'test', action: 'test' }, content: '', timestamp: 1000 }],\n    };\n    \n    const { result } = renderHook(() => useActionCards(snapshot));\n    \n    act(() => {\n      result.current.markRead('log-1');\n    });\n    \n    expect(result.current.cards[0].read).toBe(true);\n    expect(result.current.unreadCount).toBe(0);\n  });\n\n  it('should mark all cards as read', () => {\n    const snapshot: A0Snapshot = {\n      logs: [\n        { no: 1, id: 'log-1', type: 'tool', kvps: { module: 'a', action: 'a' }, content: '', timestamp: 1000 },\n        { no: 2, id: 'log-2', type: 'tool', kvps: { module: 'b', action: 'b' }, content: '', timestamp: 1001 },\n      ],\n    };\n    \n    const { result } = renderHook(() => useActionCards(snapshot));\n    expect(result.current.unreadCount).toBe(2);\n    \n    act(() => {\n      result.current.markAllRead();\n    });\n    \n    expect(result.current.unreadCount).toBe(0);\n  });\n\n  it('should handle logs with null IDs gracefully', () => {\n    const snapshot: A0Snapshot = {\n      logs: [{\n        no: 1,\n        id: null as any,\n        type: 'tool',\n        kvps: { module: 'test', action: 'test' },\n        content: '',\n        timestamp: 1000,\n      }],\n    };\n    \n    const { result } = renderHook(() => useActionCards(snapshot));\n    // Should not crash\n    expect(result.current.cards.length).toBeGreaterThanOrEqual(0);\n  });\n});"
