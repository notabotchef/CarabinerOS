        "code": "describe('csrf', () => {\n  beforeEach(() => {\n    clearCsrfToken();\n    global.fetch = jest.fn();\n    document.cookie = '';\n  });\n\n  it('should cache CSRF token after first fetch', async () => {\n    global.fetch = jest.fn(() => Promise.resolve({\n      json: () => Promise.resolve({ ok: true, token: 'token-123', runtime_id: 'rt-456' })\n    }));\n    \n    await getCsrfToken();\n    await getCsrfToken();\n    \n    expect(global.fetch).toHaveBeenCalledTimes(1);\n  });\n\n  it('should deduplicate concurrent requests', async () => {\n    global.fetch = jest.fn(() => Promise.resolve({\n      json: () => Promise.resolve({ ok: true, token: 'token-123', runtime_id: 'rt-456' })\n    }));\n    \n    const [token1, token2, token3] = await Promise.all([\n      getCsrfToken(),\n      getCsrfToken(),\n      getCsrfToken()\n    ]);\n    \n    expect(global.fetch).toHaveBeenCalledTimes(1);\n    expect(token1).toBe(token2);\n    expect(token2).toBe(token3);\n  });\n\n  it('should throw on fetch failure', async () => {\n    global.fetch = jest.fn(() => Promise.reject(new Error('Network error')));\n    \n    await expect(getCsrfToken()).rejects.toThrow();\n  });\n\n  it('should throw when response.ok is false', async () => {\n    global.fetch = jest.fn(() => Promise.resolve({\n      json: () => Promise.resolve({ ok: false, error: 'Invalid request' })\n    }));\n    \n    await expect(getCsrfToken()).rejects.toThrow('Invalid request');\n  });\n\n  it('should set CSRF cookie with runtime_id', async () => {\n    global.fetch = jest.fn(() => Promise.resolve({\n      json: () => Promise.resolve({ ok: true, token: 'token-123', runtime_id: 'rt-456' })\n    }));\n    \n    await getCsrfToken();\n    \n    expect(document.cookie).toContain('csrf_token_rt-456=token-123');\n    expect(document.cookie).toContain('SameSite=Strict');\n  });\n\n  it('should return runtime ID', async () => {\n    global.fetch = jest.fn(() => Promise.resolve({\n      json: () => Promise.resolve({ ok: true, token: 'token-123', runtime_id: 'rt-456' })\n    }));\n    \n    await getCsrfToken();\n    \n    expect(getRuntimeId()).toBe('rt-456');\n  });\n\n  it('should clear cached token', () => {\n    clearCsrfToken();\n    \n    expect(getRuntimeId()).toBeNull();\n  });\n\n  it('should fetch new token after clearing', async () => {\n    global.fetch = jest.fn(() => Promise.resolve({\n      json: () => Promise.resolve({ ok: true, token: 'token-123', runtime_id: 'rt-456' })\n    }));\n    \n    await getCsrfToken();\n    clearCsrfToken();\n    await getCsrfToken();\n    \n    expect(global.fetch).toHaveBeenCalledTimes(2);\n  });\n});"
