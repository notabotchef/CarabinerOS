        "code": "describe('useIsMobile', () => {\n  it('should return undefined initially', () => {\n    const { result } = renderHook(() => useIsMobile());\n    // On first render before useEffect\n    expect(result.current).toBeUndefined();\n  });\n\n  it('should detect mobile viewport (< 768px)', () => {\n    Object.defineProperty(window, 'innerWidth', { value: 500, writable: true });\n    const { result } = renderHook(() => useIsMobile());\n    \n    act(() => {\n      window.dispatchEvent(new Event('resize'));\n    });\n    \n    expect(result.current).toBe(true);\n  });\n\n  it('should detect desktop viewport (>= 768px)', () => {\n    Object.defineProperty(window, 'innerWidth', { value: 1024, writable: true });\n    const { result } = renderHook(() => useIsMobile());\n    \n    act(() => {\n      window.dispatchEvent(new Event('resize'));\n    });\n    \n    expect(result.current).toBe(false);\n  });\n\n  it('should handle breakpoint threshold (exactly 768px)', () => {\n    Object.defineProperty(window, 'innerWidth', { value: 768, writable: true });\n    // Assert it's NOT mobile (>= 768 = desktop)\n  });\n\n  it('should cleanup event listener on unmount', () => {\n    const removeEventListenerSpy = jest.spyOn(MediaQueryList.prototype, 'removeEventListener');\n    const { unmount } = renderHook(() => useIsMobile());\n    \n    unmount();\n    expect(removeEventListenerSpy).toHaveBeenCalled();\n  });\n\n  it('should handle rapid resize events', () => {\n    // Dispatch multiple resize events quickly\n    // Assert state updates correctly\n  });\n});"
