ogs are now processed\n  });\n\n  it('should only include agentno=0 responses', () => {\n    const snapshot = {\n      logs: [\n        { id: '1', type: 'response', content: 'Main agent', agentno: 0, timestamp: 1000 },\n        { id: '2', type: 'response', content: 'Sub agent', agentno: 1, timestamp: 1001 }\n      ]\n    };\n    // Assert only main agent response is in messages\n  });\n\n  it('should handle CSRF token fetch failure', async () => {\n    jest.spyOn(require('@/lib/csrf'), 'getCsrfToken')\n      .mockRejectedValue(new Error('CSRF failed'));\n    // Assert send still attempts but handles gracefully\n  });\n\n  it('should update contextId from response', async () => {\n    global.fetch = jest.fn(() => Promise.resolve({\n      ok: true,\n      json: () => Promise.resolve({ context: 'new-context-123' })\n    }));\n    \n    const { result } = renderHook(() => useChat(null));\n    await act(() => result.current.sendMessage('test'));\n    \n    expect(result.current.contextId).toBe('new-context-123');\n  });\n\n  it('should show queued messages in chat immediately', () => {\n    // Verify that queued messages appear as user messages\n  });\n});"
