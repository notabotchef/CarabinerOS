        "code": "describe('useWorkspace', () => {\n  it('should handle 404 errors', async () => {\n    global.fetch = jest.fn(() => Promise.resolve({ ok: false, status: 404 }));\n    \n    const { result } = renderHook(() => useWorkspace('/api/items'));\n    \n    await waitFor(() => {\n      expect(result.current.error).toBe('404');\n      expect(result.current.data).toEqual([]);\n    });\n  });\n\n  it('should handle network errors', async () => {\n    global.fetch = jest.fn(() => Promise.reject(new Error('Network failed')));\n    \n    const { result } = renderHook(() => useWorkspace('/api/items'));\n    \n    await waitFor(() => {\n      expect(result.current.error).toBeTruthy();\n    });\n  });\n\n  it('should include locationId in query string', async () => {\n    global.fetch = jest.fn(() => Promise.resolve({\n      ok: true,\n      json: () => Promise.resolve([])\n    }));\n    \n    renderHook(() => useWorkspace('/api/items', 'loc-123'));\n    \n    expect(global.fetch).toHaveBeenCalledWith(\n      expect.stringContaining('location_id=loc-123'),\n      expect.any(Object)\n    );\n  });\n\n  it('should parse items from response.items', async () => {\n    global.fetch = jest.fn(() => Promise.resolve({\n      ok: true,\n      json: () => Promise.resolve({ items: [{ id: 1 }, { id: 2 }] })\n    }));\n    \n    const { result } = renderHook(() => useWorkspace('/api/items'));\n    \n    await waitFor(() => {\n      expect(result.current.data).toHaveLength(2);\n    });\n  });\n\n  it('should parse items from response.data', async () => {\n    global.fetch = jest.fn(() => Promise.resolve({\n      ok: true,\n      json: () => Promise.resolve({ data: [{ id: 1 }] })\n    }));\n    \n    // Assert data is extracted correctly\n  });\n\n  it('should parse direct array response', async () => {\n    global.fetch = jest.fn(() => Promise.resolve({\n      ok: true,\n      json: () => Promise.resolve([{ id: 1 }])\n    }));\n    \n    // Assert data is extracted correctly\n  });\n\n  it('should refresh data when refresh is called', async () => {\n    const { result } = renderHook(() => useWorkspace('/api/items'));\n    \n    const firstCallCount = (global.fetch as jest.Mock).mock.calls.length;\n    \n    act(() => {\n      result.current.refresh();\n    });\n    \n    expect((global.fetch as jest.Mock).mock.calls.length).toBe(firstCallCount + 1);\n  });\n\n  it('should handle concurrent refresh calls', async () => {\n    const { result } = renderHook(() => useWorkspace('/api/items'));\n    \n    act(() => {\n      result.current.refresh();\n      result.current.refresh();\n      result.current.refresh();\n    });\n    \n    // Assert no race conditions, data remains consistent\n  });\n\n  it('should set loading to true during fetch', () => {\n    global.fetch = jest.fn(() => new Promise(() => {})); // Never resolves\n    \n    const { result } = renderHook(() => useWorkspace('/api/items'));\n    \n    expect(result.current.loading).toBe(true);\n  });\n});"
