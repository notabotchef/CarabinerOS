ct((socket as any).io.opts.withCredentials).toBe(true);\n  });\n\n  it('should use NEXT_PUBLIC_A0_URL if set', () => {\n    process.env.NEXT_PUBLIC_A0_URL = 'http://custom:5000';\n    \n    // Re-initialize\n    disconnectAll();\n    const socket = initStateSyncSocket();\n    \n    expect((socket as any).io.uri).toContain('http://custom:5000');\n  });\n\n  it('should disconnect all sockets', () => {\n    const socket = initStateSyncSocket();\n    const disconnectSpy = jest.spyOn(socket, 'disconnect');\n    \n    disconnectAll();\n    \n    expect(disconnectSpy).toHaveBeenCalled();\n    expect(getStateSyncSocket()).toBeNull();\n  });\n});\n```\n\n---\n\n",
