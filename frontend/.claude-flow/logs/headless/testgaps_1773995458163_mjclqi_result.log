        "code": "describe('useSocket', () => {\n  it('should handle connection failure', () => {\n    const mockSocket = {\n      on: jest.fn(),\n      emit: jest.fn(),\n      connect: jest.fn(() => { /* never fires connect event */ }),\n      disconnect: jest.fn()\n    };\n    \n    // Mock socket initialization\n    // Assert connected state remains false\n  });\n\n  it('should fetch CSRF token before connecting', async () => {\n    const getCsrfTokenSpy = jest.spyOn(require('@/lib/csrf'), 'getCsrfToken');\n    \n    renderHook(() => useSocket());\n    \n    expect(getCsrfTokenSpy).toHaveBeenCalled();\n  });\n\n  it('should handle state_push with missing snapshot', () => {\n    // Emit state_push with malformed data\n    // Assert warning is logged, no crash\n  });\n\n  it('should update chefStatus on chef_status event', () => {\n    const { result } = renderHook(() => useSocket());\n    \n    act(() => {\n      // Emit chef_status event\n      mockSocket.emit('chef_status', { status: 'working', text: 'Processing...' });\n    });\n    \n    expect(result.current.chefStatus).toMatchObject({ status: 'working' });\n  });\n\n  it('should queue subscribe context when socket not connected', () => {\n    const { result } = renderHook(() => useSocket());\n    \n    // Call subscribe before socket connects\n    act(() => {\n      result.current.subscribe('context-123');\n    });\n    \n    // Trigger connection\n    // Assert state_request is sent with queued context\n  });\n\n  it('should emit state_request on connect with queued context', () => {\n    // Test pending context handling\n  });\n\n  it('should cleanup event listeners on unmount', () => {\n    const { unmount } = renderHook(() => useSocket());\n    \n    const offSpy = jest.spyOn(mockSocket, 'off');\n    unmount();\n    \n    expect(offSpy).toHaveBeenCalledWith('connect');\n    expect(offSpy).toHaveBeenCalledWith('disconnect');\n    expect(offSpy).toHaveBeenCalledWith('state_push');\n    expect(offSpy).toHaveBeenCalledWith('chef_status');\n  });\n\n  it('should track log version correctly', () => {\n    // Test logFromRef updates based on snapshot.logs\n  });\n\n  it('should include timezone in state_request', () => {\n    const emitSpy = jest.spyOn(mockSocket, 'emit');\n    \n    // Trigger state_request\n    expect(emitSpy).toHaveBeenCalledWith('state_request', \n      expect.objectContaining({\n        timezone: expect.any(String)\n      })\n    );\n  });\n});"
