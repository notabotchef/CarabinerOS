        "code": "describe('expo-messages', () => {\n  describe('getExpoMessage', () => {\n    it('should return message for known tool', () => {\n      const log = {\n        type: 'tool',\n        heading: 'Using food_cost_tool...',\n        content: ''\n      };\n      \n      const message = getExpoMessage(log);\n      expect(message).toBeTruthy();\n      // Verify it's from QUIRKY_MESSAGES.food_cost_tool\n    });\n\n    it('should return default message for unknown tool', () => {\n      const log = {\n        type: 'tool',\n        heading: 'Using unknown_tool...',\n        content: ''\n      };\n      \n      const message = getExpoMessage(log);\n      expect(message).toBeTruthy();\n      // Verify it's from QUIRKY_MESSAGES.default\n    });\n\n    it('should handle agent logs', () => {\n      const log = {\n        type: 'agent',\n        heading: 'Chef Assistant',\n        content: ''\n      };\n      \n      const message = getExpoMessage(log);\n      expect(message).toContain('Delegating');\n    });\n\n    it('should handle subagent logs', () => {\n      const log = {\n        type: 'subagent',\n        heading: 'Prep Specialist',\n        content: ''\n      };\n      \n      const message = getExpoMessage(log);\n      expect(message).toContain('Delegating');\n    });\n\n    it('should handle progress logs', () => {\n      const log = {\n        type: 'progress',\n        content: 'Processing step 2 of 5...',\n        heading: ''\n      };\n      \n      const message = getExpoMessage(log);\n      expect(message).toBe('Processing step 2 of 5...');\n    });\n\n    it('should return null for unhandled log types', () => {\n      const log = {\n        type: 'user',\n        heading: '',\n        content: 'Hello'\n      };\n      \n      expect(getExpoMessage(log)).toBeNull();\n    });\n\n    it('should handle null heading gracefully', () => {\n      const log = {\n        type: 'tool',\n        heading: null,\n        content: ''\n      };\n      \n      // Should not crash\n      getExpoMessage(log);\n    });\n  });\n\n  describe('getCompletionMessage', () => {\n    it('should return a completion message', () => {\n      const message = getCompletionMessage();\n      expect(['Heard.', 'Service.', 'All set.', 'Done, Chef.']).toContain(message);\n    });\n\n    it('should return different messages on multiple calls', () => {\n      // Call 100 times, verify we get at least 2 different messages\n      const messages = new Set(\n        Array.from({ length: 100 }, () => getCompletionMessage())\n      );\n      expect(messages.size).toBeGreaterThan(1);\n    });\n  });\n});"
