(getRuntimeId()).toBe('rt-456');\n  });\n\n  it('should clear cached token', () => {\n    clearCsrfToken();\n    \n    expect(getRuntimeId()).toBeNull();\n  });\n\n  it('should fetch new token after clearing', async () => {\n    global.fetch = jest.fn(() => Promise.resolve({\n      json: () => Promise.resolve({ ok: true, token: 'token-123', runtime_id: 'rt-456' })\n    }));\n    \n    await getCsrfToken();\n    clearCsrfToken();\n    await getCsrfToken();\n    \n    expect(global.fetch).toHaveBeenCalledTimes(2);\n  });\n});\n```\n\n---\n\n## 8. **expo-messages.ts**\n\n### Missing Coverage\n\n- ❌ All tool types in QUIRKY_MESSAGES\n- ❌ Agent/subagent log handling\n- ❌ Progress log handling\n- ❌ Unknown tool type fallback\n- ❌ Null/missing log.heading\n- ❌ Empty log.content\n- ❌ Random message selection\n\n### Test Skeletons\n\n```typescript\ndescribe('expo-messages', () => {\n  describe('getExpoMessage', () => {\n    it('should return message for known tool', () => {\n      const log = {\n        type: 'tool',\n        heading: 'Using food_cost_tool...',\n        content: ''\n      };\n      \n      const message = getExpoMessage(log);\n      expect(message).toBeTruthy();\n      // Verify it's from QUIRKY_MESSAGES.food_cost_tool\n    });\n\n    it('should return default message for unknown tool', () => {\n      const log = {\n        type: 'tool',\n        heading: 'Using unknown_tool...',\n        content: ''\n      };\n      \n      const message = getExpoMessage(log);\n      expect(message).toBeTruthy();\n      // Verify it's from QUIRKY_MESSAGES.default\n    });\n\n    it('should handle agent logs', () => {\n      const log = {\n        type: 'agent',\n        heading: 'Chef Assistant',\n        content: ''\n      };\n      \n      const message = getExpoMessage(log);\n      expect(message).toContain('Delegating');\n    });\n\n    it('should handle subagent logs', () => {\n      const log = {\n        type: 'subagent',\n        heading: 'Prep Specialist',\n        content: ''\n      };\n      \n      const message = getExpoMessage(log);\n      expect(message).toContain('Delegating');\n    });\n\n    it('should handle progress logs', () => {\n      const log = {\n        type: 'progress',\n        content: 'Processing step 2 of 5...',\n        heading: ''\n      };\n      \n      const message = getExpoMessage(log);\n      expect(message).toBe('Processing step 2 of 5...');\n    });\n\n    it('should return null for unhandled log types', () => {\n      const log = {\n        type: 'user',\n        heading: '',\n        content: 'Hello'\n      };\n      \n      expect(getExpoMessage(log)).toBeNull();\n    });\n\n    it('should handle null heading gracefully', () => {\n      const log = {\n        type: 'tool',\n        heading: null,\n        content: ''\n      };\n      \n      // Should not crash\n      getExpoMessage(log);\n    });\n  });\n\n  describe('getCompletionMessage', () => {\n    it('should return a completion message', () => {\n      const message = getCompletionMessage();\n      expect(['Heard.', 'Service.', 'All set.', 'Done, Chef.']).toContain(message);\n    });\n\n    it('should return different messages on multiple calls', () => {\n      // Call 100 times, verify we get at least 2 different messages\n      const messages = new Set(\n        Array.from({ length: 100 }, () => getCompletionMessage())\n      );\n      expect(messages.size).toBeGreaterThan(1);\n    });\n  });\n});\n```\n\n---\n\n## 9. **socket-client.ts**\n\n### Missing Coverage\n\n- ❌ Singleton pattern enforcement\n- ❌ Auth callback with CSRF token\n- ❌ Auth callback failure handling\n- ❌ connect_error event handling\n- ❌ CSRF token invalidation on error\n- ❌ Transport selection (polling then websocket)\n- ❌ URL configuration (dev vs prod)\n- ❌ Disconnect cleanup\n\n### Test Skeletons\n\n```typescript\ndescribe('socket-client', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n    disconnectAll();\n  });\n\n  it('should enforce singleton pattern', () => {\n    const socket1 = initStateSyncSocket();\n    const socket2 = initStateSyncSocket();\n    \n    expect(socket1).toBe(socket2);\n  });\n\n  it('should fetch CSRF token in auth callback', async () => {\n    const getCsrfTokenSpy = jest.spyOn(require('@/lib/csrf'), 'getCsrfToken')\n      .mockResolvedValue('token-123');\n    \n    const socket = initStateSyncSocket();\n    const authCallback = (socket as any).auth;\n    \n    await new Promise(resolve => {\n      authCallback(resolve);\n    });\n    \n    expect(getCsrfTokenSpy).toHaveBeenCalled();\n  });\n\n  it('should handle CSRF token fetch failure in auth', async () => {\n    jest.spyOn(require('@/lib/csrf'), 'getCsrfToken')\n      .mockRejectedValue(new Error('CSRF failed'));\n    \n    const socket = initStateSyncSocket();\n    const authCallback = (socket as any).auth;\n    \n    const result = await new Promise(resolve => {\n      authCallback(resolve);\n    });\n    \n    // Should call callback with empty object\n    expect(result).toEqual({});\n  });\n\n  it('should clear CSRF token on connect_error', () => {\n    const clearCsrfTokenSpy = jest.spyOn(require('@/lib/csrf'), 'clearCsrfToken');\n    \n    const socket = initStateSyncSocket();\n    socket.emit('connect_error');\n    \n    expect(clearCsrfTokenSpy).toHaveBeenCalled();\n  });\n\n  it('should use polling as initial transport', () => {\n    const socket = initStateSyncSocket();\n    \n    expect((socket as any).io.opts.transports).toEqual(['polling', 'websocket']);\n  });\n\n  it('should set autoConnect to false', () => {\n    const socket = initStateSyncSocket();\n    \n    expect((socket as any).io.opts.autoConnect).toBe(false);\n  });\n\n  it('should set withCredentials to true', () => {\n    const socket = initStateSyncSocket();\n    \n    expect((socket as any).io.opts.withCredentials).toBe(true);\n  });\n\n  it('should use NEXT_PUBLIC_A0_URL if set', () => {\n    process.env.NEXT_PUBLIC_A0_URL = 'http://custom:5000';\n    \n    // Re-initialize\n    disconnectAll();\n    const socket = initStateSyncSocket();\n    \n    expect((socket as any).io.uri).toContain('http://custom:5000');\n  });\n\n  it('should disconnect all sockets', () => {\n    const socket = initStateSyncSocket();\n    const disconnectSpy = jest.spyOn(socket, 'disconnect');\n    \n    disconnectAll();\n    \n    expect(disconnectSpy).toHaveBeenCalled();\n    expect(getStateSyncSocket()).toBeNull();\n  });\n});\n```\n\n---\n\n## 10. **utils.ts**\n\n### Missing Coverage\n\n- ❌ Empty inputs\n- ❌ Null/undefined inputs\n- ❌ Class conflict resolution\n- ❌ Tailwind-specific class merging\n- ❌ Array inputs\n- ❌ Conditional classes\n\n### Test Skeletons\n\n```typescript\ndescribe('utils', () => {\n  describe('cn', () => {\n    it('should handle empty inputs', () => {\n      expect(cn()).toBe('');\n    });\n\n    it('should handle single class', () => {\n      expect(cn('text-red-500')).toBe('text-red-500');\n    });\n\n    it('should merge multiple classes', () => {\n      expect(cn('text-red-500', 'bg-blue-200')).toBe('text-red-500 bg-blue-200');\n    });\n\n    it('should handle undefined inputs', () => {\n      expect(cn('text-red-500', undefined, 'bg-blue-200')).toBe('text-red-500 bg-blue-200');\n    });\n\n    it('should handle null inputs', () => {\n      expect(cn('text-red-500', null, 'bg-blue-200')).toBe('text-red-500 bg-blue-200');\n    });\n\n    it('should handle conditional classes', () => {\n      const isActive = true;\n      expect(cn('base', isActive && 'active')).toContain('active');\n      \n      const isDisabled = false;\n      expect(cn('base', isDisabled && 'disabled')).not.toContain('disabled');\n    });\n\n    it('should merge conflicting Tailwind classes', () => {\n      // Later class should override earlier one\n      const result = cn('p-4', 'p-8');\n      expect(result).toBe('p-8');\n    });\n\n    it('should handle array inputs', () => {\n      expect(cn(['text-red-500', 'bg-blue-200'])).toContain('text-red-500');\n    });\n\n    it('should handle object inputs', () => {\n      expect(cn({\n        'text-red-500': true,\n        'bg-blue-200': false\n      })).toBe('text-red-500');\n    });\n\n    it('should handle complex combinations', () => {\n      const result = cn(\n        'base-class',\n        ['array-class'],\n        { 'object-class': true, 'excluded': false },\n        undefined,\n        null,\n        'final-class'\n      );\n      \n      expect(result).toContain('base-class');\n      expect(result).toContain('array-class');\n      expect(result).toContain('object-class');\n      expect(result).not.toContain('excluded');\n      expect(result).toContain('final-class');\n    });\n  });\n});\n```\n\n---\n\n## Summary of Critical Gaps\n\n### High Priority (Security & Data Integrity)\n1. **Error handling**: Network failures, HTTP errors, malformed responses\n2. **Deduplication logic**: Prevent duplicate processing in all hooks\n3. **Race conditions**: Concurrent operations in async hooks\n4. **CSRF token management**: All failure paths and edge cases\n\n### Medium Priority (User Experience)\n5. **State transitions**: Loading/idle/error states\n6. **Queue management**: Message queueing and processing\n7. **Timer cleanup**: Prevent memory leaks\n8. **Event listener cleanup**: Prevent memory leaks\n\n### Low Priority (Edge Cases)\n9. **Null/undefined handling**: All inputs\n10. **Type conversions**: Non-standard data types\n11. **Empty arrays/objects**: Boundary conditions\n12. **SSR safety**: Window/document object checks\n\n---\n\n## Recommended Testing Strategy\n\n1. **Start with critical paths**: Error handling, CSRF, socket connection\n2. **Add integration tests**: Full user flows (send message → receive response → update UI)\n3. **Add edge case tests**: Null inputs, empty arrays, malformed data\n4. **Add performance tests**: Memory leaks, concurrent operations, cleanup\n5. **Add E2E tests**: Real browser, real WebSocket connection, real backend\n",
