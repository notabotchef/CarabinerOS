        "code": "describe('socket-client', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n    disconnectAll();\n  });\n\n  it('should enforce singleton pattern', () => {\n    const socket1 = initStateSyncSocket();\n    const socket2 = initStateSyncSocket();\n    \n    expect(socket1).toBe(socket2);\n  });\n\n  it('should fetch CSRF token in auth callback', async () => {\n    const getCsrfTokenSpy = jest.spyOn(require('@/lib/csrf'), 'getCsrfToken')\n      .mockResolvedValue('token-123');\n    \n    const socket = initStateSyncSocket();\n    const authCallback = (socket as any).auth;\n    \n    await new Promise(resolve => {\n      authCallback(resolve);\n    });\n    \n    expect(getCsrfTokenSpy).toHaveBeenCalled();\n  });\n\n  it('should handle CSRF token fetch failure in auth', async () => {\n    jest.spyOn(require('@/lib/csrf'), 'getCsrfToken')\n      .mockRejectedValue(new Error('CSRF failed'));\n    \n    const socket = initStateSyncSocket();\n    const authCallback = (socket as any).auth;\n    \n    const result = await new Promise(resolve => {\n      authCallback(resolve);\n    });\n    \n    // Should call callback with empty object\n    expect(result).toEqual({});\n  });\n\n  it('should clear CSRF token on connect_error', () => {\n    const clearCsrfTokenSpy = jest.spyOn(require('@/lib/csrf'), 'clearCsrfToken');\n    \n    const socket = initStateSyncSocket();\n    socket.emit('connect_error');\n    \n    expect(clearCsrfTokenSpy).toHaveBeenCalled();\n  });\n\n  it('should use polling as initial transport', () => {\n    const socket = initStateSyncSocket();\n    \n    expect((socket as any).io.opts.transports).toEqual(['polling', 'websocket']);\n  });\n\n  it('should set autoConnect to false', () => {\n    const socket = initStateSyncSocket();\n    \n    expect((socket as any).io.opts.autoConnect).toBe(false);\n  });\n\n  it('should set withCredentials to true', () => {\n    const socket = initStateSyncSocket();\n    \n    expect((socket as any).io.opts.withCredentials).toBe(true);\n  });\n\n  it('should use NEXT_PUBLIC_A0_URL if set', () => {\n    process.env.NEXT_PUBLIC_A0_URL = 'http://custom:5000';\n    \n    // Re-initialize\n    disconnectAll();\n    const socket = initStateSyncSocket();\n    \n    expect((socket as any).io.uri).toContain('http://custom:5000');\n  });\n\n  it('should disconnect all sockets', () => {\n    const socket = initStateSyncSocket();\n    const disconnectSpy = jest.spyOn(socket, 'disconnect');\n    \n    disconnectAll();\n    \n    expect(disconnectSpy).toHaveBeenCalled();\n    expect(getStateSyncSocket()).toBeNull();\n  });\n});"
