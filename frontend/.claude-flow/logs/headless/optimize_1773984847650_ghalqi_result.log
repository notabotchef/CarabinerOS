        "language": "typescript",
        "code": "const cache = new Map<string, { data: unknown[]; timestamp: number }>();\nconst CACHE_TTL = 30000; // 30 seconds\n\nexport function useWorkspace<T = Record<string, unknown>>(\n  endpoint: string,\n  locationId?: string,\n): UseWorkspaceReturn<T> {\n  const [data, setData] = useState<T[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n  const [refreshKey, setRefreshKey] = useState(0);\n\n  useEffect(() => {\n    const url = locationId ? `${endpoint}?location_id=${locationId}` : endpoint;\n    const cacheKey = url;\n    \n    // Check cache first\n    const cached = cache.get(cacheKey);\n    if (cached && Date.now() - cached.timestamp < CACHE_TTL && refreshKey === 0) {\n      setData(cached.data as T[]);\n      setLoading(false);\n      return;\n    }\n\n    const abortController = new AbortController();\n    setLoading(true);\n    \n    fetch(url, { \n      credentials: \"include\",\n      signal: abortController.signal,\n    })\n      .then(async (res) => {\n        if (!res.ok) throw new Error(`${res.status}`);\n        const json = await res.json();\n        const items = Array.isArray(json) ? json : json.items ?? json.data ?? [];\n        \n        // Update cache\n        cache.set(cacheKey, { data: items, timestamp: Date.now() });\n        \n        setData(items);\n        setError(null);\n      })\n      .catch((err) => {\n        if (err.name !== 'AbortError') {\n          setError(err.message);\n          setData([]);\n        }\n      })\n      .finally(() => setLoading(false));\n\n    return () => abortController.abort();\n  }, [endpoint, locationId, refreshKey]);\n\n  return { data, loading, error, refresh: () => setRefreshKey((k) => k + 1) };\n}"
