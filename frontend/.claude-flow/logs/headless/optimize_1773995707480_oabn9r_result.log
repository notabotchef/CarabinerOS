  "output": "# Performance Analysis: CarabinerOS Frontend\n\n## 1. 🔴 N+1 Query Patterns\n\n### Issue: Potential Backend N+1 (Frontend perspective)\nThe `useWorkspace` hook fetches collections but doesn't indicate if the backend is doing efficient joins.\n\n**Recommendation:** Add `include` or `expand` query params to fetch related data in one request:\n\n```typescript\n// src/hooks/use-workspace.ts\nexport function useWorkspace<T = Record<string, unknown>>(\n  endpoint: string,\n  locationId?: string,\n  options?: { include?: string[] }  // NEW\n): UseWorkspaceReturn<T> {\n  // ...\n  useEffect(() => {\n    const params = new URLSearchParams();\n    if (locationId) params.set('location_id', locationId);\n    if (options?.include) params.set('include', options.include.join(','));  // NEW\n    \n    const url = `${endpoint}?${params}`;\n    // ... fetch\n  }, [endpoint, locationId, options?.include]);\n}\n\n// Usage in pages:\nconst { data } = useWorkspace('/api/orders', locationId, {\n  include: ['vendor', 'line_items', 'user']  // Fetch all in one query\n});\n```\n\n---\n\n## 2. 🔴 Unnecessary Re-renders in React\n\n### Issue A: Unbounded Log Processing\n`use-action-cards.ts` and `use-chat.ts` iterate through **ALL logs** on every snapshot update.\n\n**Current (inefficient):**\n```typescript\n// src/hooks/use-action-cards.ts\nuseEffect(() => {\n  if (!snapshot) return;\n\n  for (const log of snapshot.logs) {  // ❌ Processes ALL logs every time\n    if (processedIds.current.has(log.id)) continue;\n    // ...\n  }\n}, [snapshot]);\n```\n\n**Optimized:**\n```typescript\n// src/hooks/use-action-cards.ts\nexport function useActionCards(snapshot: A0Snapshot | null): UseActionCardsReturn {\n  const [cards, setCards] = useState<ActionCard[]>([]);\n  const processedIds = useRef(new Set<string>());\n  const lastProcessedIndex = useRef(0);  // NEW: Track position\n\n  useEffect(() => {\n    if (!snapshot?.logs) return;\n\n    const newCards: ActionCard[] = [];\n    \n    // ✅ Only process NEW logs since last index\n    for (let i = lastProcessedIndex.current; i < snapshot.logs.length; i++) {\n      const log = snapshot.logs[i];\n      if (processedIds.current.has(log.id)) continue;\n      \n      if (log.type === \"tool\" && log.kvps?.module && log.kvps?.action) {\n        newCards.push({\n          id: log.id,\n          type: String(log.kvps.action),\n          module: String(log.kvps.module),\n          action: String(log.kvps.action),\n          itemId: log.kvps.item_id ? String(log.kvps.item_id) : undefined,\n          item: log.kvps.item as Record<string, unknown> | undefined,\n          summary: log.content.slice(0, 120),\n          timestamp: log.timestamp,\n          read: false,\n        });\n        processedIds.current.add(log.id);\n      }\n    }\n    \n    lastProcessedIndex.current = snapshot.logs.length;\n    \n    if (newCards.length > 0) {\n      setCards(prev => [...prev, ...newCards]);  // Batch update\n    }\n  }, [snapshot]);\n  \n  // ... rest unchanged\n}\n```\n\n### Issue B: Multiple State Updates Causing Re-renders\n`use-chat.ts` calls `setState` multiple times in one effect.\n\n**Optimized with batching:**\n```typescript\n// src/hooks/use-chat.ts\nuseEffect(() => {\n  if (!snapshot?.logs || freshChatRef.current) {\n    if (freshChatRef.current) setLoading(false);\n    return;\n  }\n\n  // ✅ Batch all state updates\n  const updates: {\n    newMessages?: ChatMessage[];\n    newContextId?: string;\n    newLoading?: boolean;\n  } = {};\n\n  const newMessages: ChatMessage[] = [];\n  const startIdx = lastProcessedIndex.current;  // NEW: Track position\n\n  for (let i = startIdx; i < snapshot.logs.length; i++) {\n    const log = snapshot.logs[i];\n    const logKey = log.id ?? `no-${log.no}`;\n    \n    if (processedLogIds.current.has(logKey)) continue;\n\n    if (log.type === \"user\") {\n      newMessages.push({\n        id: logKey,\n        role: \"user\",\n        content: log.content,\n        timestamp: log.timestamp,\n      });\n      processedLogIds.current.add(logKey);\n    }\n\n    if (log.type === \"response\" && log.content.trim() && log.agentno === 0) {\n      newMessages.push({\n        id: logKey,\n        role: \"assistant\",\n        content: log.content,\n        timestamp: log.timestamp,\n      });\n      processedLogIds.current.add(logKey);\n    }\n  }\n\n  lastProcessedIndex.current = snapshot.logs.length;\n\n  // ✅ Single state update instead of 3 separate ones\n  React.startTransition(() => {\n    if (newMessages.length > 0) {\n      setMessages(prev => [...prev, ...newMessages]);\n    }\n    if (snapshot.context && snapshot.context !== contextId) {\n      setContextId(snapshot.context);\n    }\n    if (snapshot.log_progress_active !== loading) {\n      setLoading(snapshot.log_progress_active);\n    }\n  });\n}, [snapshot]);\n```\n\n### Issue C: Expensive Computations on Every Render\nHelper functions in page components are recreated on every render.\n\n**Current (inefficient):**\n```typescript\n// src/app/orders/page.tsx\nfunction formatCurrency(v: unknown): string {  // ❌ Recreated on every render\n  // ...\n}\n```\n\n**Optimized with useMemo:**\n```typescript\n// src/lib/formatters.ts - Centralized utilities\nexport const formatCurrency = (v: unknown): string => {\n  if (v == null || v === \"\") return \"—\";\n  const s = String(v).replace(/[$,]/g, \"\").trim();\n  const n = Number(s);\n  if (isNaN(n)) return String(v);\n  return `$${n.toLocaleString(\"en-US\", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;\n};\n\nexport const formatDate = (v: unknown): string => {\n  if (!v || typeof v !== \"string\") return \"—\";\n  const d = new Date(v);\n  if (isNaN(d.getTime())) return \"—\";\n  return d.toLocaleDateString(\"en-US\", { month: \"short\", day: \"numeric\" });\n};\n\n// Usage in components - import once, no recreation\nimport { formatCurrency, formatDate } from \"@/lib/formatters\";\n```\n\n---\n\n## 3. 🟡 Caching Opportunities\n\n### Issue: No Request Caching or Deduplication\nMultiple components might fetch the same data simultaneously.\n\n**Recommendation: Add React Query or SWR:**\n\n```typescript\n// src/hooks/use-workspace-optimized.ts\nimport { useQuery } from '@tanstack/react-query';\n\nexport function useWorkspace<T = Record<string, unknown>>(\n  endpoint: string,\n  locationId?: string,\n) {\n  const queryKey = [endpoint, locationId];\n  \n  return useQuery({\n    queryKey,\n    queryFn: async () => {\n      const url = locationId \n        ? `${endpoint}?location_id=${locationId}` \n        : endpoint;\n      \n      const res = await fetch(url, { credentials: \"include\" });\n      if (!res.ok) throw new Error(`${res.status}`);\n      const json = await res.json();\n      return Array.isArray(json) ? json : json.items ?? json.data ?? [];\n    },\n    staleTime: 30_000,  // ✅ Cache for 30s\n    gcTime: 5 * 60_000,  // ✅ Keep in memory for 5min\n    refetchOnWindowFocus: false,\n  });\n}\n\n// Wrap app with QueryClientProvider in layout.tsx:\nimport { QueryClient, QueryClientProvider } from '@tanstack/react-query';\n\nconst queryClient = new QueryClient();\n\nexport default function RootLayout({ children }) {\n  return (\n    <html>\n      <body>\n        <QueryClientProvider client={queryClient}>\n          <SocketProvider>\n            <Shell>{children}</Shell>\n          </SocketProvider>\n        </QueryClientProvider>\n      </body>\n    </html>\n  );\n}\n```\n\n### Issue: Expensive Computations Not Memoized\nStatus lookups, filtering, sorting happen on every render.\n\n**Optimized:**\n```typescript\n// src/app/food-cost/page.tsx\nconst { data, isLoading } = useWorkspace<FoodCostItem>(\"/api/food-cost\");\n\n// ✅ Memoize filtered data with correct dependencies\nconst filteredItems = useMemo(() => {\n  if (!data) return [];\n  if (activeFilter === \"All\") return data;\n  return data.filter(item => normalizePressure(item.pressure) === activeFilter);\n}, [data, activeFilter]);  // Only recompute when these change\n\n// ✅ Memoize expensive aggregations\nconst kpis = useMemo(() => {\n  const high = filteredItems.filter(i => normalizePressure(i.pressure) === \"High\").length;\n  const avgCost = filteredItems.reduce((sum, i) => sum + parseCost(i.current_cost_pct), 0) / (filteredItems.length || 1);\n  \n  return { high, avgCost: avgCost.toFixed(1) };\n}, [filteredItems]);\n```\n\n---\n\n## 4. 🔴 Memory Leaks\n\n### Issue: Unbounded Ref Growth\n`processedIds.current` in hooks grows infinitely.\n\n**Fix:**\n```typescript\n// src/hooks/use-action-cards.ts\nexport function useActionCards(snapshot: A0Snapshot | null): UseActionCardsReturn {\n  const [cards, setCards] = useState<ActionCard[]>([]);\n  const processedIds = useRef(new Set<string>());\n  const MAX_PROCESSED_IDS = 1000;  // NEW: Limit cache size\n\n  useEffect(() => {\n    if (!snapshot) return;\n    \n    // ... process logs\n    \n    // ✅ Prevent unbounded growth\n    if (processedIds.current.size > MAX_PROCESSED_IDS) {\n      // Keep only the most recent IDs\n      const idsArray = Array.from(processedIds.current);\n      processedIds.current = new Set(idsArray.slice(-MAX_PROCESSED_IDS / 2));\n    }\n  }, [snapshot]);\n  \n  // ✅ Clear on unmount\n  useEffect(() => {\n    return () => {\n      processedIds.current.clear();\n    };\n  }, []);\n}\n```\n\n### Issue: Socket Connection Not Fully Cleaned\nSocket persists even after component unmount.\n\n**Fix:**\n```typescript\n// src/components/socket-provider.tsx\nexport function SocketProvider({ children }: { children: React.ReactNode }) {\n  const [state, setState] = useState<SocketState>({\n    connected: false,\n    snapshot: null,\n    chefStatus: null,\n  });\n\n  useEffect(() => {\n    const socket = initStateSyncSocket();\n    \n    // ... event listeners\n    \n    socket.connect();\n\n    return () => {\n      socket.off(\"connect\");\n      socket.off(\"disconnect\");\n      socket.off(\"state_push\");\n      socket.off(\"chef_status\");\n      socket.disconnect();\n      disconnectAll();  // ✅ Ensure full cleanup\n    };\n  }, []);\n}\n```\n\n---\n\n## 5. 🟡 Redundant Computations\n\n### Issue: Repeated String Operations\nParsing/formatting happens repeatedly for the same values.\n\n**Optimize with lookup table:**\n```typescript\n// src/lib/formatters.ts\nconst dateFormatCache = new Map<string, string>();\nconst MAX_CACHE_SIZE = 500;\n\nexport const formatDate = (v: unknown): string => {\n  if (!v || typeof v !== \"string\") return \"—\";\n  \n  // ✅ Check cache first\n  if (dateFormatCache.has(v)) {\n    return dateFormatCache.get(v)!;\n  }\n  \n  const d = new Date(v);\n  if (isNaN(d.getTime())) return \"—\";\n  \n  const formatted = d.toLocaleDateString(\"en-US\", { \n    month: \"short\", \n    day: \"numeric\" \n  });\n  \n  // ✅ Cache result\n  if (dateFormatCache.size > MAX_CACHE_SIZE) {\n    const firstKey = dateFormatCache.keys().next().value;\n    dateFormatCache.delete(firstKey);\n  }\n  dateFormatCache.set(v, formatted);\n  \n  return formatted;\n};\n```\n\n---\n\n## Priority Fixes (Highest Impact)\n\n1. **Add incremental log processing** in `use-chat.ts` and `use-action-cards.ts` → ~70% reduction in wasted iterations\n2. **Implement React Query** for API caching → Eliminate duplicate requests\n3. **Fix unbounded ref growth** → Prevent memory leaks in long sessions\n4. **Centralize formatters** → Reduce function recreation overhead\n5. **Add React.memo** to expensive list items in tables → Reduce re-render cascade\n\nThese optimizations will significantly improve performance, especially as the log arrays grow during long sessions.\n",
