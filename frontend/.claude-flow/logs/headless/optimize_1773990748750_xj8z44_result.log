        "language": "typescript",
        "code": "type ChatState = {\n  messages: ChatMessage[];\n  contextId: string | null;\n  loading: boolean;\n  queuedMessages: string[];\n};\n\ntype ChatAction =\n  | { type: 'ADD_MESSAGE'; payload: ChatMessage }\n  | { type: 'ADD_MESSAGES'; payload: ChatMessage[] }\n  | { type: 'SET_LOADING'; payload: boolean }\n  | { type: 'SET_CONTEXT'; payload: string | null }\n  | { type: 'QUEUE_MESSAGE'; payload: string }\n  | { type: 'DEQUEUE_MESSAGE' }\n  | { type: 'RESET' };\n\nfunction chatReducer(state: ChatState, action: ChatAction): ChatState {\n  switch (action.type) {\n    case 'ADD_MESSAGE':\n      return { ...state, messages: [...state.messages, action.payload] };\n    case 'ADD_MESSAGES':\n      return { ...state, messages: [...state.messages, ...action.payload] };\n    case 'SET_LOADING':\n      return { ...state, loading: action.payload };\n    case 'SET_CONTEXT':\n      return { ...state, contextId: action.payload };\n    case 'RESET':\n      return { messages: [], contextId: null, loading: false, queuedMessages: [] };\n    default:\n      return state;\n  }\n}\n\nexport function useChat(snapshot: A0Snapshot | null) {\n  const [state, dispatch] = useReducer(chatReducer, {\n    messages: [],\n    contextId: null,\n    loading: false,\n    queuedMessages: [],\n  });\n  \n  // ... use dispatch instead of individual setters\n}"
