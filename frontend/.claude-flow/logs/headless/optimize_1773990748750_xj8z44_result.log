        "language": "typescript",
        "code": "const workspaceCache = new Map<string, { data: unknown[]; timestamp: number }>();\nconst CACHE_TTL = 30000; // 30s\n\nexport function useWorkspace<T = Record<string, unknown>>(\n  endpoint: string,\n  locationId?: string,\n): UseWorkspaceReturn<T> {\n  const [data, setData] = useState<T[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n  const [refreshKey, setRefreshKey] = useState(0);\n  const abortControllerRef = useRef<AbortController | null>(null);\n\n  useEffect(() => {\n    const url = locationId ? `${endpoint}?location_id=${locationId}` : endpoint;\n    const cacheKey = url;\n    \n    // Check cache first\n    const cached = workspaceCache.get(cacheKey);\n    if (cached && Date.now() - cached.timestamp < CACHE_TTL) {\n      setData(cached.data as T[]);\n      setLoading(false);\n      return;\n    }\n\n    // Abort previous request\n    abortControllerRef.current?.abort();\n    abortControllerRef.current = new AbortController();\n\n    setLoading(true);\n    \n    fetch(url, { \n      credentials: \"include\",\n      signal: abortControllerRef.current.signal,\n    })\n      .then(async (res) => {\n        if (!res.ok) throw new Error(`${res.status}`);\n        const json = await res.json();\n        const items = Array.isArray(json) ? json : json.items ?? json.data ?? [];\n        \n        // Update cache\n        workspaceCache.set(cacheKey, { data: items, timestamp: Date.now() });\n        \n        setData(items);\n        setError(null);\n      })\n      .catch((err) => {\n        if (err.name === 'AbortError') return;\n        setError(err.message);\n        setData([]);\n      })\n      .finally(() => setLoading(false));\n      \n    return () => {\n      abortControllerRef.current?.abort();\n    };\n  }, [endpoint, locationId, refreshKey]);\n\n  return { \n    data, \n    loading, \n    error, \n    refresh: () => {\n      workspaceCache.delete(endpoint); // Clear cache on manual refresh\n      setRefreshKey((k) => k + 1);\n    }\n  };\n}"
