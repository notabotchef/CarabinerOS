        "language": "typescript",
        "code": "// use-action-cards.ts (optimized)\nexport function useActionCards(snapshot: A0Snapshot | null): UseActionCardsReturn {\n  const [cards, setCards] = useState<ActionCard[]>([]);\n  const lastProcessedVersion = useRef(0);\n\n  useEffect(() => {\n    if (!snapshot || snapshot.log_version === lastProcessedVersion.current) return;\n\n    const newCards: ActionCard[] = [];\n    \n    // Only process logs added since last version\n    for (const log of snapshot.logs) {\n      if (log.no < lastProcessedVersion.current) continue;\n      if (log.type !== \"tool\" || !log.kvps?.module || !log.kvps?.action) continue;\n\n      newCards.push({\n        id: log.id,\n        type: String(log.kvps.action),\n        module: String(log.kvps.module),\n        action: String(log.kvps.action),\n        itemId: log.kvps.item_id ? String(log.kvps.item_id) : undefined,\n        item: log.kvps.item as Record<string, unknown> | undefined,\n        summary: log.content.slice(0, 120),\n        timestamp: log.timestamp,\n        read: false,\n      });\n    }\n\n    if (newCards.length > 0) {\n      setCards(prev => [...prev, ...newCards]);\n    }\n    \n    lastProcessedVersion.current = snapshot.log_version;\n  }, [snapshot?.log_version]); // Only re-run when version changes\n\n  // ... rest\n}"
