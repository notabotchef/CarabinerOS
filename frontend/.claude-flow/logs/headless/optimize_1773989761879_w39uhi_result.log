        "language": "typescript",
        "code": "// hooks/use-processed-logs.ts\ninterface ProcessedLogs {\n  messages: ChatMessage[];\n  cards: ActionCard[];\n  expoData: { thoughts: string[]; headline: string | null; step: string | null };\n}\n\nexport function useProcessedLogs(snapshot: A0Snapshot | null): ProcessedLogs {\n  return useMemo(() => {\n    if (!snapshot?.logs) {\n      return { messages: [], cards: [], expoData: { thoughts: [], headline: null, step: null } };\n    }\n\n    const messages: ChatMessage[] = [];\n    const cards: ActionCard[] = [];\n    let expoData = { thoughts: [] as string[], headline: null as string | null, step: null as string | null };\n\n    // Single pass through logs\n    for (const log of snapshot.logs) {\n      // Extract messages\n      if (log.type === \"user\" || (log.type === \"response\" && log.content.trim())) {\n        messages.push({\n          id: log.id ?? `no-${log.no}`,\n          role: log.type === \"user\" ? \"user\" : \"assistant\",\n          content: log.content,\n          timestamp: log.timestamp,\n        });\n      }\n\n      // Extract action cards\n      if (log.type === \"tool\" && log.kvps?.module && log.kvps?.action) {\n        cards.push({\n          id: log.id,\n          type: String(log.kvps.action),\n          module: String(log.kvps.module),\n          action: String(log.kvps.action),\n          summary: log.content.slice(0, 120),\n          timestamp: log.timestamp,\n          read: false,\n        });\n      }\n\n      // Extract expo data (latest wins)\n      if (log.type === \"agent\" && log.kvps) {\n        const thoughts = log.kvps.thoughts as string[] | undefined;\n        const headline = log.kvps.headline as string | undefined;\n        const step = log.kvps.step as string | undefined;\n        \n        if (thoughts || headline || step) {\n          expoData = {\n            thoughts: thoughts ?? expoData.thoughts,\n            headline: headline ?? expoData.headline,\n            step: step ?? expoData.step,\n          };\n        }\n      }\n    }\n\n    return { messages, cards, expoData };\n  }, [snapshot?.log_version]); // Only recompute when logs change\n}"
