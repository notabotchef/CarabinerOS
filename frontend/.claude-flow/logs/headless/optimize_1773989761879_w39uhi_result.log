        "language": "typescript",
        "code": "export function useChat(snapshot: A0Snapshot | null): UseChatReturn {\n  // ... state\n  const contextIdRef = useRef<string | null>(null);\n  const isProcessingRef = useRef(false);\n\n  // Stable callback - only recreated if nothing changes\n  const doSend = useCallback(async (text: string): Promise<string> => {\n    freshChatRef.current = false;\n    \n    const userMsg: ChatMessage = {\n      id: crypto.randomUUID(),\n      role: \"user\",\n      content: text,\n      timestamp: Date.now() / 1000,\n    };\n    \n    setMessages(prev => [...prev, userMsg]);\n    setLoading(true);\n    isProcessingRef.current = true;\n\n    try {\n      const csrf = await getCsrfToken();\n      const res = await fetch(\"/message_async\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\", \"X-CSRF-Token\": csrf },\n        credentials: \"include\",\n        body: JSON.stringify({ text, context: contextIdRef.current || \"\" }),\n      });\n\n      if (!res.ok) throw new Error(`Agent Zero returned ${res.status}`);\n\n      const data = await res.json();\n      const newContextId = data.context || contextIdRef.current;\n      if (newContextId) {\n        setContextId(newContextId);\n        contextIdRef.current = newContextId;\n      }\n      return newContextId || \"\";\n    } catch {\n      // ... error handling\n    } finally {\n      isProcessingRef.current = false;\n      setLoading(false);\n    }\n  }, []); // Empty deps - uses refs for dynamic values\n\n  const sendMessage = useCallback(\n    async (text: string): Promise<string> => {\n      if (isProcessingRef.current) {\n        setQueuedMessages(prev => [...prev, text]);\n        setMessages(prev => [...prev, {\n          id: crypto.randomUUID(),\n          role: \"user\",\n          content: text,\n          timestamp: Date.now() / 1000,\n        }]);\n        return contextIdRef.current || \"\";\n      }\n      return doSend(text);\n    },\n    [doSend]\n  );\n\n  return { messages, sendMessage, contextId, loading, queuedMessages, resetChat };\n}"
