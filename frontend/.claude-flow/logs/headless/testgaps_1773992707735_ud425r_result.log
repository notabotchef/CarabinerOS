        "language": "typescript",
        "code": "// __tests__/lib/expo-messages.test.ts\nimport { getExpoMessage, getCompletionMessage } from '@/lib/expo-messages';\nimport type { A0LogEntry } from '@/lib/types';\n\ndescribe('expo-messages', () => {\n  it('should return tool-specific message', () => {\n    const log: A0LogEntry = {\n      type: 'tool',\n      heading: 'Using food_cost_tool...',\n      content: '',\n      // ... other fields\n    };\n\n    const message = getExpoMessage(log);\n    expect(message).toMatch(/Crunching|checking/i);\n  });\n\n  it('should return default message for unknown tool', () => {\n    const log: A0LogEntry = {\n      type: 'tool',\n      heading: 'Using unknown_tool...',\n      // ... other fields\n    };\n\n    const message = getExpoMessage(log);\n    expect(message).toBeTruthy();\n  });\n\n  it('should handle agent/subagent logs', () => {\n    const log: A0LogEntry = {\n      type: 'agent',\n      heading: 'Chef Assistant',\n      // ... other fields\n    };\n\n    const message = getExpoMessage(log);\n    expect(message).toContain('Delegating');\n  });\n\n  it('should return null for irrelevant log types', () => {\n    const log: A0LogEntry = {\n      type: 'user',\n      heading: '',\n      content: 'Hello',\n      // ... other fields\n    };\n\n    const message = getExpoMessage(log);\n    expect(message).toBeNull();\n  });\n\n  it('should return completion messages', () => {\n    const message = getCompletionMessage();\n    expect(['Heard.', 'Service.', 'All set.', 'Done, Chef.']).toContain(message);\n  });\n\n  it('should handle progress logs', () => {\n    const log: A0LogEntry = {\n      type: 'progress',\n      content: 'Processing step 2 of 5',\n      // ... other fields\n    };\n\n    const message = getExpoMessage(log);\n    expect(message).toBe('Processing step 2 of 5');\n  });\n});"
