        "title": "Test Skeleton",
        "content": "\n```typescript\n// __tests__/lib/socket-client.test.ts\nimport { initStateSyncSocket, getStateSyncSocket, disconnectAll } from '@/lib/socket-client';\nimport { getCsrfToken, clearCsrfToken } from '@/lib/csrf';\nimport { io } from 'socket.io-client';\n\njest.mock('socket.io-client');\njest.mock('@/lib/csrf');\n\ndescribe('socket-client', () => {\n  let mockSocket: any;\n\n  beforeEach(() => {\n    mockSocket = {\n      on: jest.fn(),\n      disconnect: jest.fn(),\n    };\n    \n    (io as jest.Mock).mockReturnValue(mockSocket);\n    (getCsrfToken as jest.Mock).mockResolvedValue('test-token');\n  });\n\n  it('should initialize socket with correct config', () => {\n    initStateSyncSocket();\n    \n    expect(io).toHaveBeenCalledWith(\n      expect.stringContaining('/state_sync'),\n      expect.objectContaining({\n        autoConnect: false,\n        transports: ['polling', 'websocket'],\n        withCredentials: true,\n      })\n    );\n  });\n\n  it('should return singleton instance', () => {\n    const socket1 = initStateSyncSocket();\n    const socket2 = initStateSyncSocket();\n    \n    expect(socket1).toBe(socket2);\n    expect(io).toHaveBeenCalledTimes(1);\n  });\n\n  it('should fetch CSRF token in auth callback', async () => {\n    const authCallback = jest.fn();\n    (io as jest.Mock).mockImplementationOnce((url, opts) => {\n      opts.auth(authCallback);\n      return mockSocket;\n    });\n\n    initStateSyncSocket();\n    \n    await new Promise(resolve => setTimeout(resolve, 0));\n    \n    expect(getCsrfToken).toHaveBeenCalled();\n    expect(authCallback).toHaveBeenCalledWith({ csrf_token: 'test-token' });\n  });\n\n  it('should clear CSRF token on connect_error', () => {\n    initStateSyncSocket();\n    \n    const errorHandler = mockSocket.on.mock.calls.find(\n      ([event]) => event === 'connect_error'\n    )?.[1];\n    \n    errorHandler?.();\n    \n    expect(clearCsrfToken).toHaveBeenCalled();\n  });\n\n  it('should disconnect socket on disconnectAll', () => {\n    initStateSyncSocket();\n    disconnectAll();\n    \n    expect(mockSocket.disconnect).toHaveBeenCalled();\n    expect(getStateSyncSocket()).toBeNull();\n  });\n\n  it('should handle CSRF fetch failure in auth', async () => {\n    (getCsrfToken as jest.Mock).mockRejectedValueOnce(new Error('CSRF failed'));\n    \n    const authCallback = jest.fn();\n    (io as jest.Mock).mockImplementationOnce((url, opts) => {\n      opts.auth(authCallback);\n      return mockSocket;\n    });\n\n    initStateSyncSocket();\n    await new Promise(resolve => setTimeout(resolve, 0));\n    \n    // Should call callback with empty object on error\n    expect(authCallback).toHaveBeenCalledWith({});\n  });\n});\n```\n\n---\n\n",
