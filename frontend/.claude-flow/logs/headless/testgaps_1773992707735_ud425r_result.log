        "code": "// __tests__/lib/csrf.test.ts\nimport { getCsrfToken, clearCsrfToken, getRuntimeId } from '@/lib/csrf';\n\ndescribe('csrf', () => {\n  beforeEach(() => {\n    global.fetch = jest.fn();\n    document.cookie = '';\n    clearCsrfToken();\n  });\n\n  it('should fetch and cache CSRF token', async () => {\n    (global.fetch as jest.Mock).mockResolvedValueOnce({\n      json: async () => ({ ok: true, token: 'token-123', runtime_id: 'rt-456' }),\n    });\n\n    const token = await getCsrfToken();\n    \n    expect(token).toBe('token-123');\n    expect(global.fetch).toHaveBeenCalledTimes(1);\n\n    // Second call should use cache\n    const token2 = await getCsrfToken();\n    expect(token2).toBe('token-123');\n    expect(global.fetch).toHaveBeenCalledTimes(1);\n  });\n\n  it('should set csrf_token cookie with runtime_id', async () => {\n    (global.fetch as jest.Mock).mockResolvedValueOnce({\n      json: async () => ({ ok: true, token: 'token-123', runtime_id: 'rt-456' }),\n    });\n\n    await getCsrfToken();\n    \n    expect(document.cookie).toContain('csrf_token_rt-456=token-123');\n  });\n\n  it('should handle concurrent getCsrfToken calls', async () => {\n    (global.fetch as jest.Mock).mockResolvedValueOnce({\n      json: async () => ({ ok: true, token: 'token-123', runtime_id: 'rt-456' }),\n    });\n\n    const [token1, token2] = await Promise.all([\n      getCsrfToken(),\n      getCsrfToken(),\n    ]);\n\n    expect(token1).toBe(token2);\n    expect(global.fetch).toHaveBeenCalledTimes(1);\n  });\n\n  it('should throw on API error', async () => {\n    (global.fetch as jest.Mock).mockResolvedValueOnce({\n      json: async () => ({ ok: false, error: 'Unauthorized' }),\n    });\n\n    await expect(getCsrfToken()).rejects.toThrow('Unauthorized');\n  });\n\n  it('should clear cached token', () => {\n    clearCsrfToken();\n    expect(getRuntimeId()).toBeNull();\n  });\n\n  it('should handle network errors', async () => {\n    (global.fetch as jest.Mock).mockRejectedValueOnce(new Error('Network error'));\n    await expect(getCsrfToken()).rejects.toThrow();\n  });\n});"
      },
