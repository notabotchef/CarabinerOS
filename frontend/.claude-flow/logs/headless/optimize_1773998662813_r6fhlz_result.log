      {
        "language": "typescript",
        "code": "// src/lib/workspace-cache.ts\nconst cache = new Map<string, {\n  data: unknown;\n  timestamp: number;\n  promise: Promise<unknown> | null;\n}>();\n\nconst CACHE_TIME = 5000; // 5 seconds\n\nexport async function fetchWorkspace<T>(\n  endpoint: string,\n  locationId?: string\n): Promise<T[]> {\n  const url = locationId\n    ? `${endpoint}?location_id=${locationId}`\n    : endpoint;\n\n  const cached = cache.get(url);\n  const now = Date.now();\n\n  // Return cached data if fresh\n  if (cached && now - cached.timestamp < CACHE_TIME) {\n    return cached.data as T[];\n  }\n\n  // Deduplicate in-flight requests\n  if (cached?.promise) {\n    return cached.promise as Promise<T[]>;\n  }\n\n  const promise = fetch(url, { credentials: \"include\" })\n    .then(async (res) => {\n      if (!res.ok) throw new Error(`${res.status}`);\n      const json = await res.json();\n      const data = Array.isArray(json) ? json : json.items ?? json.data ?? [];\n      \n      cache.set(url, { data, timestamp: Date.now(), promise: null });\n      return data;\n    });\n\n  cache.set(url, { data: cached?.data ?? [], timestamp: cached?.timestamp ?? 0, promise });\n  return promise;\n}"
