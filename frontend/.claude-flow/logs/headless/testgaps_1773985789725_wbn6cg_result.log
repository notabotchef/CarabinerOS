        "title": "Test Skeleton",
        "content": "\n```typescript\n// src/hooks/__tests__/use-expo-stream.test.ts\nimport { renderHook, act } from '@testing-library/react';\nimport { useExpoStream } from '../use-expo-stream';\nimport type { A0Snapshot, ChefStatus } from '@/lib/types';\n\njest.useFakeTimers();\n\ndescribe('useExpoStream', () => {\n  describe('chefStatus priority', () => {\n    it('should show chefStatus text when active', () => {\n      const chefStatus: ChefStatus = {\n        status: 'working',\n        tool: 'food_cost_tool',\n        text: 'Calculating costs...',\n        active: true,\n      };\n\n      const { result } = renderHook(() => useExpoStream(null, chefStatus));\n      \n      expect(result.current.text).toBe('Calculating costs...');\n      expect(result.current.active).toBe(true);\n    });\n\n    it('should fade out after 3 seconds when inactive', () => {\n      const chefStatus: ChefStatus = {\n        status: 'completed',\n        text: 'Done',\n        active: false,\n      };\n\n      const { result } = renderHook(() => useExpoStream(null, chefStatus));\n      \n      expect(result.current.text).toBe('Done');\n      expect(result.current.active).toBe(false);\n\n      act(() => {\n        jest.advanceTimersByTime(3000);\n      });\n\n      expect(result.current.text).toBeNull();\n    });\n\n    it('should cancel fade timer if status becomes active again', () => {\n      const { result, rerender } = renderHook(\n        ({ status }) => useExpoStream(null, status),\n        {\n          initialProps: {\n            status: {\n              status: 'completed' as const,\n              text: 'Done',\n              active: false,\n            },\n          },\n        }\n      );\n\n      act(() => {\n        jest.advanceTimersByTime(1000);\n      });\n\n      // Reactivate before fade completes\n      rerender({\n        status: {\n          status: 'working' as const,\n          text: 'Working again',\n          active: true,\n        },\n      });\n\n      act(() => {\n        jest.advanceTimersByTime(5000);\n      });\n\n      // Should still be showing the new text\n      expect(result.current.text).toBe('Working again');\n      expect(result.current.active).toBe(true);\n    });\n  });\n\n  describe('snapshot fallback', () => {\n    it('should use snapshot progress when no chefStatus', () => {\n      const snapshot: A0Snapshot = {\n        log_progress: 'icon://chat A0: Responding',\n        log_progress_active: true,\n        logs: [],\n      };\n\n      const { result } = renderHook(() => useExpoStream(snapshot, null));\n      \n      expect(result.current.text).toBe('Responding');\n      expect(result.current.active).toBe(true);\n    });\n\n    it('should clean Agent Zero prefixes from progress text', () => {\n      const snapshot: A0Snapshot = {\n        log_progress: 'icon://tool A0: Using food_cost_tool',\n        log_progress_active: true,\n        logs: [],\n      };\n\n      const { result } = renderHook(() => useExpoStream(snapshot, null));\n      \n      expect(result.current.text).toBe('Using food_cost_tool');\n    });\n\n    it('should handle numeric progress values', () => {\n      const snapshot: A0Snapshot = {\n        log_progress: 42,\n        log_progress_active: true,\n        logs: [],\n      };\n\n      const { result } = renderHook(() => useExpoStream(snapshot, null));\n      \n      expect(result.current.text).toBe('Working...');\n    });\n\n    it('should show Done and fade when progress becomes inactive', () => {\n      const snapshot: A0Snapshot = {\n        log_progress: 'Processing',\n        log_progress_active: false,\n        logs: [],\n      };\n\n      const { result } = renderHook(() => useExpoStream(snapshot, null));\n      \n      expect(result.current.text).toBe('Done');\n      expect(result.current.active).toBe(false);\n\n      act(() => {\n        jest.advanceTimersByTime(2000);\n      });\n\n      expect(result.current.text).toBeNull();\n    });\n  });\n\n  describe('cleanProgressText helper', () => {\n    // This would be tested if exported, but it's internal\n    // We can test it indirectly through useExpoStream\n    \n    it('should remove icon:// prefix', () => {\n      const snapshot: A0Snapshot = {\n        log_progress: 'icon://chat Some text',\n        log_progress_active: true,\n        logs: [],\n      };\n\n      const { result } = renderHook(() => useExpoStream(snapshot, null));\n      expect(result.current.text).not.toContain('icon://');\n    });\n\n    it('should remove A0: prefix', () => {\n      const snapshot: A0Snapshot = {\n        log_progress: 'A0: Doing something',\n        log_progress_active: true,\n        logs: [],\n      };\n\n      const { result } = renderHook(() => useExpoStream(snapshot, null));\n      expect(result.current.text).toBe('Doing something');\n    });\n\n    it('should handle empty string and return default', () => {\n      const snapshot: A0Snapshot = {\n        log_progress: '',\n        log_progress_active: true,\n        logs: [],\n      };\n\n      const { result } = renderHook(() => useExpoStream(snapshot, null));\n      expect(result.current.text).toBe('Working...');\n    });\n  });\n\n  describe('edge cases', () => {\n    it('should handle null chefStatus and null snapshot', () => {\n      const { result } = renderHook(() => useExpoStream(null, null));\n      \n      expect(result.current.text).toBeNull();\n      expect(result.current.active).toBe(false);\n    });\n\n    it('should prioritize chefStatus over snapshot', () => {\n      const snapshot: A0Snapshot = {\n        log_progress: 'Snapshot progress',\n        log_progress_active: true,\n        logs: [],\n      };\n\n      const chefStatus: ChefStatus = {\n        status: 'working',\n        text: 'Chef status',\n        active: true,\n      };\n\n      const { result } = renderHook(() => useExpoStream(snapshot, chefStatus));\n      \n      expect(result.current.text).toBe('Chef status');\n    });\n  });\n\n  describe('timer cleanup', () => {\n    it('should cleanup timer on unmount', () => {\n      const chefStatus: ChefStatus = {\n        status: 'completed',\n        text: 'Done',\n        active: false,\n      };\n\n      const { unmount } = renderHook(() => useExpoStream(null, chefStatus));\n      \n      unmount();\n\n      // If timer wasn't cleaned up, this would cause issues\n      act(() => {\n        jest.advanceTimersByTime(5000);\n      });\n      \n      // Test passes if no errors thrown\n    });\n  });\n});\n```\n\n---\n\n",
