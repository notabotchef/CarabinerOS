        "content": "\n```typescript\n// src/hooks/__tests__/use-action-cards.test.ts\nimport { renderHook, act } from '@testing-library/react';\nimport { useActionCards } from '../use-action-cards';\nimport type { A0Snapshot, A0LogEntry } from '@/lib/types';\n\ndescribe('useActionCards', () => {\n  const mockToolLog: A0LogEntry = {\n    no: 1,\n    id: 'log-1',\n    type: 'tool',\n    heading: 'Using food_cost_tool',\n    content: 'Calculating food costs...',\n    kvps: { module: 'food_cost', action: 'calculate', item_id: '123' },\n    timestamp: 1234567890,\n    agentno: 0,\n  };\n\n  describe('card extraction', () => {\n    it('should extract action cards from tool logs with kvps', () => {\n      const snapshot: A0Snapshot = {\n        logs: [mockToolLog],\n        // ... other required fields\n      };\n      const { result } = renderHook(() => useActionCards(snapshot));\n      expect(result.current.cards).toHaveLength(1);\n      expect(result.current.cards[0].module).toBe('food_cost');\n    });\n\n    it('should ignore logs without module or action', () => {\n      const snapshot: A0Snapshot = {\n        logs: [{ ...mockToolLog, kvps: { module: 'test' } }], // missing action\n      };\n      const { result } = renderHook(() => useActionCards(snapshot));\n      expect(result.current.cards).toHaveLength(0);\n    });\n\n    it('should ignore non-tool logs', () => {\n      const snapshot: A0Snapshot = {\n        logs: [{ ...mockToolLog, type: 'user' }],\n      };\n      const { result } = renderHook(() => useActionCards(snapshot));\n      expect(result.current.cards).toHaveLength(0);\n    });\n\n    it('should handle logs without kvps', () => {\n      const snapshot: A0Snapshot = {\n        logs: [{ ...mockToolLog, kvps: undefined as any }],\n      };\n      const { result } = renderHook(() => useActionCards(snapshot));\n      expect(result.current.cards).toHaveLength(0);\n    });\n  });\n\n  describe('duplicate prevention', () => {\n    it('should not process the same log twice', () => {\n      const snapshot: A0Snapshot = { logs: [mockToolLog] };\n      const { result, rerender } = renderHook(() => useActionCards(snapshot));\n      \n      expect(result.current.cards).toHaveLength(1);\n      rerender();\n      expect(result.current.cards).toHaveLength(1); // should not duplicate\n    });\n\n    it('should handle logs with same content but different IDs', () => {\n      const log1 = { ...mockToolLog, id: 'log-1' };\n      const log2 = { ...mockToolLog, id: 'log-2' };\n      const snapshot: A0Snapshot = { logs: [log1, log2] };\n      const { result } = renderHook(() => useActionCards(snapshot));\n      expect(result.current.cards).toHaveLength(2);\n    });\n  });\n\n  describe('read state management', () => {\n    it('should mark a card as read', () => {\n      const snapshot: A0Snapshot = { logs: [mockToolLog] };\n      const { result } = renderHook(() => useActionCards(snapshot));\n      \n      expect(result.current.unreadCount).toBe(1);\n      act(() => result.current.markRead('log-1'));\n      expect(result.current.unreadCount).toBe(0);\n      expect(result.current.cards[0].read).toBe(true);\n    });\n\n    it('should mark all cards as read', () => {\n      const snapshot: A0Snapshot = {\n        logs: [\n          mockToolLog,\n          { ...mockToolLog, id: 'log-2', no: 2 },\n        ],\n      };\n      const { result } = renderHook(() => useActionCards(snapshot));\n      \n      expect(result.current.unreadCount).toBe(2);\n      act(() => result.current.markAllRead());\n      expect(result.current.unreadCount).toBe(0);\n    });\n\n    it('should not affect other cards when marking one as read', () => {\n      const snapshot: A0Snapshot = {\n        logs: [\n          mockToolLog,\n          { ...mockToolLog, id: 'log-2', no: 2 },\n        ],\n      };\n      const { result } = renderHook(() => useActionCards(snapshot));\n      \n      act(() => result.current.markRead('log-1'));\n      expect(result.current.cards[0].read).toBe(true);\n      expect(result.current.cards[1].read).toBe(false);\n    });\n  });\n\n  describe('edge cases', () => {\n    it('should handle null snapshot', () => {\n      const { result } = renderHook(() => useActionCards(null));\n      expect(result.current.cards).toHaveLength(0);\n      expect(result.current.unreadCount).toBe(0);\n    });\n\n    it('should handle snapshot with empty logs array', () => {\n      const snapshot: A0Snapshot = { logs: [] };\n      const { result } = renderHook(() => useActionCards(snapshot));\n      expect(result.current.cards).toHaveLength(0);\n    });\n\n    it('should truncate long summaries to 120 chars', () => {\n      const longContent = 'a'.repeat(200);\n      const log = { ...mockToolLog, content: longContent };\n      const snapshot: A0Snapshot = { logs: [log] };\n      const { result } = renderHook(() => useActionCards(snapshot));\n      expect(result.current.cards[0].summary).toHaveLength(120);\n    });\n\n    it('should handle optional item and itemId fields', () => {\n      const logWithItem = {\n        ...mockToolLog,\n        kvps: {\n          module: 'test',\n          action: 'test',\n          item_id: '123',\n          item: { name: 'Test Item' },\n        },\n      };\n      const snapshot: A0Snapshot = { logs: [logWithItem] };\n      const { result } = renderHook(() => useActionCards(snapshot));\n      expect(result.current.cards[0].itemId).toBe('123');\n      expect(result.current.cards[0].item).toEqual({ name: 'Test Item' });\n    });\n  });\n\n  describe('memory management', () => {\n    it('should not leak memory with processedIds Set', () => {\n      // Test that processedIds grows but doesn't cause issues\n      // In a real scenario, this would need a cleanup mechanism\n      const logs = Array.from({ length: 1000 }, (_, i) => ({\n        ...mockToolLog,\n        id: `log-${i}`,\n        no: i,\n      }));\n      const snapshot: A0Snapshot = { logs };\n      const { result } = renderHook(() => useActionCards(snapshot));\n      expect(result.current.cards).toHaveLength(1000);\n    });\n  });\n});\n```\n\n---\n\n",
