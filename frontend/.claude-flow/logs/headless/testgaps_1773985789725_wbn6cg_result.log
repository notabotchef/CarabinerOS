        "language": "typescript",
        "code": "// src/hooks/__tests__/use-mobile.test.ts\nimport { renderHook, act } from '@testing-library/react';\nimport { useIsMobile } from '../use-mobile';\n\ndescribe('useIsMobile', () => {\n  const originalInnerWidth = window.innerWidth;\n\n  beforeEach(() => {\n    // Reset window size\n    Object.defineProperty(window, 'innerWidth', {\n      writable: true,\n      configurable: true,\n      value: 1024,\n    });\n  });\n\n  afterEach(() => {\n    Object.defineProperty(window, 'innerWidth', {\n      writable: true,\n      configurable: true,\n      value: originalInnerWidth,\n    });\n  });\n\n  describe('initial state', () => {\n    it('should return false for desktop width', () => {\n      window.innerWidth = 1024;\n      const { result } = renderHook(() => useIsMobile());\n      expect(result.current).toBe(false);\n    });\n\n    it('should return true for mobile width', () => {\n      window.innerWidth = 375;\n      const { result } = renderHook(() => useIsMobile());\n      expect(result.current).toBe(true);\n    });\n\n    it('should return false for exact breakpoint', () => {\n      window.innerWidth = 768;\n      const { result } = renderHook(() => useIsMobile());\n      expect(result.current).toBe(false);\n    });\n\n    it('should return true for one pixel below breakpoint', () => {\n      window.innerWidth = 767;\n      const { result } = renderHook(() => useIsMobile());\n      expect(result.current).toBe(true);\n    });\n\n    it('should start as undefined before effect runs', () => {\n      const { result } = renderHook(() => useIsMobile());\n      // After effect runs, should be boolean\n      expect(typeof result.current).toBe('boolean');\n    });\n  });\n\n  describe('resize handling', () => {\n    it('should update when window is resized to mobile', () => {\n      window.innerWidth = 1024;\n      const { result } = renderHook(() => useIsMobile());\n      \n      expect(result.current).toBe(false);\n\n      act(() => {\n        window.innerWidth = 375;\n        window.dispatchEvent(new Event('change'));\n        // Trigger media query change\n        const mql = window.matchMedia('(max-width: 767px)');\n        mql.dispatchEvent(new Event('change'));\n      });\n\n      // Note: This test may need adjustment based on how matchMedia is mocked\n    });\n\n    it('should update when window is resized to desktop', () => {\n      window.innerWidth = 375;\n      const { result } = renderHook(() => useIsMobile());\n      \n      expect(result.current).toBe(true);\n\n      act(() => {\n        window.innerWidth = 1024;\n        const mql = window.matchMedia('(max-width: 767px)');\n        mql.dispatchEvent(new Event('change'));\n      });\n    });\n\n    it('should handle multiple rapid resizes', () => {\n      const { result } = renderHook(() => useIsMobile());\n      \n      act(() => {\n        window.innerWidth = 375;\n        window.dispatchEvent(new Event('resize'));\n        window.innerWidth = 1024;\n        window.dispatchEvent(new Event('resize'));\n        window.innerWidth = 500;\n        window.dispatchEvent(new Event('resize'));\n      });\n\n      // Should reflect final state\n      expect(typeof result.current).toBe('boolean');\n    });\n  });\n\n  describe('cleanup', () => {\n    it('should remove event listener on unmount', () => {\n      const removeEventListenerSpy = jest.spyOn(\n        window.matchMedia('(max-width: 767px)'),\n        'removeEventListener'\n      );\n\n      const { unmount } = renderHook(() => useIsMobile());\n      unmount();\n\n      expect(removeEventListenerSpy).toHaveBeenCalled();\n    });\n  });\n\n  describe('edge cases', () => {\n    it('should handle missing matchMedia', () => {\n      const originalMatchMedia = window.matchMedia;\n      (window.matchMedia as any) = undefined;\n\n      const { result } = renderHook(() => useIsMobile());\n      \n      // Should not crash\n      expect(typeof result.current).toBe('boolean');\n\n      window.matchMedia = originalMatchMedia;\n    });\n\n    it('should handle very small widths', () => {\n      window.innerWidth = 320;\n      const { result } = renderHook(() => useIsMobile());\n      expect(result.current).toBe(true);\n    });\n\n    it('should handle very large widths', () => {\n      window.innerWidth = 3840; // 4K\n      const { result } = renderHook(() => useIsMobile());\n      expect(result.current).toBe(false);\n    });\n  });\n});"
