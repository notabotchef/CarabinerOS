        "title": "9. socket-client.ts",
        "content": "\n",
        "level": 2
      },
      {
        "title": "Test Skeleton",
        "content": "\n```typescript\n// src/lib/__tests__/socket-client.test.ts\nimport { io, Socket } from 'socket.io-client';\nimport { initStateSyncSocket, getStateSyncSocket, disconnectAll } from '../socket-client';\nimport * as csrfModule from './csrf';\n\njest.mock('socket.io-client');\njest.mock('./csrf');\n\ndescribe('socket-client', () => {\n  let mockSocket: Partial<Socket>;\n\n  beforeEach(() => {\n    jest.clearAllMocks();\n    mockSocket = {\n      connected: false,\n      disconnect: jest.fn(),\n      on: jest.fn(),\n    };\n    (io as jest.Mock).mockReturnValue(mockSocket);\n    (csrfModule.getCsrfToken as jest.Mock).mockResolvedValue('mock-token');\n    (csrfModule.clearCsrfToken as jest.Mock).mockImplementation(() => {});\n  });\n\n  describe('initStateSyncSocket', () => {\n    it('should create socket with correct configuration', () => {\n      initStateSyncSocket();\n\n      expect(io).toHaveBeenCalledWith(\n        '/state_sync',\n        expect.objectContaining({\n          autoConnect: false,\n          transports: ['polling', 'websocket'],\n          withCredentials: true,\n        })\n      );\n    });\n\n    it('should return same instance on multiple calls', () => {\n      const socket1 = initStateSyncSocket();\n      const socket2 = initStateSyncSocket();\n\n      expect(socket1).toBe(socket2);\n      expect(io).toHaveBeenCalledTimes(1);\n    });\n\n    it('should configure auth callback', () => {\n      initStateSyncSocket();\n\n      const config = (io as jest.Mock).mock.calls[0][1];\n      expect(config.auth).toBeInstanceOf(Function);\n    });\n\n    it('should fetch CSRF token in auth callback', async () => {\n      initStateSyncSocket();\n\n      const config = (io as jest.Mock).mock.calls[0][1];\n      const callback = jest.fn();\n      \n      await config.auth(callback);\n\n      expect(csrfModule.getCsrfToken).toHaveBeenCalled();\n      expect(callback).toHaveBeenCalledWith({ csrf_token: 'mock-token' });\n    });\n\n    it('should handle CSRF token fetch failure in auth', async () => {\n      (csrfModule.getCsrfToken as jest.Mock).mockRejectedValueOnce(\n        new Error('CSRF failed')\n      );\n\n      const consoleSpy = jest.spyOn(console, 'error').mockImplementation();\n      initStateSyncSocket();\n\n      const config = (io as jest.Mock).mock.calls[0][1];\n      const callback = jest.fn();\n      \n      await config.auth(callback);\n\n      expect(consoleSpy).toHaveBeenCalledWith(\n        expect.stringContaining('CSRF token fetch failed'),\n        expect.any(Error)\n      );\n      expect(callback).toHaveBeenCalledWith({});\n\n      consoleSpy.mockRestore();\n    });\n\n    it('should setup connect_error handler', () => {\n      initStateSyncSocket();\n\n      expect(mockSocket.on).toHaveBeenCalledWith('connect_error', expect.any(Function));\n    });\n\n    it('should clear CSRF token on connect_error', () => {\n      initStateSyncSocket();\n\n      const connectErrorHandler = (mockSocket.on as jest.Mock).mock.calls.find(\n        call => call[0] === 'connect_error'\n      )?.[1];\n\n      connectErrorHandler();\n\n      expect(csrfModule.clearCsrfToken).toHaveBeenCalled();\n    });\n\n    it('should use NEXT_PUBLIC_A0_URL if provided', () => {\n      const originalEnv = process.env.NEXT_PUBLIC_A0_URL;\n      process.env.NEXT_PUBLIC_A0_URL = 'http://localhost:5000';\n\n      // Reset module to pick up new env\n      jest.resetModules();\n      const { initStateSyncSocket } = require('../socket-client');\n      initStateSyncSocket();\n\n      expect(io).toHaveBeenCalledWith(\n        'http://localhost:5000/state_sync',\n        expect.any(Object)\n      );\n\n      process.env.NEXT_PUBLIC_A0_URL = originalEnv;\n    });\n\n    it('should use empty string for URL in production', () => {\n      const originalEnv = process.env.NEXT_PUBLIC_A0_URL;\n      delete process.env.NEXT_PUBLIC_A0_URL;\n\n      jest.resetModules();\n      const { initStateSyncSocket } = require('../socket-client');\n      initStateSyncSocket();\n\n      expect(io).toHaveBeenCalledWith(\n        '/state_sync',\n        expect.any(Object)\n      );\n\n      process.env.NEXT_PUBLIC_A0_URL = originalEnv;\n    });\n  });\n\n  describe('getStateSyncSocket', () => {\n    it('should return null before init', () => {\n      expect(getStateSyncSocket()).toBeNull();\n    });\n\n    it('should return socket after init', () => {\n      initStateSyncSocket();\n      const socket = getStateSyncSocket();\n\n      expect(socket).toBe(mockSocket);\n    });\n  });\n\n  describe('disconnectAll', () => {\n    it('should disconnect and clear socket', () => {\n      initStateSyncSocket();\n      \n      disconnectAll();\n\n      expect(mockSocket.disconnect).toHaveBeenCalled();\n      expect(getStateSyncSocket()).toBeNull();\n    });\n\n    it('should handle disconnect when socket not initialized', () => {\n      expect(() => disconnectAll()).not.toThrow();\n    });\n\n    it('should allow reinit after disconnect', () => {\n      initStateSyncSocket();\n      disconnectAll();\n      \n      const newSocket = initStateSyncSocket();\n\n      expect(newSocket).toBeTruthy();\n      expect(io).toHaveBeenCalledTimes(2);\n    });\n  });\n\n  describe('transport configuration', () => {\n    it('should start with polling transport', () => {\n      initStateSyncSocket();\n\n      const config = (io as jest.Mock).mock.calls[0][1];\n      expect(config.transports[0]).toBe('polling');\n    });\n\n    it('should include websocket as fallback', () => {\n      initStateSyncSocket();\n\n      const config = (io as jest.Mock).mock.calls[0][1];\n      expect(config.transports).toContain('websocket');\n    });\n\n    it('should send credentials with requests', () => {\n      initStateSyncSocket();\n\n      const config = (io as jest.Mock).mock.calls[0][1];\n      expect(config.withCredentials).toBe(true);\n    });\n  });\n});\n```\n\n---\n\n",
