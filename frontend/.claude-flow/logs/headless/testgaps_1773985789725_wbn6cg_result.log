        "language": "typescript",
        "code": "// src/hooks/__tests__/use-chat.test.ts\nimport { renderHook, act, waitFor } from '@testing-library/react';\nimport { useChat } from '../use-chat';\nimport * as csrfModule from '@/lib/csrf';\nimport type { A0Snapshot } from '@/lib/types';\n\n// Mock fetch globally\nglobal.fetch = jest.fn();\njest.mock('@/lib/csrf');\n\ndescribe('useChat', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n    (csrfModule.getCsrfToken as jest.Mock).mockResolvedValue('mock-csrf-token');\n  });\n\n  describe('message sending', () => {\n    it('should send a message successfully', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => ({ context: 'ctx-123' }),\n      });\n\n      const { result } = renderHook(() => useChat(null));\n      \n      let contextId: string;\n      await act(async () => {\n        contextId = await result.current.sendMessage('Hello');\n      });\n\n      expect(result.current.messages).toHaveLength(1);\n      expect(result.current.messages[0].content).toBe('Hello');\n      expect(result.current.messages[0].role).toBe('user');\n      expect(contextId!).toBe('ctx-123');\n    });\n\n    it('should queue messages when already processing', async () => {\n      (global.fetch as jest.Mock).mockImplementation(\n        () => new Promise(resolve => setTimeout(() => resolve({\n          ok: true,\n          json: async () => ({ context: 'ctx-123' }),\n        }), 100))\n      );\n\n      const { result } = renderHook(() => useChat(null));\n      \n      await act(async () => {\n        result.current.sendMessage('Message 1');\n        result.current.sendMessage('Message 2'); // should be queued\n      });\n\n      expect(result.current.queuedMessages).toContain('Message 2');\n    });\n\n    it('should handle network errors gracefully', async () => {\n      (global.fetch as jest.Mock).mockRejectedValueOnce(new Error('Network error'));\n\n      const { result } = renderHook(() => useChat(null));\n      \n      await act(async () => {\n        await result.current.sendMessage('Hello');\n      });\n\n      expect(result.current.messages).toHaveLength(2); // user + error message\n      expect(result.current.messages[1].role).toBe('assistant');\n      expect(result.current.messages[1].content).toContain(\"Can't reach the kitchen\");\n    });\n\n    it('should handle non-200 responses', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: false,\n        status: 500,\n      });\n\n      const { result } = renderHook(() => useChat(null));\n      \n      await act(async () => {\n        await result.current.sendMessage('Hello');\n      });\n\n      expect(result.current.messages[1].content).toContain(\"Can't reach the kitchen\");\n    });\n  });\n\n  describe('context management', () => {\n    it('should update contextId from response', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => ({ context: 'new-context' }),\n      });\n\n      const { result } = renderHook(() => useChat(null));\n      \n      await act(async () => {\n        await result.current.sendMessage('Test');\n      });\n\n      expect(result.current.contextId).toBe('new-context');\n    });\n\n    it('should persist contextId across messages', async () => {\n      (global.fetch as jest.Mock).mockResolvedValue({\n        ok: true,\n        json: async () => ({ context: 'ctx-123' }),\n      });\n\n      const { result } = renderHook(() => useChat(null));\n      \n      await act(async () => {\n        await result.current.sendMessage('Message 1');\n        await result.current.sendMessage('Message 2');\n      });\n\n      expect(global.fetch).toHaveBeenCalledTimes(2);\n      const secondCall = (global.fetch as jest.Mock).mock.calls[1][1];\n      const body = JSON.parse(secondCall.body);\n      expect(body.context).toBe('ctx-123');\n    });\n  });\n\n  describe('snapshot processing', () => {\n    it('should extract user messages from snapshot logs', () => {\n      const snapshot: A0Snapshot = {\n        logs: [\n          {\n            no: 1,\n            id: 'log-1',\n            type: 'user',\n            content: 'Test message',\n            timestamp: Date.now() / 1000,\n            heading: '',\n            kvps: {},\n            agentno: 0,\n          },\n        ],\n        log_progress_active: false,\n        // ... other fields\n      };\n\n      const { result } = renderHook(() => useChat(snapshot));\n      \n      expect(result.current.messages).toHaveLength(1);\n      expect(result.current.messages[0].role).toBe('user');\n      expect(result.current.messages[0].content).toBe('Test message');\n    });\n\n    it('should extract assistant responses from snapshot logs', () => {\n      const snapshot: A0Snapshot = {\n        logs: [\n          {\n            no: 1,\n            id: 'log-1',\n            type: 'response',\n            content: 'Assistant reply',\n            timestamp: Date.now() / 1000,\n            heading: '',\n            kvps: {},\n            agentno: 0,\n          },\n        ],\n        log_progress_active: false,\n      };\n\n      const { result } = renderHook(() => useChat(snapshot));\n      \n      expect(result.current.messages).toHaveLength(1);\n      expect(result.current.messages[0].role).toBe('assistant');\n    });\n\n    it('should not duplicate logs on re-render', () => {\n      const snapshot: A0Snapshot = {\n        logs: [\n          {\n            no: 1,\n            id: 'log-1',\n            type: 'user',\n            content: 'Test',\n            timestamp: Date.now() / 1000,\n            heading: '',\n            kvps: {},\n            agentno: 0,\n          },\n        ],\n        log_progress_active: false,\n      };\n\n      const { result, rerender } = renderHook(\n        ({ snap }) => useChat(snap),\n        { initialProps: { snap: snapshot } }\n      );\n      \n      expect(result.current.messages).toHaveLength(1);\n      rerender({ snap: snapshot });\n      expect(result.current.messages).toHaveLength(1);\n    });\n\n    it('should handle logs with null ID using log number', () => {\n      const snapshot: A0Snapshot = {\n        logs: [\n          {\n            no: 1,\n            id: null as any,\n            type: 'user',\n            content: 'Test',\n            timestamp: Date.now() / 1000,\n            heading: '',\n            kvps: {},\n            agentno: 0,\n          },\n        ],\n        log_progress_active: false,\n      };\n\n      const { result } = renderHook(() => useChat(snapshot));\n      expect(result.current.messages).toHaveLength(1);\n    });\n\n    it('should ignore empty response messages', () => {\n      const snapshot: A0Snapshot = {\n        logs: [\n          {\n            no: 1,\n            id: 'log-1',\n            type: 'response',\n            content: '   ',\n            timestamp: Date.now() / 1000,\n            heading: '',\n            kvps: {},\n            agentno: 0,\n          },\n        ],\n        log_progress_active: false,\n      };\n\n      const { result } = renderHook(() => useChat(snapshot));\n      expect(result.current.messages).toHaveLength(0);\n    });\n\n    it('should update loading state from snapshot', () => {\n      const snapshot: A0Snapshot = {\n        logs: [],\n        log_progress_active: true,\n      };\n\n      const { result } = renderHook(() => useChat(snapshot));\n      expect(result.current.loading).toBe(true);\n    });\n  });\n\n  describe('resetChat', () => {\n    it('should clear all messages and context', async () => {\n      (global.fetch as jest.Mock).mockResolvedValue({\n        ok: true,\n        json: async () => ({ context: 'ctx-123' }),\n      });\n\n      const { result } = renderHook(() => useChat(null));\n      \n      await act(async () => {\n        await result.current.sendMessage('Test');\n        result.current.resetChat();\n      });\n\n      expect(result.current.messages).toHaveLength(0);\n      expect(result.current.contextId).toBeNull();\n      expect(result.current.queuedMessages).toHaveLength(0);\n    });\n\n    it('should set freshChat flag to ignore stale logs', () => {\n      const oldSnapshot: A0Snapshot = {\n        logs: [\n          {\n            no: 1,\n            id: 'old-log',\n            type: 'user',\n            content: 'Old message',\n            timestamp: Date.now() / 1000,\n            heading: '',\n            kvps: {},\n            agentno: 0,\n          },\n        ],\n        log_progress_active: false,\n      };\n\n      const { result, rerender } = renderHook(\n        ({ snap }) => useChat(snap),\n        { initialProps: { snap: null } }\n      );\n\n      act(() => result.current.resetChat());\n      rerender({ snap: oldSnapshot });\n\n      // Should NOT process old logs\n      expect(result.current.messages).toHaveLength(0);\n    });\n\n    it('should clear freshChat flag on first send after reset', async () => {\n      (global.fetch as jest.Mock).mockResolvedValue({\n        ok: true,\n        json: async () => ({ context: 'new-ctx' }),\n      });\n\n      const { result } = renderHook(() => useChat(null));\n      \n      await act(async () => {\n        result.current.resetChat();\n        await result.current.sendMessage('New message');\n      });\n\n      // After send, should process snapshot logs again\n      expect(result.current.messages).toHaveLength(1);\n    });\n  });\n\n  describe('queue processing', () => {\n    it('should process queued messages after loading completes', async () => {\n      (global.fetch as jest.Mock).mockResolvedValue({\n        ok: true,\n        json: async () => ({ context: 'ctx' }),\n      });\n\n      const snapshot: A0Snapshot = {\n        logs: [],\n        log_progress_active: false,\n      };\n\n      const { result, rerender } = renderHook(\n        ({ snap }) => useChat(snap),\n        { initialProps: { snap: snapshot } }\n      );\n\n      await act(async () => {\n        result.current.sendMessage('Message 1');\n        result.current.sendMessage('Message 2'); // queued\n      });\n\n      // Wait for first message to complete\n      await waitFor(() => expect(result.current.loading).toBe(false));\n\n      // Second message should be processed\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledTimes(2);\n      }, { timeout: 3000 });\n    });\n\n    it('should handle CSRF token failures', async () => {\n      (csrfModule.getCsrfToken as jest.Mock).mockRejectedValueOnce(\n        new Error('CSRF failed')\n      );\n\n      const { result } = renderHook(() => useChat(null));\n      \n      await act(async () => {\n        await result.current.sendMessage('Test');\n      });\n\n      expect(result.current.messages[1].content).toContain(\"Can't reach the kitchen\");\n    });\n  });\n});"
