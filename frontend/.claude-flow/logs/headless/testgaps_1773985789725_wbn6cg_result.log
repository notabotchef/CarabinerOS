        "language": "typescript",
        "code": "// src/hooks/__tests__/use-workspace.test.ts\nimport { renderHook, waitFor } from '@testing-library/react';\nimport { useWorkspace } from '../use-workspace';\n\nglobal.fetch = jest.fn();\n\ndescribe('useWorkspace', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n  });\n\n  describe('data fetching', () => {\n    it('should fetch data from endpoint', async () => {\n      const mockData = [{ id: 1, name: 'Item 1' }];\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => mockData,\n      });\n\n      const { result } = renderHook(() => useWorkspace('/api/items'));\n\n      expect(result.current.loading).toBe(true);\n\n      await waitFor(() => {\n        expect(result.current.loading).toBe(false);\n      });\n\n      expect(result.current.data).toEqual(mockData);\n      expect(result.current.error).toBeNull();\n    });\n\n    it('should include location ID in query string', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => [],\n      });\n\n      renderHook(() => useWorkspace('/api/items', 'loc-123'));\n\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledWith(\n          '/api/items?location_id=loc-123',\n          expect.objectContaining({ credentials: 'include' })\n        );\n      });\n    });\n\n    it('should not include location ID if not provided', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => [],\n      });\n\n      renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledWith(\n          '/api/items',\n          expect.any(Object)\n        );\n      });\n    });\n\n    it('should send credentials with request', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => [],\n      });\n\n      renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledWith(\n          expect.any(String),\n          expect.objectContaining({ credentials: 'include' })\n        );\n      });\n    });\n  });\n\n  describe('data normalization', () => {\n    it('should handle array response', async () => {\n      const mockData = [{ id: 1 }, { id: 2 }];\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => mockData,\n      });\n\n      const { result } = renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(result.current.data).toEqual(mockData);\n      });\n    });\n\n    it('should extract items from response object', async () => {\n      const mockData = { items: [{ id: 1 }, { id: 2 }] };\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => mockData,\n      });\n\n      const { result } = renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(result.current.data).toEqual(mockData.items);\n      });\n    });\n\n    it('should extract data from response object', async () => {\n      const mockData = { data: [{ id: 1 }, { id: 2 }] };\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => mockData,\n      });\n\n      const { result } = renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(result.current.data).toEqual(mockData.data);\n      });\n    });\n\n    it('should handle empty response', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => ({}),\n      });\n\n      const { result } = renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(result.current.data).toEqual([]);\n      });\n    });\n\n    it('should handle null response', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => null,\n      });\n\n      const { result } = renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(result.current.data).toEqual([]);\n      });\n    });\n  });\n\n  describe('error handling', () => {\n    it('should set error on non-ok response', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: false,\n        status: 500,\n      });\n\n      const { result } = renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(result.current.error).toBe('500');\n        expect(result.current.data).toEqual([]);\n        expect(result.current.loading).toBe(false);\n      });\n    });\n\n    it('should set error on network failure', async () => {\n      (global.fetch as jest.Mock).mockRejectedValueOnce(new Error('Network error'));\n\n      const { result } = renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(result.current.error).toBe('Network error');\n        expect(result.current.data).toEqual([]);\n      });\n    });\n\n    it('should set error on JSON parse failure', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => {\n          throw new Error('Invalid JSON');\n        },\n      });\n\n      const { result } = renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(result.current.error).toBe('Invalid JSON');\n      });\n    });\n\n    it('should clear previous error on successful fetch', async () => {\n      (global.fetch as jest.Mock)\n        .mockRejectedValueOnce(new Error('First error'))\n        .mockResolvedValueOnce({\n          ok: true,\n          json: async () => [{ id: 1 }],\n        });\n\n      const { result } = renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(result.current.error).toBe('First error');\n      });\n\n      result.current.refresh();\n\n      await waitFor(() => {\n        expect(result.current.error).toBeNull();\n        expect(result.current.data).toHaveLength(1);\n      });\n    });\n  });\n\n  describe('refresh function', () => {\n    it('should refetch data when refresh is called', async () => {\n      (global.fetch as jest.Mock).mockResolvedValue({\n        ok: true,\n        json: async () => [{ id: 1 }],\n      });\n\n      const { result } = renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(result.current.loading).toBe(false);\n      });\n\n      expect(global.fetch).toHaveBeenCalledTimes(1);\n\n      result.current.refresh();\n\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledTimes(2);\n      });\n    });\n\n    it('should set loading true during refresh', async () => {\n      (global.fetch as jest.Mock).mockImplementation(\n        () => new Promise(resolve => setTimeout(() => resolve({\n          ok: true,\n          json: async () => [],\n        }), 100))\n      );\n\n      const { result } = renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(result.current.loading).toBe(false);\n      });\n\n      result.current.refresh();\n\n      expect(result.current.loading).toBe(true);\n\n      await waitFor(() => {\n        expect(result.current.loading).toBe(false);\n      });\n    });\n  });\n\n  describe('dependency updates', () => {\n    it('should refetch when endpoint changes', async () => {\n      (global.fetch as jest.Mock).mockResolvedValue({\n        ok: true,\n        json: async () => [],\n      });\n\n      const { rerender } = renderHook(\n        ({ endpoint }) => useWorkspace(endpoint),\n        { initialProps: { endpoint: '/api/items' } }\n      );\n\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledWith('/api/items', expect.any(Object));\n      });\n\n      rerender({ endpoint: '/api/orders' });\n\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledWith('/api/orders', expect.any(Object));\n      });\n    });\n\n    it('should refetch when location ID changes', async () => {\n      (global.fetch as jest.Mock).mockResolvedValue({\n        ok: true,\n        json: async () => [],\n      });\n\n      const { rerender } = renderHook(\n        ({ locationId }) => useWorkspace('/api/items', locationId),\n        { initialProps: { locationId: 'loc-1' } }\n      );\n\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledWith(\n          '/api/items?location_id=loc-1',\n          expect.any(Object)\n        );\n      });\n\n      rerender({ locationId: 'loc-2' });\n\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledWith(\n          '/api/items?location_id=loc-2',\n          expect.any(Object)\n        );\n      });\n    });\n  });\n\n  describe('TypeScript generics', () => {\n    interface TestItem {\n      id: number;\n      name: string;\n    }\n\n    it('should type data correctly with generic', async () => {\n      const mockData: TestItem[] = [{ id: 1, name: 'Test' }];\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => mockData,\n      });\n\n      const { result } = renderHook(() => useWorkspace<TestItem>('/api/items'));\n\n      await waitFor(() => {\n        expect(result.current.data).toEqual(mockData);\n      });\n\n      // TypeScript should enforce this type\n      const item: TestItem = result.current.data[0];\n      expect(item.name).toBe('Test');\n    });\n  });\n});"
