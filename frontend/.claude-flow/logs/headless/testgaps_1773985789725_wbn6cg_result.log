        "title": "7. csrf.ts",
        "content": "\n",
        "level": 2
      },
      {
        "title": "Gaps Identified",
        "content": "- ❌ No tests for getCsrfToken\n- ❌ No tests for concurrent calls\n- ❌ No tests for cookie setting\n- ❌ No error handling tests\n- ❌ No tests for getRuntimeId and clearCsrfToken\n\n",
        "level": 3
      },
      {
        "title": "Test Skeleton",
        "content": "\n```typescript\n// src/lib/__tests__/csrf.test.ts\nimport { getCsrfToken, getRuntimeId, clearCsrfToken } from '../csrf';\n\nglobal.fetch = jest.fn();\n\ndescribe('csrf', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n    clearCsrfToken();\n    document.cookie = ''; // Clear cookies\n  });\n\n  describe('getCsrfToken', () => {\n    it('should fetch CSRF token on first call', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          token: 'csrf-123',\n          runtime_id: 'runtime-456',\n        }),\n      });\n\n      const token = await getCsrfToken();\n\n      expect(token).toBe('csrf-123');\n      expect(global.fetch).toHaveBeenCalledWith('/csrf_token', {\n        credentials: 'include',\n      });\n    });\n\n    it('should return cached token on subsequent calls', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          token: 'csrf-123',\n          runtime_id: 'runtime-456',\n        }),\n      });\n\n      const token1 = await getCsrfToken();\n      const token2 = await getCsrfToken();\n\n      expect(token1).toBe(token2);\n      expect(global.fetch).toHaveBeenCalledTimes(1);\n    });\n\n    it('should set cookie with runtime ID', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          token: 'csrf-123',\n          runtime_id: 'runtime-456',\n        }),\n      });\n\n      await getCsrfToken();\n\n      expect(document.cookie).toContain('csrf_token_runtime-456=csrf-123');\n      expect(document.cookie).toContain('SameSite=Strict');\n    });\n\n    it('should handle concurrent calls with promise caching', async () => {\n      let resolveCount = 0;\n      (global.fetch as jest.Mock).mockImplementation(() => {\n        resolveCount++;\n        return Promise.resolve({\n          json: async () => ({\n            ok: true,\n            token: 'csrf-123',\n            runtime_id: 'runtime-456',\n          }),\n        });\n      });\n\n      const [token1, token2, token3] = await Promise.all([\n        getCsrfToken(),\n        getCsrfToken(),\n        getCsrfToken(),\n      ]);\n\n      expect(token1).toBe(token2);\n      expect(token2).toBe(token3);\n      expect(global.fetch).toHaveBeenCalledTimes(1);\n    });\n\n    it('should throw error if response is not ok', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: false,\n          error: 'CSRF generation failed',\n        }),\n      });\n\n      await expect(getCsrfToken()).rejects.toThrow('CSRF generation failed');\n    });\n\n    it('should throw error if fetch fails', async () => {\n      (global.fetch as jest.Mock).mockRejectedValueOnce(new Error('Network error'));\n\n      await expect(getCsrfToken()).rejects.toThrow('Network error');\n    });\n\n    it('should clear promise cache after resolution', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          token: 'csrf-123',\n          runtime_id: 'runtime-456',\n        }),\n      });\n\n      await getCsrfToken();\n\n      // Promise cache should be cleared, but token cache should remain\n      const token2 = await getCsrfToken();\n      expect(token2).toBe('csrf-123');\n      expect(global.fetch).toHaveBeenCalledTimes(1);\n    });\n\n    it('should clear promise cache after rejection', async () => {\n      (global.fetch as jest.Mock)\n        .mockRejectedValueOnce(new Error('First error'))\n        .mockResolvedValueOnce({\n          json: async () => ({\n            ok: true,\n            token: 'csrf-123',\n            runtime_id: 'runtime-456',\n          }),\n        });\n\n      await expect(getCsrfToken()).rejects.toThrow('First error');\n\n      // Should be able to retry\n      const token = await getCsrfToken();\n      expect(token).toBe('csrf-123');\n    });\n  });\n\n  describe('getRuntimeId', () => {\n    it('should return null initially', () => {\n      expect(getRuntimeId()).toBeNull();\n    });\n\n    it('should return runtime ID after getCsrfToken', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          token: 'csrf-123',\n          runtime_id: 'runtime-456',\n        }),\n      });\n\n      await getCsrfToken();\n\n      expect(getRuntimeId()).toBe('runtime-456');\n    });\n  });\n\n  describe('clearCsrfToken', () => {\n    it('should clear cached token and runtime ID', async () => {\n      (global.fetch as jest.Mock).mockResolvedValue({\n        json: async () => ({\n          ok: true,\n          token: 'csrf-123',\n          runtime_id: 'runtime-456',\n        }),\n      });\n\n      await getCsrfToken();\n      expect(getRuntimeId()).toBe('runtime-456');\n\n      clearCsrfToken();\n\n      expect(getRuntimeId()).toBeNull();\n\n      // Should fetch again after clear\n      await getCsrfToken();\n      expect(global.fetch).toHaveBeenCalledTimes(2);\n    });\n\n    it('should not clear cookies', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          token: 'csrf-123',\n          runtime_id: 'runtime-456',\n        }),\n      });\n\n      await getCsrfToken();\n      const cookiesBefore = document.cookie;\n\n      clearCsrfToken();\n\n      // Cookies should still exist (clearCsrfToken only clears memory cache)\n      expect(document.cookie).toBe(cookiesBefore);\n    });\n  });\n\n  describe('edge cases', () => {\n    it('should handle missing token in response', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          // missing token and runtime_id\n        }),\n      });\n\n      const token = await getCsrfToken();\n\n      expect(token).toBeUndefined();\n    });\n\n    it('should handle response with default error message', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: false,\n          // no error field\n        }),\n      });\n\n      await expect(getCsrfToken()).rejects.toThrow('Failed to get CSRF token');\n    });\n  });\n});\n```\n\n---\n\n",
