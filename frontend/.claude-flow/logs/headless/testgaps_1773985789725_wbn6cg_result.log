s\n      rerender({\n        status: {\n          status: 'working' as const,\n          text: 'Working again',\n          active: true,\n        },\n      });\n\n      act(() => {\n        jest.advanceTimersByTime(5000);\n      });\n\n      // Should still be showing the new text\n      expect(result.current.text).toBe('Working again');\n      expect(result.current.active).toBe(true);\n    });\n  });\n\n  describe('snapshot fallback', () => {\n    it('should use snapshot progress when no chefStatus', () => {\n      const snapshot: A0Snapshot = {\n        log_progress: 'icon://chat A0: Responding',\n        log_progress_active: true,\n        logs: [],\n      };\n\n      const { result } = renderHook(() => useExpoStream(snapshot, null));\n      \n      expect(result.current.text).toBe('Responding');\n      expect(result.current.active).toBe(true);\n    });\n\n    it('should clean Agent Zero prefixes from progress text', () => {\n      const snapshot: A0Snapshot = {\n        log_progress: 'icon://tool A0: Using food_cost_tool',\n        log_progress_active: true,\n        logs: [],\n      };\n\n      const { result } = renderHook(() => useExpoStream(snapshot, null));\n      \n      expect(result.current.text).toBe('Using food_cost_tool');\n    });\n\n    it('should handle numeric progress values', () => {\n      const snapshot: A0Snapshot = {\n        log_progress: 42,\n        log_progress_active: true,\n        logs: [],\n      };\n\n      const { result } = renderHook(() => useExpoStream(snapshot, null));\n      \n      expect(result.current.text).toBe('Working...');\n    });\n\n    it('should show Done and fade when progress becomes inactive', () => {\n      const snapshot: A0Snapshot = {\n        log_progress: 'Processing',\n        log_progress_active: false,\n        logs: [],\n      };\n\n      const { result } = renderHook(() => useExpoStream(snapshot, null));\n      \n      expect(result.current.text).toBe('Done');\n      expect(result.current.active).toBe(false);\n\n      act(() => {\n        jest.advanceTimersByTime(2000);\n      });\n\n      expect(result.current.text).toBeNull();\n    });\n  });\n\n  describe('cleanProgressText helper', () => {\n    // This would be tested if exported, but it's internal\n    // We can test it indirectly through useExpoStream\n    \n    it('should remove icon:// prefix', () => {\n      const snapshot: A0Snapshot = {\n        log_progress: 'icon://chat Some text',\n        log_progress_active: true,\n        logs: [],\n      };\n\n      const { result } = renderHook(() => useExpoStream(snapshot, null));\n      expect(result.current.text).not.toContain('icon://');\n    });\n\n    it('should remove A0: prefix', () => {\n      const snapshot: A0Snapshot = {\n        log_progress: 'A0: Doing something',\n        log_progress_active: true,\n        logs: [],\n      };\n\n      const { result } = renderHook(() => useExpoStream(snapshot, null));\n      expect(result.current.text).toBe('Doing something');\n    });\n\n    it('should handle empty string and return default', () => {\n      const snapshot: A0Snapshot = {\n        log_progress: '',\n        log_progress_active: true,\n        logs: [],\n      };\n\n      const { result } = renderHook(() => useExpoStream(snapshot, null));\n      expect(result.current.text).toBe('Working...');\n    });\n  });\n\n  describe('edge cases', () => {\n    it('should handle null chefStatus and null snapshot', () => {\n      const { result } = renderHook(() => useExpoStream(null, null));\n      \n      expect(result.current.text).toBeNull();\n      expect(result.current.active).toBe(false);\n    });\n\n    it('should prioritize chefStatus over snapshot', () => {\n      const snapshot: A0Snapshot = {\n        log_progress: 'Snapshot progress',\n        log_progress_active: true,\n        logs: [],\n      };\n\n      const chefStatus: ChefStatus = {\n        status: 'working',\n        text: 'Chef status',\n        active: true,\n      };\n\n      const { result } = renderHook(() => useExpoStream(snapshot, chefStatus));\n      \n      expect(result.current.text).toBe('Chef status');\n    });\n  });\n\n  describe('timer cleanup', () => {\n    it('should cleanup timer on unmount', () => {\n      const chefStatus: ChefStatus = {\n        status: 'completed',\n        text: 'Done',\n        active: false,\n      };\n\n      const { unmount } = renderHook(() => useExpoStream(null, chefStatus));\n      \n      unmount();\n\n      // If timer wasn't cleaned up, this would cause issues\n      act(() => {\n        jest.advanceTimersByTime(5000);\n      });\n      \n      // Test passes if no errors thrown\n    });\n  });\n});\n```\n\n---\n\n## 4. use-mobile.ts\n\n### Gaps Identified\n- ❌ No tests for initial state\n- ❌ No tests for resize handling\n- ❌ No tests for event listener cleanup\n- ❌ No SSR/hydration tests\n\n### Test Skeleton\n\n```typescript\n// src/hooks/__tests__/use-mobile.test.ts\nimport { renderHook, act } from '@testing-library/react';\nimport { useIsMobile } from '../use-mobile';\n\ndescribe('useIsMobile', () => {\n  const originalInnerWidth = window.innerWidth;\n\n  beforeEach(() => {\n    // Reset window size\n    Object.defineProperty(window, 'innerWidth', {\n      writable: true,\n      configurable: true,\n      value: 1024,\n    });\n  });\n\n  afterEach(() => {\n    Object.defineProperty(window, 'innerWidth', {\n      writable: true,\n      configurable: true,\n      value: originalInnerWidth,\n    });\n  });\n\n  describe('initial state', () => {\n    it('should return false for desktop width', () => {\n      window.innerWidth = 1024;\n      const { result } = renderHook(() => useIsMobile());\n      expect(result.current).toBe(false);\n    });\n\n    it('should return true for mobile width', () => {\n      window.innerWidth = 375;\n      const { result } = renderHook(() => useIsMobile());\n      expect(result.current).toBe(true);\n    });\n\n    it('should return false for exact breakpoint', () => {\n      window.innerWidth = 768;\n      const { result } = renderHook(() => useIsMobile());\n      expect(result.current).toBe(false);\n    });\n\n    it('should return true for one pixel below breakpoint', () => {\n      window.innerWidth = 767;\n      const { result } = renderHook(() => useIsMobile());\n      expect(result.current).toBe(true);\n    });\n\n    it('should start as undefined before effect runs', () => {\n      const { result } = renderHook(() => useIsMobile());\n      // After effect runs, should be boolean\n      expect(typeof result.current).toBe('boolean');\n    });\n  });\n\n  describe('resize handling', () => {\n    it('should update when window is resized to mobile', () => {\n      window.innerWidth = 1024;\n      const { result } = renderHook(() => useIsMobile());\n      \n      expect(result.current).toBe(false);\n\n      act(() => {\n        window.innerWidth = 375;\n        window.dispatchEvent(new Event('change'));\n        // Trigger media query change\n        const mql = window.matchMedia('(max-width: 767px)');\n        mql.dispatchEvent(new Event('change'));\n      });\n\n      // Note: This test may need adjustment based on how matchMedia is mocked\n    });\n\n    it('should update when window is resized to desktop', () => {\n      window.innerWidth = 375;\n      const { result } = renderHook(() => useIsMobile());\n      \n      expect(result.current).toBe(true);\n\n      act(() => {\n        window.innerWidth = 1024;\n        const mql = window.matchMedia('(max-width: 767px)');\n        mql.dispatchEvent(new Event('change'));\n      });\n    });\n\n    it('should handle multiple rapid resizes', () => {\n      const { result } = renderHook(() => useIsMobile());\n      \n      act(() => {\n        window.innerWidth = 375;\n        window.dispatchEvent(new Event('resize'));\n        window.innerWidth = 1024;\n        window.dispatchEvent(new Event('resize'));\n        window.innerWidth = 500;\n        window.dispatchEvent(new Event('resize'));\n      });\n\n      // Should reflect final state\n      expect(typeof result.current).toBe('boolean');\n    });\n  });\n\n  describe('cleanup', () => {\n    it('should remove event listener on unmount', () => {\n      const removeEventListenerSpy = jest.spyOn(\n        window.matchMedia('(max-width: 767px)'),\n        'removeEventListener'\n      );\n\n      const { unmount } = renderHook(() => useIsMobile());\n      unmount();\n\n      expect(removeEventListenerSpy).toHaveBeenCalled();\n    });\n  });\n\n  describe('edge cases', () => {\n    it('should handle missing matchMedia', () => {\n      const originalMatchMedia = window.matchMedia;\n      (window.matchMedia as any) = undefined;\n\n      const { result } = renderHook(() => useIsMobile());\n      \n      // Should not crash\n      expect(typeof result.current).toBe('boolean');\n\n      window.matchMedia = originalMatchMedia;\n    });\n\n    it('should handle very small widths', () => {\n      window.innerWidth = 320;\n      const { result } = renderHook(() => useIsMobile());\n      expect(result.current).toBe(true);\n    });\n\n    it('should handle very large widths', () => {\n      window.innerWidth = 3840; // 4K\n      const { result } = renderHook(() => useIsMobile());\n      expect(result.current).toBe(false);\n    });\n  });\n});\n```\n\n---\n\n## 5. use-socket.ts\n\n### Gaps Identified\n- ❌ No tests for socket connection lifecycle\n- ❌ No tests for state_push event handling\n- ❌ No tests for CSRF integration\n- ❌ No tests for subscribe function\n- ❌ No error handling tests\n- ❌ No reconnection tests\n\n### Test Skeleton\n\n```typescript\n// src/hooks/__tests__/use-socket.test.ts\nimport { renderHook, act, waitFor } from '@testing-library/react';\nimport { useSocket } from '../use-socket';\nimport * as socketClient from '@/lib/socket-client';\nimport * as csrfModule from '@/lib/csrf';\nimport type { Socket } from 'socket.io-client';\n\njest.mock('@/lib/socket-client');\njest.mock('@/lib/csrf');\n\ndescribe('useSocket', () => {\n  let mockSocket: Partial<Socket>;\n  let eventHandlers: Record<string, Function>;\n\n  beforeEach(() => {\n    eventHandlers = {};\n    mockSocket = {\n      connected: false,\n      connect: jest.fn(),\n      disconnect: jest.fn(),\n      emit: jest.fn(),\n      on: jest.fn((event, handler) => {\n        eventHandlers[event] = handler;\n      }),\n      off: jest.fn(),\n    };\n\n    (socketClient.initStateSyncSocket as jest.Mock).mockReturnValue(mockSocket);\n    (socketClient.getStateSyncSocket as jest.Mock).mockReturnValue(mockSocket);\n    (csrfModule.getCsrfToken as jest.Mock).mockResolvedValue('mock-token');\n  });\n\n  afterEach(() => {\n    jest.clearAllMocks();\n  });\n\n  describe('initialization', () => {\n    it('should initialize socket on mount', () => {\n      renderHook(() => useSocket());\n      \n      expect(socketClient.initStateSyncSocket).toHaveBeenCalled();\n      expect(mockSocket.on).toHaveBeenCalledWith('connect', expect.any(Function));\n      expect(mockSocket.on).toHaveBeenCalledWith('disconnect', expect.any(Function));\n      expect(mockSocket.on).toHaveBeenCalledWith('state_push', expect.any(Function));\n      expect(mockSocket.on).toHaveBeenCalledWith('chef_status', expect.any(Function));\n    });\n\n    it('should fetch CSRF token before connecting', async () => {\n      renderHook(() => useSocket());\n      \n      await waitFor(() => {\n        expect(csrfModule.getCsrfToken).toHaveBeenCalled();\n        expect(mockSocket.connect).toHaveBeenCalled();\n      });\n    });\n\n    it('should connect even if CSRF fails', async () => {\n      (csrfModule.getCsrfToken as jest.Mock).mockRejectedValue(new Error('CSRF failed'));\n\n      renderHook(() => useSocket());\n      \n      await waitFor(() => {\n        expect(mockSocket.connect).toHaveBeenCalled();\n      });\n    });\n  });\n\n  describe('connection events', () => {\n    it('should set connected true on connect', async () => {\n      const { result } = renderHook(() => useSocket());\n      \n      expect(result.current.connected).toBe(false);\n\n      act(() => {\n        eventHandlers.connect();\n      });\n\n      expect(result.current.connected).toBe(true);\n    });\n\n    it('should emit state_request on connect', async () => {\n      renderHook(() => useSocket());\n      \n      act(() => {\n        mockSocket.connected = true;\n        eventHandlers.connect();\n      });\n\n      expect(mockSocket.emit).toHaveBeenCalledWith('state_request', expect.objectContaining({\n        context: null,\n        log_from: 0,\n        notifications_from: 0,\n        timezone: expect.any(String),\n      }));\n    });\n\n    it('should set connected false on disconnect', () => {\n      const { result } = renderHook(() => useSocket());\n      \n      act(() => {\n        eventHandlers.connect();\n      });\n      expect(result.current.connected).toBe(true);\n\n      act(() => {\n        eventHandlers.disconnect();\n      });\n      expect(result.current.connected).toBe(false);\n    });\n  });\n\n  describe('state_push handling', () => {\n    it('should update snapshot from state_push event', () => {\n      const { result } = renderHook(() => useSocket());\n      \n      const mockPush = {\n        data: {\n          snapshot: {\n            logs: [{ no: 1, type: 'user', content: 'Test' }],\n            log_progress_active: false,\n          },\n        },\n      };\n\n      act(() => {\n        eventHandlers.state_push(mockPush);\n      });\n\n      expect(result.current.snapshot).toEqual(mockPush.data.snapshot);\n    });\n\n    it('should handle malformed state_push', () => {\n      const { result } = renderHook(() => useSocket());\n      \n      const consoleSpy = jest.spyOn(console, 'warn').mockImplementation();\n\n      act(() => {\n        eventHandlers.state_push({ data: {} });\n      });\n\n      expect(consoleSpy).toHaveBeenCalledWith(\n        expect.stringContaining('no snapshot'),\n        expect.any(Array)\n      );\n      expect(result.current.snapshot).toBeNull();\n\n      consoleSpy.mockRestore();\n    });\n\n    it('should update logFrom based on last log number', () => {\n      renderHook(() => useSocket());\n      \n      const mockPush = {\n        data: {\n          snapshot: {\n            logs: [\n              { no: 1, type: 'user' },\n              { no: 2, type: 'response' },\n              { no: 3, type: 'user' },\n            ],\n          },\n        },\n      };\n\n      act(() => {\n        eventHandlers.state_push(mockPush);\n      });\n\n      // logFrom should be 4 (last.no + 1)\n      // This is internal state, would verify through next state_request\n    });\n\n    it('should log when receiving response logs', () => {\n      const consoleSpy = jest.spyOn(console, 'log').mockImplementation();\n      renderHook(() => useSocket());\n      \n      const mockPush = {\n        data: {\n          snapshot: {\n            logs: [\n              { no: 1, type: 'response', content: 'Response' },\n            ],\n            log_progress_active: true,\n          },\n        },\n      };\n\n      act(() => {\n        eventHandlers.state_push(mockPush);\n      });\n\n      expect(consoleSpy).toHaveBeenCalledWith(\n        expect.stringContaining('1 logs, 1 responses')\n      );\n\n      consoleSpy.mockRestore();\n    });\n  });\n\n  describe('chef_status handling', () => {\n    it('should update chefStatus from chef_status event', () => {\n      const { result } = renderHook(() => useSocket());\n      \n      const mockStatus = {\n        status: 'working' as const,\n        tool: 'test_tool',\n        text: 'Working...',\n        active: true,\n      };\n\n      act(() => {\n        eventHandlers.chef_status(mockStatus);\n      });\n\n      expect(result.current.chefStatus).toEqual(mockStatus);\n    });\n  });\n\n  describe('subscribe function', () => {\n    it('should emit state_request with contextId', () => {\n      const { result } = renderHook(() => useSocket());\n      \n      act(() => {\n        mockSocket.connected = true;\n        result.current.subscribe('ctx-123');\n      });\n\n      expect(mockSocket.emit).toHaveBeenCalledWith('state_request', expect.objectContaining({\n        context: 'ctx-123',\n        log_from: 0,\n      }));\n    });\n\n    it('should reset logFrom on subscribe', () => {\n      const { result } = renderHook(() => useSocket());\n      \n      // First subscribe\n      act(() => {\n        mockSocket.connected = true;\n        result.current.subscribe('ctx-1');\n      });\n\n      // Second subscribe should reset logFrom\n      act(() => {\n        result.current.subscribe('ctx-2');\n      });\n\n      const calls = (mockSocket.emit as jest.Mock).mock.calls;\n      const lastCall = calls[calls.length - 1];\n      expect(lastCall[1].log_from).toBe(0);\n    });\n\n    it('should not emit if socket not connected', () => {\n      const { result } = renderHook(() => useSocket());\n      \n      mockSocket.connected = false;\n      \n      act(() => {\n        result.current.subscribe('ctx-123');\n      });\n\n      expect(mockSocket.emit).not.toHaveBeenCalled();\n    });\n\n    it('should handle null contextId', () => {\n      const { result } = renderHook(() => useSocket());\n      \n      act(() => {\n        mockSocket.connected = true;\n        result.current.subscribe(null);\n      });\n\n      expect(mockSocket.emit).toHaveBeenCalledWith('state_request', expect.objectContaining({\n        context: null,\n      }));\n    });\n  });\n\n  describe('cleanup', () => {\n    it('should remove all event listeners on unmount', () => {\n      const { unmount } = renderHook(() => useSocket());\n      \n      unmount();\n\n      expect(mockSocket.off).toHaveBeenCalledWith('connect');\n      expect(mockSocket.off).toHaveBeenCalledWith('disconnect');\n      expect(mockSocket.off).toHaveBeenCalledWith('state_push');\n      expect(mockSocket.off).toHaveBeenCalledWith('chef_status');\n    });\n\n    it('should disconnect socket on unmount', () => {\n      const { unmount } = renderHook(() => useSocket());\n      \n      unmount();\n\n      expect(mockSocket.disconnect).toHaveBeenCalled();\n    });\n  });\n});\n```\n\n---\n\n## 6. use-workspace.ts\n\n### Gaps Identified\n- ❌ No tests for data fetching\n- ❌ No error handling tests\n- ❌ No tests for refresh function\n- ❌ No tests for location ID parameter\n- ❌ No tests for data normalization\n\n### Test Skeleton\n\n```typescript\n// src/hooks/__tests__/use-workspace.test.ts\nimport { renderHook, waitFor } from '@testing-library/react';\nimport { useWorkspace } from '../use-workspace';\n\nglobal.fetch = jest.fn();\n\ndescribe('useWorkspace', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n  });\n\n  describe('data fetching', () => {\n    it('should fetch data from endpoint', async () => {\n      const mockData = [{ id: 1, name: 'Item 1' }];\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => mockData,\n      });\n\n      const { result } = renderHook(() => useWorkspace('/api/items'));\n\n      expect(result.current.loading).toBe(true);\n\n      await waitFor(() => {\n        expect(result.current.loading).toBe(false);\n      });\n\n      expect(result.current.data).toEqual(mockData);\n      expect(result.current.error).toBeNull();\n    });\n\n    it('should include location ID in query string', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => [],\n      });\n\n      renderHook(() => useWorkspace('/api/items', 'loc-123'));\n\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledWith(\n          '/api/items?location_id=loc-123',\n          expect.objectContaining({ credentials: 'include' })\n        );\n      });\n    });\n\n    it('should not include location ID if not provided', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => [],\n      });\n\n      renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledWith(\n          '/api/items',\n          expect.any(Object)\n        );\n      });\n    });\n\n    it('should send credentials with request', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => [],\n      });\n\n      renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledWith(\n          expect.any(String),\n          expect.objectContaining({ credentials: 'include' })\n        );\n      });\n    });\n  });\n\n  describe('data normalization', () => {\n    it('should handle array response', async () => {\n      const mockData = [{ id: 1 }, { id: 2 }];\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => mockData,\n      });\n\n      const { result } = renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(result.current.data).toEqual(mockData);\n      });\n    });\n\n    it('should extract items from response object', async () => {\n      const mockData = { items: [{ id: 1 }, { id: 2 }] };\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => mockData,\n      });\n\n      const { result } = renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(result.current.data).toEqual(mockData.items);\n      });\n    });\n\n    it('should extract data from response object', async () => {\n      const mockData = { data: [{ id: 1 }, { id: 2 }] };\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => mockData,\n      });\n\n      const { result } = renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(result.current.data).toEqual(mockData.data);\n      });\n    });\n\n    it('should handle empty response', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => ({}),\n      });\n\n      const { result } = renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(result.current.data).toEqual([]);\n      });\n    });\n\n    it('should handle null response', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => null,\n      });\n\n      const { result } = renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(result.current.data).toEqual([]);\n      });\n    });\n  });\n\n  describe('error handling', () => {\n    it('should set error on non-ok response', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: false,\n        status: 500,\n      });\n\n      const { result } = renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(result.current.error).toBe('500');\n        expect(result.current.data).toEqual([]);\n        expect(result.current.loading).toBe(false);\n      });\n    });\n\n    it('should set error on network failure', async () => {\n      (global.fetch as jest.Mock).mockRejectedValueOnce(new Error('Network error'));\n\n      const { result } = renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(result.current.error).toBe('Network error');\n        expect(result.current.data).toEqual([]);\n      });\n    });\n\n    it('should set error on JSON parse failure', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => {\n          throw new Error('Invalid JSON');\n        },\n      });\n\n      const { result } = renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(result.current.error).toBe('Invalid JSON');\n      });\n    });\n\n    it('should clear previous error on successful fetch', async () => {\n      (global.fetch as jest.Mock)\n        .mockRejectedValueOnce(new Error('First error'))\n        .mockResolvedValueOnce({\n          ok: true,\n          json: async () => [{ id: 1 }],\n        });\n\n      const { result } = renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(result.current.error).toBe('First error');\n      });\n\n      result.current.refresh();\n\n      await waitFor(() => {\n        expect(result.current.error).toBeNull();\n        expect(result.current.data).toHaveLength(1);\n      });\n    });\n  });\n\n  describe('refresh function', () => {\n    it('should refetch data when refresh is called', async () => {\n      (global.fetch as jest.Mock).mockResolvedValue({\n        ok: true,\n        json: async () => [{ id: 1 }],\n      });\n\n      const { result } = renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(result.current.loading).toBe(false);\n      });\n\n      expect(global.fetch).toHaveBeenCalledTimes(1);\n\n      result.current.refresh();\n\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledTimes(2);\n      });\n    });\n\n    it('should set loading true during refresh', async () => {\n      (global.fetch as jest.Mock).mockImplementation(\n        () => new Promise(resolve => setTimeout(() => resolve({\n          ok: true,\n          json: async () => [],\n        }), 100))\n      );\n\n      const { result } = renderHook(() => useWorkspace('/api/items'));\n\n      await waitFor(() => {\n        expect(result.current.loading).toBe(false);\n      });\n\n      result.current.refresh();\n\n      expect(result.current.loading).toBe(true);\n\n      await waitFor(() => {\n        expect(result.current.loading).toBe(false);\n      });\n    });\n  });\n\n  describe('dependency updates', () => {\n    it('should refetch when endpoint changes', async () => {\n      (global.fetch as jest.Mock).mockResolvedValue({\n        ok: true,\n        json: async () => [],\n      });\n\n      const { rerender } = renderHook(\n        ({ endpoint }) => useWorkspace(endpoint),\n        { initialProps: { endpoint: '/api/items' } }\n      );\n\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledWith('/api/items', expect.any(Object));\n      });\n\n      rerender({ endpoint: '/api/orders' });\n\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledWith('/api/orders', expect.any(Object));\n      });\n    });\n\n    it('should refetch when location ID changes', async () => {\n      (global.fetch as jest.Mock).mockResolvedValue({\n        ok: true,\n        json: async () => [],\n      });\n\n      const { rerender } = renderHook(\n        ({ locationId }) => useWorkspace('/api/items', locationId),\n        { initialProps: { locationId: 'loc-1' } }\n      );\n\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledWith(\n          '/api/items?location_id=loc-1',\n          expect.any(Object)\n        );\n      });\n\n      rerender({ locationId: 'loc-2' });\n\n      await waitFor(() => {\n        expect(global.fetch).toHaveBeenCalledWith(\n          '/api/items?location_id=loc-2',\n          expect.any(Object)\n        );\n      });\n    });\n  });\n\n  describe('TypeScript generics', () => {\n    interface TestItem {\n      id: number;\n      name: string;\n    }\n\n    it('should type data correctly with generic', async () => {\n      const mockData: TestItem[] = [{ id: 1, name: 'Test' }];\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        ok: true,\n        json: async () => mockData,\n      });\n\n      const { result } = renderHook(() => useWorkspace<TestItem>('/api/items'));\n\n      await waitFor(() => {\n        expect(result.current.data).toEqual(mockData);\n      });\n\n      // TypeScript should enforce this type\n      const item: TestItem = result.current.data[0];\n      expect(item.name).toBe('Test');\n    });\n  });\n});\n```\n\n---\n\n## 7. csrf.ts\n\n### Gaps Identified\n- ❌ No tests for getCsrfToken\n- ❌ No tests for concurrent calls\n- ❌ No tests for cookie setting\n- ❌ No error handling tests\n- ❌ No tests for getRuntimeId and clearCsrfToken\n\n### Test Skeleton\n\n```typescript\n// src/lib/__tests__/csrf.test.ts\nimport { getCsrfToken, getRuntimeId, clearCsrfToken } from '../csrf';\n\nglobal.fetch = jest.fn();\n\ndescribe('csrf', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n    clearCsrfToken();\n    document.cookie = ''; // Clear cookies\n  });\n\n  describe('getCsrfToken', () => {\n    it('should fetch CSRF token on first call', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          token: 'csrf-123',\n          runtime_id: 'runtime-456',\n        }),\n      });\n\n      const token = await getCsrfToken();\n\n      expect(token).toBe('csrf-123');\n      expect(global.fetch).toHaveBeenCalledWith('/csrf_token', {\n        credentials: 'include',\n      });\n    });\n\n    it('should return cached token on subsequent calls', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          token: 'csrf-123',\n          runtime_id: 'runtime-456',\n        }),\n      });\n\n      const token1 = await getCsrfToken();\n      const token2 = await getCsrfToken();\n\n      expect(token1).toBe(token2);\n      expect(global.fetch).toHaveBeenCalledTimes(1);\n    });\n\n    it('should set cookie with runtime ID', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          token: 'csrf-123',\n          runtime_id: 'runtime-456',\n        }),\n      });\n\n      await getCsrfToken();\n\n      expect(document.cookie).toContain('csrf_token_runtime-456=csrf-123');\n      expect(document.cookie).toContain('SameSite=Strict');\n    });\n\n    it('should handle concurrent calls with promise caching', async () => {\n      let resolveCount = 0;\n      (global.fetch as jest.Mock).mockImplementation(() => {\n        resolveCount++;\n        return Promise.resolve({\n          json: async () => ({\n            ok: true,\n            token: 'csrf-123',\n            runtime_id: 'runtime-456',\n          }),\n        });\n      });\n\n      const [token1, token2, token3] = await Promise.all([\n        getCsrfToken(),\n        getCsrfToken(),\n        getCsrfToken(),\n      ]);\n\n      expect(token1).toBe(token2);\n      expect(token2).toBe(token3);\n      expect(global.fetch).toHaveBeenCalledTimes(1);\n    });\n\n    it('should throw error if response is not ok', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: false,\n          error: 'CSRF generation failed',\n        }),\n      });\n\n      await expect(getCsrfToken()).rejects.toThrow('CSRF generation failed');\n    });\n\n    it('should throw error if fetch fails', async () => {\n      (global.fetch as jest.Mock).mockRejectedValueOnce(new Error('Network error'));\n\n      await expect(getCsrfToken()).rejects.toThrow('Network error');\n    });\n\n    it('should clear promise cache after resolution', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          token: 'csrf-123',\n          runtime_id: 'runtime-456',\n        }),\n      });\n\n      await getCsrfToken();\n\n      // Promise cache should be cleared, but token cache should remain\n      const token2 = await getCsrfToken();\n      expect(token2).toBe('csrf-123');\n      expect(global.fetch).toHaveBeenCalledTimes(1);\n    });\n\n    it('should clear promise cache after rejection', async () => {\n      (global.fetch as jest.Mock)\n        .mockRejectedValueOnce(new Error('First error'))\n        .mockResolvedValueOnce({\n          json: async () => ({\n            ok: true,\n            token: 'csrf-123',\n            runtime_id: 'runtime-456',\n          }),\n        });\n\n      await expect(getCsrfToken()).rejects.toThrow('First error');\n\n      // Should be able to retry\n      const token = await getCsrfToken();\n      expect(token).toBe('csrf-123');\n    });\n  });\n\n  describe('getRuntimeId', () => {\n    it('should return null initially', () => {\n      expect(getRuntimeId()).toBeNull();\n    });\n\n    it('should return runtime ID after getCsrfToken', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          token: 'csrf-123',\n          runtime_id: 'runtime-456',\n        }),\n      });\n\n      await getCsrfToken();\n\n      expect(getRuntimeId()).toBe('runtime-456');\n    });\n  });\n\n  describe('clearCsrfToken', () => {\n    it('should clear cached token and runtime ID', async () => {\n      (global.fetch as jest.Mock).mockResolvedValue({\n        json: async () => ({\n          ok: true,\n          token: 'csrf-123',\n          runtime_id: 'runtime-456',\n        }),\n      });\n\n      await getCsrfToken();\n      expect(getRuntimeId()).toBe('runtime-456');\n\n      clearCsrfToken();\n\n      expect(getRuntimeId()).toBeNull();\n\n      // Should fetch again after clear\n      await getCsrfToken();\n      expect(global.fetch).toHaveBeenCalledTimes(2);\n    });\n\n    it('should not clear cookies', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          token: 'csrf-123',\n          runtime_id: 'runtime-456',\n        }),\n      });\n\n      await getCsrfToken();\n      const cookiesBefore = document.cookie;\n\n      clearCsrfToken();\n\n      // Cookies should still exist (clearCsrfToken only clears memory cache)\n      expect(document.cookie).toBe(cookiesBefore);\n    });\n  });\n\n  describe('edge cases', () => {\n    it('should handle missing token in response', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: true,\n          // missing token and runtime_id\n        }),\n      });\n\n      const token = await getCsrfToken();\n\n      expect(token).toBeUndefined();\n    });\n\n    it('should handle response with default error message', async () => {\n      (global.fetch as jest.Mock).mockResolvedValueOnce({\n        json: async () => ({\n          ok: false,\n          // no error field\n        }),\n      });\n\n      await expect(getCsrfToken()).rejects.toThrow('Failed to get CSRF token');\n    });\n  });\n});\n```\n\n---\n\n## 8. expo-messages.ts\n\n### Test Skeleton\n\n```typescript\n// src/lib/__tests__/expo-messages.test.ts\nimport { getExpoMessage, getCompletionMessage } from '../expo-messages';\nimport type { A0LogEntry } from '../types';\n\ndescribe('expo-messages', () => {\n  describe('getExpoMessage', () => {\n    it('should return quirky message for known tool', () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: 'log-1',\n        type: 'tool',\n        heading: 'Using food_cost_tool...',\n        content: 'Calculating costs',\n        kvps: {},\n        timestamp: Date.now() / 1000,\n        agentno: 0,\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBeTruthy();\n      expect(typeof message).toBe('string');\n      // Should be one of the food_cost_tool messages\n      expect(\n        message === 'Crunching the numbers on that produce order...' ||\n        message === 'Checking if the avocado market crashed yet...'\n      ).toBe(true);\n    });\n\n    it('should return default message for unknown tool', () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: 'log-1',\n        type: 'tool',\n        heading: 'Using unknown_tool...',\n        content: '',\n        kvps: {},\n        timestamp: Date.now() / 1000,\n        agentno: 0,\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBeTruthy();\n      expect(['Working on it...', 'One moment...', 'On it, Chef...']).toContain(message);\n    });\n\n    it('should extract tool name from heading', () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: 'log-1',\n        type: 'tool',\n        heading: 'Using inventory_tool...',\n        content: '',\n        kvps: {},\n        timestamp: Date.now() / 1000,\n        agentno: 0,\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(\n        message === 'Checking the walk-in...' ||\n        message === 'Counting what\\'s left after brunch service...'\n      ).toBe(true);\n    });\n\n    it('should return delegation message for agent logs', () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: 'log-1',\n        type: 'agent',\n        heading: 'Sous Chef',\n        content: '',\n        kvps: {},\n        timestamp: Date.now() / 1000,\n        agentno: 0,\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBe('Delegating to Sous Chef...');\n    });\n\n    it('should return delegation message for subagent logs', () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: 'log-1',\n        type: 'subagent',\n        heading: 'Prep Cook',\n        content: '',\n        kvps: {},\n        timestamp: Date.now() / 1000,\n        agentno: 0,\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBe('Delegating to Prep Cook...');\n    });\n\n    it('should handle agent log without heading', () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: 'log-1',\n        type: 'agent',\n        heading: '',\n        content: '',\n        kvps: {},\n        timestamp: Date.now() / 1000,\n        agentno: 0,\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBe('Delegating to a specialist...');\n    });\n\n    it('should return progress content for progress logs', () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: 'log-1',\n        type: 'progress',\n        heading: '',\n        content: 'Processing step 3 of 5...',\n        kvps: {},\n        timestamp: Date.now() / 1000,\n        agentno: 0,\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBe('Processing step 3 of 5...');\n    });\n\n    it('should return null for progress log with empty content', () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: 'log-1',\n        type: 'progress',\n        heading: '',\n        content: '',\n        kvps: {},\n        timestamp: Date.now() / 1000,\n        agentno: 0,\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBeNull();\n    });\n\n    it('should return null for non-tool/non-agent logs', () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: 'log-1',\n        type: 'user',\n        heading: '',\n        content: 'User message',\n        kvps: {},\n        timestamp: Date.now() / 1000,\n        agentno: 0,\n      };\n\n      const message = getExpoMessage(log);\n\n      expect(message).toBeNull();\n    });\n\n    it('should handle all defined tool types', () => {\n      const tools = [\n        'food_cost_tool',\n        'inventory_tool',\n        'prep_tool',\n        'order_tool',\n        'recipe_tool',\n        'reporting_tool',\n        'invoice_tool',\n        'marketing_tool',\n        'menu_tool',\n      ];\n\n      tools.forEach(toolName => {\n        const log: A0LogEntry = {\n          no: 1,\n          id: 'log-1',\n          type: 'tool',\n          heading: `Using ${toolName}...`,\n          content: '',\n          kvps: {},\n          timestamp: Date.now() / 1000,\n          agentno: 0,\n        };\n\n        const message = getExpoMessage(log);\n\n        expect(message).toBeTruthy();\n        expect(typeof message).toBe('string');\n      });\n    });\n  });\n\n  describe('getCompletionMessage', () => {\n    it('should return one of the completion messages', () => {\n      const message = getCompletionMessage();\n\n      expect(['Heard.', 'Service.', 'All set.', 'Done, Chef.']).toContain(message);\n    });\n\n    it('should be random', () => {\n      const messages = new Set<string>();\n      for (let i = 0; i < 100; i++) {\n        messages.add(getCompletionMessage());\n      }\n\n      // With 100 iterations and 4 options, very likely to see at least 2 different messages\n      expect(messages.size).toBeGreaterThan(1);\n    });\n  });\n\n  describe('message randomization', () => {\n    it('should randomize tool messages', () => {\n      const log: A0LogEntry = {\n        no: 1,\n        id: 'log-1',\n        type: 'tool',\n        heading: 'Using food_cost_tool...',\n        content: '',\n        kvps: {},\n        timestamp: Date.now() / 1000,\n        agentno: 0,\n      };\n\n      const messages = new Set<string>();\n      for (let i = 0; i < 50; i++) {\n        const message = getExpoMessage(log);\n        if (message) messages.add(message);\n      }\n\n      // Should see multiple variations\n      expect(messages.size).toBeGreaterThan(1);\n    });\n  });\n});\n```\n\n---\n\n## 9. socket-client.ts\n\n### Test Skeleton\n\n```typescript\n// src/lib/__tests__/socket-client.test.ts\nimport { io, Socket } from 'socket.io-client';\nimport { initStateSyncSocket, getStateSyncSocket, disconnectAll } from '../socket-client';\nimport * as csrfModule from './csrf';\n\njest.mock('socket.io-client');\njest.mock('./csrf');\n\ndescribe('socket-client', () => {\n  let mockSocket: Partial<Socket>;\n\n  beforeEach(() => {\n    jest.clearAllMocks();\n    mockSocket = {\n      connected: false,\n      disconnect: jest.fn(),\n      on: jest.fn(),\n    };\n    (io as jest.Mock).mockReturnValue(mockSocket);\n    (csrfModule.getCsrfToken as jest.Mock).mockResolvedValue('mock-token');\n    (csrfModule.clearCsrfToken as jest.Mock).mockImplementation(() => {});\n  });\n\n  describe('initStateSyncSocket', () => {\n    it('should create socket with correct configuration', () => {\n      initStateSyncSocket();\n\n      expect(io).toHaveBeenCalledWith(\n        '/state_sync',\n        expect.objectContaining({\n          autoConnect: false,\n          transports: ['polling', 'websocket'],\n          withCredentials: true,\n        })\n      );\n    });\n\n    it('should return same instance on multiple calls', () => {\n      const socket1 = initStateSyncSocket();\n      const socket2 = initStateSyncSocket();\n\n      expect(socket1).toBe(socket2);\n      expect(io).toHaveBeenCalledTimes(1);\n    });\n\n    it('should configure auth callback', () => {\n      initStateSyncSocket();\n\n      const config = (io as jest.Mock).mock.calls[0][1];\n      expect(config.auth).toBeInstanceOf(Function);\n    });\n\n    it('should fetch CSRF token in auth callback', async () => {\n      initStateSyncSocket();\n\n      const config = (io as jest.Mock).mock.calls[0][1];\n      const callback = jest.fn();\n      \n      await config.auth(callback);\n\n      expect(csrfModule.getCsrfToken).toHaveBeenCalled();\n      expect(callback).toHaveBeenCalledWith({ csrf_token: 'mock-token' });\n    });\n\n    it('should handle CSRF token fetch failure in auth', async () => {\n      (csrfModule.getCsrfToken as jest.Mock).mockRejectedValueOnce(\n        new Error('CSRF failed')\n      );\n\n      const consoleSpy = jest.spyOn(console, 'error').mockImplementation();\n      initStateSyncSocket();\n\n      const config = (io as jest.Mock).mock.calls[0][1];\n      const callback = jest.fn();\n      \n      await config.auth(callback);\n\n      expect(consoleSpy).toHaveBeenCalledWith(\n        expect.stringContaining('CSRF token fetch failed'),\n        expect.any(Error)\n      );\n      expect(callback).toHaveBeenCalledWith({});\n\n      consoleSpy.mockRestore();\n    });\n\n    it('should setup connect_error handler', () => {\n      initStateSyncSocket();\n\n      expect(mockSocket.on).toHaveBeenCalledWith('connect_error', expect.any(Function));\n    });\n\n    it('should clear CSRF token on connect_error', () => {\n      initStateSyncSocket();\n\n      const connectErrorHandler = (mockSocket.on as jest.Mock).mock.calls.find(\n        call => call[0] === 'connect_error'\n      )?.[1];\n\n      connectErrorHandler();\n\n      expect(csrfModule.clearCsrfToken).toHaveBeenCalled();\n    });\n\n    it('should use NEXT_PUBLIC_A0_URL if provided', () => {\n      const originalEnv = process.env.NEXT_PUBLIC_A0_URL;\n      process.env.NEXT_PUBLIC_A0_URL = 'http://localhost:5000';\n\n      // Reset module to pick up new env\n      jest.resetModules();\n      const { initStateSyncSocket } = require('../socket-client');\n      initStateSyncSocket();\n\n      expect(io).toHaveBeenCalledWith(\n        'http://localhost:5000/state_sync',\n        expect.any(Object)\n      );\n\n      process.env.NEXT_PUBLIC_A0_URL = originalEnv;\n    });\n\n    it('should use empty string for URL in production', () => {\n      const originalEnv = process.env.NEXT_PUBLIC_A0_URL;\n      delete process.env.NEXT_PUBLIC_A0_URL;\n\n      jest.resetModules();\n      const { initStateSyncSocket } = require('../socket-client');\n      initStateSyncSocket();\n\n      expect(io).toHaveBeenCalledWith(\n        '/state_sync',\n        expect.any(Object)\n      );\n\n      process.env.NEXT_PUBLIC_A0_URL = originalEnv;\n    });\n  });\n\n  describe('getStateSyncSocket', () => {\n    it('should return null before init', () => {\n      expect(getStateSyncSocket()).toBeNull();\n    });\n\n    it('should return socket after init', () => {\n      initStateSyncSocket();\n      const socket = getStateSyncSocket();\n\n      expect(socket).toBe(mockSocket);\n    });\n  });\n\n  describe('disconnectAll', () => {\n    it('should disconnect and clear socket', () => {\n      initStateSyncSocket();\n      \n      disconnectAll();\n\n      expect(mockSocket.disconnect).toHaveBeenCalled();\n      expect(getStateSyncSocket()).toBeNull();\n    });\n\n    it('should handle disconnect when socket not initialized', () => {\n      expect(() => disconnectAll()).not.toThrow();\n    });\n\n    it('should allow reinit after disconnect', () => {\n      initStateSyncSocket();\n      disconnectAll();\n      \n      const newSocket = initStateSyncSocket();\n\n      expect(newSocket).toBeTruthy();\n      expect(io).toHaveBeenCalledTimes(2);\n    });\n  });\n\n  describe('transport configuration', () => {\n    it('should start with polling transport', () => {\n      initStateSyncSocket();\n\n      const config = (io as jest.Mock).mock.calls[0][1];\n      expect(config.transports[0]).toBe('polling');\n    });\n\n    it('should include websocket as fallback', () => {\n      initStateSyncSocket();\n\n      const config = (io as jest.Mock).mock.calls[0][1];\n      expect(config.transports).toContain('websocket');\n    });\n\n    it('should send credentials with requests', () => {\n      initStateSyncSocket();\n\n      const config = (io as jest.Mock).mock.calls[0][1];\n      expect(config.withCredentials).toBe(true);\n    });\n  });\n});\n```\n\n---\n\n## 10. utils.ts\n\n### Test Skeleton\n\n```typescript\n// src/lib/__tests__/utils.test.ts\nimport { cn } from '../utils';\n\ndescribe('utils', () => {\n  describe('cn (className merger)', () => {\n    it('should merge class names', () => {\n      const result = cn('foo', 'bar');\n      expect(result).toBe('foo bar');\n    });\n\n    it('should handle conditional classes', () => {\n      const result = cn('foo', false && 'bar', 'baz');\n      expect(result).toBe('foo baz');\n    });\n\n    it('should merge Tailwind conflicting classes correctly', () => {\n      const result = cn('px-2', 'px-4');\n      // twMerge should keep only the last px class\n      expect(result).toBe('px-4');\n    });\n\n    it('should handle undefined and null', () => {\n      const result = cn('foo', undefined, null, 'bar');\n      expect(result).toBe('foo bar');\n    });\n\n    it('should handle empty inputs', () => {\n      const result = cn();\n      expect(result).toBe('');\n    });\n\n    it('should handle objects', () => {\n      const result = cn({ 'foo': true, 'bar': false, 'baz': true });\n      expect(result).toBe('foo baz');\n    });\n\n    it('should handle arrays', () => {\n      const result = cn(['foo', 'bar'], 'baz');\n      expect(result).toBe('foo bar baz');\n    });\n\n    it('should handle complex Tailwind conflicts', () => {\n      const result = cn(\n        'bg-red-500 text-white',\n        'bg-blue-500'\n      );\n      expect(result).toBe('text-white bg-blue-500');\n    });\n\n    it('should handle very long class strings', () => {\n      const longClass = Array.from({ length: 100 }, (_, i) => `class-${i}`).join(' ');\n      const result = cn(longClass, 'extra');\n      expect(result).toContain('extra');\n    });\n\n    it('should deduplicate classes', () => {\n      const result = cn('foo', 'bar', 'foo');\n      expect(result).toBe('foo bar');\n    });\n  });\n});\n```\n\n---\n\n## Integration Test Gaps\n\n### 1. Socket.IO + Chat Integration\n```typescript\n// src/__tests__/integration/socket-chat.test.tsx\ndescribe('Socket.IO + Chat Integration', () => {\n  it('should display assistant messages from socket state_push');\n  it('should handle user message send and response cycle');\n  it('should sync context ID between chat and socket');\n  it('should recover from connection loss');\n});\n```\n\n### 2. Action Cards + Socket Integration\n```typescript\n// src/__tests__/integration/action-cards-socket.test.tsx\ndescribe('Action Cards + Socket Integration', () => {\n  it('should create action cards from tool logs in real-time');\n  it('should handle rapid tool execution');\n  it('should persist read state across snapshot updates');\n});\n```\n\n### 3. Expo Bar + Multiple Data Sources\n```typescript\n// src/__tests__/integration/expo-multistream.test.tsx\ndescribe('Expo Bar Multiple Sources', () => {\n  it('should prioritize chefStatus over snapshot progress');\n  it('should fall back to snapshot when chefStatus unavailable');\n  it('should handle race conditions between sources');\n});\n```\n\n### 4. End-to-End Chat Flow\n```typescript\n// src/__tests__/e2e/chat-flow.test.tsx\ndescribe('Complete Chat Flow', () => {\n  it('should send message, receive response, update UI');\n  it('should queue messages during processing');\n  it('should handle network errors gracefully');\n  it('should reset chat and clear all state');\n});\n```\n\n---\n\n## Summary\n\n### Coverage Statistics (Estimated)\n- **Hooks:** 0% tested (0/6 hooks)\n- **Utilities:** 0% tested (0/4 utility modules)\n- **Critical Paths:** Network error handling, queue processing, socket lifecycle - all untested\n- **Edge Cases:** ~90% of identified edge cases untested\n\n### Priority Recommendations\n1. **Critical (Implement First):**\n   - `use-chat.ts` — Queue processing and error handling\n   - `use-socket.ts` — Connection lifecycle and CSRF integration\n   - `csrf.ts` — Concurrent call handling\n\n2. **High Priority:**\n   - `use-action-cards.ts` — Duplicate prevention\n   - `use-expo-stream.ts` — Timer cleanup\n   - `socket-client.ts` — Auth callback\n\n3. **Medium Priority:**\n   - `use-workspace.ts` — Data normalization\n   - `expo-messages.ts` — Message generation\n   - `use-mobile.ts` — Resize handling\n\n4. **Nice to Have:**\n   - `utils.ts` — Class merging\n   - Integration tests for complete flows\n",
