      {
        "language": "typescript",
        "code": "export function useExpoStream(\n  snapshot: A0Snapshot | null,\n  chefStatus: ChefStatus | null,\n): ExpoState {\n  const [expo, setExpo] = useState<ExpoState>({\n    text: null,\n    thoughts: [],\n    active: false,\n  });\n  \n  const lastLogVersion = useRef(0);\n  const cachedExtraction = useRef<{ thoughts: string[]; headline: string | null; step: string | null } | null>(null);\n\n  // Memoize log extraction - only recompute when log_version changes\n  const { thoughts, headline, step } = useMemo(() => {\n    if (!snapshot?.logs?.length || snapshot.log_version === lastLogVersion.current) {\n      return cachedExtraction.current ?? { thoughts: [], headline: null, step: null };\n    }\n\n    // Only scan recent logs (last 20) for agent kvps\n    const recentLogs = snapshot.logs.slice(-20);\n    \n    for (let i = recentLogs.length - 1; i >= 0; i--) {\n      const log = recentLogs[i];\n      if (log.type !== \"agent\" || !log.kvps) continue;\n\n      const kvps = getAgentKvps(log.kvps);\n      if (kvps.thoughts?.length || kvps.headline || kvps.step) {\n        const result = {\n          thoughts: kvps.thoughts ?? [],\n          headline: kvps.headline ?? null,\n          step: kvps.step ?? null,\n        };\n        lastLogVersion.current = snapshot.log_version;\n        cachedExtraction.current = result;\n        return result;\n      }\n    }\n\n    const fallback = { thoughts: [], headline: null, step: null };\n    cachedExtraction.current = fallback;\n    lastLogVersion.current = snapshot.log_version;\n    return fallback;\n  }, [snapshot?.log_version, snapshot?.logs]);\n\n  // Rest of logic...\n}"
