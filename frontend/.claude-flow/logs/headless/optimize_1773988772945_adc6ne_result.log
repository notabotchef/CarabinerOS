      {
        "language": "typescript",
        "code": "export function useActionCards(snapshot: A0Snapshot | null): UseActionCardsReturn {\n  const [cards, setCards] = useState<ActionCard[]>([]);\n  const lastProcessedNo = useRef(0);\n\n  useEffect(() => {\n    if (!snapshot?.logs) return;\n\n    // Only process NEW logs (logs are ordered by .no)\n    const newLogs = snapshot.logs.filter(log => log.no > lastProcessedNo.current);\n    if (newLogs.length === 0) return;\n\n    const newCards: ActionCard[] = [];\n    \n    for (const log of newLogs) {\n      if (log.type !== \"tool\") continue;\n      const kvps = log.kvps || {};\n      \n      if (kvps.module && kvps.action) {\n        newCards.push({\n          id: log.id,\n          type: String(kvps.action),\n          module: String(kvps.module),\n          action: String(kvps.action),\n          itemId: kvps.item_id ? String(kvps.item_id) : undefined,\n          item: kvps.item as Record<string, unknown> | undefined,\n          summary: log.content.slice(0, 120),\n          timestamp: log.timestamp,\n          read: false,\n        });\n      }\n    }\n\n    if (newCards.length > 0) {\n      setCards(prev => [...prev, ...newCards]);\n      lastProcessedNo.current = newLogs[newLogs.length - 1].no;\n    }\n  }, [snapshot]);\n\n  // Rest remains same...\n}"
      },
      {
        "language": "typescript",
        "code": "// Current - loops backwards through ALL logs on every update\nfunction extractFromLogs(snapshot: A0Snapshot | null) {\n  if (!snapshot?.logs?.length) return { thoughts: [], headline: null, step: null };\n\n  for (let i = snapshot.logs.length - 1; i >= 0; i--) {\n    // Loops through potentially hundreds of logs\n  }\n}\n\nuseEffect(() => {\n  const { thoughts, headline, step } = extractFromLogs(snapshot); // Called every time\n}, [snapshot]);"
