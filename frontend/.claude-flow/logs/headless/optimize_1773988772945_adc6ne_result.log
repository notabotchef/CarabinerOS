        "language": "typescript",
        "code": "const CSRF_STORAGE_KEY = 'carabiner_csrf';\nconst RUNTIME_STORAGE_KEY = 'carabiner_runtime';\n\nexport async function getCsrfToken(): Promise<string> {\n  // Try sessionStorage first\n  const cached = sessionStorage.getItem(CSRF_STORAGE_KEY);\n  const cachedRuntime = sessionStorage.getItem(RUNTIME_STORAGE_KEY);\n  \n  if (cached && cachedRuntime) {\n    csrfToken = cached;\n    runtimeId = cachedRuntime;\n    return cached;\n  }\n\n  if (csrfPromise) return csrfPromise;\n\n  csrfPromise = fetch(\"/csrf_token\", { credentials: \"include\" })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.ok) {\n        csrfToken = data.token;\n        runtimeId = data.runtime_id;\n        \n        // Persist to sessionStorage\n        sessionStorage.setItem(CSRF_STORAGE_KEY, data.token);\n        sessionStorage.setItem(RUNTIME_STORAGE_KEY, data.runtime_id);\n        \n        document.cookie = `csrf_token_${runtimeId}=${csrfToken}; SameSite=Strict; Path=/`;\n        return data.token;\n      }\n      throw new Error(data.error || \"Failed to get CSRF token\");\n    })\n    .finally(() => {\n      csrfPromise = null;\n    });\n\n  return csrfPromise;\n}\n\nexport function clearCsrfToken() {\n  csrfToken = null;\n  runtimeId = null;\n  sessionStorage.removeItem(CSRF_STORAGE_KEY);\n  sessionStorage.removeItem(RUNTIME_STORAGE_KEY);\n}"
