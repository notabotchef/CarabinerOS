        "content": "**Missing Coverage:**\n- ✗ Token caching\n- ✗ Cookie setting with correct attributes\n- ✗ Concurrent request deduplication\n- ✗ Error handling\n- ✗ Clear function\n\n**Test Skeleton:**\n```typescript\n// __tests__/lib/csrf.test.ts\nimport { getCsrfToken, clearCsrfToken, getRuntimeId } from '@/lib/csrf';\n\ndescribe('csrf', () => {\n  beforeEach(() => {\n    global.fetch = jest.fn();\n    document.cookie = '';\n    clearCsrfToken();\n  });\n\n  it('should fetch and cache CSRF token', async () => {\n    (global.fetch as jest.Mock).mockResolvedValueOnce({\n      json: async () => ({ ok: true, token: 'test-token', runtime_id: 'runtime-1' }),\n    });\n\n    const token = await getCsrfToken();\n    expect(token).toBe('test-token');\n    expect(global.fetch).toHaveBeenCalledTimes(1);\n\n    // Second call should use cache\n    const token2 = await getCsrfToken();\n    expect(token2).toBe('test-token');\n    expect(global.fetch).toHaveBeenCalledTimes(1);\n  });\n\n  it('should set cookie with correct attributes', async () => {\n    (global.fetch as jest.Mock).mockResolvedValueOnce({\n      json: async () => ({ ok: true, token: 'test-token', runtime_id: 'runtime-1' }),\n    });\n\n    await getCsrfToken();\n    expect(document.cookie).toContain('csrf_token_runtime-1=test-token');\n    expect(document.cookie).toContain('SameSite=Strict');\n  });\n\n  it('should deduplicate concurrent requests', async () => {\n    (global.fetch as jest.Mock).mockResolvedValueOnce({\n      json: async () => ({ ok: true, token: 'test-token', runtime_id: 'runtime-1' }),\n    });\n\n    const [token1, token2] = await Promise.all([getCsrfToken(), getCsrfToken()]);\n    expect(token1).toBe(token2);\n    expect(global.fetch).toHaveBeenCalledTimes(1);\n  });\n\n  it('should handle fetch errors', async () => {\n    (global.fetch as jest.Mock).mockRejectedValueOnce(new Error('Network error'));\n    await expect(getCsrfToken()).rejects.toThrow();\n  });\n\n  it('should clear cached token', () => {\n    // Test clearCsrfToken resets state\n  });\n\n  it('should return runtime ID', async () => {\n    (global.fetch as jest.Mock).mockResolvedValueOnce({\n      json: async () => ({ ok: true, token: 'test-token', runtime_id: 'runtime-1' }),\n    });\n\n    await getCsrfToken();\n    expect(getRuntimeId()).toBe('runtime-1');\n  });\n});\n```\n\n---\n\n",
