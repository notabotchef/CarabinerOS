        "title": "6. **socket-client.ts** — High Priority",
        "content": "**Missing Coverage:**\n- ✗ Singleton pattern enforcement\n- ✗ Socket initialization with correct config\n- ✗ Auth callback execution\n- ✗ CSRF token clearing on error\n- ✗ Transport configuration (polling → websocket)\n- ✗ Disconnect cleanup\n\n**Test Skeleton:**\n```typescript\n// __tests__/lib/socket-client.test.ts\nimport { initStateSyncSocket, getStateSyncSocket, disconnectAll } from '@/lib/socket-client';\nimport { io } from 'socket.io-client';\nimport * as csrf from '@/lib/csrf';\n\njest.mock('socket.io-client');\njest.mock('@/lib/csrf');\n\ndescribe('socket-client', () => {\n  beforeEach(() => {\n    disconnectAll();\n    jest.clearAllMocks();\n  });\n\n  it('should initialize socket with correct config', () => {\n    const mockSocket = { on: jest.fn(), disconnect: jest.fn() };\n    (io as jest.Mock).mockReturnValue(mockSocket);\n\n    initStateSyncSocket();\n\n    expect(io).toHaveBeenCalledWith(\n      expect.stringContaining('/state_sync'),\n      expect.objectContaining({\n        autoConnect: false,\n        transports: ['polling', 'websocket'],\n        withCredentials: true,\n      })\n    );\n  });\n\n  it('should return same socket instance on multiple calls', () => {\n    const mockSocket = { on: jest.fn(), disconnect: jest.fn() };\n    (io as jest.Mock).mockReturnValue(mockSocket);\n\n    const socket1 = initStateSyncSocket();\n    const socket2 = initStateSyncSocket();\n    \n    expect(socket1).toBe(socket2);\n    expect(io).toHaveBeenCalledTimes(1);\n  });\n\n  it('should call CSRF token in auth callback', async () => {\n    const mockSocket = { on: jest.fn(), disconnect: jest.fn() };\n    (io as jest.Mock).mockReturnValue(mockSocket);\n    (csrf.getCsrfToken as jest.Mock).mockResolvedValue('test-token');\n\n    initStateSyncSocket();\n\n    const authCallback = (io as jest.Mock).mock.calls[0][1].auth;\n    const cb = jest.fn();\n    await authCallback(cb);\n\n    expect(csrf.getCsrfToken).toHaveBeenCalled();\n    expect(cb).toHaveBeenCalledWith({ csrf_token: 'test-token' });\n  });\n\n  it('should clear CSRF token on connect_error', () => {\n    const mockSocket = { on: jest.fn(), disconnect: jest.fn() };\n    (io as jest.Mock).mockReturnValue(mockSocket);\n\n    initStateSyncSocket();\n\n    const errorHandler = mockSocket.on.mock.calls.find(\n      ([event]) => event === 'connect_error'\n    )[1];\n\n    errorHandler();\n    expect(csrf.clearCsrfToken).toHaveBeenCalled();\n  });\n\n  it('should disconnect socket on disconnectAll', () => {\n    const mockSocket = { on: jest.fn(), disconnect: jest.fn() };\n    (io as jest.Mock).mockReturnValue(mockSocket);\n\n    initStateSyncSocket();\n    disconnectAll();\n\n    expect(mockSocket.disconnect).toHaveBeenCalled();\n    expect(getStateSyncSocket()).toBeNull();\n  });\n});\n```\n\n---\n\n",
