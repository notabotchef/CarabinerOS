        "title": "8. **utils.ts**",
        "content": "\n**Untested Functions:**\n- cn() with various input combinations\n- Tailwind class merging behavior\n- Edge cases\n\n**Test Skeletons:**\n\n```typescript\n// tests/lib/utils.test.ts\nimport { cn } from '@/lib/utils';\n\ndescribe('utils - cn', () => {\n  it('should merge single class', () => {\n    expect(cn('text-red-500')).toBe('text-red-500');\n  });\n\n  it('should merge multiple classes', () => {\n    expect(cn('text-red-500', 'bg-blue-100')).toBe('text-red-500 bg-blue-100');\n  });\n\n  it('should handle conflicting Tailwind classes', () => {\n    // Later class should win\n    const result = cn('text-red-500', 'text-blue-500');\n    expect(result).toBe('text-blue-500');\n  });\n\n  it('should filter falsy values', () => {\n    expect(cn('text-red-500', false, null, undefined, 'bg-blue-100'))\n      .toBe('text-red-500 bg-blue-100');\n  });\n\n  it('should handle conditional classes', () => {\n    const isActive = true;\n    expect(cn('base-class', isActive && 'active-class'))\n      .toBe('base-class active-class');\n  });\n\n  it('should handle empty input', () => {\n    expect(cn()).toBe('');\n  });\n\n  it('should handle arrays', () => {\n    expect(cn(['text-red-500', 'bg-blue-100']))\n      .toBe('text-red-500 bg-blue-100');\n  });\n\n  it('should handle objects', () => {\n    expect(cn({ 'text-red-500': true, 'bg-blue-100': false }))\n      .toBe('text-red-500');\n  });\n});\n```\n\n",
