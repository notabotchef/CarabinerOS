// tests/hooks/use-workspace.test.ts\nimport { renderHook, waitFor } from '@testing-library/react';\nimport { useWorkspace } from '@/hooks/use-workspace';\n\nglobal.fetch = jest.fn();\n\ndescribe('useWorkspace', () => {\n  afterEach(() => {\n    jest.clearAllMocks();\n  });\n\n  it('should handle 404 responses', async () => {\n    (fetch as jest.Mock).mockResolvedValue({\n      ok: false,\n      status: 404\n    });\n    const { result } = renderHook(() => useWorkspace('/api/test'));\n    await waitFor(() => expect(result.current.loading).toBe(false));\n    expect(result.current.error).toBeTruthy();\n    expect(result.current.data).toEqual([]);\n  });\n\n  it('should handle network errors', async () => {\n    (fetch as jest.Mock).mockRejectedValue(new Error('Network failed'));\n    // Verify error state\n  });\n\n  it('should append locationId to query string', () => {\n    renderHook(() => useWorkspace('/api/test', 'loc-123'));\n    expect(fetch).toHaveBeenCalledWith(\n      '/api/test?location_id=loc-123',\n      expect.any(Object)\n    );\n  });\n\n  it('should handle array response', async () => {\n    (fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => [{ id: 1 }, { id: 2 }]\n    });\n    // Verify data = array\n  });\n\n  it('should extract data from json.items', async () => {\n    (fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => ({ items: [{ id: 1 }] })\n    });\n    // Verify data = json.items\n  });\n\n  it('should extract data from json.data', async () => {\n    (fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => ({ data: [{ id: 1 }] })\n    });\n    // Verify data = json.data\n  });\n\n  it('should refetch on refresh()', async () => {\n    const { result } = renderHook(() => useWorkspace('/api/test'));\n    await waitFor(() => expect(result.current.loading).toBe(false));\n    \n    (fetch as jest.Mock).mockClear();\n    act(() => result.current.refresh());\n    \n    expect(fetch).toHaveBeenCalledTimes(1);\n  });\n\n  it('should refetch when locationId changes', async () => {\n    const { rerender } = renderHook(\n      ({ locationId }) => useWorkspace('/api/test', locationId),\n      { initialProps: { locationId: 'loc-1' } }\n    );\n    \n    await waitFor(() => expect(fetch).toHaveBeenCalledTimes(1));\n    \n    rerender({ locationId: 'loc-2' });\n    expect(fetch).toHaveBeenCalledTimes(2);\n  });\n});\n```\n\n### 5. **csrf.ts**\n\n**Untested Functions:**\n- Concurrent getCsrfToken calls\n- Cookie setting mechanism\n- clearCsrfToken behavior\n- getRuntimeId edge cases\n\n**Test Skeletons:**\n\n```typescript\n// tests/lib/csrf.test.ts\nimport { getCsrfToken, getRuntimeId, clearCsrfToken } from '@/lib/csrf';\n\nglobal.fetch = jest.fn();\n\ndescribe('csrf', () => {\n  beforeEach(() => {\n    clearCsrfToken();\n    document.cookie = '';\n  });\n\n  it('should fetch token on first call', async () => {\n    (fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'csrf-123', runtime_id: 'rt-1' })\n    });\n    \n    const token = await getCsrfToken();\n    expect(token).toBe('csrf-123');\n    expect(fetch).toHaveBeenCalledTimes(1);\n  });\n\n  it('should cache token and reuse', async () => {\n    (fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'csrf-123', runtime_id: 'rt-1' })\n    });\n    \n    await getCsrfToken();\n    await getCsrfToken();\n    expect(fetch).toHaveBeenCalledTimes(1);\n  });\n\n  it('should deduplicate concurrent calls', async () => {\n    (fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'csrf-123', runtime_id: 'rt-1' })\n    });\n    \n    const [t1, t2, t3] = await Promise.all([\n      getCsrfToken(),\n      getCsrfToken(),\n      getCsrfToken()\n    ]);\n    \n    expect(fetch).toHaveBeenCalledTimes(1);\n    expect(t1).toBe(t2);\n    expect(t2).toBe(t3);\n  });\n\n  it('should set cookie with runtime_id', async () => {\n    (fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'csrf-123', runtime_id: 'rt-1' })\n    });\n    \n    await getCsrfToken();\n    expect(document.cookie).toContain('csrf_token_rt-1=csrf-123');\n  });\n\n  it('should throw on error response', async () => {\n    (fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: false, error: 'Token generation failed' })\n    });\n    \n    await expect(getCsrfToken()).rejects.toThrow('Token generation failed');\n  });\n\n  it('should handle network errors', async () => {\n    (fetch as jest.Mock).mockRejectedValue(new Error('Network error'));\n    await expect(getCsrfToken()).rejects.toThrow('Network error');\n  });\n\n  it('should return cached runtime_id', async () => {\n    (fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'csrf-123', runtime_id: 'rt-1' })\n    });\n    \n    await getCsrfToken();\n    expect(getRuntimeId()).toBe('rt-1');\n  });\n\n  it('should return null before fetch', () => {\n    expect(getRuntimeId()).toBeNull();\n  });\n\n  it('should clear cached values', async () => {\n    (fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'csrf-123', runtime_id: 'rt-1' })\n    });\n    \n    await getCsrfToken();\n    clearCsrfToken();\n    \n    expect(getRuntimeId()).toBeNull();\n    \n    // Next call should fetch again\n    await getCsrfToken();\n    expect(fetch).toHaveBeenCalledTimes(2);\n  });\n});\n```\n\n### 6. **socket-client.ts**\n\n**Missing Integration Tests:**\n- Auth callback flow\n- Transport upgrade behavior\n- Connect error → CSRF invalidation\n- Multiple init calls\n\n**Test Skeletons:**\n\n```typescript\n// tests/lib/socket-client.test.ts\nimport { initStateSyncSocket, getStateSyncSocket, disconnectAll } from '@/lib/socket-client';\nimport { getCsrfToken, clearCsrfToken } from '@/lib/csrf';\nimport { io } from 'socket.io-client';\n\njest.mock('socket.io-client');\njest.mock('@/lib/csrf');\n\ndescribe('socket-client', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n  });\n\n  it('should initialize socket with correct config', () => {\n    const mockSocket = {\n      on: jest.fn(),\n      connect: jest.fn(),\n      disconnect: jest.fn()\n    };\n    (io as jest.Mock).mockReturnValue(mockSocket);\n    \n    const socket = initStateSyncSocket();\n    \n    expect(io).toHaveBeenCalledWith(\n      expect.stringContaining('/state_sync'),\n      expect.objectContaining({\n        autoConnect: false,\n        transports: ['polling', 'websocket'],\n        withCredentials: true,\n        auth: expect.any(Function)\n      })\n    );\n  });\n\n  it('should reuse existing socket on multiple init calls', () => {\n    const mockSocket = { on: jest.fn() };\n    (io as jest.Mock).mockReturnValue(mockSocket);\n    \n    const s1 = initStateSyncSocket();\n    const s2 = initStateSyncSocket();\n    \n    expect(s1).toBe(s2);\n    expect(io).toHaveBeenCalledTimes(1);\n  });\n\n  it('should fetch CSRF token in auth callback', async () => {\n    const mockSocket = { on: jest.fn() };\n    (io as jest.Mock).mockReturnValue(mockSocket);\n    (getCsrfToken as jest.Mock).mockResolvedValue('csrf-token');\n    \n    initStateSyncSocket();\n    \n    const authCallback = (io as jest.Mock).mock.calls[0][1].auth;\n    const cb = jest.fn();\n    await authCallback(cb);\n    \n    expect(getCsrfToken).toHaveBeenCalled();\n    expect(cb).toHaveBeenCalledWith({ csrf_token: 'csrf-token' });\n  });\n\n  it('should handle CSRF fetch failure in auth', async () => {\n    const mockSocket = { on: jest.fn() };\n    (io as jest.Mock).mockReturnValue(mockSocket);\n    (getCsrfToken as jest.Mock).mockRejectedValue(new Error('CSRF failed'));\n    \n    initStateSyncSocket();\n    \n    const authCallback = (io as jest.Mock).mock.calls[0][1].auth;\n    const cb = jest.fn();\n    await authCallback(cb);\n    \n    expect(cb).toHaveBeenCalledWith({});\n  });\n\n  it('should clear CSRF token on connect_error', () => {\n    const mockSocket = { on: jest.fn() };\n    (io as jest.Mock).mockReturnValue(mockSocket);\n    \n    initStateSyncSocket();\n    \n    const connectErrorHandler = mockSocket.on.mock.calls.find(\n      call => call[0] === 'connect_error'\n    )[1];\n    \n    connectErrorHandler();\n    expect(clearCsrfToken).toHaveBeenCalled();\n  });\n\n  it('should disconnect and clear on disconnectAll', () => {\n    const mockSocket = { \n      on: jest.fn(),\n      disconnect: jest.fn()\n    };\n    (io as jest.Mock).mockReturnValue(mockSocket);\n    \n    initStateSyncSocket();\n    disconnectAll();\n    \n    expect(mockSocket.disconnect).toHaveBeenCalled();\n    expect(getStateSyncSocket()).toBeNull();\n  });\n\n  it('should handle disconnectAll when not connected', () => {\n    expect(() => disconnectAll()).not.toThrow();\n  });\n});\n```\n\n### 7. **expo-messages.ts**\n\n**Untested Functions:**\n- All message extraction paths\n- Random selection distribution\n- Edge cases in tool name extraction\n\n**Test Skeletons:**\n\n```typescript\n// tests/lib/expo-messages.test.ts\nimport { getExpoMessage, getCompletionMessage } from '@/lib/expo-messages';\n\ndescribe('expo-messages', () => {\n  describe('getExpoMessage', () => {\n    it('should return tool-specific message', () => {\n      const log = {\n        type: 'tool',\n        heading: 'Using food_cost_tool...',\n        content: ''\n      };\n      const msg = getExpoMessage(log);\n      expect(msg).toBeTruthy();\n      // Should be one of food_cost_tool messages\n    });\n\n    it('should handle tool without custom messages', () => {\n      const log = {\n        type: 'tool',\n        heading: 'Using unknown_tool...',\n        content: ''\n      };\n      const msg = getExpoMessage(log);\n      expect(msg).toBeTruthy();\n      // Should fall back to default\n    });\n\n    it('should handle agent delegation', () => {\n      const log = {\n        type: 'agent',\n        heading: 'Specialist Agent',\n        content: ''\n      };\n      const msg = getExpoMessage(log);\n      expect(msg).toContain('Delegating');\n    });\n\n    it('should handle subagent delegation', () => {\n      const log = {\n        type: 'subagent',\n        heading: 'Worker Agent',\n        content: ''\n      };\n      const msg = getExpoMessage(log);\n      expect(msg).toContain('Delegating');\n    });\n\n    it('should return progress content', () => {\n      const log = {\n        type: 'progress',\n        content: 'Processing step 3 of 5',\n        heading: ''\n      };\n      const msg = getExpoMessage(log);\n      expect(msg).toBe('Processing step 3 of 5');\n    });\n\n    it('should return null for unhandled log types', () => {\n      const log = {\n        type: 'user',\n        heading: '',\n        content: ''\n      };\n      expect(getExpoMessage(log)).toBeNull();\n    });\n\n    it('should handle missing heading', () => {\n      const log = {\n        type: 'tool',\n        heading: null,\n        content: ''\n      };\n      expect(getExpoMessage(log)).toBeNull();\n    });\n  });\n\n  describe('getCompletionMessage', () => {\n    it('should return one of completion messages', () => {\n      const msg = getCompletionMessage();\n      expect(['Heard.', 'Service.', 'All set.', 'Done, Chef.']).toContain(msg);\n    });\n\n    it('should return consistent message types across calls', () => {\n      const messages = new Set();\n      for (let i = 0; i < 100; i++) {\n        messages.add(getCompletionMessage());\n      }\n      // Should have some variety but all valid\n      expect(messages.size).toBeGreaterThan(0);\n      expect(messages.size).toBeLessThanOrEqual(4);\n    });\n  });\n});\n```\n\n### 8. **utils.ts**\n\n**Untested Functions:**\n- cn() with various input combinations\n- Tailwind class merging behavior\n- Edge cases\n\n**Test Skeletons:**\n\n```typescript\n// tests/lib/utils.test.ts\nimport { cn } from '@/lib/utils';\n\ndescribe('utils - cn', () => {\n  it('should merge single class', () => {\n    expect(cn('text-red-500')).toBe('text-red-500');\n  });\n\n  it('should merge multiple classes', () => {\n    expect(cn('text-red-500', 'bg-blue-100')).toBe('text-red-500 bg-blue-100');\n  });\n\n  it('should handle conflicting Tailwind classes', () => {\n    // Later class should win\n    const result = cn('text-red-500', 'text-blue-500');\n    expect(result).toBe('text-blue-500');\n  });\n\n  it('should filter falsy values', () => {\n    expect(cn('text-red-500', false, null, undefined, 'bg-blue-100'))\n      .toBe('text-red-500 bg-blue-100');\n  });\n\n  it('should handle conditional classes', () => {\n    const isActive = true;\n    expect(cn('base-class', isActive && 'active-class'))\n      .toBe('base-class active-class');\n  });\n\n  it('should handle empty input', () => {\n    expect(cn()).toBe('');\n  });\n\n  it('should handle arrays', () => {\n    expect(cn(['text-red-500', 'bg-blue-100']))\n      .toBe('text-red-500 bg-blue-100');\n  });\n\n  it('should handle objects', () => {\n    expect(cn({ 'text-red-500': true, 'bg-blue-100': false }))\n      .toBe('text-red-500');\n  });\n});\n```\n\n## Summary of Critical Gaps\n\n### High Priority (Security/Data Integrity):\n1. **CSRF token handling** - Concurrent calls, error recovery\n2. **Socket authentication** - Auth callback failure modes\n3. **Error boundaries** - Missing error handling in all hooks\n4. **Data validation** - No schema validation for API responses\n\n### Medium Priority (Correctness):\n1. **State synchronization** - Race conditions in useSocket\n2. **Log deduplication** - Edge cases in useActionCards, useChat\n3. **Fresh chat state** - Context switching in useChat\n4. **Duration calculation** - Timestamp edge cases\n\n### Low Priority (UX):\n1. **Message variety** - Random message distribution\n2. **Mobile detection** - SSR hydration\n3. **Heading cleanup** - Agent number mapping\n\n## Recommended Next Steps:\