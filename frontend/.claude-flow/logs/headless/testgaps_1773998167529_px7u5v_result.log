        "title": "3. **use-socket.ts**",
        "content": "\n**Untested Functions:**\n- CSRF token fetch failure handling\n- Pending context management\n- Connection lifecycle edge cases\n- Log deduplication\n\n**Missing Integration Tests:**\n- Full connect → subscribe → receive flow\n- Reconnection with fresh CSRF\n- Multiple state_push events\n\n**Test Skeletons:**\n\n```typescript\n// tests/hooks/use-socket.test.ts\nimport { renderHook, waitFor } from '@testing-library/react';\nimport { useSocket } from '@/hooks/use-socket';\nimport { getCsrfToken } from '@/lib/csrf';\n\njest.mock('@/lib/csrf');\njest.mock('@/lib/socket-client');\n\ndescribe('useSocket', () => {\n  it('should initialize with disconnected state', () => {\n    const { result } = renderHook(() => useSocket());\n    expect(result.current.connected).toBe(false);\n    expect(result.current.snapshot).toBeNull();\n  });\n\n  it('should handle CSRF token fetch failure gracefully', async () => {\n    (getCsrfToken as jest.Mock).mockRejectedValue(new Error('CSRF failed'));\n    // Socket should still attempt connection\n  });\n\n  it('should queue subscribe call before connection', () => {\n    const { result } = renderHook(() => useSocket());\n    act(() => {\n      result.current.subscribe('context-123');\n    });\n    // pendingContextRef should be set\n  });\n\n  it('should use pending context on connection', async () => {\n    // Subscribe before connect\n    // Verify state_request uses pending context\n  });\n\n  it('should handle state_push without snapshot', () => {\n    // Malformed envelope\n    // Should log warning, not crash\n  });\n\n  it('should deduplicate logs based on log.no', () => {\n    // Receive same log twice\n    // logFromRef should prevent reprocessing\n  });\n\n  it('should update logFromRef after each state_push', () => {\n    // Verify logFromRef = last log.no + 1\n  });\n\n  it('should handle chef_status events', () => {\n    // Mock chef_status emission\n  });\n\n  it('should cleanup on unmount', () => {\n    const { unmount } = renderHook(() => useSocket());\n    unmount();\n    // Verify socket.disconnect() called\n  });\n});\n```\n\n",
