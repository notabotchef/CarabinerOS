        "language": "typescript",
        "code": "// tests/hooks/use-workspace.test.ts\nimport { renderHook, waitFor } from '@testing-library/react';\nimport { useWorkspace } from '@/hooks/use-workspace';\n\nglobal.fetch = jest.fn();\n\ndescribe('useWorkspace', () => {\n  afterEach(() => {\n    jest.clearAllMocks();\n  });\n\n  it('should handle 404 responses', async () => {\n    (fetch as jest.Mock).mockResolvedValue({\n      ok: false,\n      status: 404\n    });\n    const { result } = renderHook(() => useWorkspace('/api/test'));\n    await waitFor(() => expect(result.current.loading).toBe(false));\n    expect(result.current.error).toBeTruthy();\n    expect(result.current.data).toEqual([]);\n  });\n\n  it('should handle network errors', async () => {\n    (fetch as jest.Mock).mockRejectedValue(new Error('Network failed'));\n    // Verify error state\n  });\n\n  it('should append locationId to query string', () => {\n    renderHook(() => useWorkspace('/api/test', 'loc-123'));\n    expect(fetch).toHaveBeenCalledWith(\n      '/api/test?location_id=loc-123',\n      expect.any(Object)\n    );\n  });\n\n  it('should handle array response', async () => {\n    (fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => [{ id: 1 }, { id: 2 }]\n    });\n    // Verify data = array\n  });\n\n  it('should extract data from json.items', async () => {\n    (fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => ({ items: [{ id: 1 }] })\n    });\n    // Verify data = json.items\n  });\n\n  it('should extract data from json.data', async () => {\n    (fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => ({ data: [{ id: 1 }] })\n    });\n    // Verify data = json.data\n  });\n\n  it('should refetch on refresh()', async () => {\n    const { result } = renderHook(() => useWorkspace('/api/test'));\n    await waitFor(() => expect(result.current.loading).toBe(false));\n    \n    (fetch as jest.Mock).mockClear();\n    act(() => result.current.refresh());\n    \n    expect(fetch).toHaveBeenCalledTimes(1);\n  });\n\n  it('should refetch when locationId changes', async () => {\n    const { rerender } = renderHook(\n      ({ locationId }) => useWorkspace('/api/test', locationId),\n      { initialProps: { locationId: 'loc-1' } }\n    );\n    \n    await waitFor(() => expect(fetch).toHaveBeenCalledTimes(1));\n    \n    rerender({ locationId: 'loc-2' });\n    expect(fetch).toHaveBeenCalledTimes(2);\n  });\n});"
