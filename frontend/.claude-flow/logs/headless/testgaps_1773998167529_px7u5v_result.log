        "title": "7. **expo-messages.ts**",
        "content": "\n**Untested Functions:**\n- All message extraction paths\n- Random selection distribution\n- Edge cases in tool name extraction\n\n**Test Skeletons:**\n\n```typescript\n// tests/lib/expo-messages.test.ts\nimport { getExpoMessage, getCompletionMessage } from '@/lib/expo-messages';\n\ndescribe('expo-messages', () => {\n  describe('getExpoMessage', () => {\n    it('should return tool-specific message', () => {\n      const log = {\n        type: 'tool',\n        heading: 'Using food_cost_tool...',\n        content: ''\n      };\n      const msg = getExpoMessage(log);\n      expect(msg).toBeTruthy();\n      // Should be one of food_cost_tool messages\n    });\n\n    it('should handle tool without custom messages', () => {\n      const log = {\n        type: 'tool',\n        heading: 'Using unknown_tool...',\n        content: ''\n      };\n      const msg = getExpoMessage(log);\n      expect(msg).toBeTruthy();\n      // Should fall back to default\n    });\n\n    it('should handle agent delegation', () => {\n      const log = {\n        type: 'agent',\n        heading: 'Specialist Agent',\n        content: ''\n      };\n      const msg = getExpoMessage(log);\n      expect(msg).toContain('Delegating');\n    });\n\n    it('should handle subagent delegation', () => {\n      const log = {\n        type: 'subagent',\n        heading: 'Worker Agent',\n        content: ''\n      };\n      const msg = getExpoMessage(log);\n      expect(msg).toContain('Delegating');\n    });\n\n    it('should return progress content', () => {\n      const log = {\n        type: 'progress',\n        content: 'Processing step 3 of 5',\n        heading: ''\n      };\n      const msg = getExpoMessage(log);\n      expect(msg).toBe('Processing step 3 of 5');\n    });\n\n    it('should return null for unhandled log types', () => {\n      const log = {\n        type: 'user',\n        heading: '',\n        content: ''\n      };\n      expect(getExpoMessage(log)).toBeNull();\n    });\n\n    it('should handle missing heading', () => {\n      const log = {\n        type: 'tool',\n        heading: null,\n        content: ''\n      };\n      expect(getExpoMessage(log)).toBeNull();\n    });\n  });\n\n  describe('getCompletionMessage', () => {\n    it('should return one of completion messages', () => {\n      const msg = getCompletionMessage();\n      expect(['Heard.', 'Service.', 'All set.', 'Done, Chef.']).toContain(msg);\n    });\n\n    it('should return consistent message types across calls', () => {\n      const messages = new Set();\n      for (let i = 0; i < 100; i++) {\n        messages.add(getCompletionMessage());\n      }\n      // Should have some variety but all valid\n      expect(messages.size).toBeGreaterThan(0);\n      expect(messages.size).toBeLessThanOrEqual(4);\n    });\n  });\n});\n```\n\n",
