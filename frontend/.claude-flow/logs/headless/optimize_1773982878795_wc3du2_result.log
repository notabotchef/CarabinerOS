      {
        "language": "typescript",
        "code": "// ✅ IMPROVED - use-workspace.ts\nimport { useState, useEffect, useRef } from \"react\";\n\nexport function useWorkspace<T = Record<string, unknown>>(\n  endpoint: string,\n  locationId?: string,\n): UseWorkspaceReturn<T> {\n  const [data, setData] = useState<T[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n  const [refreshKey, setRefreshKey] = useState(0);\n  \n  // Cache to prevent redundant fetches\n  const cacheRef = useRef<Map<string, { data: T[]; timestamp: number }>>(new Map());\n  const CACHE_TTL = 30000; // 30 seconds\n\n  useEffect(() => {\n    const url = locationId ? `${endpoint}?location_id=${locationId}` : endpoint;\n    \n    // Check cache first\n    const cached = cacheRef.current.get(url);\n    const now = Date.now();\n    if (cached && now - cached.timestamp < CACHE_TTL) {\n      setData(cached.data);\n      setLoading(false);\n      setError(null);\n      return;\n    }\n\n    setLoading(true);\n    fetch(url, { credentials: \"include\" })\n      .then(async (res) => {\n        if (!res.ok) throw new Error(`${res.status}`);\n        const json = await res.json();\n        const items = Array.isArray(json) ? json : json.items ?? json.data ?? [];\n        \n        // Update cache\n        cacheRef.current.set(url, { data: items, timestamp: now });\n        \n        setData(items);\n        setError(null);\n      })\n      .catch((err) => {\n        setError(err.message);\n        setData([]);\n      })\n      .finally(() => setLoading(false));\n  }, [endpoint, locationId, refreshKey]);\n\n  return { \n    data, \n    loading, \n    error, \n    refresh: () => {\n      cacheRef.current.clear(); // Clear cache on manual refresh\n      setRefreshKey((k) => k + 1);\n    }\n  };\n}"
