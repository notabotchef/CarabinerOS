  "output": "# Performance Analysis - CarabinerOS Frontend\n\nI've identified several critical performance issues across the codebase. Here's a comprehensive breakdown with actionable fixes:\n\n---\n\n## 1. **Memory Leaks** 🔴 CRITICAL\n\n### Issue: Unbounded ref growth in multiple hooks\n\n**Files affected:** `use-chat.ts`, `use-action-cards.ts`\n\n**Problem:** The `processedLogIds` and `processedIds` refs grow infinitely, never cleared across chat sessions.\n\n```typescript\n// ❌ CURRENT - Memory leak\nconst processedLogIds = useRef(new Set<string>());\n\nuseEffect(() => {\n  for (const log of snapshot.logs) {\n    const logKey = log.id ?? `no-${log.no}`;\n    if (processedIds.current.has(logKey)) continue;\n    // ... process\n    processedIds.current.add(logKey); // ← Grows forever\n  }\n}, [snapshot]);\n```\n\n**Fix:**\n\n```typescript\n// ✅ FIXED - use-chat.ts\nconst resetChat = useCallback(() => {\n  setMessages([]);\n  setContextId(null);\n  contextIdRef.current = null;\n  setLoading(false);\n  setQueuedMessages([]);\n  processedLogIds.current.clear(); // ← Clear the set\n  isProcessingRef.current = false;\n  freshChatRef.current = true;\n}, []);\n\n// Also clear on context switch\nuseEffect(() => {\n  if (contextId === null) {\n    processedLogIds.current.clear();\n  }\n}, [contextId]);\n```\n\n```typescript\n// ✅ FIXED - use-action-cards.ts\nexport function useActionCards(snapshot: A0Snapshot | null): UseActionCardsReturn {\n  const [cards, setCards] = useState<ActionCard[]>([]);\n  const processedIds = useRef(new Set<string>());\n  const prevContextRef = useRef<string | null>(null);\n\n  // Clear processed IDs when context changes\n  useEffect(() => {\n    const currentContext = snapshot?.context ?? null;\n    if (currentContext !== prevContextRef.current) {\n      processedIds.current.clear();\n      setCards([]);\n      prevContextRef.current = currentContext;\n    }\n  }, [snapshot?.context]);\n  \n  // ... rest of implementation\n}\n```\n\n---\n\n## 2. **Unnecessary Re-renders** 🟡 HIGH IMPACT\n\n### Issue A: Socket event handlers recreated on every mount\n\n**File:** `use-socket.ts`\n\n**Problem:** Socket event listeners are added/removed on every component mount, causing unnecessary work.\n\n```typescript\n// ❌ CURRENT - Handlers recreated every mount\nuseEffect(() => {\n  const socket = initStateSyncSocket();\n  \n  socket.on(\"state_push\", (envelope: A0StatePush) => {\n    // Handler recreated on every mount\n  });\n  \n  return () => {\n    socket.off(\"state_push\"); // Removes handler\n    socket.disconnect(); // ← This disconnects shared socket!\n  };\n}, []);\n```\n\n**Fix:**\n\n```typescript\n// ✅ FIXED - use-socket.ts\nexport function useSocket(): UseSocketReturn {\n  const [connected, setConnected] = useState(false);\n  const [snapshot, setSnapshot] = useState<A0Snapshot | null>(null);\n  const [chefStatus, setChefStatus] = useState<ChefStatus | null>(null);\n  const logFromRef = useRef(0);\n  \n  // Stable callback refs to prevent handler churn\n  const handleConnect = useCallback(() => {\n    setConnected(true);\n    const socket = getStateSyncSocket();\n    if (!socket) return;\n    \n    socket.emit(\"state_request\", {\n      context: null,\n      log_from: 0,\n      notifications_from: 0,\n      timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,\n      ts: new Date().toISOString(),\n      correlationId: crypto.randomUUID(),\n    });\n  }, []);\n\n  const handleDisconnect = useCallback(() => {\n    setConnected(false);\n  }, []);\n\n  const handleStatePush = useCallback((envelope: A0StatePush) => {\n    const data = envelope?.data;\n    const snap = data?.snapshot;\n    if (!snap) {\n      console.warn(\"[state_push] no snapshot in envelope\", Object.keys(envelope || {}));\n      return;\n    }\n    setSnapshot(snap);\n    if (snap.logs?.length > 0) {\n      logFromRef.current = snap.logs[snap.logs.length - 1].no + 1;\n    }\n  }, []);\n\n  const handleChefStatus = useCallback((status: ChefStatus) => {\n    setChefStatus(status);\n  }, []);\n\n  useEffect(() => {\n    const socket = initStateSyncSocket();\n    \n    // Register handlers once\n    socket.on(\"connect\", handleConnect);\n    socket.on(\"disconnect\", handleDisconnect);\n    socket.on(\"state_push\", handleStatePush);\n    socket.on(\"chef_status\", handleChefStatus);\n\n    getCsrfToken()\n      .then(() => socket.connect())\n      .catch(() => socket.connect());\n\n    return () => {\n      // Only remove handlers, don't disconnect (socket is shared)\n      socket.off(\"connect\", handleConnect);\n      socket.off(\"disconnect\", handleDisconnect);\n      socket.off(\"state_push\", handleStatePush);\n      socket.off(\"chef_status\", handleChefStatus);\n    };\n  }, [handleConnect, handleDisconnect, handleStatePush, handleChefStatus]);\n\n  // ... rest\n}\n```\n\n### Issue B: Workspace data re-fetched on every refresh trigger\n\n**File:** `use-workspace.ts`\n\n**Problem:** No deduplication or caching of identical requests.\n\n```typescript\n// ✅ IMPROVED - use-workspace.ts\nimport { useState, useEffect, useRef } from \"react\";\n\nexport function useWorkspace<T = Record<string, unknown>>(\n  endpoint: string,\n  locationId?: string,\n): UseWorkspaceReturn<T> {\n  const [data, setData] = useState<T[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n  const [refreshKey, setRefreshKey] = useState(0);\n  \n  // Cache to prevent redundant fetches\n  const cacheRef = useRef<Map<string, { data: T[]; timestamp: number }>>(new Map());\n  const CACHE_TTL = 30000; // 30 seconds\n\n  useEffect(() => {\n    const url = locationId ? `${endpoint}?location_id=${locationId}` : endpoint;\n    \n    // Check cache first\n    const cached = cacheRef.current.get(url);\n    const now = Date.now();\n    if (cached && now - cached.timestamp < CACHE_TTL) {\n      setData(cached.data);\n      setLoading(false);\n      setError(null);\n      return;\n    }\n\n    setLoading(true);\n    fetch(url, { credentials: \"include\" })\n      .then(async (res) => {\n        if (!res.ok) throw new Error(`${res.status}`);\n        const json = await res.json();\n        const items = Array.isArray(json) ? json : json.items ?? json.data ?? [];\n        \n        // Update cache\n        cacheRef.current.set(url, { data: items, timestamp: now });\n        \n        setData(items);\n        setError(null);\n      })\n      .catch((err) => {\n        setError(err.message);\n        setData([]);\n      })\n      .finally(() => setLoading(false));\n  }, [endpoint, locationId, refreshKey]);\n\n  return { \n    data, \n    loading, \n    error, \n    refresh: () => {\n      cacheRef.current.clear(); // Clear cache on manual refresh\n      setRefreshKey((k) => k + 1);\n    }\n  };\n}\n```\n\n---\n\n## 3. **Redundant Computations** 🟡 HIGH IMPACT\n\n### Issue: Repeated parsing in workspace pages\n\n**Files:** `food-cost/page.tsx`, `inventory/page.tsx`, `orders/page.tsx`, etc.\n\n**Problem:** Each row parses dates/numbers/currency on every render, even with stable data.\n\n```typescript\n// ❌ CURRENT - Parses on every render\n{formatCurrency(item.total)} {/* Called for every row on every render */}\n```\n\n**Fix - Create memoized computed data:**\n\n```typescript\n// ✅ FIXED - orders/page.tsx\nconst computedOrders = useMemo(() => \n  data.map(order => ({\n    ...order,\n    _computed: {\n      totalFormatted: formatCurrency(order.total),\n      createdFormatted: formatDate(order.created_at),\n      etaFormatted: formatDate(order.eta),\n    }\n  })),\n  [data] // Only recompute when data changes\n);\n\n// In render:\n<TableCell>{order._computed.totalFormatted}</TableCell>\n```\n\n**Better yet - compute during data fetch:**\n\n```typescript\n// ✅ BEST - use-workspace.ts enhancement\nexport function useWorkspace<T = Record<string, unknown>>(\n  endpoint: string,\n  locationId?: string,\n  options?: {\n    transform?: (items: T[]) => T[];\n  }\n): UseWorkspaceReturn<T> {\n  // ... fetch logic\n  \n  .then(async (res) => {\n    const json = await res.json();\n    let items = Array.isArray(json) ? json : json.items ?? json.data ?? [];\n    \n    // Apply transformation once during fetch\n    if (options?.transform) {\n      items = options.transform(items);\n    }\n    \n    setData(items);\n  })\n}\n\n// Usage in orders/page.tsx:\nconst { data, loading } = useWorkspace<Order>(\"/orders\", undefined, {\n  transform: (orders) => orders.map(o => ({\n    ...o,\n    _totalFormatted: formatCurrency(o.total),\n    _createdFormatted: formatDate(o.created_at),\n  }))\n});\n```\n\n---\n\n## 4. **Caching Opportunities** 🟢 MEDIUM IMPACT\n\n### Issue: No request deduplication or SWR pattern\n\n**Problem:** Multiple components fetching same data, no shared cache.\n\n**Recommendation:** Adopt SWR or React Query\n\n```typescript\n// ✅ RECOMMENDED - Add SWR\n// npm install swr\n\n// lib/workspace-swr.ts\nimport useSWR from 'swr';\n\nconst fetcher = (url: string) => \n  fetch(url, { credentials: \"include\" })\n    .then(async (res) => {\n      if (!res.ok) throw new Error(`${res.status}`);\n      const json = await res.json();\n      return Array.isArray(json) ? json : json.items ?? json.data ?? [];\n    });\n\nexport function useWorkspaceSWR<T = Record<string, unknown>>(\n  endpoint: string,\n  locationId?: string,\n) {\n  const url = locationId ? `${endpoint}?location_id=${locationId}` : endpoint;\n  \n  const { data, error, mutate, isLoading } = useSWR<T[]>(url, fetcher, {\n    revalidateOnFocus: false,\n    dedupingInterval: 30000, // Dedupe requests within 30s\n  });\n\n  return {\n    data: data ?? [],\n    loading: isLoading,\n    error: error?.message ?? null,\n    refresh: mutate,\n  };\n}\n```\n\n**Benefits:**\n- Automatic request deduplication\n- Global cache across components\n- Background revalidation\n- Optimistic updates\n\n---\n\n## 5. **N+1 Query Patterns** 🟢 LOW (not applicable to frontend)\n\n**Finding:** No N+1 patterns in frontend code. The workspace hooks fetch collections in single requests. However, if the **backend** returns sparse data requiring follow-up requests (e.g., fetching recipe details for each menu item), that would be an N+1 issue to fix server-side.\n\n---\n\n## 6. **Additional Optimizations**\n\n### A. Virtual scrolling for large lists\n\n**Files:** All workspace pages with `<Table>` components\n\n**When lists exceed 100+ items:**\n\n```typescript\n// ✅ Add react-window for virtualization\nimport { FixedSizeList } from 'react-window';\n\nfunction VirtualizedTable({ items }: { items: Order[] }) {\n  const Row = ({ index, style }: { index: number; style: React.CSSProperties }) => (\n    <TableRow style={style}>\n      {/* Row content */}\n    </TableRow>\n  );\n\n  return (\n    <FixedSizeList\n      height={600}\n      itemCount={items.length}\n      itemSize={60}\n      width=\"100%\"\n    >\n      {Row}\n    </FixedSizeList>\n  );\n}\n```\n\n### B. Debounce search inputs\n\n**Files:** Pages with search inputs\n\n```typescript\n// ✅ use-debounce.ts\nimport { useEffect, useState } from 'react';\n\nexport function useDebounce<T>(value: T, delay: number): T {\n  const [debouncedValue, setDebouncedValue] = useState(value);\n\n  useEffect(() => {\n    const timer = setTimeout(() => setDebouncedValue(value), delay);\n    return () => clearTimeout(timer);\n  }, [value, delay]);\n\n  return debouncedValue;\n}\n\n// Usage:\nconst [searchTerm, setSearchTerm] = useState(\"\");\nconst debouncedSearch = useDebounce(searchTerm, 300);\n\nconst filtered = useMemo(() => \n  data.filter(item => item.name.includes(debouncedSearch)),\n  [data, debouncedSearch] // Only re-filter after 300ms of no typing\n);\n```\n\n---\n\n## Priority Roadmap\n\n| Priority | Issue | Impact | Effort |\n|----------|-------|--------|--------|\n| 🔴 P0 | Memory leaks (unbounded refs) | App crashes after long sessions | 30 min |\n| 🟡 P1 | Socket handler churn | Unnecessary re-renders on every mount | 1 hour |\n| 🟡 P1 | Redundant parsing | Slow list rendering | 2 hours |\n| 🟢 P2 | Add SWR/React Query | Better UX, less backend load | 4 hours |\n| 🟢 P3 | Virtual scrolling | Only needed for 100+ item lists | 3 hours |\n| 🟢 P3 | Debounce search | Nice-to-have | 30 min |\n\n**Start with P0 memory leaks immediately** — these will cause crashes in production during long sessions or multi-context workflows.\n",
