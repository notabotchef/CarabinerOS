        "language": "typescript",
        "code": "// __tests__/hooks/use-chat.test.ts\nimport { renderHook, act, waitFor } from '@testing-library/react';\nimport { useChat } from '@/hooks/use-chat';\nimport { getCsrfToken } from '@/lib/csrf';\n\njest.mock('@/lib/csrf');\nglobal.fetch = jest.fn();\n\ndescribe('useChat', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n    (getCsrfToken as jest.Mock).mockResolvedValue('test-token');\n  });\n\n  it('initializes with empty messages', () => {\n    const { result } = renderHook(() => useChat(null));\n    expect(result.current.messages).toEqual([]);\n    expect(result.current.loading).toBe(false);\n  });\n\n  it('extracts user and response messages from snapshot', () => {\n    const snapshot = createSnapshot([\n      { no: 1, id: 'log-1', type: 'user', content: 'Hello', timestamp: 1000 },\n      { no: 2, id: 'log-2', type: 'response', content: 'Hi there', timestamp: 1001 },\n    ]);\n    const { result } = renderHook(() => useChat(snapshot));\n    \n    expect(result.current.messages).toHaveLength(2);\n    expect(result.current.messages[0].role).toBe('user');\n    expect(result.current.messages[1].role).toBe('assistant');\n  });\n\n  it('deduplicates messages using log.no when log.id is null', () => {\n    const snapshot1 = createSnapshot([\n      { no: 1, id: null, type: 'user', content: 'Test', timestamp: 1000 },\n    ]);\n    const snapshot2 = createSnapshot([\n      { no: 1, id: null, type: 'user', content: 'Test', timestamp: 1000 },\n      { no: 2, id: 'log-2', type: 'response', content: 'Response', timestamp: 1001 },\n    ]);\n    \n    const { result, rerender } = renderHook(\n      ({ snap }) => useChat(snap),\n      { initialProps: { snap: snapshot1 } }\n    );\n    expect(result.current.messages).toHaveLength(1);\n    \n    rerender({ snap: snapshot2 });\n    expect(result.current.messages).toHaveLength(2); // Only log-2 added\n  });\n\n  it('sends message and updates context', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => ({ context: 'ctx-123' }),\n    });\n\n    const { result } = renderHook(() => useChat(null));\n    \n    await act(async () => {\n      await result.current.sendMessage('Test message');\n    });\n\n    expect(result.current.contextId).toBe('ctx-123');\n    expect(global.fetch).toHaveBeenCalledWith('/message_async', expect.objectContaining({\n      method: 'POST',\n      body: JSON.stringify({ text: 'Test message', context: '' }),\n    }));\n  });\n\n  it('queues messages when already processing', async () => {\n    (global.fetch as jest.Mock).mockImplementation(() => \n      new Promise(resolve => setTimeout(() => resolve({\n        ok: true,\n        json: async () => ({ context: 'ctx' }),\n      }), 100))\n    );\n\n    const { result } = renderHook(() => useChat(null));\n    \n    await act(async () => {\n      result.current.sendMessage('Message 1');\n      result.current.sendMessage('Message 2'); // Should be queued\n    });\n\n    expect(result.current.queuedMessages).toContain('Message 2');\n  });\n\n  it('handles network errors gracefully', async () => {\n    (global.fetch as jest.Mock).mockRejectedValue(new Error('Network error'));\n\n    const { result } = renderHook(() => useChat(null));\n    \n    await act(async () => {\n      await result.current.sendMessage('Test');\n    });\n\n    const lastMsg = result.current.messages[result.current.messages.length - 1];\n    expect(lastMsg.role).toBe('assistant');\n    expect(lastMsg.content).toContain(\"Can't reach the kitchen\");\n  });\n\n  it('resets chat state completely', () => {\n    const { result } = renderHook(() => useChat(createSnapshot([\n      { no: 1, id: 'log-1', type: 'user', content: 'Test', timestamp: 1000 },\n    ])));\n    \n    act(() => result.current.resetChat());\n    \n    expect(result.current.messages).toEqual([]);\n    expect(result.current.contextId).toBeNull();\n    expect(result.current.queuedMessages).toEqual([]);\n  });\n\n  it('ignores stale snapshot logs after resetChat', () => {\n    const snapshot = createSnapshot([\n      { no: 1, id: 'stale-1', type: 'user', content: 'Old message', timestamp: 999 },\n    ]);\n    \n    const { result, rerender } = renderHook(\n      ({ snap }) => useChat(snap),\n      { initialProps: { snap: null } }\n    );\n    \n    act(() => result.current.resetChat());\n    rerender({ snap: snapshot });\n    \n    expect(result.current.messages).toEqual([]); // Stale logs ignored\n  });\n\n  it('handles 500 server error', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({ ok: false, status: 500 });\n\n    const { result } = renderHook(() => useChat(null));\n    await act(async () => {\n      await result.current.sendMessage('Test');\n    });\n\n    expect(result.current.messages.some(m => m.content.includes(\"Can't reach\"))).toBe(true);\n  });\n});"
      },
      {
        "language": "typescript",
        "code": "// __tests__/hooks/use-expo-stream.test.ts\nimport { renderHook, act } from '@testing-library/react';\nimport { useExpoStream } from '@/hooks/use-expo-stream';\nimport type { A0Snapshot, ChefStatus } from '@/lib/types';\n\ndescribe('useExpoStream', () => {\n  beforeEach(() => {\n    jest.useFakeTimers();\n  });\n\n  afterEach(() => {\n    jest.runOnlyPendingTimers();\n    jest.useRealTimers();\n  });\n\n  it('returns inactive state for null snapshot', () => {\n    const { result } = renderHook(() => useExpoStream(null, null));\n    expect(result.current).toMatchObject({\n      text: null,\n      thoughts: [],\n      active: false,\n    });\n  });\n\n  it('extracts thoughts and headline from agent logs', () => {\n    const snapshot: A0Snapshot = {\n      logs: [{\n        no: 1,\n        id: 'log-1',\n        type: 'agent',\n        kvps: {\n          thoughts: ['Checking inventory', 'Calculating costs'],\n          headline: 'Working on food cost analysis',\n        },\n        content: '',\n        timestamp: 1000,\n        heading: '',\n        agentno: 0,\n      }],\n      log_progress_active: true,\n      // ...\n    };\n\n    const { result } = renderHook(() => useExpoStream(snapshot, null));\n    expect(result.current.thoughts).toEqual(['Checking inventory', 'Calculating costs']);\n    expect(result.current.text).toBe('Working on food cost analysis');\n    expect(result.current.active).toBe(true);\n  });\n\n  it('falls back to chefStatus text when no headline', () => {\n    const snapshot: A0Snapshot = {\n      logs: [{ no: 1, id: 'log-1', type: 'agent', kvps: {}, content: '', timestamp: 1000, heading: '', agentno: 0 }],\n      log_progress_active: true,\n      // ...\n    };\n    const chefStatus: ChefStatus = {\n      status: 'working',\n      text: 'Chef status message',\n      active: true,\n    };\n\n    const { result } = renderHook(() => useExpoStream(snapshot, chefStatus));\n    expect(result.current.text).toBe('Chef status message');\n  });\n\n  it('uses random joke when no other text available', () => {\n    const snapshot: A0Snapshot = {\n      logs: [],\n      log_progress_active: true,\n      // ...\n    };\n\n    const { result } = renderHook(() => useExpoStream(snapshot, null));\n    expect(result.current.text).toBeTruthy();\n    expect(typeof result.current.text).toBe('string');\n  });\n\n  it('clears text after completion with timer', () => {\n    const chefStatus: ChefStatus = { status: 'completed', text: 'Done', active: false };\n\n    const { result, rerender } = renderHook(\n      ({ status }) => useExpoStream(null, status),\n      { initialProps: { status: chefStatus } }\n    );\n\n    expect(result.current.text).toBe('Done');\n    \n    act(() => {\n      jest.advanceTimersByTime(3000);\n    });\n\n    expect(result.current.text).toBeNull();\n  });\n\n  it('handles rapid active/inactive transitions', () => {\n    const activeSnapshot = { logs: [], log_progress_active: true, /* ... */ };\n    const inactiveSnapshot = { logs: [], log_progress_active: false, /* ... */ };\n\n    const { result, rerender } = renderHook(\n      ({ snap }) => useExpoStream(snap, null),\n      { initialProps: { snap: activeSnapshot } }\n    );\n\n    rerender({ snap: inactiveSnapshot });\n    rerender({ snap: activeSnapshot });\n    \n    // Should remain stable without crashing\n    expect(result.current.active).toBe(false); // Last state\n  });\n\n  it('prioritizes step over chefStatus', () => {\n    const snapshot: A0Snapshot = {\n      logs: [{\n        no: 1,\n        id: 'log-1',\n        type: 'agent',\n        kvps: { step: 'Analyzing prep list' },\n        content: '',\n        timestamp: 1000,\n        heading: '',\n        agentno: 0,\n      }],\n      log_progress_active: true,\n      // ...\n    };\n    const chefStatus: ChefStatus = { status: 'working', text: 'Chef working', active: true };\n\n    const { result } = renderHook(() => useExpoStream(snapshot, chefStatus));\n    expect(result.current.text).toBe('Analyzing prep list');\n  });\n});"
      },
      {
        "language": "typescript",
        "code": "// __tests__/hooks/use-socket.test.ts\nimport { renderHook, act, waitFor } from '@testing-library/react';\nimport { useSocket } from '@/hooks/use-socket';\nimport { initStateSyncSocket } from '@/lib/socket-client';\nimport { getCsrfToken } from '@/lib/csrf';\nimport type { Socket } from 'socket.io-client';\n\njest.mock('@/lib/socket-client');\njest.mock('@/lib/csrf');\n\ndescribe('useSocket', () => {\n  let mockSocket: Partial<Socket>;\n\n  beforeEach(() => {\n    mockSocket = {\n      on: jest.fn(),\n      off: jest.fn(),\n      emit: jest.fn(),\n      connect: jest.fn(),\n      disconnect: jest.fn(),\n      connected: false,\n    };\n    (initStateSyncSocket as jest.Mock).mockReturnValue(mockSocket);\n    (getCsrfToken as jest.Mock).mockResolvedValue('test-token');\n  });\n\n  it('initializes socket and connects on mount', async () => {\n    renderHook(() => useSocket());\n    \n    expect(initStateSyncSocket).toHaveBeenCalled();\n    await waitFor(() => expect(mockSocket.connect).toHaveBeenCalled());\n  });\n\n  it('sets connected state on socket connect event', () => {\n    const { result } = renderHook(() => useSocket());\n    \n    const onConnect = (mockSocket.on as jest.Mock).mock.calls.find(\n      call => call[0] === 'connect'\n    )?.[1];\n\n    act(() => onConnect?.());\n    expect(result.current.connected).toBe(true);\n  });\n\n  it('emits state_request on connect', () => {\n    renderHook(() => useSocket());\n    \n    const onConnect = (mockSocket.on as jest.Mock).mock.calls.find(\n      call => call[0] === 'connect'\n    )?.[1];\n\n    act(() => onConnect?.());\n    \n    expect(mockSocket.emit).toHaveBeenCalledWith('state_request', expect.objectContaining({\n      context: null,\n      log_from: 0,\n      notifications_from: 0,\n    }));\n  });\n\n  it('updates snapshot from state_push event', () => {\n    const { result } = renderHook(() => useSocket());\n    \n    const onStatePush = (mockSocket.on as jest.Mock).mock.calls.find(\n      call => call[0] === 'state_push'\n    )?.[1];\n\n    const testSnapshot = {\n      logs: [{ no: 1, id: 'log-1', type: 'user', content: 'Test', timestamp: 1000, heading: '', agentno: 0 }],\n      context: 'ctx-123',\n      log_progress_active: false,\n    };\n\n    act(() => onStatePush?.({ data: { snapshot: testSnapshot } }));\n    \n    expect(result.current.snapshot).toMatchObject(testSnapshot);\n  });\n\n  it('handles malformed state_push gracefully', () => {\n    const consoleWarnSpy = jest.spyOn(console, 'warn').mockImplementation();\n    const { result } = renderHook(() => useSocket());\n    \n    const onStatePush = (mockSocket.on as jest.Mock).mock.calls.find(\n      call => call[0] === 'state_push'\n    )?.[1];\n\n    act(() => onStatePush?.({})); // Missing data.snapshot\n    \n    expect(consoleWarnSpy).toHaveBeenCalledWith(expect.stringContaining('no snapshot'));\n    expect(result.current.snapshot).toBeNull();\n    \n    consoleWarnSpy.mockRestore();\n  });\n\n  it('updates chefStatus from chef_status event', () => {\n    const { result } = renderHook(() => useSocket());\n    \n    const onChefStatus = (mockSocket.on as jest.Mock).mock.calls.find(\n      call => call[0] === 'chef_status'\n    )?.[1];\n\n    const status = { status: 'working' as const, text: 'Processing', active: true };\n    act(() => onChefStatus?.(status));\n    \n    expect(result.current.chefStatus).toEqual(status);\n  });\n\n  it('subscribes to context when subscribe called', () => {\n    mockSocket.connected = true;\n    const { result } = renderHook(() => useSocket());\n    \n    act(() => result.current.subscribe('ctx-456'));\n    \n    expect(mockSocket.emit).toHaveBeenCalledWith('state_request', expect.objectContaining({\n      context: 'ctx-456',\n    }));\n  });\n\n  it('does not emit if socket not connected', () => {\n    mockSocket.connected = false;\n    const { result } = renderHook(() => useSocket());\n    \n    (mockSocket.emit as jest.Mock).mockClear();\n    act(() => result.current.subscribe('ctx-456'));\n    \n    expect(mockSocket.emit).not.toHaveBeenCalled();\n  });\n\n  it('cleans up socket on unmount', () => {\n    const { unmount } = renderHook(() => useSocket());\n    \n    unmount();\n    \n    expect(mockSocket.off).toHaveBeenCalledWith('connect');\n    expect(mockSocket.off).toHaveBeenCalledWith('disconnect');\n    expect(mockSocket.off).toHaveBeenCalledWith('state_push');\n    expect(mockSocket.off).toHaveBeenCalledWith('chef_status');\n    expect(mockSocket.disconnect).toHaveBeenCalled();\n  });\n\n  it('handles CSRF token fetch failure gracefully', async () => {\n    (getCsrfToken as jest.Mock).mockRejectedValue(new Error('CSRF failed'));\n    \n    renderHook(() => useSocket());\n    \n    await waitFor(() => expect(mockSocket.connect).toHaveBeenCalled());\n    // Should still attempt connection even if CSRF fails\n  });\n});"
