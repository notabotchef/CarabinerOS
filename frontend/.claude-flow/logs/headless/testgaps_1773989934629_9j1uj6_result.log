s).toHaveLength(1);\n    \n    rerender({ snapshot: createSnapshot([createToolLog('log-1'), createToolLog('log-2')]) });\n    expect(result.current.cards).toHaveLength(2); // Only log-2 added\n  });\n\n  it('marks individual cards as read', () => {\n    const { result } = renderHook(() => useActionCards(createSnapshot([createToolLog('log-1')])));\n    \n    act(() => result.current.markRead('log-1'));\n    expect(result.current.cards[0].read).toBe(true);\n    expect(result.current.unreadCount).toBe(0);\n  });\n\n  it('marks all cards as read', () => {\n    const { result } = renderHook(() => useActionCards(\n      createSnapshot([createToolLog('log-1'), createToolLog('log-2')])\n    ));\n    \n    act(() => result.current.markAllRead());\n    expect(result.current.unreadCount).toBe(0);\n    expect(result.current.cards.every(c => c.read)).toBe(true);\n  });\n\n  it('handles missing kvps gracefully', () => {\n    const snapshot: A0Snapshot = {\n      logs: [{ no: 1, id: 'log-1', type: 'tool', kvps: null as any, content: '', timestamp: 0, heading: '', agentno: 0 }],\n      // ...\n    };\n    const { result } = renderHook(() => useActionCards(snapshot));\n    expect(result.current.cards).toEqual([]);\n  });\n});\n```\n\n---\n\n",
