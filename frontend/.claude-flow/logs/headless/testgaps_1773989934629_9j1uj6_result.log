fToken, getRuntimeId, clearCsrfToken } from '@/lib/csrf';\n\nglobal.fetch = jest.fn();\n\ndescribe('csrf', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n    clearCsrfToken();\n    document.cookie = '';\n  });\n\n  it('fetches CSRF token on first call', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'test-token-123', runtime_id: 'rt-456' }),\n    });\n\n    const token = await getCsrfToken();\n    \n    expect(token).toBe('test-token-123');\n    expect(global.fetch).toHaveBeenCalledWith('/csrf_token', { credentials: 'include' });\n  });\n\n  it('caches token on subsequent calls', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'cached-token', runtime_id: 'rt-123' }),\n    });\n\n    await getCsrfToken();\n    const token2 = await getCsrfToken();\n    \n    expect(global.fetch).toHaveBeenCalledTimes(1); // Only one network call\n    expect(token2).toBe('cached-token');\n  });\n\n  it('deduplicates concurrent calls', async () => {\n    (global.fetch as jest.Mock).mockImplementation(() =>\n      new Promise(resolve => setTimeout(() => resolve({\n        json: async () => ({ ok: true, token: 'concurrent-token', runtime_id: 'rt-789' }),\n      }), 100))\n    );\n\n    const [token1, token2, token3] = await Promise.all([\n      getCsrfToken(),\n      getCsrfToken(),\n      getCsrfToken(),\n    ]);\n\n    expect(global.fetch).toHaveBeenCalledTimes(1);\n    expect(token1).toBe(token2);\n    expect(token2).toBe(token3);\n  });\n\n  it('sets cookie with runtime_id', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'cookie-token', runtime_id: 'rt-cookie' }),\n    });\n\n    await getCsrfToken();\n    \n    expect(document.cookie).toContain('csrf_token_rt-cookie=cookie-token');\n  });\n\n  it('throws error when server returns ok: false', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: false, error: 'Server error' }),\n    });\n\n    await expect(getCsrfToken()).rejects.toThrow('Server error');\n  });\n\n  it('returns runtime_id after fetch', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'token', runtime_id: 'rt-get' }),\n    });\n\n    await getCsrfToken();\n    expect(getRuntimeId()).toBe('rt-get');\n  });\n\n  it('clears cached token', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'clear-test', runtime_id: 'rt-clear' }),\n    });\n\n    await getCsrfToken();\n    clearCsrfToken();\n    \n    expect(getRuntimeId()).toBeNull();\n    \n    await getCsrfToken();\n    expect(global.fetch).toHaveBeenCalledTimes(2); // Fetch again after clear\n  });\n\n  it('handles network error', async () => {\n    (global.fetch as jest.Mock).mockRejectedValue(new Error('Network failure'));\n\n    await expect(getCsrfToken()).rejects.toThrow('Network failure');\n  });\n});\n```\n\n---\n\n## 6. `socket-client.ts` - Socket Initialization\n\n### Edge Cases\n- Multiple calls to `initStateSyncSocket`\n- CSRF token failure in auth callback\n- Connect error triggering `clearCsrfToken`\n- Environment variable missing (`NEXT_PUBLIC_A0_URL`)\n\n### Test Skeleton\n\n```typescript\n// __tests__/lib/socket-client.test.ts\nimport { initStateSyncSocket, getStateSyncSocket, disconnectAll } from '@/lib/socket-client';\nimport { io } from 'socket.io-client';\nimport { getCsrfToken, clearCsrfToken } from '@/lib/csrf';\n\njest.mock('socket.io-client');\njest.mock('@/lib/csrf');\n\ndescribe('socket-client', () => {\n  let mockSocket: any;\n\n  beforeEach(() => {\n    jest.clearAllMocks();\n    disconnectAll();\n    \n    mockSocket = {\n      on: jest.fn(),\n      disconnect: jest.fn(),\n    };\n    (io as jest.Mock).mockReturnValue(mockSocket);\n    (getCsrfToken as jest.Mock).mockResolvedValue('test-token');\n  });\n\n  it('creates socket with correct configuration', () => {\n    initStateSyncSocket();\n    \n    expect(io).toHaveBeenCalledWith('/state_sync', expect.objectContaining({\n      autoConnect: false,\n      transports: ['polling', 'websocket'],\n      withCredentials: true,\n    }));\n  });\n\n  it('returns same socket on multiple calls', () => {\n    const socket1 = initStateSyncSocket();\n    const socket2 = initStateSyncSocket();\n    \n    expect(socket1).toBe(socket2);\n    expect(io).toHaveBeenCalledTimes(1);\n  });\n\n  it('auth callback fetches CSRF token', async () => {\n    initStateSyncSocket();\n    \n    const authCallback = (io as jest.Mock).mock.calls[0][1].auth;\n    const mockCb = jest.fn();\n    \n    await authCallback(mockCb);\n    \n    expect(getCsrfToken).toHaveBeenCalled();\n    expect(mockCb).toHaveBeenCalledWith({ csrf_token: 'test-token' });\n  });\n\n  it('auth callback handles CSRF error gracefully', async () => {\n    (getCsrfToken as jest.Mock).mockRejectedValue(new Error('CSRF failed'));\n    const consoleErrorSpy = jest.spyOn(console, 'error').mockImplementation();\n    \n    initStateSyncSocket();\n    \n    const authCallback = (io as jest.Mock).mock.calls[0][1].auth;\n    const mockCb = jest.fn();\n    \n    await authCallback(mockCb);\n    \n    expect(mockCb).toHaveBeenCalledWith({}); // Empty auth on error\n    consoleErrorSpy.mockRestore();\n  });\n\n  it('clears CSRF token on connect_error', () => {\n    initStateSyncSocket();\n    \n    const onConnectError = mockSocket.on.mock.calls.find(\n      ([event]: any) => event === 'connect_error'\n    )?.[1];\n\n    onConnectError?.();\n    \n    expect(clearCsrfToken).toHaveBeenCalled();\n  });\n\n  it('disconnects socket on disconnectAll', () => {\n    initStateSyncSocket();\n    disconnectAll();\n    \n    expect(mockSocket.disconnect).toHaveBeenCalled();\n    expect(getStateSyncSocket()).toBeNull();\n  });\n});\n```\n\n---\n\n## 7. `expo-messages.ts` - Message Utilities\n\n### Edge Cases\n- Unknown tool names (fallback to default)\n- Missing `log.heading` or `log.content`\n- All log types (agent, subagent, progress, tool)\n\n### Test Skeleton\n\n```typescript\n// __tests__/lib/expo-messages.test.ts\nimport { getExpoMessage, getCompletionMessage } from '@/lib/expo-messages';\nimport type { A0LogEntry } from '@/lib/types';\n\ndescribe('expo-messages', () => {\n  it('returns quirky message for known tool', () => {\n    const log: A0LogEntry = {\n      no: 1,\n      id: 'log-1',\n      type: 'tool',\n      heading: 'Using food_cost_tool...',\n      content: '',\n      kvps: {},\n      timestamp: 1000,\n      agentno: 0,\n    };\n    \n    const msg = getExpoMessage(log);\n    expect(msg).toBeTruthy();\n    expect(typeof msg).toBe('string');\n  });\n\n  it('returns default message for unknown tool', () => {\n    const log: A0LogEntry = {\n      no: 1,\n      id: 'log-1',\n      type: 'tool',\n      heading: 'Using unknown_tool...',\n      content: '',\n      kvps: {},\n      timestamp: 1000,\n      agentno: 0,\n    };\n    \n    const msg = getExpoMessage(log);\n    expect(msg).toMatch(/Working on it|One moment|On it/);\n  });\n\n  it('returns delegation message for agent logs', () => {\n    const log: A0LogEntry = {\n      no: 1,\n      id: 'log-1',\n      type: 'agent',\n      heading: 'Inventory Agent',\n      content: '',\n      kvps: {},\n      timestamp: 1000,\n      agentno: 0,\n    };\n    \n    expect(getExpoMessage(log)).toContain('Delegating to Inventory Agent');\n  });\n\n  it('returns content for progress logs', () => {\n    const log: A0LogEntry = {\n      no: 1,\n      id: 'log-1',\n      type: 'progress',\n      heading: '',\n      content: 'Processing step 3 of 5',\n      kvps: {},\n      timestamp: 1000,\n      agentno: 0,\n    };\n    \n    expect(getExpoMessage(log)).toBe('Processing step 3 of 5');\n  });\n\n  it('returns null for unhandled log types', () => {\n    const log: A0LogEntry = {\n      no: 1,\n      id: 'log-1',\n      type: 'error',\n      heading: '',\n      content: 'Error occurred',\n      kvps: {},\n      timestamp: 1000,\n      agentno: 0,\n    };\n    \n    expect(getExpoMessage(log)).toBeNull();\n  });\n\n  it('getCompletionMessage returns valid kitchen phrase', () => {\n    const msg = getCompletionMessage();\n    expect(msg).toMatch(/Heard|Service|All set|Done, Chef/);\n  });\n});\n```\n\n---\n\n## 8. `use-workspace.ts` - Data Fetching Hook\n\n### Edge Cases\n- 404/500 HTTP errors\n- Empty arrays vs null data\n- Malformed JSON\n- Rapid `refresh()` calls\n- Component unmount during fetch\n\n### Test Skeleton\n\n```typescript\n// __tests__/hooks/use-workspace.test.ts\nimport { renderHook, waitFor } from '@testing-library/react';\nimport { useWorkspace } from '@/hooks/use-workspace';\n\nglobal.fetch = jest.fn();\n\ndescribe('useWorkspace', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n  });\n\n  it('fetches data on mount', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => [{ id: 1, name: 'Item 1' }],\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/items'));\n    \n    expect(result.current.loading).toBe(true);\n    \n    await waitFor(() => expect(result.current.loading).toBe(false));\n    expect(result.current.data).toEqual([{ id: 1, name: 'Item 1' }]);\n    expect(result.current.error).toBeNull();\n  });\n\n  it('includes locationId in query params', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => [],\n    });\n\n    renderHook(() => useWorkspace('/api/items', 'loc-123'));\n    \n    await waitFor(() => \n      expect(global.fetch).toHaveBeenCalledWith('/api/items?location_id=loc-123', expect.any(Object))\n    );\n  });\n\n  it('handles 404 error', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({ ok: false, status: 404 });\n\n    const { result } = renderHook(() => useWorkspace('/api/missing'));\n    \n    await waitFor(() => expect(result.current.loading).toBe(false));\n    expect(result.current.error).toBe('404');\n    expect(result.current.data).toEqual([]);\n  });\n\n  it('handles network error', async () => {\n    (global.fetch as jest.Mock).mockRejectedValue(new Error('Network failure'));\n\n    const { result } = renderHook(() => useWorkspace('/api/items'));\n    \n    await waitFor(() => expect(result.current.loading).toBe(false));\n    expect(result.current.error).toBe('Network failure');\n  });\n\n  it('extracts data from nested response structure', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => ({ items: [{ id: 1 }] }),\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/items'));\n    \n    await waitFor(() => expect(result.current.data).toEqual([{ id: 1 }]));\n  });\n\n  it('refetches data when refresh called', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => [{ id: 1 }],\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/items'));\n    await waitFor(() => expect(result.current.loading).toBe(false));\n\n    (global.fetch as jest.Mock).mockClear();\n    result.current.refresh();\n    \n    await waitFor(() => expect(global.fetch).toHaveBeenCalledTimes(1));\n  });\n});\n```\n\n---\n\n## 9. Integration Test Gaps\n\n### Critical Missing Integration Tests\n\n1. **Full chat flow:** User sends message → `/message_async` → `state_push` → UI updates\n2. **Socket reconnection:** Disconnect → reconnect → state resync\n3. **Concurrent operations:** Send message while queued messages pending\n4. **Error recovery:** Network failure → retry → success\n5. **CSRF flow:** Token fetch → cookie set → WebSocket auth → API call\n\n### Integration Test Skeleton\n\n```typescript\n// __tests__/integration/chat-flow.test.tsx\nimport { render, screen, waitFor } from '@testing-library/react';\nimport userEvent from '@testing-library/user-event';\nimport { ChatView } from '@/components/ChatView'; // Assuming this exists\nimport { initStateSyncSocket } from '@/lib/socket-client';\nimport { getCsrfToken } from '@/lib/csrf';\n\njest.mock('@/lib/socket-client');\njest.mock('@/lib/csrf');\n\ndescribe('Chat Integration Flow', () => {\n  it('completes full message send and response cycle', async () => {\n    const user = userEvent.setup();\n    \n    // Mock CSRF\n    (getCsrfToken as jest.Mock).mockResolvedValue('csrf-token');\n    \n    // Mock API\n    global.fetch = jest.fn().mockResolvedValue({\n      ok: true,\n      json: async () => ({ context: 'ctx-123' }),\n    });\n    \n    // Mock socket\n    const mockSocket = {\n      on: jest.fn(),\n      emit: jest.fn(),\n      connect: jest.fn(),\n      disconnect: jest.fn(),\n      connected: true,\n    };\n    (initStateSyncSocket as jest.Mock).mockReturnValue(mockSocket);\n    \n    render(<ChatView />);\n    \n    // User types and sends message\n    const input = screen.getByPlaceholderText(/type a message/i);\n    await user.type(input, 'Check inventory');\n    await user.click(screen.getByRole('button', { name: /send/i }));\n    \n    // Verify API call\n    await waitFor(() => \n      expect(global.fetch).toHaveBeenCalledWith('/message_async', expect.objectContaining({\n        method: 'POST',\n        body: JSON.stringify({ text: 'Check inventory', context: '' }),\n      }))\n    );\n    \n    // Simulate state_push response\n    const onStatePush = mockSocket.on.mock.calls.find(\n      ([event]: any) => event === 'state_push'\n    )?.[1];\n    \n    onStatePush?.({\n      data: {\n        snapshot: {\n          logs: [\n            { no: 1, id: 'log-1', type: 'user', content: 'Check inventory', timestamp: 1000 },\n            { no: 2, id: 'log-2', type: 'response', content: 'Inventory checked.', timestamp: 1001 },\n          ],\n          context: 'ctx-123',\n          log_progress_active: false,\n        },\n      },\n    });\n    \n    // Verify UI update\n    await waitFor(() => {\n      expect(screen.getByText('Check inventory')).toBeInTheDocument();\n      expect(screen.getByText('Inventory checked.')).toBeInTheDocument();\n    });\n  });\n});\n```\n\n---\n\n## Summary of Priority Gaps\n\n| Priority | Area | Key Missing Tests |\n|----------|------|-------------------|\n| **P0** | `use-chat.ts` | Queue logic, resetChat race conditions, error handling |\n| **P0** | `use-socket.ts` | Reconnection, malformed payloads, CSRF failures |\n| **P0** | `csrf.ts` | Concurrent calls, token caching, error states |\n| **P1** | `use-expo-stream.ts` | Timer cleanup, state transitions, fallback logic |\n| **P1** | `use-action-cards.ts` | Deduplication, type coercion edge cases |\n| **P2** | `use-workspace.ts` | Error handling, refresh logic |\n| **P2** | Integration tests | Full chat flow, socket reconnection, error recovery |\n\nStart with P0 tests for core reliability, then expand to P1/P2 for robustness.\n",
