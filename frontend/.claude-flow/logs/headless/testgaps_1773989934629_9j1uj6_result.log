      {
        "title": "Edge Cases Not Covered",
        "content": "- Logs with partial kvps (missing `thoughts`/`headline`/`step`)\n- Rapid state transitions (active → inactive → active)\n- ChefStatus updates during snapshot processing\n- Timer cleanup on unmount\n- Empty thoughts array vs undefined\n\n",
        "level": 3
      },
      {
        "title": "Test Skeleton",
        "content": "\n```typescript\n// __tests__/hooks/use-expo-stream.test.ts\nimport { renderHook, act } from '@testing-library/react';\nimport { useExpoStream } from '@/hooks/use-expo-stream';\nimport type { A0Snapshot, ChefStatus } from '@/lib/types';\n\ndescribe('useExpoStream', () => {\n  beforeEach(() => {\n    jest.useFakeTimers();\n  });\n\n  afterEach(() => {\n    jest.runOnlyPendingTimers();\n    jest.useRealTimers();\n  });\n\n  it('returns inactive state for null snapshot', () => {\n    const { result } = renderHook(() => useExpoStream(null, null));\n    expect(result.current).toMatchObject({\n      text: null,\n      thoughts: [],\n      active: false,\n    });\n  });\n\n  it('extracts thoughts and headline from agent logs', () => {\n    const snapshot: A0Snapshot = {\n      logs: [{\n        no: 1,\n        id: 'log-1',\n        type: 'agent',\n        kvps: {\n          thoughts: ['Checking inventory', 'Calculating costs'],\n          headline: 'Working on food cost analysis',\n        },\n        content: '',\n        timestamp: 1000,\n        heading: '',\n        agentno: 0,\n      }],\n      log_progress_active: true,\n      // ...\n    };\n\n    const { result } = renderHook(() => useExpoStream(snapshot, null));\n    expect(result.current.thoughts).toEqual(['Checking inventory', 'Calculating costs']);\n    expect(result.current.text).toBe('Working on food cost analysis');\n    expect(result.current.active).toBe(true);\n  });\n\n  it('falls back to chefStatus text when no headline', () => {\n    const snapshot: A0Snapshot = {\n      logs: [{ no: 1, id: 'log-1', type: 'agent', kvps: {}, content: '', timestamp: 1000, heading: '', agentno: 0 }],\n      log_progress_active: true,\n      // ...\n    };\n    const chefStatus: ChefStatus = {\n      status: 'working',\n      text: 'Chef status message',\n      active: true,\n    };\n\n    const { result } = renderHook(() => useExpoStream(snapshot, chefStatus));\n    expect(result.current.text).toBe('Chef status message');\n  });\n\n  it('uses random joke when no other text available', () => {\n    const snapshot: A0Snapshot = {\n      logs: [],\n      log_progress_active: true,\n      // ...\n    };\n\n    const { result } = renderHook(() => useExpoStream(snapshot, null));\n    expect(result.current.text).toBeTruthy();\n    expect(typeof result.current.text).toBe('string');\n  });\n\n  it('clears text after completion with timer', () => {\n    const chefStatus: ChefStatus = { status: 'completed', text: 'Done', active: false };\n\n    const { result, rerender } = renderHook(\n      ({ status }) => useExpoStream(null, status),\n      { initialProps: { status: chefStatus } }\n    );\n\n    expect(result.current.text).toBe('Done');\n    \n    act(() => {\n      jest.advanceTimersByTime(3000);\n    });\n\n    expect(result.current.text).toBeNull();\n  });\n\n  it('handles rapid active/inactive transitions', () => {\n    const activeSnapshot = { logs: [], log_progress_active: true, /* ... */ };\n    const inactiveSnapshot = { logs: [], log_progress_active: false, /* ... */ };\n\n    const { result, rerender } = renderHook(\n      ({ snap }) => useExpoStream(snap, null),\n      { initialProps: { snap: activeSnapshot } }\n    );\n\n    rerender({ snap: inactiveSnapshot });\n    rerender({ snap: activeSnapshot });\n    \n    // Should remain stable without crashing\n    expect(result.current.active).toBe(false); // Last state\n  });\n\n  it('prioritizes step over chefStatus', () => {\n    const snapshot: A0Snapshot = {\n      logs: [{\n        no: 1,\n        id: 'log-1',\n        type: 'agent',\n        kvps: { step: 'Analyzing prep list' },\n        content: '',\n        timestamp: 1000,\n        heading: '',\n        agentno: 0,\n      }],\n      log_progress_active: true,\n      // ...\n    };\n    const chefStatus: ChefStatus = { status: 'working', text: 'Chef working', active: true };\n\n    const { result } = renderHook(() => useExpoStream(snapshot, chefStatus));\n    expect(result.current.text).toBe('Analyzing prep list');\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "4. `use-socket.ts` - WebSocket Connection",
        "content": "\n",
        "level": 2
      },
      {
        "title": "Untested Functions",
        "content": "- `useSocket` hook\n- `subscribe` callback\n- Socket event handlers (`state_push`, `chef_status`)\n\n",
        "level": 3
      },
      {
        "title": "Critical Edge Cases",
        "content": "- **CSRF token fetch failure before connect**\n- **Reconnection after disconnect**\n- **Multiple rapid `state_push` events**\n- **Empty/malformed snapshot in state_push**\n- **Component unmount during active connection**\n- **Subscribe called before socket connected**\n\n",
        "level": 3
      },
      {
        "title": "Integration Test Gaps",
        "content": "- End-to-end message flow (send → state_push → UI update)\n- Socket reconnection with stale context\n\n",
        "level": 3
      },
      {
        "title": "Test Skeleton",
        "content": "\n```typescript\n// __tests__/hooks/use-socket.test.ts\nimport { renderHook, act, waitFor } from '@testing-library/react';\nimport { useSocket } from '@/hooks/use-socket';\nimport { initStateSyncSocket } from '@/lib/socket-client';\nimport { getCsrfToken } from '@/lib/csrf';\nimport type { Socket } from 'socket.io-client';\n\njest.mock('@/lib/socket-client');\njest.mock('@/lib/csrf');\n\ndescribe('useSocket', () => {\n  let mockSocket: Partial<Socket>;\n\n  beforeEach(() => {\n    mockSocket = {\n      on: jest.fn(),\n      off: jest.fn(),\n      emit: jest.fn(),\n      connect: jest.fn(),\n      disconnect: jest.fn(),\n      connected: false,\n    };\n    (initStateSyncSocket as jest.Mock).mockReturnValue(mockSocket);\n    (getCsrfToken as jest.Mock).mockResolvedValue('test-token');\n  });\n\n  it('initializes socket and connects on mount', async () => {\n    renderHook(() => useSocket());\n    \n    expect(initStateSyncSocket).toHaveBeenCalled();\n    await waitFor(() => expect(mockSocket.connect).toHaveBeenCalled());\n  });\n\n  it('sets connected state on socket connect event', () => {\n    const { result } = renderHook(() => useSocket());\n    \n    const onConnect = (mockSocket.on as jest.Mock).mock.calls.find(\n      call => call[0] === 'connect'\n    )?.[1];\n\n    act(() => onConnect?.());\n    expect(result.current.connected).toBe(true);\n  });\n\n  it('emits state_request on connect', () => {\n    renderHook(() => useSocket());\n    \n    const onConnect = (mockSocket.on as jest.Mock).mock.calls.find(\n      call => call[0] === 'connect'\n    )?.[1];\n\n    act(() => onConnect?.());\n    \n    expect(mockSocket.emit).toHaveBeenCalledWith('state_request', expect.objectContaining({\n      context: null,\n      log_from: 0,\n      notifications_from: 0,\n    }));\n  });\n\n  it('updates snapshot from state_push event', () => {\n    const { result } = renderHook(() => useSocket());\n    \n    const onStatePush = (mockSocket.on as jest.Mock).mock.calls.find(\n      call => call[0] === 'state_push'\n    )?.[1];\n\n    const testSnapshot = {\n      logs: [{ no: 1, id: 'log-1', type: 'user', content: 'Test', timestamp: 1000, heading: '', agentno: 0 }],\n      context: 'ctx-123',\n      log_progress_active: false,\n    };\n\n    act(() => onStatePush?.({ data: { snapshot: testSnapshot } }));\n    \n    expect(result.current.snapshot).toMatchObject(testSnapshot);\n  });\n\n  it('handles malformed state_push gracefully', () => {\n    const consoleWarnSpy = jest.spyOn(console, 'warn').mockImplementation();\n    const { result } = renderHook(() => useSocket());\n    \n    const onStatePush = (mockSocket.on as jest.Mock).mock.calls.find(\n      call => call[0] === 'state_push'\n    )?.[1];\n\n    act(() => onStatePush?.({})); // Missing data.snapshot\n    \n    expect(consoleWarnSpy).toHaveBeenCalledWith(expect.stringContaining('no snapshot'));\n    expect(result.current.snapshot).toBeNull();\n    \n    consoleWarnSpy.mockRestore();\n  });\n\n  it('updates chefStatus from chef_status event', () => {\n    const { result } = renderHook(() => useSocket());\n    \n    const onChefStatus = (mockSocket.on as jest.Mock).mock.calls.find(\n      call => call[0] === 'chef_status'\n    )?.[1];\n\n    const status = { status: 'working' as const, text: 'Processing', active: true };\n    act(() => onChefStatus?.(status));\n    \n    expect(result.current.chefStatus).toEqual(status);\n  });\n\n  it('subscribes to context when subscribe called', () => {\n    mockSocket.connected = true;\n    const { result } = renderHook(() => useSocket());\n    \n    act(() => result.current.subscribe('ctx-456'));\n    \n    expect(mockSocket.emit).toHaveBeenCalledWith('state_request', expect.objectContaining({\n      context: 'ctx-456',\n    }));\n  });\n\n  it('does not emit if socket not connected', () => {\n    mockSocket.connected = false;\n    const { result } = renderHook(() => useSocket());\n    \n    (mockSocket.emit as jest.Mock).mockClear();\n    act(() => result.current.subscribe('ctx-456'));\n    \n    expect(mockSocket.emit).not.toHaveBeenCalled();\n  });\n\n  it('cleans up socket on unmount', () => {\n    const { unmount } = renderHook(() => useSocket());\n    \n    unmount();\n    \n    expect(mockSocket.off).toHaveBeenCalledWith('connect');\n    expect(mockSocket.off).toHaveBeenCalledWith('disconnect');\n    expect(mockSocket.off).toHaveBeenCalledWith('state_push');\n    expect(mockSocket.off).toHaveBeenCalledWith('chef_status');\n    expect(mockSocket.disconnect).toHaveBeenCalled();\n  });\n\n  it('handles CSRF token fetch failure gracefully', async () => {\n    (getCsrfToken as jest.Mock).mockRejectedValue(new Error('CSRF failed'));\n    \n    renderHook(() => useSocket());\n    \n    await waitFor(() => expect(mockSocket.connect).toHaveBeenCalled());\n    // Should still attempt connection even if CSRF fails\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "5. `csrf.ts` - Token Management",
        "content": "\n",
        "level": 2
      },
      {
        "title": "Untested Functions",
        "content": "- `getCsrfToken` (concurrent call handling)\n- `getRuntimeId`\n- `clearCsrfToken`\n\n",
        "level": 3
      },
      {
        "title": "Edge Cases",
        "content": "- **Concurrent calls to `getCsrfToken`** (promise deduplication)\n- **Server returns `ok: false`**\n- **Missing `token` or `runtime_id` in response**\n- **Cookie setting edge cases**\n\n",
        "level": 3
      },
      {
        "title": "Test Skeleton",
        "content": "\n```typescript\n// __tests__/lib/csrf.test.ts\nimport { getCsrfToken, getRuntimeId, clearCsrfToken } from '@/lib/csrf';\n\nglobal.fetch = jest.fn();\n\ndescribe('csrf', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n    clearCsrfToken();\n    document.cookie = '';\n  });\n\n  it('fetches CSRF token on first call', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'test-token-123', runtime_id: 'rt-456' }),\n    });\n\n    const token = await getCsrfToken();\n    \n    expect(token).toBe('test-token-123');\n    expect(global.fetch).toHaveBeenCalledWith('/csrf_token', { credentials: 'include' });\n  });\n\n  it('caches token on subsequent calls', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'cached-token', runtime_id: 'rt-123' }),\n    });\n\n    await getCsrfToken();\n    const token2 = await getCsrfToken();\n    \n    expect(global.fetch).toHaveBeenCalledTimes(1); // Only one network call\n    expect(token2).toBe('cached-token');\n  });\n\n  it('deduplicates concurrent calls', async () => {\n    (global.fetch as jest.Mock).mockImplementation(() =>\n      new Promise(resolve => setTimeout(() => resolve({\n        json: async () => ({ ok: true, token: 'concurrent-token', runtime_id: 'rt-789' }),\n      }), 100))\n    );\n\n    const [token1, token2, token3] = await Promise.all([\n      getCsrfToken(),\n      getCsrfToken(),\n      getCsrfToken(),\n    ]);\n\n    expect(global.fetch).toHaveBeenCalledTimes(1);\n    expect(token1).toBe(token2);\n    expect(token2).toBe(token3);\n  });\n\n  it('sets cookie with runtime_id', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'cookie-token', runtime_id: 'rt-cookie' }),\n    });\n\n    await getCsrfToken();\n    \n    expect(document.cookie).toContain('csrf_token_rt-cookie=cookie-token');\n  });\n\n  it('throws error when server returns ok: false', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: false, error: 'Server error' }),\n    });\n\n    await expect(getCsrfToken()).rejects.toThrow('Server error');\n  });\n\n  it('returns runtime_id after fetch', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'token', runtime_id: 'rt-get' }),\n    });\n\n    await getCsrfToken();\n    expect(getRuntimeId()).toBe('rt-get');\n  });\n\n  it('clears cached token', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      json: async () => ({ ok: true, token: 'clear-test', runtime_id: 'rt-clear' }),\n    });\n\n    await getCsrfToken();\n    clearCsrfToken();\n    \n    expect(getRuntimeId()).toBeNull();\n    \n    await getCsrfToken();\n    expect(global.fetch).toHaveBeenCalledTimes(2); // Fetch again after clear\n  });\n\n  it('handles network error', async () => {\n    (global.fetch as jest.Mock).mockRejectedValue(new Error('Network failure'));\n\n    await expect(getCsrfToken()).rejects.toThrow('Network failure');\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "6. `socket-client.ts` - Socket Initialization",
        "content": "\n",
        "level": 2
      },
      {
        "title": "Edge Cases",
        "content": "- Multiple calls to `initStateSyncSocket`\n- CSRF token failure in auth callback\n- Connect error triggering `clearCsrfToken`\n- Environment variable missing (`NEXT_PUBLIC_A0_URL`)\n\n",
        "level": 3
      },
      {
        "title": "Test Skeleton",
        "content": "\n```typescript\n// __tests__/lib/socket-client.test.ts\nimport { initStateSyncSocket, getStateSyncSocket, disconnectAll } from '@/lib/socket-client';\nimport { io } from 'socket.io-client';\nimport { getCsrfToken, clearCsrfToken } from '@/lib/csrf';\n\njest.mock('socket.io-client');\njest.mock('@/lib/csrf');\n\ndescribe('socket-client', () => {\n  let mockSocket: any;\n\n  beforeEach(() => {\n    jest.clearAllMocks();\n    disconnectAll();\n    \n    mockSocket = {\n      on: jest.fn(),\n      disconnect: jest.fn(),\n    };\n    (io as jest.Mock).mockReturnValue(mockSocket);\n    (getCsrfToken as jest.Mock).mockResolvedValue('test-token');\n  });\n\n  it('creates socket with correct configuration', () => {\n    initStateSyncSocket();\n    \n    expect(io).toHaveBeenCalledWith('/state_sync', expect.objectContaining({\n      autoConnect: false,\n      transports: ['polling', 'websocket'],\n      withCredentials: true,\n    }));\n  });\n\n  it('returns same socket on multiple calls', () => {\n    const socket1 = initStateSyncSocket();\n    const socket2 = initStateSyncSocket();\n    \n    expect(socket1).toBe(socket2);\n    expect(io).toHaveBeenCalledTimes(1);\n  });\n\n  it('auth callback fetches CSRF token', async () => {\n    initStateSyncSocket();\n    \n    const authCallback = (io as jest.Mock).mock.calls[0][1].auth;\n    const mockCb = jest.fn();\n    \n    await authCallback(mockCb);\n    \n    expect(getCsrfToken).toHaveBeenCalled();\n    expect(mockCb).toHaveBeenCalledWith({ csrf_token: 'test-token' });\n  });\n\n  it('auth callback handles CSRF error gracefully', async () => {\n    (getCsrfToken as jest.Mock).mockRejectedValue(new Error('CSRF failed'));\n    const consoleErrorSpy = jest.spyOn(console, 'error').mockImplementation();\n    \n    initStateSyncSocket();\n    \n    const authCallback = (io as jest.Mock).mock.calls[0][1].auth;\n    const mockCb = jest.fn();\n    \n    await authCallback(mockCb);\n    \n    expect(mockCb).toHaveBeenCalledWith({}); // Empty auth on error\n    consoleErrorSpy.mockRestore();\n  });\n\n  it('clears CSRF token on connect_error', () => {\n    initStateSyncSocket();\n    \n    const onConnectError = mockSocket.on.mock.calls.find(\n      ([event]: any) => event === 'connect_error'\n    )?.[1];\n\n    onConnectError?.();\n    \n    expect(clearCsrfToken).toHaveBeenCalled();\n  });\n\n  it('disconnects socket on disconnectAll', () => {\n    initStateSyncSocket();\n    disconnectAll();\n    \n    expect(mockSocket.disconnect).toHaveBeenCalled();\n    expect(getStateSyncSocket()).toBeNull();\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "7. `expo-messages.ts` - Message Utilities",
        "content": "\n",
        "level": 2
      },
      {
        "title": "Edge Cases",
        "content": "- Unknown tool names (fallback to default)\n- Missing `log.heading` or `log.content`\n- All log types (agent, subagent, progress, tool)\n\n",
        "level": 3
      },
      {
        "title": "Test Skeleton",
        "content": "\n```typescript\n// __tests__/lib/expo-messages.test.ts\nimport { getExpoMessage, getCompletionMessage } from '@/lib/expo-messages';\nimport type { A0LogEntry } from '@/lib/types';\n\ndescribe('expo-messages', () => {\n  it('returns quirky message for known tool', () => {\n    const log: A0LogEntry = {\n      no: 1,\n      id: 'log-1',\n      type: 'tool',\n      heading: 'Using food_cost_tool...',\n      content: '',\n      kvps: {},\n      timestamp: 1000,\n      agentno: 0,\n    };\n    \n    const msg = getExpoMessage(log);\n    expect(msg).toBeTruthy();\n    expect(typeof msg).toBe('string');\n  });\n\n  it('returns default message for unknown tool', () => {\n    const log: A0LogEntry = {\n      no: 1,\n      id: 'log-1',\n      type: 'tool',\n      heading: 'Using unknown_tool...',\n      content: '',\n      kvps: {},\n      timestamp: 1000,\n      agentno: 0,\n    };\n    \n    const msg = getExpoMessage(log);\n    expect(msg).toMatch(/Working on it|One moment|On it/);\n  });\n\n  it('returns delegation message for agent logs', () => {\n    const log: A0LogEntry = {\n      no: 1,\n      id: 'log-1',\n      type: 'agent',\n      heading: 'Inventory Agent',\n      content: '',\n      kvps: {},\n      timestamp: 1000,\n      agentno: 0,\n    };\n    \n    expect(getExpoMessage(log)).toContain('Delegating to Inventory Agent');\n  });\n\n  it('returns content for progress logs', () => {\n    const log: A0LogEntry = {\n      no: 1,\n      id: 'log-1',\n      type: 'progress',\n      heading: '',\n      content: 'Processing step 3 of 5',\n      kvps: {},\n      timestamp: 1000,\n      agentno: 0,\n    };\n    \n    expect(getExpoMessage(log)).toBe('Processing step 3 of 5');\n  });\n\n  it('returns null for unhandled log types', () => {\n    const log: A0LogEntry = {\n      no: 1,\n      id: 'log-1',\n      type: 'error',\n      heading: '',\n      content: 'Error occurred',\n      kvps: {},\n      timestamp: 1000,\n      agentno: 0,\n    };\n    \n    expect(getExpoMessage(log)).toBeNull();\n  });\n\n  it('getCompletionMessage returns valid kitchen phrase', () => {\n    const msg = getCompletionMessage();\n    expect(msg).toMatch(/Heard|Service|All set|Done, Chef/);\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "8. `use-workspace.ts` - Data Fetching Hook",
        "content": "\n",
        "level": 2
      },
      {
        "title": "Edge Cases",
        "content": "- 404/500 HTTP errors\n- Empty arrays vs null data\n- Malformed JSON\n- Rapid `refresh()` calls\n- Component unmount during fetch\n\n",
        "level": 3
      },
      {
        "title": "Test Skeleton",
        "content": "\n```typescript\n// __tests__/hooks/use-workspace.test.ts\nimport { renderHook, waitFor } from '@testing-library/react';\nimport { useWorkspace } from '@/hooks/use-workspace';\n\nglobal.fetch = jest.fn();\n\ndescribe('useWorkspace', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n  });\n\n  it('fetches data on mount', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => [{ id: 1, name: 'Item 1' }],\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/items'));\n    \n    expect(result.current.loading).toBe(true);\n    \n    await waitFor(() => expect(result.current.loading).toBe(false));\n    expect(result.current.data).toEqual([{ id: 1, name: 'Item 1' }]);\n    expect(result.current.error).toBeNull();\n  });\n\n  it('includes locationId in query params', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => [],\n    });\n\n    renderHook(() => useWorkspace('/api/items', 'loc-123'));\n    \n    await waitFor(() => \n      expect(global.fetch).toHaveBeenCalledWith('/api/items?location_id=loc-123', expect.any(Object))\n    );\n  });\n\n  it('handles 404 error', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({ ok: false, status: 404 });\n\n    const { result } = renderHook(() => useWorkspace('/api/missing'));\n    \n    await waitFor(() => expect(result.current.loading).toBe(false));\n    expect(result.current.error).toBe('404');\n    expect(result.current.data).toEqual([]);\n  });\n\n  it('handles network error', async () => {\n    (global.fetch as jest.Mock).mockRejectedValue(new Error('Network failure'));\n\n    const { result } = renderHook(() => useWorkspace('/api/items'));\n    \n    await waitFor(() => expect(result.current.loading).toBe(false));\n    expect(result.current.error).toBe('Network failure');\n  });\n\n  it('extracts data from nested response structure', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => ({ items: [{ id: 1 }] }),\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/items'));\n    \n    await waitFor(() => expect(result.current.data).toEqual([{ id: 1 }]));\n  });\n\n  it('refetches data when refresh called', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => [{ id: 1 }],\n    });\n\n    const { result } = renderHook(() => useWorkspace('/api/items'));\n    await waitFor(() => expect(result.current.loading).toBe(false));\n\n    (global.fetch as jest.Mock).mockClear();\n    result.current.refresh();\n    \n    await waitFor(() => expect(global.fetch).toHaveBeenCalledTimes(1));\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "9. Integration Test Gaps",
        "content": "\n",
        "level": 2
      },
      {
        "title": "Critical Missing Integration Tests",
        "content": "\n1. **Full chat flow:** User sends message → `/message_async` → `state_push` → UI updates\n2. **Socket reconnection:** Disconnect → reconnect → state resync\n3. **Concurrent operations:** Send message while queued messages pending\n4. **Error recovery:** Network failure → retry → success\n5. **CSRF flow:** Token fetch → cookie set → WebSocket auth → API call\n\n",
        "level": 3
      },
      {
        "title": "Integration Test Skeleton",
        "content": "\n```typescript\n// __tests__/integration/chat-flow.test.tsx\nimport { render, screen, waitFor } from '@testing-library/react';\nimport userEvent from '@testing-library/user-event';\nimport { ChatView } from '@/components/ChatView'; // Assuming this exists\nimport { initStateSyncSocket } from '@/lib/socket-client';\nimport { getCsrfToken } from '@/lib/csrf';\n\njest.mock('@/lib/socket-client');\njest.mock('@/lib/csrf');\n\ndescribe('Chat Integration Flow', () => {\n  it('completes full message send and response cycle', async () => {\n    const user = userEvent.setup();\n    \n    // Mock CSRF\n    (getCsrfToken as jest.Mock).mockResolvedValue('csrf-token');\n    \n    // Mock API\n    global.fetch = jest.fn().mockResolvedValue({\n      ok: true,\n      json: async () => ({ context: 'ctx-123' }),\n    });\n    \n    // Mock socket\n    const mockSocket = {\n      on: jest.fn(),\n      emit: jest.fn(),\n      connect: jest.fn(),\n      disconnect: jest.fn(),\n      connected: true,\n    };\n    (initStateSyncSocket as jest.Mock).mockReturnValue(mockSocket);\n    \n    render(<ChatView />);\n    \n    // User types and sends message\n    const input = screen.getByPlaceholderText(/type a message/i);\n    await user.type(input, 'Check inventory');\n    await user.click(screen.getByRole('button', { name: /send/i }));\n    \n    // Verify API call\n    await waitFor(() => \n      expect(global.fetch).toHaveBeenCalledWith('/message_async', expect.objectContaining({\n        method: 'POST',\n        body: JSON.stringify({ text: 'Check inventory', context: '' }),\n      }))\n    );\n    \n    // Simulate state_push response\n    const onStatePush = mockSocket.on.mock.calls.find(\n      ([event]: any) => event === 'state_push'\n    )?.[1];\n    \n    onStatePush?.({\n      data: {\n        snapshot: {\n          logs: [\n            { no: 1, id: 'log-1', type: 'user', content: 'Check inventory', timestamp: 1000 },\n            { no: 2, id: 'log-2', type: 'response', content: 'Inventory checked.', timestamp: 1001 },\n          ],\n          context: 'ctx-123',\n          log_progress_active: false,\n        },\n      },\n    });\n    \n    // Verify UI update\n    await waitFor(() => {\n      expect(screen.getByText('Check inventory')).toBeInTheDocument();\n      expect(screen.getByText('Inventory checked.')).toBeInTheDocument();\n    });\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "Summary of Priority Gaps",
        "content": "| Priority | Area | Key Missing Tests |\n|----------|------|-------------------|\n| **P0** | `use-chat.ts` | Queue logic, resetChat race conditions, error handling |\n| **P0** | `use-socket.ts` | Reconnection, malformed payloads, CSRF failures |\n| **P0** | `csrf.ts` | Concurrent calls, token caching, error states |\n| **P1** | `use-expo-stream.ts` | Timer cleanup, state transitions, fallback logic |\n| **P1** | `use-action-cards.ts` | Deduplication, type coercion edge cases |\n| **P2** | `use-workspace.ts` | Error handling, refresh logic |\n| **P2** | Integration tests | Full chat flow, socket reconnection, error recovery |\n\nStart with P0 tests for core reliability, then expand to P1/P2 for robustness.",
        "level": 2
      }
    ],
    "codeBlocks": [
      {
        "language": "typescript",
        "code": "// __tests__/hooks/use-action-cards.test.ts\nimport { renderHook, act } from '@testing-library/react';\nimport { useActionCards } from '@/hooks/use-action-cards';\nimport type { A0Snapshot } from '@/lib/types';\n\ndescribe('useActionCards', () => {\n  it('returns empty cards for null snapshot', () => {\n    const { result } = renderHook(() => useActionCards(null));\n    expect(result.current.cards).toEqual([]);\n    expect(result.current.unreadCount).toBe(0);\n  });\n\n  it('extracts action cards from tool logs with kvps', () => {\n    const snapshot: A0Snapshot = {\n      logs: [{\n        no: 1,\n        id: 'log-1',\n        type: 'tool',\n        kvps: { module: 'inventory', action: 'check_stock', item_id: '123' },\n        content: 'Checking stock levels...',\n        timestamp: 1234567890,\n        heading: '',\n        agentno: 0,\n      }],\n      // ... other required fields\n    };\n    const { result } = renderHook(() => useActionCards(snapshot));\n    expect(result.current.cards).toHaveLength(1);\n    expect(result.current.cards[0]).toMatchObject({\n      module: 'inventory',\n      action: 'check_stock',\n      itemId: '123',\n      read: false,\n    });\n  });\n\n  it('ignores logs without module or action', () => {\n    const snapshot: A0Snapshot = {\n      logs: [\n        { no: 1, id: 'log-1', type: 'tool', kvps: { module: 'test' }, content: '', timestamp: 0, heading: '', agentno: 0 },\n        { no: 2, id: 'log-2', type: 'tool', kvps: {}, content: '', timestamp: 0, heading: '', agentno: 0 },\n      ],\n      // ...\n    };\n    const { result } = renderHook(() => useActionCards(snapshot));\n    expect(result.current.cards).toEqual([]);\n  });\n\n  it('deduplicates logs by ID across updates', () => {\n    const { result, rerender } = renderHook(\n      ({ snapshot }) => useActionCards(snapshot),\n      { initialProps: { snapshot: createSnapshot([createToolLog('log-1')]) } }\n    );\n    expect(result.current.cards).toHaveLength(1);\n    \n    rerender({ snapshot: createSnapshot([createToolLog('log-1'), createToolLog('log-2')]) });\n    expect(result.current.cards).toHaveLength(2); // Only log-2 added\n  });\n\n  it('marks individual cards as read', () => {\n    const { result } = renderHook(() => useActionCards(createSnapshot([createToolLog('log-1')])));\n    \n    act(() => result.current.markRead('log-1'));\n    expect(result.current.cards[0].read).toBe(true);\n    expect(result.current.unreadCount).toBe(0);\n  });\n\n  it('marks all cards as read', () => {\n    const { result } = renderHook(() => useActionCards(\n      createSnapshot([createToolLog('log-1'), createToolLog('log-2')])\n    ));\n    \n    act(() => result.current.markAllRead());\n    expect(result.current.unreadCount).toBe(0);\n    expect(result.current.cards.every(c => c.read)).toBe(true);\n  });\n\n  it('handles missing kvps gracefully', () => {\n    const snapshot: A0Snapshot = {\n      logs: [{ no: 1, id: 'log-1', type: 'tool', kvps: null as any, content: '', timestamp: 0, heading: '', agentno: 0 }],\n      // ...\n    };\n    const { result } = renderHook(() => useActionCards(snapshot));\n    expect(result.current.cards).toEqual([]);\n  });\n});"
