        "code": "// src/lib/formatters.ts\nconst currencyCache = new Map<string, string>();\nconst dateCache = new Map<string, string>();\n\nexport function formatCurrency(v: unknown): string {\n  const key = String(v);\n  if (currencyCache.has(key)) return currencyCache.get(key)!;\n  \n  if (v == null || v === \"\") return \"—\";\n  const s = String(v).replace(/[$,]/g, \"\").trim();\n  const n = Number(s);\n  if (isNaN(n)) return String(v);\n  \n  const result = `$${n.toLocaleString(\"en-US\", { \n    minimumFractionDigits: 2, \n    maximumFractionDigits: 2 \n  })}`;\n  \n  currencyCache.set(key, result);\n  return result;\n}\n\n// Clear cache periodically to prevent unbounded growth\nsetInterval(() => {\n  if (currencyCache.size > 1000) currencyCache.clear();\n  if (dateCache.size > 1000) dateCache.clear();\n}, 60_000);"
