        "code": "// ❌ Current: Each component fetches independently\nfunction InventoryPage() {\n  const { data } = useWorkspace(\"/api/inventory\");\n}\nfunction InventorySidebar() {\n  const { data } = useWorkspace(\"/api/inventory\"); // Duplicate fetch!\n}"
