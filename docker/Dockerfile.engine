FROM python:3.12-slim

WORKDIR /app

# System dependencies for Agent Zero (git, build tools, tesseract for OCR, ffmpeg for whisper)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        build-essential \
        gfortran \
        tesseract-ocr \
        poppler-utils \
        ffmpeg \
        libsndfile1 \
        libopenblas-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy engine code (includes agent-zero submodule)
COPY engine/ engine/

# Upgrade pip and install build tools
RUN pip install --no-cache-dir --upgrade pip setuptools wheel meson-python meson ninja cython numpy

# Install litellm first (core Agent Zero dep missing from requirements.txt)
RUN pip install --no-cache-dir litellm

# Install Agent Zero dependencies (heavy, cached layer)
RUN pip install --no-cache-dir -r engine/agent-zero/requirements.txt

# Install CarabinerOS engine dependencies
RUN pip install --no-cache-dir \
    fastapi>=0.115.0 \
    "uvicorn[standard]>=0.34.0" \
    python-socketio>=5.14.0 \
    "sqlalchemy[asyncio]>=2.0.36" \
    asyncpg>=0.30.0 \
    alembic>=1.14.0 \
    pydantic>=2.10.0 \
    pydantic-settings>=2.7.0 \
    python-dotenv>=1.1.0 \
    httpx>=0.28.0

# Set working directory to engine
WORKDIR /app/engine

# Create usr directory for runtime data (overlay symlinks, .env, memory)
RUN mkdir -p agent-zero/usr

EXPOSE 8000

CMD ["python", "main.py"]
