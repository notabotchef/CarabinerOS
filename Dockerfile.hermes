# Dedicated CarabinerOS Hermes gateway (OpenAI-compatible API on :8642).
FROM python:3.11-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HERMES_HOME=/opt/data \
    PATH=/opt/hermes-agent/venv/bin:/usr/local/bin:$PATH

WORKDIR /opt/hermes-agent

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      curl git build-essential ca-certificates \
 && rm -rf /var/lib/apt/lists/*

ARG HERMES_PIP_SPEC=hermes-agent==0.18.2
COPY hermes-src/ /opt/hermes-agent/

# aiohttp is required by gateway/platforms/api_server.py
RUN python -m venv /opt/hermes-agent/venv \
 && /opt/hermes-agent/venv/bin/pip install -U pip setuptools wheel \
 && if [ -f /opt/hermes-agent/pyproject.toml ] || [ -f /opt/hermes-agent/setup.py ]; then \
      /opt/hermes-agent/venv/bin/pip install -e /opt/hermes-agent ; \
    else \
      /opt/hermes-agent/venv/bin/pip install "${HERMES_PIP_SPEC}" ; \
    fi \
 && /opt/hermes-agent/venv/bin/pip install "aiohttp>=3.9"

RUN mkdir -p /opt/data

EXPOSE 8642

HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=10 \
  CMD curl -sf -H "Authorization: Bearer ${API_SERVER_KEY}" http://127.0.0.1:8642/v1/models || exit 1

CMD ["hermes", "gateway", "run", "--accept-hooks"]
