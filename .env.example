# CarabinerOS local development example.
# Copy values into your shell, Docker environment, or an untracked .env file.

DATABASE_URL=postgresql+asyncpg://carabiner:carabiner@localhost:5432/carabiner
FLASK_SECRET_KEY=replace-with-local-dev-secret
ALLOWED_ORIGINS=*://localhost,*://localhost:*,*://127.0.0.1,*://127.0.0.1:*

# Frontend dev server proxy target. The Next.js dev server proxies
# /api, /csrf_token, /message_async, /chats, /socket.io, and /mcp to
# this URL. Docker compose sets it to http://bridge:8641. For hermetic
# dev (no Docker), point it at the locally-running bridge.
#
# NOTE: A0_URL is a legacy name from the Agent Zero era. It is being
# formally renamed to BRIDGE_URL in CFG-002. For now, keep the name
# to avoid breaking the frontend proxy config.
A0_URL=http://localhost:8641
NEXT_PUBLIC_A0_URL=

# Optional local model endpoints for hermes settings.local.json overrides.
OLLAMA_API_BASE=http://localhost:11434

# Optional provider keys. Do not commit real values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
NOUS_API_KEY=

# --- Hermes beta runtime ---
# Set CARABINER_RUNTIME=echo for hermetic dev (no hermes gateway needed).
# Set CARABINER_RUNTIME=hermes to wire up the real hermes intelligence.
CARABINER_RUNTIME=echo
BRIDGE_PORT=8641
BRIDGE_SECRET_KEY=change-me-openssl-rand-hex-32
HERMES_BASE_URL=http://127.0.0.1:8642
API_SERVER_KEY=change-me-openssl-rand-hex-32
HERMES_MODEL=carabineros-hermes
MCP_PUBLIC_URL=http://127.0.0.1:8641/mcp
AUDIT_REQUIRED=true

# --- Docker compose (postgres credentials) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=carabiner
