FROM python:3.12-slim

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl git \
    && rm -rf /var/lib/apt/lists/*

# Python deps — install with flexible resolution to handle A0's version conflicts
COPY requirements.txt requirements2.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt -r requirements2.txt || \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -r requirements2.txt

# Copy entire app
COPY . .

EXPOSE 5000

CMD ["python", "run_ui.py", "--dockerized=true"]
