# CarabinerOS — layered on top of Agent Zero's standard Docker pipeline
# Base image: Python 3.12 venv, tkinter, torch, HF, supervisord, searxng
FROM agent0ai/agent-zero-base:latest

ARG BRANCH=local
ENV BRANCH=$BRANCH

# ── A0 filesystem overlay (install scripts, exe scripts, supervisor config) ──
COPY engine/agent-zero/docker/run/fs/ /

# ── A0 engine source (local branch mode — no git clone) ──
COPY engine/agent-zero/ /git/agent-zero

# ── A0 install pipeline (same as DockerfileLocal) ──
RUN bash /ins/pre_install.sh $BRANCH
RUN bash /ins/install_A0.sh $BRANCH
RUN bash /ins/install_additional.sh $BRANCH
RUN bash /ins/post_install.sh $BRANCH

# ── CarabinerOS layer ──
# Install domain deps in A0's venv
RUN bash -c 'source /opt/venv-a0/bin/activate && \
    uv pip install "sqlalchemy[asyncio]>=2.0" "asyncpg>=0.29" "alembic>=1.13" "typer>=0.12" "rich>=13.0"'

# Copy domain code (runtime volume mount overrides this for dev)
COPY carabiner/ /cos/carabiner/

# Make carabiner.* importable from A0's code_execution
ENV PYTHONPATH="/cos:${PYTHONPATH}"

# CLI wrapper — A0 calls `carabiner orders list --json` via code_execution
RUN printf '#!/bin/bash\nsource /opt/venv-a0/bin/activate\nexec python -m carabiner.cli "$@"\n' > /usr/local/bin/carabiner && \
    chmod +x /usr/local/bin/carabiner

# ── Standard A0 runtime ──
EXPOSE 80 22 9000-9009

RUN chmod +x /exe/initialize.sh /exe/run_A0.sh /exe/run_searxng.sh /exe/run_tunnel_api.sh

# supervisord manages: sshd, cron, searxng, A0 (run_ui.py on port 80)
CMD ["/exe/initialize.sh", "local"]
