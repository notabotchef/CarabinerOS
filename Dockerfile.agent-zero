FROM python:3.12-slim

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl git \
    && rm -rf /var/lib/apt/lists/*

# Python deps — install with flexible resolution to handle A0's version conflicts
COPY requirements.txt requirements2.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt -r requirements2.txt || \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -r requirements2.txt

# Copy entire app
COPY . .

# Create .venv/bin/python symlink so MCP server config (.venv/bin/python)
# works identically in Docker (system python) and local dev (real venv)
RUN mkdir -p .venv/bin && ln -sf /usr/local/bin/python .venv/bin/python

# ipython is required by Agent Zero's code_execution_tool for Python runtime
RUN pip install --no-cache-dir ipython

# Entrypoint script installs codex-proxy plugin at startup (usr/ is volume-mounted,
# not available at build time). Then launches the app.
EXPOSE 5000

CMD ["sh", "-c", "\
  if [ -f usr/plugins/codex-proxy/initialize.py ]; then \
    python usr/plugins/codex-proxy/initialize.py --a0-root /app --plugin-root /app/usr/plugins/codex-proxy \
    && mkdir -p plugins \
    && ln -sfn /app/usr/plugins/codex-proxy plugins/codex-proxy \
    && echo '[entrypoint] codex-proxy plugin installed'; \
  fi \
  && python run_ui.py --dockerized=true"]
