FROM python:3.12-slim

# A0 runs from /a0, CarabinerOS domain code at /cos
WORKDIR /a0

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl git \
    && rm -rf /var/lib/apt/lists/*

# Python deps — A0's requirements
COPY engine/agent-zero/requirements.txt engine/agent-zero/requirements2.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt -r requirements2.txt || \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -r requirements2.txt

# CarabinerOS additional deps (SQLAlchemy async, asyncpg, MCP, Pydantic, etc.)
COPY carabiner/requirements.txt /tmp/cos-requirements.txt
RUN pip install --no-cache-dir -r /tmp/cos-requirements.txt 2>/dev/null || true

# ipython is required by Agent Zero's code_execution_tool
RUN pip install --no-cache-dir ipython

# Copy A0 engine (from submodule — read-only, never modified)
COPY engine/agent-zero/ /a0/

# Copy CarabinerOS domain code
COPY carabiner/ /cos/carabiner/

# Create .venv/bin/python symlink so MCP server config works
RUN mkdir -p /a0/.venv/bin && ln -sf /usr/local/bin/python /a0/.venv/bin/python

# Add /cos to Python path so carabiner.* imports work from A0 extensions
ENV PYTHONPATH="/cos:${PYTHONPATH}"

EXPOSE 5000

# Run A0's run_ui.py — CarabinerOS registers via startup_migration extension
CMD ["python", "run_ui.py"]
