# Ignore common unwanted files globally
**/.DS_Store
**/.env
**/__pycache__/
*.py[cod]
**/.conda/

# IDE files
.cursor/
.windsurf/

# test files in root dir
/*.test.py

# Virtual environment
.venv/

# Obsolete folders
/memory/
/knowledge/custom/
/instruments/

# Logs
logs/**
!logs/**/

# Temp
tmp/**
!tmp/**/

# ── usr/ ─────────────────────────────────────────────
# Track our plugins/extensions/agents/settings but ignore
# runtime data (chats, memory, workdir, secrets, projects)
usr/chats/
usr/memory/
usr/workdir/
usr/secrets.env
usr/projects/
usr/.env
usr/**/__pycache__/
/usr/**/.git

# ── Engine submodule ─────────────────────────────────
# The submodule is tracked by .gitmodules — don't ignore it

# ── Build artifacts ──────────────────────────────────
frontend/.next/
frontend/node_modules/
.ruff_cache/
.next/

# for browser-use
agent_history.gif

# Rune / Claude state
.agent/**
.worktrees/

# Global .gitkeep
!**/.gitkeep
