# ── Runtime data (volume-mounted, not baked into image) ──
usr/chats/
usr/memory/
usr/workdir/
usr/secrets.env
usr/projects/

# ── Build artifacts ──
frontend/node_modules/
frontend/.next/
frontend/out/
.venv/

# ── Dev/tooling files ──
.conda/
.cursor/
.claude/
.rune/
.github/
.worktrees/
.git/

# ── Docs (not needed at runtime) ──
docs/

# ── Tests ──
tests/

# ── OS / editor junk ──
**/.DS_Store
**/Thumbs.db
**/__pycache__/
**/*.py[cod]
*.env
